// UI-01, Q-008 вариант b (решение владельца 15.11.2026): текст "Данных нет"
// выводится программно, а не настройкой схемы компоновки. Штатный элемент
// схемы "текст при отсутствии данных" платформа 8.5.4 в этой редакции не
// принимает: загрузка расширения прерывается ошибкой разбора файла схемы
// (см. docs/review/ui01-design-2026-11-15.md §3). Поэтому компоновка
// выполняется вручную тем же способом, что и штатная обработка, а при
// пустом результате в тело отчёта дописывается строка.
//
// Любой сбой ручной компоновки возвращает управление платформе
// (СтандартнаяОбработка = Истина): отчёт не должен перестать открываться
// из-за этого механизма.

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Попытка
		СхемаКД = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		Настройки = КомпоновщикНастроек.ПолучитьНастройки();

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКД, Настройки);

		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);

		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
		ПроцессорВывода.Вывести(Процессор);

		// Пустота определяется по высоте готового документа: шапка отчёта
		// (заголовки колонок и итоговая строка оформления) занимает
		// ВысотаШапкиОтчета строк, каждая запись добавляет строку. Свойство
		// закреплено проверкой ТестТекстОтсутствияДанных: пустой результат
		// ровно ВысотаШапкиОтчета, полный - больше; при изменении схемы
		// проверка упадёт и потребует обновить константу. Подсчёт элементов
		// результата для этой цели не годится: платформа отдаёт элементы и
		// при пустом результате.
		Если ДокументРезультат.ВысотаТаблицы <= ВысотаШапкиОтчета() Тогда
			ВывестиТекстОтсутствияДанных(ДокументРезультат);
		КонецЕсли;
	Исключение
		// Отчёт обязан открыться: при любом сбое работает штатная обработка.
		СтандартнаяОбработка = Истина;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Высота шапки отчёта в строках табличного документа.
//
// Возвращаемое значение:
//   Число - строки заголовков/оформления до первой записи.
//
Функция ВысотаШапкиОтчета()

	ВысотаШапки = 5;
	Возврат ВысотаШапки;

КонецФункции

Процедура ВывестиТекстОтсутствияДанных(ДокументРезультат) Экспорт

	НомерСтроки = ?(ДокументРезультат.ВысотаТаблицы > 0, ДокументРезультат.ВысотаТаблицы + 1, 1);
	Ячейка = ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1");
	Если Ячейка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ячейка.Текст = НСтр("ru = 'Данных нет'");
	// Ручная компоновка отчёта: конструктор шрифта допустим (см. шапку модуля).
	// BSLLS:StyleElementConstructors-off
	РазмерШрифта = 12;
	Ячейка.Шрифт = Новый Шрифт(, РазмерШрифта, Истина);
	// BSLLS:StyleElementConstructors-on

КонецПроцедуры

#КонецОбласти

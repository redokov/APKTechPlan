// Форма обработки «Тх_ФормированиеПланаРаботТехники» (design 5.4/6.1,
// T7-T9): параметры потребности по техкартам годового плана АПК и кнопка
// «Сформировать» (Form.Command.Сформировать).
//
// T9: «Сформировать» создаёт НОВЫЙ документ «Потребность в технике»
// (Тх_ТехникаСервер.ЗаполнитьПланРабот), записывает и открывает его;
// если указан «текущий документ» - перезаполнение его табличных частей
// с подтверждением (FAQ Q8). Без техкарт документ не создаётся (design 9).
//
// Без модальности и фоновых заданий (NFR-001): ПоказатьВопрос /
// ПоказатьПредупреждение / ОткрытьЗначение - асинхронные. Форма выбора
// типового справочника сценариев - стандартный (поле типизировано
// с T7; легаси-обработчик НачалоВыбора удалён, FAQ Q8, TD-001).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Умолчание (design 5.4): СменВдень = 1.
	Если НЕ ЗначениеЗаполнено(СменВдень) Тогда
		СменВдень = 1;
	КонецЕсли;

	// Открытие из существующего документа: параметр «Документ»
	// (design 5.4 - опция «Перезаполнить текущий документ»).
	ВходящийДокумент = Неопределено;
	Параметры.Свойство("Документ", ВходящийДокумент);
	Если ВходящийДокумент <> Неопределено Тогда
		Документ = ВходящийДокумент;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)

	// Сценарий планирования обязателен (design 5.4).
	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите сценарий планирования.'"));
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Документ) Тогда
		// FAQ Q8: перезаполнение текущего документа - с подтверждением.
		Оповещение = Новый ОписаниеОповещения("ПерезаполнениеЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			СтрШаблон(НСтр("ru = 'Перезаполнить документ %1? Табличные части будут очищены.'"),
				Строка(Документ)),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		СоздатьИОткрытьДокумент();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнениеЗавершение(РезультатВопроса, ДопПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Результат = ПерезаполнитьНаСервере();
		Если Результат.КоличествоСтрок = 0 Тогда
			// Крайний случай design 9: документ не перезаполняется.
			ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
				НСтр("ru = 'Техкарты за период не найдены.'"));
		Иначе
			ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
				ТекстСводки(Результат));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИОткрытьДокумент()

	Результат = СоздатьНаСервере();
	Если Результат.КоличествоСтрок = 0 Тогда
		// Крайний случай design 9: документ не создаётся.
		ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
			НСтр("ru = 'Техкарты за период не найдены.'"));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
			ТекстСводки(Результат));
		ОткрытьЗначение(Результат.Документ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ТекстСводки(Результат)

	Возврат СтрШаблон(
		НСтр("ru = 'Строк: %1, смен всего: %2 (часов: %3), замещено: %4, дефицитных: %5'"),
		Результат.КоличествоСтрок, Результат.ВсегоСмен, Результат.ВсегоЧасов,
		Результат.ЗамещенныхСтрок, Результат.ДефицитныхСтрок);

КонецФункции

&НаСервере
Функция СоздатьНаСервере()

	ДокументОбъект = Документы.Тх_ПланТехническихРесурсов.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	Результат = Тх_ТехникаСервер.ЗаполнитьПланРабот(ДокументОбъект, ПараметрыЗаполнения());

	Если Результат.КоличествоСтрок > 0 Тогда
		ДокументОбъект.Записать();
		Результат.Вставить("Документ", ДокументОбъект.Ссылка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПерезаполнитьНаСервере()

	ДокументОбъект = Документ.ПолучитьОбъект();
	Результат = Неопределено;
	Если ДокументОбъект <> Неопределено Тогда
		Результат = Тх_ТехникаСервер.ЗаполнитьПланРабот(ДокументОбъект, ПараметрыЗаполнения());
		Если Результат.КоличествоСтрок > 0 Тогда
			ДокументОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Результат = Новый Структура("КоличествоСтрок", 0);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПараметрыЗаполнения()

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СценарийПланирования", СценарийПланирования);
	СтруктураПараметров.Вставить("Организация", Организация);
	СтруктураПараметров.Вставить("Подразделение", Подразделение);
	СтруктураПараметров.Вставить("ДатаНачала", ПериодС);
	СтруктураПараметров.Вставить("ДатаОкончания", ПериодПо);
	СтруктураПараметров.Вставить("ДнейПериода", ДнейПериода);
	СтруктураПараметров.Вставить("СменВдень", СменВдень);

	Возврат СтруктураПараметров;

КонецФункции


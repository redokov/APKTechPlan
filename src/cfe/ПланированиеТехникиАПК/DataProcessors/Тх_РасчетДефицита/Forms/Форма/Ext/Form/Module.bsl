// Форма обработки «Тх_РасчетДефицита» (design §4.8): отборы и параметры запуска
// расчёта дефицита техники (design §4.7), серверный вызов
// Тх_ТехникаСервер.РассчитатьДефицит и открытие отчёта «Анализ дефицита техники»
// (фаза 1 двухфазной схемы, TD-002/TD-003).
//
// Без модальности и фоновых заданий (NFR-001). Форма выбора типового справочника
// сценариев открывается по строковому имени (FAQ Q8, TD-001).

&НаКлиенте
Процедура СценарийПланированияНачалоВыбора(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник." + ИмяСправочникаСценариев() + ".ФормаВыбора", , Элемент);

КонецПроцедуры

&НаКлиенте
Функция ПараметрыВводаКорректны()

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату начала периода.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату окончания периода.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Дата начала периода не может быть позже даты окончания.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СменВДень) Или СменВДень <= 0 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Смен в день должно быть больше нуля.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура РассчитатьИОткрытьОтчет(Команда)

	// Сценарий планирования обязателен: без него расчёт невозможен (design §4.7).
	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите сценарий планирования.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ПараметрыВводаКорректны() Тогда
		Возврат;
	КонецЕсли;

	КоличествоЗаписей = РассчитатьДефицитНаСервере();

	Если КоличествоЗаписей > 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Расчет дефицита'"), ,
			СтрШаблон(НСтр("ru = 'Записей в отчёте: %1'"), КоличествоЗаписей));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Расчет дефицита'"), ,
			НСтр("ru = 'Данные для отчёта не рассчитаны. Выполните «Расчет дефицита» и повторите формирование.'"));
	КонецЕсли;

	// UI-01 (Q-008c): после расчёта момент свежий - пометка снимается.
	ОбновитьПометкуУстаревания();

	// Собственной формы у отчёта нет: платформа генерирует форму по основной
	// СКД; виртуальная форма адресуется суффиксом ".Форма" (design §4.8).
	ОткрытьФорму("Отчет.Тх_ДефицитТехники.Форма");

КонецПроцедуры

&НаСервере
Функция РассчитатьДефицитНаСервере()

	// Сборка параметров расчёта (design §4.7) и вызов серверного алгоритма;
	// повторная валидация - внутри Тх_ТехникаСервер.РассчитатьДефицит.
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СценарийПланирования", СценарийПланирования);
	ПараметрыРасчета.Вставить("Организация", Организация);
	ПараметрыРасчета.Вставить("Подразделение", Подразделение);
	ПараметрыРасчета.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыРасчета.Вставить("ДатаОкончания", ДатаОкончания);
	ПараметрыРасчета.Вставить("ВидТехники", ВидТехники);
	ПараметрыРасчета.Вставить("СменВДень", СменВДень);
	ПараметрыРасчета.Вставить("СуффиксОбъема", СуффиксОбъема());

	Возврат Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

КонецФункции

&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)

	// UI-01 (Q-008c): при смене сценария пометка устаревания пересчитывается.
	ОбновитьПометкуУстаревания();

КонецПроцедуры

&НаСервере
Функция ПометкаУстареванияНаСервере(Сценарий)

	// UI-01 (Q-008 вариант c): текст пометки по состоянию расчёта сценария;
	// пустая строка = пометка не выводится (расчёта не было или данные свежие).

	Состояние = Тх_ТехникаСервер.ДанныеРасчетаУстарели(Сценарий);
	Если НЕ Состояние.Устарели Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Данные расчёта устарели: источники изменялись %1. Выполните расчёт повторно.'"),
		Формат(Состояние.ПоследнееИзменение, "ДЛФ=D"));

КонецФункции

&НаСервере
Процедура ОбновитьПометкуУстаревания()

	// UI-01 (Q-008 вариант c): реквизит - источник текста пометки, декорация -
	// вывод; пустой текст скрывает элемент (место не занимается).

	ПометкаУстаревания = ПометкаУстареванияНаСервере(СценарийПланирования);
	Элементы.ПометкаУстаревания.Заголовок = ПометкаУстаревания;
	Элементы.ПометкаУстаревания.Видимость = ЗначениеЗаполнено(ПометкаУстаревания);

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Умолчания (Q-001/FAQ Q2, FAQ Q3): СменВДень = 1, ВариантОбъема = «Вероятный».
	Если НЕ ЗначениеЗаполнено(СменВДень) Тогда
		СменВДень = 1;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ВариантОбъема) Тогда
		ВариантОбъема = "Вероятный";
	КонецЕсли;

	// UI-01 (Q-008c): пометка устаревания по предзаполненному сценарию
	// (обычно пусто - сценарий выбирают после открытия; пересчёт - в
	// СценарийПланированияПриИзменении).
	ОбновитьПометкуУстаревания();

КонецПроцедуры

&НаСервере
Функция СуффиксОбъема()

	// Контекст сервера: вызывается из РассчитатьДефицитНаСервере (T6-фикс:
	// вызов клиентской функции из серверного контекста не компилируется).

	// Вариант объёма работ -> суффикс ресурса годового плана (FAQ Q3, TD-002):
	// Минимальный -> «_Мин», Максимальный -> «_Макс», иначе -> «_Вер».
	Если ВариантОбъема = "Минимальный" Тогда
		Возврат "_Мин";
	ИначеЕсли ВариантОбъема = "Максимальный" Тогда
		Возврат "_Макс";
	Иначе
		Возврат "_Вер";
	КонецЕсли;

КонецФункции

// Локальная константа имени (design §4.1, п. 3): каноническое значение хранит
// Тх_ТехникаСервер.ИмяСправочникаСценариевПланирования; серверный модуль с
// клиента недоступен (FAQ Q8), значение продублировано в клиентском модуле.

&НаКлиенте
Функция ИмяСправочникаСценариев()

	Возврат "АпкСценарииПланирования";

КонецФункции

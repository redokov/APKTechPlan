	ДефицитТехники.МодельТехники КАК МодельТехники,
	ДефицитТехники.ВидТехники КАК ВидТехники,
	ДефицитТехники.ПотребностьСмен КАК ПотребностьСмен,
	ДефицитТехники.ДоступноСмен КАК ДоступноСмен,
	ДефицитТехники.НехватаетСмен КАК НехватаетСмен,
	ДефицитТехники.ДнейПериода КАК ДнейПериода,
	ДефицитТехники.СменВДень КАК СменВДень,
	ДефицитТехники.КоэффициентНеЗадан КАК КоэффициентНеЗадан,
	ДефицитТехники.ПланТехресурсовОтсутствует КАК ПланТехресурсовОтсутствует
ИЗ
	РегистрСведений.Тх_ДефицитТехники КАК ДефицитТехники
ГДЕ
	(&amp;Организация ЕСТЬ NULL ИЛИ ДефицитТехники.Организация = &amp;Организация)
	И (&amp;Подразделение ЕСТЬ NULL ИЛИ ДефицитТехники.Подразделение = &amp;Подразделение)
	И (&amp;СценарийПланирования ЕСТЬ NULL ИЛИ ДефицитТехники.СценарийПланирования = &amp;СценарийПланирования)
	И (&amp;ДатаНачала ЕСТЬ NULL ИЛИ ДефицитТехники.ПериодНачала &gt;= &amp;ДатаНачала)
	И (&amp;ДатаОкончания ЕСТЬ NULL ИЛИ ДефицитТехники.ПериодОкончания &lt;= &amp;ДатаОкончания)
	И (&amp;ВидРаботы ЕСТЬ NULL ИЛИ ДефицитТехники.ВидРаботы = &amp;ВидРаботы)
	И (&amp;МодельТехники ЕСТЬ NULL ИЛИ ДефицитТехники.МодельТехники = &amp;МодельТехники)
	И (&amp;ВидТехники ЕСТЬ NULL ИЛИ ДефицитТехники.ВидТехники = &amp;ВидТехники)
	И (НЕ &amp;ТолькоДефицит ИЛИ ДефицитТехники.НехватаетСмен &gt; 0)</query>

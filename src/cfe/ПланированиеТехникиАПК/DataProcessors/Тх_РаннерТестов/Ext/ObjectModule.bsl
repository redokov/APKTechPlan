// Модуль объекта обработки «Тх_РаннерТестов» (design §11, задача A11).
//
// Точка входа запуска модульных тестов общего модуля Тх_Тесты:
//  - из формы обработки (кнопка «Выполнить тесты»);
//  - headless: COM (V83.COMConnector:
//    Обработки.Тх_РаннерТестов.Создать().ВыполнитьТесты()) или /Execute.
//
// Тесты вызываются явно, поимённо (без Вычислить/Выполнить - они могут быть
// запрещены безопасным режимом расширения); упавший с исключением тест
// помечается провалом и не прерывает прогон остальных.

#Область СлужебныеПроцедурыИФункции

// Последовательно выполняет все 24 теста модуля Тх_Тесты и возвращает
// результаты прогона.
//
// Возвращаемое значение:
//   Массив - элементы Структура:
//     * Имя            - Строка - имя теста;
//     * Статус         - Строка - статус теста: "PASS", "FAIL" или "SKIP";
//     * ДлительностьМс - Число - длительность выполнения, миллисекунды;
//     * Провалы        - Массив - имена проваленных проверок (пустой для PASS и SKIP).
//
Функция ВыполнитьТесты() Экспорт

	Результаты = Новый Массив;

	// Q-006/TEST-02: стартовая очистка хвостов прошлых прогонов
	// (реестр тестовых объектов + sweep фикстур по маскам имён).
	// Сбой очистки не прерывает прогон: каждый тест всё равно
	// обратится к маркеру и упадёт видимой FAIL-строкой (проба
	// сброса Тх_ТестоваяБаза, TEST-02 acceptance).
	Попытка
		Тх_Тесты.УдалитьОстаткиПрошлыхПрогонов();
	Исключение
		Стр = Новый Структура;
		Стр.Вставить("Имя", "СтартоваяОчистка");
		Стр.Вставить("Статус", "FAIL");
		Стр.Вставить("ДлительностьМс", 0);
		Стр.Вставить("Провалы", Новый Массив);
		Стр.Провалы.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результаты.Добавить(Стр);
	КонецПопытки;

	ЗапуститьТестЧислоДнейПериода(Результаты);
	ЗапуститьТестДублиТСНеУвеличиваютДоступность(Результаты);
	ЗапуститьТестДефицитМаксНуля(Результаты);
	ЗапуститьТестПланТехресурсовОтсутствуетПометкаНеНоль(Результаты);
	ЗапуститьТестДетерминированностьПовторногоРасчета(Результаты);
	ЗапуститьТестОчисткаНеТрогаетДругиеПериоды(Результаты);
	ЗапуститьТестГраницаПересеченияОднимДнем(Результаты);
	ЗапуститьТестПустыеДатыПолнаяПерезапись(Результаты);
	ЗапуститьТестОжиданиеБлокировкиОграничено(Результаты);
	ЗапуститьТестВалидацииGenericТипов(Результаты);
	ЗапуститьТестДоступноСменЧерезЗамещение(Результаты);
	ЗапуститьТестДоступноСменЗамещениеНеЗадан(Результаты);
	ЗапуститьТестПотребностьПоТехкартамДемоДанные(Результаты);
	ЗапуститьТестПотребностьПоТехкартамЧужоеПодразделение(Результаты);
	ЗапуститьТестДоступныеМоделиПланРаспределения(Результаты);
	ЗапуститьТестДоступныеМоделиБезПлана(Результаты);
	ЗапуститьТестЗаполнитьПланРаботДемоДанные(Результаты);
	ЗапуститьТестЗаполнитьТЧЗамещениеПоШирине(Результаты);
	ЗапуститьТестЗаполнитьТЧСвояМодельДоступна(Результаты);
	ЗапуститьТестВалидацииСцепки(Результаты);
	ЗапуститьТестКоэффициентЗамещенияПриоритетРучного(Результаты);
	ЗапуститьТестКоэффициентЗамещенияПоШирине(Результаты);
	ЗапуститьТестКоэффициентЗамещенияСтартИПроч(Результаты);
	ЗапуститьТестКоэффициентЗамещенияНеЗадан(Результаты);
	ЗапуститьТестРеквизитМоделиОтсутствуетВМетаданных(Результаты);
	ЗапуститьТестОшибкаЗапросаАПКПробрасывается(Результаты);
	ЗапуститьТестКлассификаторОтключенияМодуляАПК(Результаты);
	ЗапуститьТестНеСсылкаСправочникаПредупреждена(Результаты);
	ЗапуститьТестПакетныйКэшЭквивалентенПоштучному(Результаты);
	ЗапуститьТестТекстОтсутствияДанных(Результаты);

	// Q-006/TEST-02: финальная проверка чистоты - всегда в результатах
	// (детерминированный счёт, EXPECTED_TOTAL 31). Остатки (реестр +
	// маски) = видимый FAIL прогона; список уходит и в артефакт-файл
	// рядом с логами прогона (при headless-запуске).
	НачалоЧистоты = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// Тоже под Попыткой: маркер-офф не должен валить COM-вызов целиком,
	// а давать видимый FAIL (проба сброса Тх_ТестоваяБаза).
	Попытка
		ПровалыЧистоты = Тх_Тесты.ОстаткиПослеПрогона();
	Исключение
		ПровалыЧистоты = Новый Массив;
		ОписаниеОшибкиТекстом = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПровалыЧистоты.Добавить("ОстаткиПослеПрогона: " + ОписаниеОшибкиТекстом);
	КонецПопытки;
	СтатусЧистоты = ?(ПровалыЧистоты.Количество() = 0, "PASS", "FAIL");
	ЗафиксироватьРезультат(Результаты, "ЧистотаТестовыхДанных",
		Новый Структура("Статус, Провалы", СтатусЧистоты, ПровалыЧистоты),
		НачалоЧистоты);

	Возврат Результаты;

КонецФункции

// Фиксирует результат одного теста с длительностью выполнения.
//
// Параметры:
//   Результаты          - Массив - накапливаемые результаты прогона;
//   ИмяТеста            - Строка - имя теста;
//   СтруктураРезультата - Структура, Неопределено - результат теста
//                         (Статус "PASS"/"FAIL"/"SKIP", Провалы);
//                         Неопределено - тест упал с необработанным
//                         исключением (фиксируется как FAIL);
//   НачалоТеста         - Число - момент старта теста (универсальное время, мс).
//
Процедура ЗафиксироватьРезультат(Результаты, ИмяТеста, СтруктураРезультата, НачалоТеста)

	// СтруктураРезультата = Неопределено => тест упал с необработанным
	// исключением до возврата контекста (см. Исключение в обёртке).
	Если СтруктураРезультата = Неопределено Тогда
		Статус = "FAIL";
		Провалы = Новый Массив;
	Иначе
		Статус = СтруктураРезультата.Статус;
		Провалы = СтруктураРезультата.Провалы;
	КонецЕсли;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоТеста;
	Детали = "";
	Если Провалы.Количество() > 0 Тогда
		Детали = СтрСоединить(Провалы, "; ");
	КонецЕсли;
	РезультатТеста = Новый Структура;
	РезультатТеста.Вставить("Имя", ИмяТеста);
	РезультатТеста.Вставить("Статус", Статус);
	РезультатТеста.Вставить("ДлительностьМс", Длительность);
	РезультатТеста.Вставить("Провалы", Провалы);
	РезультатТеста.Вставить("Детали", Детали);
	Результаты.Добавить(РезультатТеста);

КонецПроцедуры

// Выводит сообщение об исключении теста (тест не прерывает прогон).
//
// Параметры:
//   ИмяТеста - Строка - имя теста;
//   ТекстОшибки - Строка - описание исключения.
//
Процедура СообщитьОбИсключенииТеста(ИмяТеста, ТекстОшибки)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(НСтр("ru = 'Тест %1 упал с исключением: %2'"),
		ИмяТеста, ТекстОшибки);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область ВызовТестов

// Обёртка вызова теста ТестЧислоДнейПериода.
//
Процедура ЗапуститьТестЧислоДнейПериода(Результаты)

	ИмяТеста = "ТестЧислоДнейПериода";
	НачалоТеста = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РезультатТеста = Неопределено;
	Попытка
		РезультатТеста = Тх_Тесты.ТестЧислоДнейПериода();
	Исключение
		РезультатТеста = Неопределено;
		СообщитьОбИсключенииТеста(ИмяТеста, ОписаниеОшибки());
	КонецПопытки;
	ЗафиксироватьРезультат(Результаты, ИмяТеста, РезультатТеста, НачалоТеста);

КонецПроцедуры










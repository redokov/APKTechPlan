// Модуль объекта документа «Тх_ПланТехническихРесурсов».
//
// Проведение (design 4.4):
//  (а) заполненность шапки: Организация, Подразделение, СценарийПланирования;
//      сценарий - generic-ссылка, тип проверяется рантаймом (design 4.1, TD-001);
//  (б) строки табличных частей: транспортное средство обязательно (Q-003),
//      количество больше нуля;
//  (в) транспортное средство не может повторяться в документе (в пределах
//      одной ТЧ и между ТЧ) - отказ;
//  (г) то же ТС принято в другом подразделении того же сценария -
//      неблокирующее предупреждение (FAQ Q5), проведение проходит.
//  (д) сцепка «модель + оборудование» в ТЧ ОсновнаяТехника/Автотранспорт -
//      отказ записи при несочетаемой паре (FR-002, T4).
//
// Движения документ не создаёт (FAQ Q9): расчёт дефицита (A7) читает
// табличные части запросом по Проведен = ИСТИНА.

// Проверяет совместимость сцепки «модель + оборудование» в строках ТЧ
// ОсновнаяТехника и Автотранспорт при любой записи документа (FR-002,
// design 5.3): несочетаемая пара - отказ записи. ТЧ Оборудование сцепки
// не содержит (единственная модель, FAQ Q1).
//
// Параметры:
//   Отказ         - Булево - признак отказа записи;
//   РежимЗаписи   - РежимЗаписиДокумента - режим записи (не используется);
//   РежимПроведения - РежимПроведенияДокумента - режим проведения (не используется).
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// При загрузке данных обмена валидации объекта отключаются
	// (v8std 773 «ОбменДанными.Загрузка»).
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПроверитьСцепкуТабличныхЧастей(Отказ);

КонецПроцедуры

// Перебирает строки ТЧ с колонками «МодельТехники» и «Оборудование»
// и фиксирует отказ для несовместимых сцепок.
//
// Параметры:
//   Отказ - Булево - признак отказа записи.
//
Процедура ПроверитьСцепкуТабличныхЧастей(Отказ)

	Пары = Новый Массив;
	Пары.Добавить(Новый Структура("Коллекция, ИмяТЧ", ОсновнаяТехника, ИмяТЧОсновнаяТехника()));
	Пары.Добавить(Новый Структура("Коллекция, ИмяТЧ", Автотранспорт, ИмяТЧАвтотранспорт()));

	Для Каждого Пара Из Пары Цикл
		НомерСтроки = 0;
		Для Каждого СтрокаТЧ Из Пара.Коллекция Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НЕ Тх_ТехникаСервер.ВалидироватьСцепку(СтрокаТЧ.МодельТехники, СтрокаТЧ.Оборудование) Тогда
				Отказ = Истина;
				СообщитьОбОшибке(СтрШаблон("Табличная часть «%1», строка %2:
					|несовместимая сцепка - модель «%3» и оборудование «%4».",
					Пара.ИмяТЧ, НомерСтроки, СтрокаТЧ.МодельТехники, СтрокаТЧ.Оборудование));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// При загрузке данных обмена валидации объекта отключаются
	// (v8std 773 «ОбменДанными.Загрузка»).
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПроверитьШапку(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Все проверки трёх ТЧ и предупреждение о приёмке в других подразделениях -
	// ОДИН ПАКЕТ из 6 запросов: один поход в БД вместо трёх переборов коллекций
	// и отдельного запроса предупреждения (NFR-002). В ОбработкаПроведения запись
	// уже в транзакции - запрос видит текущие данные всех ТЧ по Ссылке.
	Результаты = ЗапросПроверкиТабличныхЧастей().ВыполнитьПакет();

	ПринятыеТС = Новый Соответствие;
	ПроверитьТабличныеЧастиЗапросом(Результаты, Отказ, ПринятыеТС);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ПредупредитьОПриемкеВДругихПодразделениях(Результаты[5], ПринятыеТС);

КонецПроцедуры

// Проверяет заполненность шапки и тип сценария планирования (design 4.1, п. 2).
//
// Параметры:
//   Отказ - Булево - признак отказа проведения.
//
Процедура ПроверитьШапку(Отказ)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не заполнена организация.");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не заполнено подразделение.");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не заполнен сценарий планирования.");
	Иначе
		ТипСценария = ТипСценарияПланирования();
		Если ТипСценария <> Неопределено
			И ТипЗнч(СценарийПланирования) <> ТипСценария Тогда
			Отказ = Истина;
			СообщитьОбОшибке("Сценарий планирования должен быть элементом справочника
				|«АпкСценарииПланирования».");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Строит пакет из 6 запросов по всем табличным частям документа
// (единственный источник представлений имён ТЧ - функции ИмяТЧ*):
//   [0] СтрокиТЧ   - временная таблица: строки трёх ТЧ (объединение по Ссылке);
//   [1] дубли ТС   - СГРУППИРОВАТЬ ПО ТС ИМЕЮЩИЕ КОЛИЧЕСТВО(*) > 1;
//   [2] пустые ТС  - счётчик по ТЧ;
//   [3] неположительное количество - строки с заполненным ТС;
//   [4] принятые ТС - уникальные (для предупреждения);
//   [5] то же ТС принято в ПРОВЕДЁННЫХ планах других подразделений того же
//       сценария (design 4.4 edge cases, неблокирующее предупреждение).
//
// Возвращаемое значение:
//   Запрос - пакет с установленными параметрами.
//
Функция ЗапросПроверкиТабличныхЧастей()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.ТранспортноеСредство КАК ТранспортноеСредство,
		|	Т.Количество КАК Количество,
		|	Т.Принят КАК Принят,
		|	&ИмяОсновнаяТехника КАК ИмяТЧ
		|ПОМЕСТИТЬ СтрокиТЧ
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.ОсновнаяТехника КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.ТранспортноеСредство,
		|	Т.Количество,
		|	Т.Принят,
		|	&ИмяОборудование
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.Оборудование КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.ТранспортноеСредство,
		|	Т.Количество,
		|	Т.Принят,
		|	&ИмяАвтотранспорт
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.Автотранспорт КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|;
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	С.ТранспортноеСредство КАК ТранспортноеСредство,
		|	КОЛИЧЕСТВО(*) КАК ЧислоСтрок
		|ИЗ
		|	СтрокиТЧ КАК С
		|ГДЕ
		|	С.ТранспортноеСредство ЕСТЬ НЕ NULL
		|СГРУППИРОВАТЬ ПО
		|	С.ТранспортноеСредство
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) > 1
		|;
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	С.ИмяТЧ КАК ИмяТЧ,
		|	КОЛИЧЕСТВО(*) КАК ЧислоСтрок
		|ИЗ
		|	СтрокиТЧ КАК С
		|ГДЕ
		|	С.ТранспортноеСредство ЕСТЬ NULL
		|СГРУППИРОВАТЬ ПО
		|	С.ИмяТЧ
		|;
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	С.ИмяТЧ КАК ИмяТЧ,
		|	С.ТранспортноеСредство КАК ТранспортноеСредство
		|ИЗ
		|	СтрокиТЧ КАК С
		|ГДЕ
		|	С.ТранспортноеСредство ЕСТЬ НЕ NULL
		|	И С.Количество <= 0
		|;
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	С.ТранспортноеСредство КАК ТранспортноеСредство
		|ИЗ
		|	СтрокиТЧ КАК С
		|ГДЕ
		|	С.Принят
		|	И С.ТранспортноеСредство ЕСТЬ НЕ NULL
		|;
		|////////////////////////////////////////////////////////////
		|// То же ТС принято в ПРОВЕДЁННЫХ планах других подразделений того же
		|// сценария. Реквизиты Проведен/СценарийПланирования/Подразделение -
		|// шапка, источник строк - табличная часть: обязательное соединение
		|// с таблицей документа (как в ЗапросДоступности), иначе «Поле не найдено»
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Осн.ТранспортноеСредство КАК ТранспортноеСредство
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.ОсновнаяТехника КАК Осн
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
		|		ПО Осн.Ссылка = Д.Ссылка
		|ГДЕ
		|	Д.Ссылка <> &Ссылка
		|	И Д.Проведен
		|	И Осн.Принят
		|	И Д.СценарийПланирования = &СценарийПланирования
		|	И Д.Подразделение <> &Подразделение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Обор.ТранспортноеСредство
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.Оборудование КАК Обор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д2
		|		ПО Обор.Ссылка = Д2.Ссылка
		|ГДЕ
		|	Д2.Ссылка <> &Ссылка
		|	И Д2.Проведен
		|	И Обор.Принят
		|	И Д2.СценарийПланирования = &СценарийПланирования
		|	И Д2.Подразделение <> &Подразделение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Авто.ТранспортноеСредство
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.Автотранспорт КАК Авто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д3
		|		ПО Авто.Ссылка = Д3.Ссылка
		|ГДЕ
		|	Д3.Ссылка <> &Ссылка
		|	И Д3.Проведен
		|	И Авто.Принят
		|	И Д3.СценарийПланирования = &СценарийПланирования
		|	И Д3.Подразделение <> &Подразделение");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ИмяОсновнаяТехника", ИмяТЧОсновнаяТехника());
	Запрос.УстановитьПараметр("ИмяОборудование", ИмяТЧОборудование());
	Запрос.УстановитьПараметр("ИмяАвтотранспорт", ИмяТЧАвтотранспорт());
	// Шапка уже записана в транзакции - значения объекта соответствуют записи
	Запрос.УстановитьПараметр("СценарийПланирования", СценарийПланирования);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Возврат Запрос;

КонецФункции

// Единственные источники представлений имён ТЧ (параметры запросов и
// тексты сообщений) - магические строки дублируются только здесь.
//
Функция ИмяТЧОсновнаяТехника()
	Возврат "Основная техника";
КонецФункции

Функция ИмяТЧОборудование()
	Возврат "Оборудование";
КонецФункции

Функция ИмяТЧАвтотранспорт()
	Возврат "Автотранспорт";
КонецФункции

// Обрабатывает результаты пакета проверок (см. ЗапросПроверкиТабличныхЧастей):
// дубли ТС, незаполненные ТС, неположительное количество; собирает принятые ТС.
//
// Параметры:
//   Результаты - Массив - результат ВыполнитьПакет();
//   Отказ      - Булево - признак отказа проведения;
//   ПринятыеТС - Соответствие - заполняется: принятые ТС текущего документа.
//
Процедура ПроверитьТабличныеЧастиЗапросом(Результаты, Отказ, ПринятыеТС)

	// 1. Уникальность ТС в пределах документа (по всем ТЧ суммарно)
	Для Каждого СтрокаДубля Из Результаты[1].Выгрузить() Цикл
		Отказ = Истина;
		СообщитьОбОшибке(СтрШаблон("Транспортное средство «%1» указано в документе более одного раза.",
			СтрокаДубля.ТранспортноеСредство));
	КонецЦикла;

	// 2. Незаполненные ТС - по ТЧ, счётчиком
	Для Каждого СтрокаПустых Из Результаты[2].Выгрузить() Цикл
		Отказ = Истина;
		СообщитьОбОшибке(СтрШаблон("Табличная часть «%1»: не заполнено транспортное средство (строк: %2).",
			СтрокаПустых.ИмяТЧ, СтрокаПустых.ЧислоСтрок));
	КонецЦикла;

	// 3. Неположительное количество (только строки с заполненным ТС)
	Для Каждого СтрокаНул Из Результаты[3].Выгрузить() Цикл
		Отказ = Истина;
		СообщитьОбОшибке(СтрШаблон("Табличная часть «%1», ТС «%2»: количество должно быть больше нуля.",
			СтрокаНул.ИмяТЧ, СтрокаНул.ТранспортноеСредство));
	КонецЦикла;

	// 4. Принятые ТС - для предупреждения о приёмке в других подразделениях
	Для Каждого СтрокаПринятых Из Результаты[4].Выгрузить() Цикл
		ПринятыеТС.Вставить(Строка(СтрокаПринятых.ТранспортноеСредство), СтрокаПринятых.ТранспортноеСредство);
	КонецЦикла;

КонецПроцедуры

// Неблокирующее предупреждение (design 4.4, edge cases): то же ТС уже принято
// в проведённом плане другого подразделения того же сценария.
// Предупреждение не препятствует проведению. Запрос - 6-й элемент пакета
// (см. ЗапросПроверкиТабличныхЧастей) - отдельного похода в БД нет.
//
// Параметры:
//   ЧужиеПринятыеТС - РезультатЗапроса - принятые ТС чужих проведённых планов;
//   ПринятыеТС      - Соответствие - принятые ТС текущего документа.
//
Процедура ПредупредитьОПриемкеВДругихПодразделениях(ЧужиеПринятыеТС, ПринятыеТС)

	Если ПринятыеТС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Выборка = ЧужиеПринятыеТС.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПринятыеТС[Строка(Выборка.ТранспортноеСредство)] <> Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Транспортное средство «%1» уже принято
				|в плане технических ресурсов другого подразделения (тот же сценарий).",
				Выборка.ТранспортноеСредство);
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает тип справочника сценариев планирования (design 4.1, п. 3).
// Если расширение №1 «Расширение_АПК» отключено, Тип() вызывает исключение -
// возвращается Неопределено, и проверка типа пропускается (объекты расширения №2
// остаются работоспособными, design §3, ФАКТ-1).
//
// Возвращаемое значение:
//   Тип - тип «СправочникСсылка.АпкСценарииПланирования»;
//   Неопределено - целевой объект недоступен (модуль АПК отключён).
Функция ТипСценарияПланирования()

	Попытка
		Возврат Тип("СправочникСсылка.АпкСценарииПланирования");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Выводит немодальное сообщение об ошибке проведения (NFR-001).
//
// Параметры:
//   Текст - Строка - текст сообщения.
Процедура СообщитьОбОшибке(Текст)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

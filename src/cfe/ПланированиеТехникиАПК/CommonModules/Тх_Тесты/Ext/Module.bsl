// Тест КоэффициентНаДату_СрезПоследних (FR-001, FR-011): на дату берётся
// последняя запись с Период <= даты; до обеих записей - Неопределено.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентНаДату_СрезПоследних() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентНаДату_СрезПоследних");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Модель = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// Две записи одного ключа с разными периодами действия.
			НаборЗаписей = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Работа.Установить(Работа);
			НаборЗаписей.Отбор.МодельТехники.Установить(Модель);
			НаборЗаписей.Отбор.ВидТехники.Установить(ВидТехники);

			Запись1 = НаборЗаписей.Добавить();
			Запись1.Период = Дата(2025, 1, 1);
			Запись1.Работа = Работа;
			Запись1.МодельТехники = Модель;
			Запись1.ВидТехники = ВидТехники;
			Запись1.Коэффициент = 2;
			Запись1.БазоваяМодель = Ложь;

			Запись2 = НаборЗаписей.Добавить();
			Запись2.Период = Дата(2025, 2, 1);
			Запись2.Работа = Работа;
			Запись2.МодельТехники = Модель;
			Запись2.ВидТехники = ВидТехники;
			Запись2.Коэффициент = 3;
			Запись2.БазоваяМодель = Ложь;
			НаборЗаписей.Записать(Истина);

			Проверить(Контекст, НСтр("ru = '15.01: взята первая запись (K = 2)'"),
				Тх_ТехникаСервер.КоэффициентНаДату(Работа, Модель, ВидТехники, Дата(2025, 1, 15)) = 2);

			Проверить(Контекст, НСтр("ru = 'на границе периода 01.01: взята первая запись (K = 2)'"),
				Тх_ТехникаСервер.КоэффициентНаДату(Работа, Модель, ВидТехники, Дата(2025, 1, 1)) = 2);

			Проверить(Контекст, НСтр("ru = '15.02: взята последняя запись (K = 3)'"),
				Тх_ТехникаСервер.КоэффициентНаДату(Работа, Модель, ВидТехники, Дата(2025, 2, 15)) = 3);

			КоэффициентДоЗаписей = Тх_ТехникаСервер.КоэффициентНаДату(
				Работа, Модель, ВидТехники, Дата(2024, 12, 31));
			Проверить(Контекст, НСтр("ru = 'до обеих записей - Неопределено (FR-011)'"),
				КоэффициентДоЗаписей = Неопределено);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Работа <> Неопределено И Модель <> Неопределено Тогда
		ОчиститьКоэффициенты(Работа, ВидТехники, Модель);
	КонецЕсли;
	УдалитьСсылку(Работа);
	УдалитьСсылку(Модель);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);


// Модуль формы документа «Тх_ПланТехническихРесурсов».
//
// Автозаполнение при выборе ТС (design 4.4): модель и хозяйственный номер -
// реквизиты АпкМодель / АпкХозНомер справочника ТранспортныеСредства, добавленные
// расширением №1 «Расширение_АПК»; читаются рантайм-запросом (design 4.1, TD-001).
// «ХозНомер» - вычисляемая колонка формы (AdditionalColumns), в документе не хранится.
//
// Счётчики «принято единиц» - в заголовках закладок табличных частей (design §7).
// До появления обёртки Тх_ТехникаСервер.ВыполнитьЗапросАПК (задача A5) запрос
// локальный, с обработкой исключения «модуль АПК недоступен» (task A4).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьЗаголовкиСтраниц();

КонецПроцедуры

// Обрабатывает выбор транспортного средства в любой табличной части:
// подставляет модель и хозяйственный номер ТС (автозаполнение, редактируемо).
//
// Параметры:
//   Элемент - ФормаЭлемент - поле ввода колонки «Транспортное средство».
&НаКлиенте
Процедура ТранспортноеСредствоПриИзменении(Элемент)

	СтрокаТЧ = Элемент.Родитель.ТекущиеДанные;
	Если СтрокаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеТС = ДанныеТранспортногоСредстваНаСервере(СтрокаТЧ.ТранспортноеСредство);
	Если ДанныеТС.МодельТехники <> Неопределено Тогда
		СтрокаТЧ.МодельТехники = ДанныеТС.МодельТехники;
	КонецЕсли;
	СтрокаТЧ.ХозНомер = ДанныеТС.ХозНомер;

КонецПроцедуры

// Обновляет счётчик принятых единиц после переключения признака «Принят».
//
// Параметры:
//   Элемент - ФормаЭлемент - поле ввода колонки «Принят».
//
&НаКлиенте
Процедура ПринятПриИзменении(Элемент)

	ОбновитьЗаголовкиСтраниц();

КонецПроцедуры

// Обновляет счётчик принятых единиц после изменения количества.
//
// Параметры:
//   Элемент - ФормаЭлемент - поле ввода колонки «Количество».
//
&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)

	ОбновитьЗаголовкиСтраниц();

КонецПроцедуры

// Читает реквизиты АпкМодель / АпкХозНомер выбранного ТС рантайм-запросом.
// При недоступности расширения №1 запрос падает: выводится предупреждение
// «модуль АПК недоступен», автозаполнение пропускается (design §8).
//
// Параметры:
//   ТранспортноеСредство - СправочникСсылка.ТранспортныеСредства - выбранное ТС.
//
// Возвращаемое значение:
//   Структура - поля:
//     МодельТехники - СправочникСсылка, Неопределено - модель ТС (АпкМодель);
//     ХозНомер      - Строка - хозяйственный номер ТС (АпкХозНомер).
&НаСервере
Функция ДанныеТранспортногоСредстваНаСервере(Знач ТранспортноеСредство)

	Результат = Новый Структура("МодельТехники, ХозНомер", Неопределено, "");
	Если НЕ ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ТС.АпкМодель КАК МодельТехники,
			|	ТС.АпкХозНомер КАК ХозНомер
			|ИЗ
			|	Справочник.ТранспортныеСредства КАК ТС
			|ГДЕ
			|	ТС.Ссылка = &ТранспортноеСредство";
		Запрос.УстановитьПараметр("ТранспортноеСредство", ТранспортноеСредство);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.МодельТехники = Выборка.МодельТехники;
			Результат.ХозНомер = Выборка.ХозНомер;
		КонецЕсли;
	Исключение
		// Реквизиты АпкМодель / АпкХозНомер принадлежат расширению №1 (design 4.1):
		// без него запрос не компилируется - предупреждаем и продолжаем вручную ввод.
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Модуль АПК недоступен: модель и хозяйственный номер
			|транспортного средства не заполняются автоматически.";
		Сообщение.Сообщить();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Обновляет заголовки закладок табличных частей: «Название (принято: N единиц)»
// (design §7). N - сумма «Количество» строк с Принят = Истина.
//
&НаСервере
Процедура ОбновитьЗаголовкиСтраниц()

	Элементы.СтраницаОсновнаяТехника.Заголовок =
		СтрШаблон("Основная техника (принято: %1)", ПринятоЕдиниц(Объект.ОсновнаяТехника));
	Элементы.СтраницаОборудование.Заголовок =
		СтрШаблон("Оборудование (принято: %1)", ПринятоЕдиниц(Объект.Оборудование));
	Элементы.СтраницаАвтотранспорт.Заголовок =
		СтрШаблон("Автотранспорт (принято: %1)", ПринятоЕдиниц(Объект.Автотранспорт));

КонецПроцедуры

// Вычисляет число принятых единиц табличной части.
//
// Параметры:
//   ТабличнаяЧасть - ТабличнаяЧасть - табличная часть документа.
//
// Возвращаемое значение:
//   Число - сумма «Количество» по строкам с Принят = Истина.
&НаСервере
Функция ПринятоЕдиниц(ТабличнаяЧасть)

	Итог = 0;
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Если СтрокаТЧ.Принят Тогда
			Итог = Итог + СтрокаТЧ.Количество;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

#Область Тесты_Сцепка

// Тест ВалидироватьСцепку (FR-002, design 5.3): совместимые пары
// (СХ-техника + СХ-оборудование, автотранспорт + прицеп) проходят,
// несовместимые отклоняются, незаполненная половина сцепкой не считается.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестВалидацииСцепки() Экспорт

	Контекст = НовыйКонтекстТеста("ТестВалидацииСцепки");

	МодельСХ = Неопределено;
	МодельАвто = Неопределено;
	ОборудованиеСХ = Неопределено;
	Прицеп = Неопределено;

	Попытка
		МодельСХ = СоздатьМодель(Перечисления.Тх_ВидыТехники.СХТехника);
		МодельАвто = СоздатьМодель(Перечисления.Тх_ВидыТехники.Автотранспорт);
		ОборудованиеСХ = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделейСХОборудования());
		Прицеп = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделейПрицепов());

		Если МодельСХ = Неопределено ИЛИ МодельАвто = Неопределено
			ИЛИ ОборудованиеСХ = Неопределено ИЛИ Прицеп = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		Проверить(Контекст, НСтр("ru = 'СХ-техника + СХ-оборудование = совместимо'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, ОборудованиеСХ));

		Проверить(Контекст, НСтр("ru = 'автотранспорт + прицеп = совместимо'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельАвто, Прицеп));

		Проверить(Контекст, НСтр("ru = 'СХ-техника + прицеп = несовместимо'"),
			НЕ Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, Прицеп));

		Проверить(Контекст, НСтр("ru = 'автотранспорт + СХ-оборудование = несовместимо'"),
			НЕ Тх_ТехникаСервер.ВалидироватьСцепку(МодельАвто, ОборудованиеСХ));

		Проверить(Контекст, НСтр("ru = 'пустое оборудование - сцепка не проверяется'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, Неопределено));

		Проверить(Контекст, НСтр("ru = 'пустая модель - сцепка не проверяется'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(Неопределено, ОборудованиеСХ));

	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельСХ);
	УдалитьСсылку(МодельАвто);
	УдалитьСсылку(ОборудованиеСХ);
	УдалитьСсылку(Прицеп);

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_КоэффициентЗамещения

// Тест приоритета ручных реквизитов замещения (FR-004, design 6.4):
// у моделей СХ-техники заполнены ручной коэффициент, ширина и мощность -
// базовым должен стать ручной КоэффициентПереводаВУЭГА; К = 6/4 = 1.5.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестКоэффициентЗамещенияПриоритетРучного() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияПриоритетРучного");

	МодельА = Неопределено;
	МодельБ = Неопределено;

	Попытка
		МодельА = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 4));
		МодельБ = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 6));

		Если МодельА = Неопределено ИЛИ МодельБ = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(МодельА);

		Проверить(Контекст, НСтр("ru = 'базовый реквизит возвращается'"),
			Реквизит <> Неопределено);

		Если Реквизит <> Неопределено Тогда
			Проверить(Контекст, НСтр("ru = 'приоритет ручного КоэффициентПереводаВУЭГА'"),
				Реквизит.Реквизит = "КоэффициентПереводаВУЭГА");

			К = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ);
			Проверить(Контекст, НСтр("ru = 'К = 6/4 = 1.5'"),
				К <> Неопределено И К > 1.499 И К < 1.501);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельА);
	УдалитьСсылку(МодельБ);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест замещения по ширине обработки (FR-004, acceptance: ширина 1.5x):
// модели СХ-техники без ручных реквизитов, ширина 2 и 3 - К = 1.5.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестКоэффициентЗамещенияПоШирине() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияПоШирине");

	МодельА = Неопределено;
	МодельБ = Неопределено;

	Попытка
		МодельА = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 2));
		МодельБ = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 3));

		Если МодельА = Неопределено ИЛИ МодельБ = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(МодельА);
		Проверить(Контекст, НСтр("ru = 'базовый реквизит - ШиринаОбработки'"),
			Реквизит <> Неопределено И Реквизит.Реквизит = "ШиринаОбработки");

		К = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ);
		Проверить(Контекст, НСтр("ru = 'К = 3/2 = 1.5 (ширина 1.5x)'"),
			К <> Неопределено И К > 1.499 И К < 1.501);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельА);
	УдалитьСсылку(МодельБ);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест стартового расчёта по мощности двигателя и прочих каталогов:
// СХ-техника без ручных реквизитов - старт по МощностьДвигателя (К = 1.5);
// автотранспорт по Грузоподъемность (К = 2); прицепы по Вместимость (К = 2).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестКоэффициентЗамещенияСтартИПрочиеКаталоги() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияСтартИПрочиеКаталоги");

	Модели = Новый Массив;

	Попытка
		Трактор100 = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 100));
		Трактор150 = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 150));
		Грузовик5 = СоздатьЭлемент("АпкМоделиАвтотранспорта",
			Новый Структура("Грузоподъемность", 5));
		Грузовик10 = СоздатьЭлемент("АпкМоделиАвтотранспорта",
			Новый Структура("Грузоподъемность", 10));
		Прицеп10 = СоздатьЭлемент("АпкМоделиПрицепов",
			Новый Структура("Вместимость", 10));
		Прицеп20 = СоздатьЭлемент("АпкМоделиПрицепов",
			Новый Структура("Вместимость", 20));
		Модели.Добавить(Трактор100);
		Модели.Добавить(Трактор150);
		Модели.Добавить(Грузовик5);
		Модели.Добавить(Грузовик10);
		Модели.Добавить(Прицеп10);
		Модели.Добавить(Прицеп20);

		Если Трактор100 = Неопределено ИЛИ Грузовик5 = Неопределено ИЛИ Прицеп10 = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(Трактор100);
		Проверить(Контекст, НСтр("ru = 'старт по МощностьДвигателя'"),
			Реквизит <> Неопределено И Реквизит.Реквизит = "МощностьДвигателя");

		КМощь = Тх_ТехникаСервер.КоэффициентЗамещения(Трактор100, Трактор150);
		Проверить(Контекст, НСтр("ru = 'К по мощности = 150/100 = 1.5'"),
			КМощь <> Неопределено И КМощь > 1.499 И КМощь < 1.501);

		КГруз = Тх_ТехникаСервер.КоэффициентЗамещения(Грузовик5, Грузовик10);
		Проверить(Контекст, НСтр("ru = 'К по грузоподъемности = 10/5 = 2'"),
			КГруз <> Неопределено И КГруз > 1.999 И КГруз < 2.001);

		КПрицеп = Тх_ТехникаСервер.КоэффициентЗамещения(Прицеп10, Прицеп20);
		Проверить(Контекст, НСтр("ru = 'К по вместимости прицепов = 20/10 = 2'"),
			КПрицеп <> Неопределено И КПрицеп > 1.999 И КПрицеп < 2.001);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Для Каждого Модель Из Модели Цикл
		УдалитьСсылку(Модель);
	КонецЦикла;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест КоэффициентНеЗадан (FR-004): пустые реквизиты, разные базовые
// реквизиты, разные каталоги - везде Неопределено.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестКоэффициентЗамещенияНеЗадан() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияНеЗадан");

	Модели = Новый Массив;

	Попытка
		ОборудованиеПустое = СоздатьЭлемент("АпкМоделиСХОборудования");
		ОборудованиеШирокое = СоздатьЭлемент("АпкМоделиСХОборудования",
			Новый Структура("ШиринаОбработки", 4));
		МодельРучная = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 4));
		МодельМощная = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 100));
		Модели.Добавить(ОборудованиеПустое);
		Модели.Добавить(ОборудованиеШирокое);
		Модели.Добавить(МодельРучная);
		Модели.Добавить(МодельМощная);

		Если ОборудованиеПустое = Неопределено ИЛИ МодельРучная = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		Проверить(Контекст, НСтр("ru = 'СХ-оборудование без ширины - Неопределено'"),
			Тх_ТехникаСервер.РеквизитЗамещения(ОборудованиеПустое) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'у замены не заполнен реквизит - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(ОборудованиеШирокое, ОборудованиеПустое) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'разные базовые реквизиты - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(МодельРучная, МодельМощная) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'разные каталоги - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(МодельМощная, ОборудованиеШирокое) = Неопределено);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Для Каждого Модель Из Модели Цикл
		УдалитьСсылку(Модель);
	КонецЦикла;

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_SRV03

// Тест классификации по метаданным (Q-005 Р1, SRV-03): отсутствующий
// в метаданных реквизит = несовпадение версий АПК - ЖР Предупреждение,
// значение 0 ("не заполнен"), БЕЗ исключения, расчёт продолжается.
// Существующий реквизит читается как раньше (регрессия).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестРеквизитМоделиОтсутствуетВМетаданных() Экспорт

	Контекст = НовыйКонтекстТеста("ТестРеквизитМоделиОтсутствуетВМетаданных");

	Модель = Неопределено;

	Попытка
		Модель = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 3));

		Если Модель = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		Проверить(Контекст, НСтр("ru = 'существующий реквизит читается (регрессия)'"),
			Тх_ТехникаСервер.ЗначениеРеквизитаМодели(Модель, "ШиринаОбработки") = 3);

		// Ветка Р1: реквизита нет в метаданных - 0 без исключения
		// (ЖР Предупреждение, расчёт продолжается).
		Проверить(Контекст, НСтр("ru = 'несуществующий реквизит = 0 (не заполнен)'"),
			Тх_ТехникаСервер.ЗначениеРеквизитаМодели(Модель, "НесуществующийРеквизит") = 0);

		// Дросселирование (владелец 13.11, вопрос 6): с кэшем расчёта пара
		// "каталог.реквизит" фиксируется один раз - запись ЖР одна.
		КэшРасчета = Тх_ТехникаСервер.НовыйКэшРасчета();
		Проверить(Контекст, НСтр("ru = 'несуществующий реквизит с кэшем = 0'"),
			Тх_ТехникаСервер.ЗначениеРеквизитаМодели(Модель, "НесуществующийРеквизит", КэшРасчета) = 0);
		Проверить(Контекст, НСтр("ru = 'кэш дросселирования зафиксировал пару'"),
			КэшРасчета.Предупреждения.Количество() = 1);
		Проверить(Контекст, НСтр("ru = 'повтор не растит кэш (запись ЖР одна)'"),
			Тх_ТехникаСервер.ЗначениеРеквизитаМодели(Модель, "НесуществующийРеквизит", КэшРасчета) = 0
				И КэшРасчета.Предупреждения.Количество() = 1);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(Модель);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест проброса ошибки запроса АПК (P1-3, Q-005 Р1): ошибка исполнения
// запроса (несуществующее поле) НЕ глушится - исключение пробрасывается,
// текст сообщения ссылается на журнал регистрации.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестОшибкаЗапросаАПКПробрасывается() Экспорт

	Контекст = НовыйКонтекстТеста("ТестОшибкаЗапросаАПКПробрасывается");

	Попытка
		ИмяСправочника = "АпкМоделиСХТехники";
		// Тест проверяет проброс ошибки разбора запроса - литерал намеренно
		// некорректен (реквизита не существует), текст запроса не менять.
		// BSLLS:QueryParseError-off
		ТекстЗапроса = "ВЫБРАТЬ Спр.НесуществующийРеквизит КАК Значение
			|ИЗ Справочник." + ИмяСправочника + " КАК Спр
			|ГДЕ Спр.Ссылка = &ПустаяСсылка";
		// BSLLS:QueryParseError-on
		ПустаяСсылка = Справочники[ИмяСправочника].ПустаяСсылка();

		ИсключениеПоймано = Ложь;
		ТекстИсключения = "";
		Попытка
			Тх_ТехникаСервер.ВыполнитьЗапросАПК(ТекстЗапроса,
				Новый Структура("ПустаяСсылка", ПустаяСсылка));
		Исключение
			ИсключениеПоймано = Истина;
			ТекстИсключения = ОписаниеОшибки();
		КонецПопытки;

		Проверить(Контекст, НСтр("ru = 'ошибка запроса проброшена, не проглочена'"),
			ИсключениеПоймано, ТекстИсключения);
		Проверить(Контекст, НСтр("ru = 'сообщение ссылается на журнал регистрации'"),
			СтрНайти(ТекстИсключения, НСтр("ru = 'журнал регистрации'")) > 0,
			ТекстИсключения);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест классификатора отключённого модуля АПК (P1-2: тесты на ошибку
// отсутствующего типа и на ошибку обычного реквизита). Синтетические
// строки: реальное отключение расширения №1 в юнит-прогоне не эмулируется.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестКлассификаторОтключенияМодуляАПК() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКлассификаторОтключенияМодуляАПК");

	Попытка
		ТекстОтключения = НСтр("ru = 'Неизвестный тип значения ""Справочник.АпкМоделиСХТехники""'");

		Проверить(Контекст, НСтр("ru = 'ошибка отсутствующего типа = отключение модуля'"),
			Тх_ТехникаСервер.ЭтоОтключениеМодуляАПК(ТекстОтключения));

		Проверить(Контекст, НСтр("ru = 'ошибка обычного реквизита = НЕ отключение'"),
			НЕ Тх_ТехникаСервер.ЭтоОтключениеМодуляАПК(
				НСтр("ru = 'Поле объекта не обнаружено (НесуществующийРеквизит)'")));

		Проверить(Контекст, НСтр("ru = 'ошибка прав = НЕ отключение'"),
			НЕ Тх_ТехникаСервер.ЭтоОтключениеМодуляАПК(
				НСтр("ru = 'Не хватает прав на выполнение операции'")));
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест мягкой ветки не-ссылок (P1-3, SRV-03 §2.3, решение владельца
// 13.11 - вопрос 4): не-ссылка в модельных параметрах - ЖР
// Предупреждение и ПРОДОЛЖЕНИЕ расчёта, исключения нет, результат Ложь;
// раньше было тихое Ложь без записи в журнале. Пустые значения -
// по-прежнему легитимны.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестНеСсылкаСправочникаПредупреждена() Экспорт

	Контекст = НовыйКонтекстТеста("ТестНеСсылкаСправочникаПредупреждена");

	Модель = Неопределено;
	Оборудование = Неопределено;

	Попытка
		Модель = СоздатьЭлемент("АпкМоделиСХТехники");

		Если Модель = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		Оборудование = СоздатьЭлемент("АпкМоделиСХОборудования");

		// Регрессия: корректная сцепка работает без исключений.
		Проверить(Контекст, НСтр("ru = 'сцепка СХ-техника + СХ-оборудование = совместимо'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(Модель, Оборудование));

		// Не-ссылка вместо модели (мягкая ветка, решение владельца 13.11):
		// ЖР Предупреждение, БЕЗ исключения, результат - Ложь.
		ИсключениеПоймано = Ложь;
		РезультатВызова = Истина;
		Попытка
			РезультатВызова = Тх_ТехникаСервер.ВалидироватьСцепку(100500, Модель);
		Исключение
			ИсключениеПоймано = Истина;
		КонецПопытки;
		Проверить(Контекст, НСтр("ru = 'не-ссылка в модели = без исключения'"),
			НЕ ИсключениеПоймано);
		Проверить(Контекст, НСтр("ru = 'не-ссылка в модели = Ложь'"),
			РезультатВызова = Ложь);

		ИсключениеПоймано = Ложь;
		РезультатВызова = Истина;
		Попытка
			РезультатВызова = Тх_ТехникаСервер.ВалидироватьСцепку(Модель, 100500);
		Исключение
			ИсключениеПоймано = Истина;
		КонецПопытки;
		Проверить(Контекст, НСтр("ru = 'не-ссылка в оборудовании = без исключения'"),
			НЕ ИсключениеПоймано);
		Проверить(Контекст, НСтр("ru = 'не-ссылка в оборудовании = Ложь'"),
			РезультатВызова = Ложь);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(Модель);
	УдалитьСсылку(Оборудование);

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_SRV04

// Тест числовой эквивалентности пакетной и поштучной загрузок реквизитов
// (SRV-04, P1-4): ПостроитьКэшРеквизитовМоделей читает те же поля тех же
// каталогов одной выборкой на каталог; значения обязаны совпадать с
// поштучным ЗначениеРеквизитаМодели на каждой паре модель х реквизит,
// а КоэффициентЗамещения - давать одинаковый коэффициент с кэшем и без.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестПакетныйКэшЭквивалентенПоштучному() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПакетныйКэшЭквивалентенПоштучному");

	МодельА = Неопределено;
	МодельБ = Неопределено;
	Трактор = Неопределено;
	Прицеп = Неопределено;

	Попытка
		МодельА = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 3));

		Если МодельА = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат РезультатТеста(Контекст);
		КонецЕсли;

		МодельБ = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки, МощностьДвигателя", 6, 100));
		Трактор = СоздатьЭлемент("АпкМоделиАвтотранспорта",
			Новый Структура("Грузоподъемность, Вместимость, МощностьДвигателя", 5, 20, 150));
		Прицеп = СоздатьЭлемент("АпкМоделиПрицепов",
			Новый Структура("Грузоподъемность, Вместимость", 10, 30));

		Модели = Новый Массив;
		Модели.Добавить(МодельА);
		Модели.Добавить(МодельБ);
		Модели.Добавить(Трактор);
		Модели.Добавить(Прицеп);
		// Дубликаты допустимы (кэш дедуплицирует по ссылке).
		Модели.Добавить(МодельА);

		КэшРасчета = Тх_ТехникаСервер.ПостроитьКэшРеквизитовМоделей(Модели);

		// Все модели попали в кэш, дубль не создал лишнего ключа.
		Проверить(Контекст, НСтр("ru = 'все модели в кэше (дубли схлопнуты)'"),
			КэшРасчета.Модели.Количество() = 4);

		// Эквивалентность значений: каждая пара модель х реквизит её
		// каталога - кэш против поштучного запроса.
		Каталоги = Новый Массив;
		Каталоги.Добавить(МодельА);
		Каталоги.Добавить(МодельБ);
		Каталоги.Добавить(Трактор);
		Каталоги.Добавить(Прицеп);
		Для Каждого Модель Из Каталоги Цикл
			Приоритеты = Тх_ТехникаСервер.ПриоритетРеквизитовЗамещения(Модель);
			Реквизиты = Новый Массив;
			Для Каждого ИмяРеквизита Из Приоритеты.Приоритетные Цикл
				Если Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
					Реквизиты.Добавить(ИмяРеквизита);
				КонецЕсли;
			КонецЦикла;
			Если Приоритеты.Стартовый <> ""
				И Реквизиты.Найти(Приоритеты.Стартовый) = Неопределено Тогда
				Реквизиты.Добавить(Приоритеты.Стартовый);
			КонецЕсли;
			Для Каждого ИмяРеквизита Из Реквизиты Цикл
				Поштучно = Тх_ТехникаСервер.ЗначениеРеквизитаМодели(Модель, ИмяРеквизита);
				Пакетно = Тх_ТехникаСервер.ЗначениеРеквизитаМодели(Модель, ИмяРеквизита, КэшРасчета);
				Проверить(Контекст,
					СтрШаблон(НСтр("ru = 'эквивалентность %1: кэш = поштучно'"), ИмяРеквизита),
					Пакетно = Поштучно);
			КонецЦикла;
		КонецЦикла;

		// Эквивалентность коэффициента: с кэшем и без - один и тот же К
		// (базовый реквизит ШиринаОбработки: 6 / 3 = 2).
		КБезКэша = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ);
		КСКэшем = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ, КэшРасчета);
		Проверить(Контекст, НСтр("ru = 'коэффициент с кэшем = коэффициенту без кэша = 2'"),
			КБезКэша = 2 И КСКэшем = 2);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельА);
	УдалитьСсылку(МодельБ);
	УдалитьСсылку(Трактор);
	УдалитьСсылку(Прицеп);

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

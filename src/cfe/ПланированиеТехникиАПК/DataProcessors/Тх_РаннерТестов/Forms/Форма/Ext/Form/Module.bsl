// Модуль формы обработки «Тх_РаннерТестов» (design §11, задача A11).
//
// Запуск тестов - только по команде «Выполнить тесты» (ПриСозданииНаСервере
// автозапуска нет): серверный вызов, таблица результатов, итоговое
// немодальное сообщение «Прошло N из 15».

#Область ОбработчикиКомандФормы

// Команда «Выполнить тесты»: серверный прогон всех тестов Тх_Тесты,
// заполнение таблицы результатов и вывод итога.
//
// Параметры:
//   Команда - КомандаФормы - команда формы.
//
&НаКлиенте
Процедура ВыполнитьТесты(Команда)

	ВыполнитьТестовНаСервере();

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(НСтр("ru = 'Прошло %1 из %2 тестов.'"),
		Прошло, ВсегоТестов);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет все тесты модульного прогона на сервере и заполняет таблицу
// результатов формы.
//
&НаСервере
Процедура ВыполнитьТестовНаСервере()

	РезультатыЗапуска = Обработки.Тх_РаннерТестов.Создать().ВыполнитьТесты();

	Результаты.Очистить();
	Прошло = 0;

	Для Каждого Результат Из РезультатыЗапуска Цикл
		СтрокаРезультата = Результаты.Добавить();
		СтрокаРезультата.Тест = Результат.Имя;
		СтрокаРезультата.Результат = ?(Результат.Прошёл,
			НСтр("ru = 'Прошёл'"), НСтр("ru = 'ПРОВАЛ'"));
		Если Результат.Прошёл Тогда
			Прошло = Прошло + 1;
		КонецЕсли;
	КонецЦикла;

	ВсегоТестов = Результаты.Количество();

КонецПроцедуры

#КонецОбласти

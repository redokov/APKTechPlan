// Общий модуль «Тх_Тесты» - серверные модульные тесты расширения
// «ПланированиеТехникиАПК» (design §11, задача A11).
//
// Упрощённый xUnit-паттерн: 15 экспортных функций Тест*(), вызываемых
// обработкой-раннером Тх_РаннерТестов (кнопка формы, COM или /Execute).
// Каждый тест:
//  - создаёт собственные данные (уникальные имена через Новый
//    УникальныйИдентификатор - конфликты повторных прогонов исключены);
//  - выполняет проверки через Проверить (провал - Сообщить с префиксом
//    имени теста и фиксация в контексте теста);
//  - очищает данные за собой в finally-стиле: очистка выполняется и при
//    успешном завершении, и при исключении;
//  - возвращает Булево: Истина - все проверки пройдены (или SKIP).
//
// Синтетика потребности (тесты пересчёта дефицита). Записи в регистры
// накопления годового плана АПК (Апк*РаботыПоГодовомуПлану) расширением
// невозможны, поэтому:
//  - тесты формул пересчёта (ТестПересчетДоступностиЧерезКоэффициент,
//    ТестКоэффициентНеЗадан_..., ТестДефицитМаксНуля,
//    ТестТранспортныеРаботы...) проверяют контракт TD-004 на уровне
//    сценария регистра: реальные записи Тх_КоэффициентыПересчетаРабот +
//    реальные КоэффициентНаДату/ЧислоДнейПериода + таблицы значений,
//    моделирующие строки потребности и доступности; формула сопоставления
//    продублирована зеркалом ДоступноСменКонтракт (проверка контракта
//    TD-004 - приватная Тх_ТехникаСервер.ДоступноСменСтроки не
//    экспортируется);
//  - сквозные тесты (ТестНеПринятыеТСИсключены,
//    ТестПланТехресурсовОтсутствует_..., ТестДетерминированность...)
//    идут по реальным экспортным функциям Тх_ТехникаСервер
//    (ЗапросДоступности / РассчитатьДефицит); тесты, которым нужна
//    потребность годового плана, помечены «зависит от данных ИБ» и при
//    пустой потребности возвращают Истина с сообщением SKIP.
//
// Модуль серверный, НЕ привилегированный: тесты выполняются под правами
// запустившего и работают только с собственными данными расширения.

#Область Инфраструктура

// Создаёт контекст теста: имя + массив провалов.
//
// Параметры:
//   ИмяТеста - Строка - имя тестовой функции (префикс сообщений).
//
// Возвращаемое значение:
//   Структура - свойства: Имя (Строка), Провалы (Массив).
//
Функция НовыйКонтекстТеста(ИмяТеста)

	Возврат Новый Структура("Имя, Провалы", ИмяТеста, Новый Массив);

КонецФункции

// Фиксирует проверку теста: провал заносится в контекст, выводится
// сообщение с префиксом имени теста.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста (НовыйКонтекстТеста);
//   ИмяПроверки    - Строка - краткое имя проверки;
//   Условие        - Булево - условие успешности проверки;
//   Детали         - Строка - детали провала (фактические значения).
//
Процедура Проверить(СтруктураТеста, ИмяПроверки, Условие, Детали = "")

	Если НЕ Условие Тогда
		СтруктураТеста.Провалы.Добавить(ИмяПроверки);
		Текст = СтрШаблон(НСтр("ru = '[%1] ПРОВАЛ: %2'"),
			СтруктураТеста.Имя, ИмяПроверки);
		Если Детали <> "" Тогда
			Текст = Текст + " (" + Детали + ")";
		КонецЕсли;
		СообщитьТекстом(Текст);
	КонецЕсли;

КонецПроцедуры

// Возвращает итог теста: Истина - провалов нет.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста.
//
// Возвращаемое значение:
//   Булево - результат теста.
//
Функция РезультатТеста(СтруктураТеста)

	Возврат СтруктураТеста.Провалы.Количество() = 0;

КонецФункции

// Выводит сообщение SKIP: тест пропущен (нет данных ИБ), считается пройденным.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста;
//   Причина        - Строка - причина пропуска.
//
Процедура СообщитьПропуск(СтруктураТеста, Причина)

	СообщитьТекстом(СтрШаблон(НСтр("ru = '[%1] SKIP: %2'"),
		СтруктураТеста.Имя, Причина));

КонецПроцедуры

// Выводит немодальное сообщение пользователю.
//
// Параметры:
//   Текст - Строка - текст сообщения.
//
Процедура СообщитьТекстом(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

// Возвращает псевдослучайное уникальное имя (генератор, устойчивый
// к повторным прогонам тестов).
//
// Возвращаемое значение:
//   Строка - строковое представление нового уникального идентификатора.
//
Функция УникальноеИмя()

	Возврат Строка(Новый УникальныйИдентификатор());

КонецФункции

// Ищет первый существующий элемент справочника АПК (тесты сначала ищут
// готовые ссылки, новые создают только при необходимости).
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника (например, "АпкМоделиСХТехники").
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка первого элемента;
//   Неопределено - элементов нет или каталог недоступен.
//
Функция НайтиПервыйЭлемент(ИмяСправочника)

	Результат = Неопределено;


	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ НЕ Спр.ПометкаУдаления";

	Попытка
		Выборка = Тх_ТехникаСервер.ВыполнитьЗапросАПК(ТекстЗапроса).Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Создаёт новый элемент справочника с уникальным наименованием
// (созданное тесты удаляют за собой).
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника;
//   Поля - Структура, Неопределено - значения реквизитов
//          (например, МощностьДвигателя).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка созданного элемента;
//   Неопределено - создать не удалось (обязательные реквизиты, отсутствие каталога).
//
Функция СоздатьЭлемент(ИмяСправочника, Поля = Неопределено)

	Результат = Неопределено;

	Попытка
		Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
		Объект.Наименование = УникальноеИмя();
		Если Поля <> Неопределено Тогда
			Для Каждого КлючЗначение Из Поля Цикл
				Объект[КлючЗначение.Ключ] = КлючЗначение.Значение;
			КонецЦикла;
		КонецЕсли;
		Объект.Записать();
		Результат = Объект.Ссылка;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Создаёт новую модель техники каталога вида техники (уникальное имя,
// опционально - мощность двигателя).
//
// Параметры:
//   ВидТехники - ПеречислениеСсылка.Тх_ВидыТехники - вид техники;
//   Мощность   - Число, Неопределено - мощность двигателя (Неопределено/0 -
//                модель «без мощности»).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка созданной модели.
//
Функция СоздатьМодель(ВидТехники, Мощность = Неопределено)

	ИмяСправочника = Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники);
	Если ИмяСправочника = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = Неопределено;
	Если Мощность <> Неопределено Тогда
		Поля = Новый Структура("МощностьДвигателя", Мощность);
	КонецЕсли;

	Возврат СоздатьЭлемент(ИмяСправочника, Поля);

КонецФункции

// Удаляет созданный тестом элемент справочника (существующие данные
// тесты не трогают, поэтому удаляются только созданные ссылки).
//
// Параметры:
//   Ссылка - СправочникСсылка, Неопределено - ссылка на удаление.
//
Процедура УдалитьСсылку(Ссылка)

	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.Удалить();
		КонецЕсли;
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Удаляет записи регистра Тх_КоэффициентыПересчетаРабот, созданные тестом
// (отборы по уникальным работе/модели теста - чужие данные не затрагиваются).
//
// Параметры:
//   Работа     - СправочникСсылка - работа теста;
//   ВидТехники - ПеречислениеСсылка.Тх_ВидыТехники - вид техники;
//   Модель     - СправочникСсылка, Неопределено - модель теста
//                (Неопределено - без отбора по модели).
//
Процедура ОчиститьКоэффициенты(Работа, ВидТехники, Модель = Неопределено)

	Попытка
		НаборЗаписей = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Работа.Установить(Работа);
		НаборЗаписей.Отбор.ВидТехники.Установить(ВидТехники);
		Если Модель <> Неопределено Тогда
			НаборЗаписей.Отбор.МодельТехники.Установить(Модель);
		КонецЕсли;
		НаборЗаписей.Записать(Истина);
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Тесты_ДатыИФункции

// Тест ЧислоДнейПериода: календарные дни периода, границы включены
// (FAQ Q1, FR-001): 01.03..10.03 = 10, один день = 1, пустые даты = 0.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены.
//
Функция ТестЧислоДнейПериода() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЧислоДнейПериода");

	Попытка
		Проверить(Контекст, НСтр("ru = '01.03..10.03 = 10 дней (границы включены)'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10)) = 10);

		Проверить(Контекст, НСтр("ru = 'один день = 1'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 5), Дата(2025, 3, 5)) = 1);

		Проверить(Контекст, НСтр("ru = 'пустые даты = 0'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(1, 1, 1), Дата(1, 1, 1)) = 0);

		Проверить(Контекст, НСтр("ru = 'интервал после окончания = 0 (не отрицательный)'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 10), Дата(2025, 3, 1)) = 0);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест КоэффициентБазовойМоделиЕдиница (FR-003): у базовой строки набора
// коэффициент принудительно 1,0000 модулем набора записей (ПередЗаписью).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентБазовойМоделиЕдиница() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентБазовойМоделиЕдиница");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Модель = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// Записываем базовую строку с заведомо неверным коэффициентом 5:
			// модуль набора обязан принудительно привести его к 1 (FR-003).
			НаборЗаписей = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Работа.Установить(Работа);
			НаборЗаписей.Отбор.МодельТехники.Установить(Модель);
			НаборЗаписей.Отбор.ВидТехники.Установить(ВидТехники);

			Запись = НаборЗаписей.Добавить();
			Запись.Период = Дата(2025, 1, 1);
			Запись.Работа = Работа;
			Запись.МодельТехники = Модель;
			Запись.ВидТехники = ВидТехники;
			Запись.Коэффициент = 5;
			Запись.БазоваяМодель = Истина;
			НаборЗаписей.Записать(Истина);

			КонтрольныйНабор = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			КонтрольныйНабор.Отбор.Работа.Установить(Работа);
			КонтрольныйНабор.Отбор.МодельТехники.Установить(Модель);
			КонтрольныйНабор.Отбор.ВидТехники.Установить(ВидТехники);
			КонтрольныйНабор.Прочитать();

			Проверить(Контекст, НСтр("ru = 'записана одна строка'"),
				КонтрольныйНабор.Количество() = 1);
			Если КонтрольныйНабор.Количество() = 1 Тогда
				Проверить(Контекст, НСтр("ru = 'коэффициент базовой модели принудительно 1'"),
					КонтрольныйНабор[0].Коэффициент = 1);
				Проверить(Контекст, НСтр("ru = 'признак базовой модели сохранён'"),
					КонтрольныйНабор[0].БазоваяМодель);
			КонецЕсли;

			Проверить(Контекст, НСтр("ru = 'КоэффициентНаДату возвращает 1 для базовой строки'"),
				Тх_ТехникаСервер.КоэффициентНаДату(Работа, Модель, ВидТехники, Дата(2025, 6, 1)) = 1);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	// Очистка (finally-стиль): регистр - по уникальным ключам теста.
	Если Работа <> Неопределено И Модель <> Неопределено Тогда
		ОчиститьКоэффициенты(Работа, ВидТехники, Модель);
	КонецЕсли;
	УдалитьСсылку(Работа);
	УдалитьСсылку(Модель);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ОтказДвеБазовыеМодели (FR-003): в наборе не может быть двух базовых
// моделей для одной работы, периода и вида техники - ПередЗаписью ставит
// Отказ, запись набора падает исключением, данные в регистр не попадают.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестОтказДвеБазовыеМодели() Экспорт

	Контекст = НовыйКонтекстТеста("ТестОтказДвеБазовыеМодели");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель1 = Неопределено;
	Модель2 = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Модель1 = СоздатьМодель(ВидТехники);
		Модель2 = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ Модель1 = Неопределено ИЛИ Модель2 = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			НаборЗаписей = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Работа.Установить(Работа);
			НаборЗаписей.Отбор.ВидТехники.Установить(ВидТехники);

			Запись1 = НаборЗаписей.Добавить();
			Запись1.Период = Дата(2025, 1, 1);
			Запись1.Работа = Работа;
			Запись1.МодельТехники = Модель1;
			Запись1.ВидТехники = ВидТехники;
			Запись1.Коэффициент = 1;
			Запись1.БазоваяМодель = Истина;

			Запись2 = НаборЗаписей.Добавить();
			Запись2.Период = Дата(2025, 1, 1);
			Запись2.Работа = Работа;
			Запись2.МодельТехники = Модель2;
			Запись2.ВидТехники = ВидТехники;
			Запись2.Коэффициент = 1;
			Запись2.БазоваяМодель = Истина;

			БылаОшибка = Ложь;
			Попытка
				НаборЗаписей.Записать(Истина);
			Исключение
				БылаОшибка = Истина;
			КонецПопытки;

			Проверить(Контекст, НСтр("ru = 'запись набора с двумя базовыми моделями отклонена'"),
				БылаОшибка);

			КонтрольныйНабор = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			КонтрольныйНабор.Отбор.Работа.Установить(Работа);
			КонтрольныйНабор.Отбор.ВидТехники.Установить(ВидТехники);
			КонтрольныйНабор.Прочитать();
			Проверить(Контекст, НСтр("ru = 'отклонённый набор не попал в регистр'"),
				КонтрольныйНабор.Количество() = 0);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Работа <> Неопределено Тогда
		ОчиститьКоэффициенты(Работа, ВидТехники);
	КонецЕсли;
	УдалитьСсылку(Работа);
	УдалитьСсылку(Модель1);
	УдалитьСсылку(Модель2);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);


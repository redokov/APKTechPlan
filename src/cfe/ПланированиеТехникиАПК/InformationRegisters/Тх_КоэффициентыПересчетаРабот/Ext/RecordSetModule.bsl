// Модуль набора записей регистра сведений «Тх_КоэффициентыПересчетаРабот».
//
// Контроль целостности коэффициентов пересчёта работ (design 4.3):
//  (а) не более одной базовой модели на (Работа + Период + ВидТехники) в наборе;
//  (б) у базовой строки коэффициент принудительно равен 1,0000 (FR-003);
//  (в) коэффициент строго больше нуля (отказ при нуле и отрицательном);
//  (г) валидация типов generic-ссылок рантаймом (design 4.1, TD-001).
//
// Строковые имена целевых объектов и рантайм-валидация типов - в общем модуле
// Тх_ТехникаСервер (design 4.1, п. 2-3, задача A5): локальные реализации
// набора записей делегированы вызовами туда.

Процедура ПередЗаписью(Отказ, РежимЗаписи)

	БазовыеПоГруппам = Новый Соответствие;

	Для Каждого Запись Из ЭтотОбъект Цикл

		Если Запись.БазоваяМодель Тогда
			ЗафиксироватьБазовуюМодель(Запись, БазовыеПоГруппам, Отказ);
		КонецЕсли;

		ПроверитьКоэффициент(Запись, Отказ);
		ПроверитьТипыСсылок(Запись, Отказ);

	КонецЦикла;

КонецПроцедуры

// Обрабатывает базовую строку набора: коэффициент принудительно 1,0000 (FR-003);
// в группе (Работа + Период + ВидТехники) допускается только одна базовая модель.
//
// Параметры:
//   Запись            - РегистрСведенийЗапись.Тх_КоэффициентыПересчетаРабот - строка набора;
//   БазовыеПоГруппам  - Соответствие - накопленные ключи групп, где базовая модель уже есть;
//   Отказ             - Булево - признак отказа записи.
Процедура ЗафиксироватьБазовуюМодель(Запись, БазовыеПоГруппам, Отказ)

	Запись.Коэффициент = 1;

	КлючГруппы = Строка(Запись.Работа) + "|"
		+ Формат(Запись.Период, "ДФ=yyyyMMddHHmmss") + "|"
		+ Строка(Запись.ВидТехники);
	Если БазовыеПоГруппам[КлючГруппы] <> Неопределено Тогда
		Отказ = Истина;
		СообщитьОбОшибке(Запись, "БазоваяМодель",
			"В наборе записей не может быть двух базовых моделей
			|для одной работы, периода и вида техники.");
	Иначе
		БазовыеПоГруппам.Вставить(КлючГруппы, Истина);
	КонецЕсли;

КонецПроцедуры

// Проверяет коэффициент: строго больше нуля (отказ при нуле и отрицательном).
//
// Параметры:
//   Запись - РегистрСведенийЗапись.Тх_КоэффициентыПересчетаРабот - строка набора;
//   Отказ  - Булево - признак отказа записи.
Процедура ПроверитьКоэффициент(Запись, Отказ)

	Если Запись.Коэффициент <= 0 Тогда
		Отказ = Истина;
		СообщитьОбОшибке(Запись, "Коэффициент",
			"Коэффициент пересчёта должен быть больше нуля.");
	КонецЕсли;

КонецПроцедуры

// Проверяет типы generic-ссылок строки (TD-001): типы проверяются в рантайме.
//
// Параметры:
//   Запись - РегистрСведенийЗапись.Тх_КоэффициентыПересчетаРабот - строка набора;
//   Отказ  - Булево - признак отказа записи.
Процедура ПроверитьТипыСсылок(Запись, Отказ)

	Если ЗначениеЗаполнено(Запись.Работа)
		И НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Запись.Работа,
			Тх_ТехникаСервер.ИмяСправочникаРабот()) Тогда
		Отказ = Истина;
		СообщитьОбОшибке(Запись, "Работа",
			"Работа должна быть элементом справочника «ВидыРаботСотрудников».");
	КонецЕсли;

	Если ЗначениеЗаполнено(Запись.МодельТехники) Тогда
		ИмяСправочника = Тх_ТехникаСервер.ИмяСправочникаМоделей(Запись.ВидТехники);
		Если ИмяСправочника <> ""
			И НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Запись.МодельТехники, ИмяСправочника) Тогда
			Отказ = Истина;
			СообщитьОбОшибке(Запись, "МодельТехники",
				"Модель техники не соответствует виду техники.");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Выводит немодальное сообщение пользователю с привязкой к строке набора.
//
// Параметры:
//   Запись - РегистрСведенийЗапись.Тх_КоэффициентыПересчетаРабот - строка набора;
//   Поле   - Строка - имя поля строки набора;
//   Текст  - Строка - текст сообщения.
Процедура СообщитьОбОшибке(Запись, Поле, Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(Запись);
	Сообщение.Сообщить();

КонецПроцедуры

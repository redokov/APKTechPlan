// Подготовка стабильных тестовых данных сценариев Vanessa Automation
// (TEST-04, пункт 1: перенос scripts/va_prep_data.py на встроенный язык -
// прод-контур проверки не должен зависеть от Python). Идемпотентно:
// элементы ищутся по имени/коду, создаются только отсутствующие;
// существующим ТС дозаполняются пустые АпкМодель/АпкТипТС (SRV-02: тип
// строки пула берётся из реквизита АпкТипТС). Только тестовая база
// (маркер Тх_ТестоваяБаза, TEST-02).
//
// Стабильный набор НЕ регистрируется в Тх_РеестрТестовыхОбъектов и не
// подпадает под очистку по маскам: сценарии опираются на него между
// прогонами (исключение из уборки - явные фиксированные имена).

#Область ПрограммныйИнтерфейс

// Создаёт (идемпотентно) стабильный набор данных сценариев: работу,
// три модели СХ-техники и четыре транспортных средства с кодами
// ТХТС00001..ТХТС00004.
//
// Возвращаемое значение:
//   Структура:
//     * Создано - Массив из Строка - описания созданных элементов;
//     * Найдено - Массив из Строка - описания существовавших элементов;
//     * Работа  - СправочникСсылка.ВидыРаботСотрудников - «Тх_Тест Работа»;
//     * Модели  - Структура - ключ ("Базовая"/"Аналог"/"БезМощности") ->
//       СправочникСсылка.АпкМоделиСХТехники;
//     * ТС      - Массив из СправочникСсылка.ТранспортныеСредства.
//
Функция ПодготовитьСтабильныеДанные() Экспорт

	Тх_Тесты.ПроверитьТестовуюБазу();

	Отчёт = Новый Структура("Создано, Найдено, Работа, Модели, ТС",
		Новый Массив, Новый Массив, Неопределено, Новый Структура, Новый Массив);

	// Работа: единственный элемент, поиск по наименованию.
	Отчёт.Работа = ОбеспечитьЭлементПоНаименованию("ВидыРаботСотрудников",
		"Тх_Тест Работа", "Работа", Отчёт);

	// Модели: Базовая (мощность 100), Аналог (125 - коэффициент замещения
	// 100/125 = 0,8), БезМощности (реквизит не заполняется: автоподбор
	// обязан её пропустить и назвать в сообщении, тесты Тх_Тест*).
	// Ключи структуры - идентификаторы без пробелов (ограничение Структура.Вставить).
	Отчёт.Модели.Вставить("Базовая",
		ОбеспечитьЭлементПоНаименованию("АпкМоделиСХТехники",
			"Тх_Тест Базовая", "Модель", Отчёт,
			Новый Структура("МощностьДвигателя", 100)));
	Отчёт.Модели.Вставить("Аналог",
		ОбеспечитьЭлементПоНаименованию("АпкМоделиСХТехники",
			"Тх_Тест Аналог", "Модель", Отчёт,
			Новый Структура("МощностьДвигателя", 125)));
	Отчёт.Модели.Вставить("БезМощности",
		ОбеспечитьЭлементПоНаименованию("АпкМоделиСХТехники",
			"Тх_Тест БезМощности", "Модель", Отчёт));

	// ТС: фиксированные коды (поиск по коду одним запросом), модель -
	// Базовая, тип строки пула - СХТехника, хоз. номер ТХХ-0000N.
	ОписаниеТС = Новый Массив;
	ОписаниеТС.Добавить(Новый Структура("Наименование, Код, ХозНомер",
		"Тх_Тест ТС 001", "ТХТС00001", "ТХХ-00001"));
	ОписаниеТС.Добавить(Новый Структура("Наименование, Код, ХозНомер",
		"Тх_Тест ТС 002", "ТХТС00002", "ТХХ-00002"));
	ОписаниеТС.Добавить(Новый Структура("Наименование, Код, ХозНомер",
		"Тх_Тест ТС 003", "ТХТС00003", "ТХХ-00003"));
	ОписаниеТС.Добавить(Новый Структура("Наименование, Код, ХозНомер",
		"Тх_Тест ТС 004", "ТХТС00004", "ТХХ-00004"));

	Коды = Новый Массив;
	Для Каждого ТС Из ОписаниеТС Цикл
		Коды.Добавить(ТС.Код);
	КонецЦикла;

	НайденныеТС = НайтиПоКодам("ТранспортныеСредства", Коды);
	ТипСХ = Перечисления.АпкТипыТС.СХТехника;
	МодельБазовая = Отчёт.Модели.Базовая;

	Для Каждого ТС Из ОписаниеТС Цикл
		// Соответствие: Получить (Свойство - только у Структуры, 8.5).
		Ссылка = НайденныеТС.Получить(ТС.Код);
		Если Ссылка = Неопределено Тогда
			Объект = Справочники["ТранспортныеСредства"].СоздатьЭлемент();
			Объект.Код                = ТС.Код;
			Объект.Наименование       = ТС.Наименование;
			Объект.АпкМодель          = МодельБазовая;
			Объект.АпкХозНомер        = ТС.ХозНомер;
			Объект.АпкТипТС           = ТипСХ;
			Объект.Записать();
			Отчёт.Создано.Добавить("ТС " + ТС.Код);
			Ссылка = Объект.Ссылка;
		Иначе
			ДозаполнитьТС(Ссылка, МодельБазовая, ТипСХ);
			Отчёт.Найдено.Добавить("ТС " + ТС.Код);
		КонецЕсли;
		Отчёт.ТС.Добавить(Ссылка);
	КонецЦикла;

	Возврат Отчёт;

КонецФункции

#КонецОбласти

#Область СлужебныеПрограммныйИнтерфейс

// Находит элемент по наименованию или создаёт его с реквизитами создания.
// Реквизиты применяются ТОЛЬКО при создании: существующие элементы не
// трогаются (ручная правка в тестах не должна молча откатываться).
//
Функция ОбеспечитьЭлементПоНаименованию(ИмяКаталога, Наименование, ПрефиксОтчёта,
		Отчёт, РеквизитыСоздания = Неопределено)

	Ссылка = НайтиПоНаименованию(ИмяКаталога, Наименование);
	Если Ссылка <> Неопределено Тогда
		Отчёт.Найдено.Добавить(ПрефиксОтчёта + " " + Наименование);
		Возврат Ссылка;
	КонецЕсли;

	Объект = Справочники[ИмяКаталога].СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Если РеквизитыСоздания <> Неопределено Тогда
		Для Каждого КлючЗначение Из РеквизитыСоздания Цикл
			Объект[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЦикла;
	КонецЕсли;
	Объект.Записать();
	Отчёт.Создано.Добавить(ПрефиксОтчёта + " " + Наименование);
	Возврат Объект.Ссылка;

КонецФункции

// Дозаполняет пустые АпкМодель/АпкТипТС у существующего ТС (перенос
// логики update_fields из va_prep_data.py; заполненные не трогаем).
//
Процедура ДозаполнитьТС(Ссылка, Модель, ТипСХ)

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Изменено = Ложь;
	Если НЕ ЗначениеЗаполнено(Объект.АпкМодель) Тогда
		Объект.АпкМодель = Модель;
		Изменено = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.АпкТипТС) Тогда
		Объект.АпкТипТС = ТипСХ;
		Изменено = Истина;
	КонецЕсли;

	Если Изменено Тогда
		Объект.Записать();
	КонецЕсли;

КонецПроцедуры

// Поиск ссылки по точному наименованию (без пометки удаления).
//
Функция НайтиПоНаименованию(ИмяКаталога, Наименование)

	// Имя метаданного подставляется динамически - анализатор не может
	// разобрать текст запроса (в рантайме запрос корректен).
	// BSLLS:QueryParseError-off
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Спр.Ссылка КАК Ссылка
		|ИЗ Справочник." + ИмяКаталога + " КАК Спр
		|ГДЕ Спр.Наименование = &Наименование
		|	И НЕ Спр.ПометкаУдаления");
	// BSLLS:QueryParseError-on
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Поиск ссылок по набору кодов одним запросом (без создания запроса в
// цикле). Возвращает Соответствие: код -> Ссылка (только найденные).
//
Функция НайтиПоКодам(ИмяКаталога, Коды)

	Результат = Новый Соответствие;
	Если Коды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Имя метаданного подставляется динамически - анализатор не может
	// разобрать текст запроса (в рантайме запрос корректен).
	// BSLLS:QueryParseError-off
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Спр.Ссылка КАК Ссылка, Спр.Код КАК Код
		|ИЗ Справочник." + ИмяКаталога + " КАК Спр
		|ГДЕ Спр.Код В (&Коды)
		|	И НЕ Спр.ПометкаУдаления");
	// BSLLS:QueryParseError-on
	Запрос.УстановитьПараметр("Коды", Коды);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СокрЛП(Выборка.Код), Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

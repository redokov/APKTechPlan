// Форма обработки «Тх_ФормированиеПланаРаботТехники» (design 5.4/6.1, T7):
// параметры потребности по техкартам годового плана АПК и кнопка
// «Сформировать» (Form.Command.Сформировать).
//
// T7: кнопка выполняет запрос потребности
// (Тх_ТехникаСервер.ПотребностьПоТехкартам) и сообщает сводку результата;
// создание и заполнение документа «Потребность в технике» - T9
// (Тх_ТехникаСервер.ЗаполнитьПланРабот).
//
// Без модальности и фоновых заданий (NFR-001). Форма выбора типового
// справочника сценариев открывается по строковому имени (FAQ Q8, TD-001).

&НаКлиенте
Процедура СценарийПланированияНачалоВыбора(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник." + ИмяСправочникаСценариев() + ".ФормаВыбора", , Элемент);

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Умолчание (design 5.4): СменВдень = 1.
	Если НЕ ЗначениеЗаполнено(СменВдень) Тогда
		СменВдень = 1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)

	// Сценарий планирования обязателен (design 5.4).
	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите сценарий планирования.'"));
		Возврат;
	КонецЕсли;

	Результат = СформироватьНаСервере();

	Если Результат.КоличествоСтрок = 0 Тогда
		// Крайний случай design: техкарты за период не найдены.
		ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
			НСтр("ru = 'Техкарты за период не найдены.'"));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
			СтрШаблон(НСтр("ru = 'Строк потребности: %1, смен всего: %2 (часов: %3)'"),
				Результат.КоличествоСтрок, Результат.ВсегоСмен, Результат.ВсегоЧасов));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере()

	// Сборка параметров запроса потребности (design 6.1, TD-005) и сводка
	// результата; заполнение документа - T9.
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СценарийПланирования", СценарийПланирования);
	ПараметрыЗапроса.Вставить("Организация", Организация);
	ПараметрыЗапроса.Вставить("Подразделение", Подразделение);
	ПараметрыЗапроса.Вставить("ДатаНачала", ПериодС);
	ПараметрыЗапроса.Вставить("ДатаОкончания", ПериодПо);

	Выборка = Тх_ТехникаСервер.ПотребностьПоТехкартам(ПараметрыЗапроса).Выбрать();

	Результат = Новый Структура("КоличествоСтрок, ВсегоСмен, ВсегоЧасов", 0, 0, 0);
	Пока Выборка.Следующий() Цикл
		Результат.КоличествоСтрок = Результат.КоличествоСтрок + 1;
		Результат.ВсегоСмен = Результат.ВсегоСмен + Выборка.ПотребностьСмен;
		Результат.ВсегоЧасов = Результат.ВсегоЧасов + Выборка.ПотребностьЧасов;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ИмяСправочникаСценариев()

	// Локальная константа имени (design 4.1, п. 3): каноническое значение хранит
	// Тх_ТехникаСервер.ИмяСправочникаСценариевПланирования; серверный модуль с
	// клиента недоступен (FAQ Q8), значение продублировано в клиентском модуле.
	Возврат "АпкСценарииПланирования";

КонецФункции

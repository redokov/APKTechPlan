// ПРОВЕРКА КОНТРАКТА TD-004: зеркало уровня 1 экспортной функции
// Тх_ТехникаСервер.ДоступностьСтрокиДвумяУровнями (S7: зеркало - эталон,
// сверяется с продакшеном в тесте ТестДефицитМаксНуля).
// Повторяет формулу сопоставления одной машины
// (Тх_ТехникаСервер.ДоступностьМашиныДляСтроки; design §4.7, шаги 4-5;
// D-007, FR-011): точная модель - полная ёмкость, другая модель того же
// вида - только СХТехника через реальный коэффициент замещения
// Тх_ТехникаСервер.КоэффициентЗамещения (T6).
// При изменении формулы в Тх_ТехникаСервер зеркало должно быть актуализировано.
//
// Параметры:
//   СтрПотребности - СтрокаТаблицыЗначений - строка потребности;
//   Машины          - ТаблицаЗначений - строки доступности (одна строка -
//                     одна физическая машина, формат ЗапросДоступности);
//   Дней            - Число - календарных дней интервала строки;
//   СменВДень       - Число - смен в день (FAQ Q1).
//
// Возвращаемое значение:
//   Структура - свойства: Доступно (Число), КоэффициентНеЗадан (Булево).
//
Функция ДоступноСменКонтракт(СтрПотребности, Машины, Дней, СменВДень)

	Доступно = 0;
	КоэффициентНеЗадан = Ложь;
	Емкость = Дней * СменВДень;

	Для Каждого Машина Из Машины Цикл
		// Сопоставляются только машины того же вида техники (D-007).
		Если Машина.ВидТехники <> СтрПотребности.ВидТехники Тогда
			Продолжить;
		КонецЕсли;

		Если Машина.МодельТехники = СтрПотребности.МодельТехники Тогда
			// Точная модель - полная ёмкость, без пересчёта через К (D-007).
			Доступно = Доступно + Емкость;
		ИначеЕсли СтрПотребности.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника Тогда
			// T6: модельный коэффициент замещения (FR-004, design 6.4);
			// Автотранспорт и Прицеп - строго модель в модель (FAQ Q4).
			К = Тх_ТехникаСервер.КоэффициентЗамещения(
				СтрПотребности.МодельТехники, Машина.МодельТехники);
			Если К = Неопределено Тогда
				// Реквизитов замещения нет - пометка вместо молчаливого 1,00 (FR-011).
				КоэффициентНеЗадан = Истина;
			Иначе
				// TD-004: эквивалент замены в сменах оригинала = смены_замены / К.
				Доступно = Доступно + Емкость / К;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Доступно, КоэффициентНеЗадан", Доступно, КоэффициентНеЗадан);

КонецФункции

// ПРОВЕРКА КОНТРАКТА FR-012: дефицит неотрицателен (зеркало формулы
// функции Тх_ТехникаСервер.РассчитатьДефицит, округление 2 знака).
//
// Параметры:
//   ПотребностьСмен - Число - потребность в сменах;
//   ДоступноСмен    - Число - доступно смен.
//
// Возвращаемое значение:
//   Число - дефицит (не меньше нуля).
//
Функция ДефицитКонтракт(ПотребностьСмен, ДоступноСмен)

	Возврат Макс(0, Окр(ПотребностьСмен - ДоступноСмен, 2));

КонецФункции



// Тест ДублиТСНеУвеличиваютДоступность (FR-008, SRV-02 §1, Q-003):
// реальный путь через Тх_ТехникаСервер.РассчитатьДефицит - доступность
// из регистра АпкИсторияТранспортныхСредств (решение владельца
// 10.11.2026): у ТС1 ДВЕ записи истории (дубль, обе Исправно = Истина),
// срез последних схлопывает их в ОДНУ машину; ТС2 - одна запись.
// Единицы считаются по ФИЗИЧЕСКИМ машинам, дубль записей единицу
// не добавляет. Дата среза 31.12.1999 (ДатаНачала расчёта) изолирует
// пул от демо-записей регистра (они начинаются с 2000-01-01).
// Потребность 25 смен за 10 дней при ёмкости машины 10 смен: две машины
// дают 20 смен (а не 30 при подсчёте дублей), дефицит 5 смен.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"), Провалы.
//
Функция ТестДублиТСНеУвеличиваютДоступность() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДублиТСНеУвеличиваютДоступность");
	Сценарий = Неопределено;
	Подразделение = Неопределено;
	Организация = Неопределено;
	ВидРаботы = Неопределено;
	Модель = Неопределено;
	ТС1 = Неопределено;
	ТС2 = Неопределено;
	Регистратор = Неопределено;

	Попытка
		// Фикстура: собственные сценарий/подразделение/организация/вид
		// работы/модель/ТС и техкарта-регистратор потребности (по сценарию
		// и подразделению теста других данных в ИБ нет).
		Сценарий = СоздатьЭлемент("АпкСценарииПланирования");
		Подразделение = СоздатьЭлемент("СтруктураПредприятия");
		Организация = СоздатьЭлемент("Организации");
		ВидРаботы = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Модель = СоздатьМодель(Перечисления.Тх_ВидыТехники.СХТехника);
		Регистратор = СоздатьРегистратораТехкарту();
		// Уникальные ТС с моделью: у справочника ТранспортныеСредства
		// Код (= «госномер») не автонумеруется - задаём GUID вручную.
		// АпкТипТС обязателен: вид техники строки пула берётся из него
		// (АпкТипыТС -> Тх_ВидыТехники), без типа машина не сопоставляется.
		ТС1 = СоздатьЭлемент("ТранспортныеСредства",
			Новый Структура("Код, АпкМодель, АпкТипТС", УникальноеИмя(), Модель,
				Перечисления.АпкТипыТС.СХТехника));
		ТС2 = СоздатьЭлемент("ТранспортныеСредства",
			Новый Структура("Код, АпкМодель, АпкТипТС", УникальноеИмя(), Модель,
				Перечисления.АпкТипыТС.СХТехника));

		Если Сценарий = Неопределено Или Подразделение = Неопределено
			Или Организация = Неопределено Или ВидРаботы = Неопределено
			Или Модель = Неопределено Или Регистратор = Неопределено
			Или ТС1 = Неопределено Или ТС2 = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'не удалось создать тестовую фикстуру (сценарий/подразделение/организация/вид работы/модель/регистратор/ТС)'");
		КонецЕсли;

		// Приписка обеих ТС к организации/подразделению теста: записи
		// независимого периодического регистра АпкИсторияТранспортныхСредств,
		// Исправно = Истина; у ТС1 - ДВЕ записи (дубль, срез последних
		// оставляет одну машину - Q-003), у ТС2 - одна.
		ЗаписатьПрипискуТС(ТС1, Организация, Подразделение, 2);
		ЗаписатьПрипискуТС(ТС2, Организация, Подразделение);

		// Потребность 25 смен за 10 дней по тестовой модели (фикстура
		// по образцу ЗаписатьПотребностьБезПлана).
		ЗаписатьПотребностьБезПлана(Регистратор, Сценарий, Подразделение,
			Организация, ВидРаботы, Модель, 25);

		// ДатаНачала = дата среза истории ТС (решение владельца):
		// 31.12.1999 - раньше всех демо-записей регистра (2000-01-01),
		// пул изолирован тестовыми приписками; окно потребности
		// (май 2014) правее границы, в расчёт попадает.
		ПараметрыРасчета = Новый Структура(
			"СценарийПланирования, Организация, Подразделение, ДатаНачала, СуффиксОбъема",
			Сценарий, Неопределено, Подразделение, Дата(1999, 12, 31), "_Вер");
		ЗаписаноСтрок = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|　Д.ПотребностьСмен КАК ПотребностьСмен,
		|　Д.ДоступноСмен КАК ДоступноСмен,
		|　Д.НехватаетПослеСвоихСмен КАК НехватаетПослеСвоихСмен,
		|　Д.НехватаетСмен КАК НехватаетСмен,
		|　Д.ПланТехресурсовОтсутствует КАК ПланТехресурсовОтсутствует
		|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
		|ГДЕ Д.СценарийПланирования = &Сценарий
		|　И Д.Подразделение = &Подразделение";
		Запрос.УстановитьПараметр("Сценарий", Сценарий);
		Запрос.УстановитьПараметр("Подразделение", Подразделение);

		СтрокДефицита = 0;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокДефицита = СтрокДефицита + 1;
			// Дубль ТС1 в ТЧ Техника не добавляет единицу: доступность
			// 2 физических машины x 10 смен = 20 (не 30 при подсчёте дублей).
			Проверить(Контекст, НСтр("ru = 'дубль ТС посчитан одной машиной (20, а не 30)'"),
				Выборка.ДоступноСмен = 20,
				СтрШаблон(НСтр("ru = 'ДоступноСмен = %1'"), Выборка.ДоступноСмен));
			// Потребность 25: после своих машин не хватает 5 (25 - 20).
			Проверить(Контекст, НСтр("ru = 'нехватка после своих смен = 5'"),
				Выборка.НехватаетПослеСвоихСмен = 5,
				СтрШаблон(НСтр("ru = 'НехватаетПослеСвоихСмен = %1'"),
					Выборка.НехватаетПослеСвоихСмен));
			Проверить(Контекст, НСтр("ru = 'дефицит = 5 (дубль не добавил 10 смен)'"),
				Выборка.НехватаетСмен = 5,
				СтрШаблон(НСтр("ru = 'НехватаетСмен = %1'"), Выборка.НехватаетСмен));
			// Машины приписаны к подразделению строки - флага нет (A2).
			Проверить(Контекст, НСтр("ru = 'план техресурсов учтён (флаг сброшен)'"),
				НЕ Выборка.ПланТехресурсовОтсутствует);
		КонецЦикла;

		Проверить(Контекст, НСтр("ru = 'ровно одна строка дефицита теста'"),
			СтрокДефицита = 1, Строка(СтрокДефицита));
		Проверить(Контекст, НСтр("ru = 'расчёт по тестовому сценарию записал строки'"),
			ЗаписаноСтрок > 0, Строка(ЗаписаноСтрок));
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	// Очистка: строки дефицита, регистратор (движения удаляются
	// вместе с ним), приписки ТС и созданные элементы; сбой очистки -
	// видимый провал теста (Q-006/К4а).
	ОшибкаВосстановления = ВосстановитьДефицитПоСценарию(Сценарий);
	УдалитьСсылку(Регистратор);
	ОшибкаВосстановления = ОшибкаВосстановления + УдалитьПрипискуТС(ТС1);
	ОшибкаВосстановления = ОшибкаВосстановления + УдалитьПрипискуТС(ТС2);
	УдалитьСсылку(ТС1);
	УдалитьСсылку(ТС2);
	УдалитьСсылку(Модель);
	УдалитьСсылку(ВидРаботы);
	УдалитьСсылку(Организация);
	УдалитьСсылку(Подразделение);
	УдалитьСсылку(Сценарий);

	Если ОшибкаВосстановления <> "" Тогда
		Проверить(Контекст, НСтр("ru = 'восстановление данных после теста'"),
			Ложь, ОшибкаВосстановления);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Пишет записи приписки ТС в независимый периодический регистр
// АпкИсторияТранспортныхСредств (новый источник доступности, решение
// владельца 10.11.2026): Исправно = Истина (иначе ТС не попадает в пул),
// период - 01.01.1999 и далее по месяцу на запись (все записи - до
// тестовой даты среза 31.12.1999, которая изолирует пул от демо-записей
// регистра с 2000-01-01; дубль записей одного ТС срез схлопывает
// в одну машину - Q-003). Набор записей с отбором по ТС замещает все
// прежние записи этого ТС.
//
// Параметры:
//   ТС            - СправочникСсылка.ТранспортныеСредства - тестовая ТС;
//   Организация   - СправочникСсылка - организация приписки;
//   Подразделение - СправочникСсылка - эксплуатирующее подразделение;
//   Записей       - Число - сколько записей истории написать (по умолчанию 1;
//                   2+ - фикстура дедупликации: срез оставляет одну машину).
//
Процедура ЗаписатьПрипискуТС(ТС, Организация, Подразделение, Записей = 1)

	ПроверитьТестовуюБазу();

	НаборЗаписей = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТранспортноеСредство.Установить(ТС);
	Для Инд = 1 По Записей Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Период = Дата(1999, 1, 1) + (Инд - 1) * 2678400;
		Запись.ТранспортноеСредство = ТС;
		Запись.Организация = Организация;
		Запись.ЭксплуатирующееПодразделение = Подразделение;
		Запись.Исправно = Истина;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Очистка фикстуры приписки: удаляет записи истории тестовой ТС
// (пустой набор по отбору). Возвращает текст ошибки ("" - успех);
// сбой очистки - видимый провал теста (Q-006/К4а).
//
// Параметры:
//   ТС - СправочникСсылка, Неопределено - тестовая ТС.
//
// Возвращаемое значение:
//   Строка - "" - записей нет; иначе описание ошибки.
//
Функция УдалитьПрипискуТС(ТС)

	ПроверитьТестовуюБазу();

	Если ТС = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Ошибки = "";
	Попытка
		НаборЗаписей = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ТранспортноеСредство.Установить(ТС);
		НаборЗаписей.Записать(Истина);
	Исключение
		Ошибки = ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат Ошибки;

КонецФункции

// Тест ДефицитМаксНуля (FR-012): доступность больше потребности -
// НехватаетСмен = 0, не отрицательное (контракт формулы РассчитатьДефицит).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестДефицитМаксНуля() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДефицитМаксНуля");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Модель = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// Потребность 10 смен; доступность - 2 физические машины своей
			// модели, приписанные к организации/подразделению строки:
			// 2 x 10 дней x 1 смена = 20 смен.
			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.Организация = "Тх_ТестОрг";
			СтрПотребности.Подразделение = "Тх_ТестПодр";
			СтрПотребности.ВидРаботы = Работа;
			СтрПотребности.МодельТехники = Модель;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрМашины = Доступность.Добавить();
			СтрМашины.ТС = "Тх_ТС1";
			СтрМашины.МодельТехники = Модель;
			СтрМашины.ВидТехники = ВидТехники;
			СтрМашины.ОрганизацияПриписки = "Тх_ТестОрг";
			СтрМашины.ПодразделениеПриписки = "Тх_ТестПодр";
			СтрМашины = Доступность.Добавить();
			СтрМашины.ТС = "Тх_ТС2";
			СтрМашины.МодельТехники = Модель;
			СтрМашины.ВидТехники = ВидТехники;
			СтрМашины.ОрганизацияПриписки = "Тх_ТестОрг";
			СтрМашины.ПодразделениеПриписки = "Тх_ТестПодр";

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			ИндексУровня1 = Тх_ТехникаСервер.ИндексПрипискиПоОргПодр(Доступность);
			РезультатСопоставления = Тх_ТехникаСервер.ДоступностьСтрокиДвумяУровнями(
				СтрПотребности, ИндексУровня1, Доступность, Дней, 1);

			Проверить(Контекст, НСтр("ru = 'уровень 1: 2 машины x 10 x 1 = 20 смен'"),
				РезультатСопоставления.ДоступноУровень1 = 20,
				Строка(РезультатСопоставления.ДоступноУровень1));
			Проверить(Контекст, НСтр("ru = 'своих машин хватило - уровень 2 не нужен'"),
				РезультатСопоставления.ДоступноУровень2 = 0,
				Строка(РезультатСопоставления.ДоступноУровень2));

			// Сверка зеркала с продакшеном (S7): эталон ДоступноСменКонтракт
			// должен совпадать с уровнем 1 ДоступностьСтрокиДвумяУровнями.
			РезультатЗеркала = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);
			Проверить(Контекст, НСтр("ru = 'зеркало == продакшен (ДоступноУровень1)'"),
				РезультатЗеркала.Доступно = РезультатСопоставления.ДоступноУровень1
					И РезультатЗеркала.КоэффициентНеЗадан = РезультатСопоставления.КоэффициентНеЗадан,
				СтрШаблон(НСтр("ru = 'зеркало %1 / КНЗ %2, продакшен %3 / КНЗ %4'"),
					РезультатЗеркала.Доступно, РезультатЗеркала.КоэффициентНеЗадан,
					РезультатСопоставления.ДоступноУровень1, РезультатСопоставления.КоэффициентНеЗадан));

			ДоступноВсего = РезультатСопоставления.ДоступноУровень1
				+ РезультатСопоставления.ДоступноУровень2;
			Дефицит = ДефицитКонтракт(СтрПотребности.ПотребностьСмен, ДоступноВсего);
			Проверить(Контекст, НСтр("ru = 'дефицит = 0 при доступности больше потребности'"),
				Дефицит = 0,
				Строка(Дефицит));
			Проверить(Контекст, НСтр("ru = 'дефицит неотрицательный (FR-012)'"),
				Дефицит >= 0);

			// Сверка зеркала дефицита с продакшен-формулой (S7).
			ДефицитПродакшен = Макс(0, Окр(СтрПотребности.ПотребностьСмен - ДоступноВсего, 2));
			Проверить(Контекст, НСтр("ru = 'зеркало дефицита == продакшен-формула'"),
				Дефицит = ДефицитПродакшен,
				СтрШаблон(НСтр("ru = 'зеркало %1, формула %2'"), Дефицит, ДефицитПродакшен));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(Работа);
	УдалитьСсылку(Модель);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции


// Тест ПланТехресурсовОтсутствует_ПометкаНеНоль (NFR-005, рек. B).
// Самодостаточный (решение Q-007/Ж1, обязательство TEST-01: причина
// прежнего SKIP устранена - тест больше не зависит от того, покрывают ли
// планы техресурсов все подразделения со спросом): создаёт собственный
// сценарий, собственное подразделение и регистратор-заглушку техкарты,
// пишет одну строку потребности в регистр оборота годового плана и
// запускает расчёт по тестовому сценарию. Записей истории ТС нет
// (пул пуст, новая семантика флага: «нет исправных ТС в срезе»,
// решение владельца 10.11.2026), поэтому строка гарантированно
// получает ПланТехресурсовОтсутствует = Истина и НехватаетСмен =
// ПотребностьСмен (вся потребность), НЕ 0. Дата среза 31.12.1999
// изолирует пул от демо-записей регистра (с 2000-01-01).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"), Провалы.
//
Функция ТестПланТехресурсовОтсутствует_ПометкаНеНоль() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПланТехресурсовОтсутствует_ПометкаНеНоль");
	Сценарий = Неопределено;
	Подразделение = Неопределено;
	Организация = Неопределено;
	ВидРаботы = Неопределено;
	Модель = Неопределено;
	Регистратор = Неопределено;

	Попытка
		// Фикстура: свой сценарий, подразделение, организация, вид работы,
		// модель и техкарта-регистратор - плана техресурсов по ним в ИБ
		// не существует; потребность пишется напрямую в регистр оборота
		// годового плана (все измерения с запретом пустых значений заполняются:
		// СценарийПланирования, Организация, Подразделение, ВидРаботы, Техника).
		Сценарий = СоздатьЭлемент("АпкСценарииПланирования");
		Подразделение = СоздатьЭлемент("СтруктураПредприятия");
		Организация = СоздатьЭлемент("Организации");
		ВидРаботы = СоздатьЭлемент("ВидыРаботСотрудников");
		Модель = СоздатьМодель(Перечисления.Тх_ВидыТехники.СХТехника);
		Регистратор = СоздатьРегистратораТехкарту();
		Если Сценарий = Неопределено Или Подразделение = Неопределено
			Или Организация = Неопределено Или ВидРаботы = Неопределено
			Или Модель = Неопределено Или Регистратор = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'не удалось создать тестовую фикстуру (сценарий/подразделение/организация/вид работы/модель/регистратор)'");
		КонецЕсли;

		ЗаписатьПотребностьБезПлана(Регистратор, Сценарий, Подразделение,
			Организация, ВидРаботы, Модель);

		ПараметрыРасчета = Новый Структура(
			"СценарийПланирования, Организация, Подразделение, ДатаНачала, СуффиксОбъема",
			Сценарий, Неопределено, Подразделение, Дата(1999, 12, 31), "_Вер");
		ЗаписаноСтрок = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

		Проверить(Контекст, НСтр("ru = 'расчёт по тестовому сценарию записал строки'"),
			ЗаписаноСтрок > 0, Строка(ЗаписаноСтрок));

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Д.ПотребностьСмен КАК ПотребностьСмен,
		|	Д.НехватаетСмен КАК НехватаетСмен,
		|	Д.ДоступноСмен КАК ДоступноСмен
		|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
		|ГДЕ Д.СценарийПланирования = &Сценарий
		|	И Д.Подразделение = &Подразделение
		|	И Д.ПланТехресурсовОтсутствует";
		Запрос.УстановитьПараметр("Сценарий", Сценарий);
		Запрос.УстановитьПараметр("Подразделение", Подразделение);

		ПомеченныеСтроки = 0;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПомеченныеСтроки = ПомеченныеСтроки + 1;
			Проверить(Контекст, НСтр("ru = 'помеченная строка: дефицит = вся потребность, не 0'"),
				Выборка.НехватаетСмен = Выборка.ПотребностьСмен
					И Выборка.ПотребностьСмен > 0,
				СтрШаблон(НСтр("ru = 'НехватаетСмен = %1, ПотребностьСмен = %2'"),
					Выборка.НехватаетСмен, Выборка.ПотребностьСмен));
			Проверить(Контекст, НСтр("ru = 'помеченная строка: доступность = 0'"),
				Выборка.ДоступноСмен = 0,
				СтрШаблон(НСтр("ru = 'ДоступноСмен = %1'"), Выборка.ДоступноСмен));
		КонецЦикла;

		Проверить(Контекст, НСтр("ru = 'ровно одна помеченная строка теста'"),
			ПомеченныеСтроки = 1, Строка(ПомеченныеСтроки));
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	// Восстановление выполняется всегда; сбой восстановления - видимый
	// провал теста (Q-006/К4а: запись журнала «Информация» доказательством
	// очистки не считается).
	ОшибкаВосстановления = ВосстановитьДефицитПоСценарию(Сценарий);
	УдалитьСсылку(Подразделение);
	УдалитьСсылку(Регистратор);
	УдалитьСсылку(Модель);
	УдалитьСсылку(ВидРаботы);
	УдалитьСсылку(Организация);
	УдалитьСсылку(Сценарий);
	// Движения регистра оборота удаляются платформой вместе с документом-
	// регистратором; остаток контролируется запросом (видимый провал, Q-006/К4а).
	ОшибкаВосстановления = ОшибкаВосстановления
		+ ОстатокПотребностиРегистратора(Регистратор);

	Если ОшибкаВосстановления <> "" Тогда
		Проверить(Контекст, НСтр("ru = 'восстановление данных после теста'"),
			Ложь, ОшибкаВосстановления);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ДетерминированностьПовторногоРасчета (NFR-005).
// ЗАВИСИТ ОТ ДАННЫХ ИБ: два расчёта с теми же параметрами - число строк
// и значения ресурсов идентичны (сравнение выгрузок регистра).
// При пустой потребности - SKIP.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестДетерминированностьПовторногоРасчета() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДетерминированностьПовторногоРасчета");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			СнимокРегистра = СнимокДефицита(Сценарий);

			ПараметрыРасчета = Новый Структура(
				"СценарийПланирования, Организация, Подразделение, СуффиксОбъема",
				Сценарий, Неопределено, Неопределено, "_Вер");

			ЗаписаноПервый = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);
			ТаблицаПервая = ВыгрузкаДефицита(Сценарий);

			ЗаписаноВторой = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);
			ТаблицаВторая = ВыгрузкаДефицита(Сценарий);

			Проверить(Контекст, НСтр("ru = 'число записанных строк одинаково'"),
				ЗаписаноПервый = ЗаписаноВторой,
				СтрШаблон(НСтр("ru = '%1 и %2'"), ЗаписаноПервый, ЗаписаноВторой));
			Проверить(Контекст, НСтр("ru = 'число строк регистра одинаково'"),
				ТаблицаПервая.Количество() = ТаблицаВторая.Количество());
			Проверить(Контекст, НСтр("ru = 'значения всех строк идентичны'"),
				ТаблицыИдентичны(ТаблицаПервая, ТаблицаВторая));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ОчисткаНеТрогаетДругиеПериоды (SRV-01, Q-001 B, дизайн §6.1):
// расчёт января не трогает февральские строки и удаляет пересекающиеся
// январские (засев синтетики клонированием строки снимка с уникальными
// периодами 2099 года, восстановление снимка после).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестОчисткаНеТрогаетДругиеПериоды() Экспорт

	Контекст = НовыйКонтекстТеста("ТестОчисткаНеТрогаетДругиеПериоды");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			СнимокРегистра = СнимокДефицита(Сценарий);

			Периоды = Новый Массив;
			// Январь 2099 - пересекается с диапазоном расчёта января.
			Периоды.Добавить(Новый Структура("ПериодНачала, ПериодОкончания",
				Дата(2099, 1, 5), Дата(2099, 1, 10)));
			// Февраль 2099 - вне диапазона, обязан остаться.
			Периоды.Добавить(Новый Структура("ПериодНачала, ПериодОкончания",
				Дата(2099, 2, 5), Дата(2099, 2, 10)));

			Если НЕ ЗасеятьСтрокиДефицита(Сценарий, СнимокРегистра, Периоды) Тогда
				Пропуск = НСтр("ru = 'в регистре нет строк сценария для клонирования фикстуры'");
			Иначе
				ПараметрыРасчета = Новый Структура(
					"СценарийПланирования, ДатаНачала, ДатаОкончания",
					Сценарий, Дата(2099, 1, 1), Дата(2099, 1, 31));
				Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

				Проверить(Контекст, НСтр("ru = 'строка пересекающегося периода удалена'"),
					НЕ ЕстьСтрокаДефицитаСПериодом(Сценарий,
						Дата(2099, 1, 5), Дата(2099, 1, 10)));
				Проверить(Контекст, НСтр("ru = 'строка вне диапазона не тронута'"),
					ЕстьСтрокаДефицитаСПериодом(Сценарий,
						Дата(2099, 2, 5), Дата(2099, 2, 10)));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ГраницаПересеченияОднимДнем (SRV-01, Q-001 B, дизайн §6.2):
// строка с ПериодОкончания = ДатаНачала пересекается (удаляется),
// строка с ПериодОкончания = ДатаНачала - 1 день - нет (остаётся).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестГраницаПересеченияОднимДнем() Экспорт

	Контекст = НовыйКонтекстТеста("ТестГраницаПересеченияОднимДнем");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			СнимокРегистра = СнимокДефицита(Сценарий);

			Периоды = Новый Массив;
			// Граничная: ПериодОкончания = ДатаНачала диапазона.
			Периоды.Добавить(Новый Структура("ПериодНачала, ПериодОкончания",
				Дата(2098, 12, 25), Дата(2099, 1, 1)));
			// За границей на один день: ПериодОкончания = ДатаНачала - 1 день.
			Периоды.Добавить(Новый Структура("ПериодНачала, ПериодОкончания",
				Дата(2098, 12, 20), Дата(2098, 12, 31)));

			Если НЕ ЗасеятьСтрокиДефицита(Сценарий, СнимокРегистра, Периоды) Тогда
				Пропуск = НСтр("ru = 'в регистре нет строк сценария для клонирования фикстуры'");
			Иначе
				ПараметрыРасчета = Новый Структура(
					"СценарийПланирования, ДатаНачала, ДатаОкончания",
					Сценарий, Дата(2099, 1, 1), Дата(2099, 1, 31));
				Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

				Проверить(Контекст, НСтр("ru = 'строка «ПериодОкончания = ДатаНачала» удалена'"),
					НЕ ЕстьСтрокаДефицитаСПериодом(Сценарий,
						Дата(2098, 12, 25), Дата(2099, 1, 1)));
				Проверить(Контекст, НСтр("ru = 'строка «ПериодОкончания = ДатаНачала - 1 день» осталась'"),
					ЕстьСтрокаДефицитаСПериодом(Сценарий,
						Дата(2098, 12, 20), Дата(2098, 12, 31)));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ПустыеДатыПолнаяПерезапись (SRV-01, дизайн §3/§6.4): при пустых
// датах запуска пересечение = все строки сценария - осознанная полная
// перезапись (строка 2099 года удаляется расчётом без дат).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестПустыеДатыПолнаяПерезапись() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПустыеДатыПолнаяПерезапись");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			СнимокРегистра = СнимокДефицита(Сценарий);

			Периоды = Новый Массив;
			Периоды.Добавить(Новый Структура("ПериодНачала, ПериодОкончания",
				Дата(2099, 1, 5), Дата(2099, 1, 10)));

			Если НЕ ЗасеятьСтрокиДефицита(Сценарий, СнимокРегистра, Периоды) Тогда
				Пропуск = НСтр("ru = 'в регистре нет строк сценария для клонирования фикстуры'");
			Иначе
				// Расчёт без дат: диапазон = вся глубина (0001-3999).
				ПараметрыРасчета = Новый Структура(
					"СценарийПланирования",
					Сценарий);
				Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

				Проверить(Контекст, НСтр("ru = 'строка 2099 года удалена полной перезаписью'"),
					НЕ ЕстьСтрокаДефицитаСПериодом(Сценарий,
						Дата(2099, 1, 5), Дата(2099, 1, 10)));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ОжиданиеБлокировкиОграничено (SRV-01, Q-004 C1, дизайн §6.5):
// фоновое задание держит блокировку области расчёта → РассчитатьДефицит
// упадает с явным сообщением после таймаута ИБ (дефолт 20 с), регистр
// НЕ изменён (полный откат), автоповтора нет. Текст платформенного
// исключения фиксируется в журнал регистрации (артефакт).
// Пробы ФЗ 2026-11-13: задание доступно из серверного сеанса;
// ОжидатьЗавершения - процедура; Идентификатор 8.3 → УникальныйИдентификатор.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестОжиданиеБлокировкиОграничено() Экспорт

	Контекст = НовыйКонтекстТеста("ТестОжиданиеБлокировкиОграничено");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Задание = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			СнимокРегистра = СнимокДефицита(Сценарий);
			ТаблицаДо = ВыгрузкаДефицита(Сценарий);

			ПараметрыРасчета = Новый Структура("СценарийПланирования", Сценарий);
			ПараметрыЗадания = Новый Массив;
			ПараметрыЗадания.Добавить(ПараметрыРасчета);
			ПараметрыЗадания.Добавить(40);	// секунд удержания

			Задание = ФоновыеЗадания.Выполнить(
				"Тх_ТехникаСервер.ДержатьБлокировкуДефицита", ПараметрыЗадания);

			// Даём фоновому заданию взять блокировку (спин-ап сеанса).
			ЗанятыйЦиклСекунд(15);

			НачалоБлокировки = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ИсключениеПоймано = Ложь;
			ТекстИсключения = "";
			Попытка
				Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);
			Исключение
				ИсключениеПоймано = Истина;
				ТекстИсключения = ОписаниеОшибки();
			КонецПопытки;
			ДлительностьСек = Окр(
				(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБлокировки) / 1000);

			// Артефакт: точный текст исключения (вкл. платформенную часть) - в ЖР.
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Тх_Тесты: bounded-wait - текст исключения таймаута'"),
				УровеньЖурналаРегистрации.Информация,,, ТекстИсключения);

			Проверить(Контекст, НСтр("ru = 'расчёт упал с исключением'"),
				ИсключениеПоймано, ТекстИсключения);
			Проверить(Контекст, НСтр("ru = 'сообщение явное, с призывом перезапустить'"),
				СтрНайти(ТекстИсключения, НСтр("ru = 'Расчёт дефицита не выполнен'")) > 0,
				ТекстИсключения);
			Проверить(Контекст, НСтр("ru = 'регистр не изменён (полный откат)'"),
				ТаблицыИдентичны(ТаблицаДо, ВыгрузкаДефицита(Сценарий)));
			Проверить(Контекст,
				НСтр("ru = 'ожидание ограничено таймаутом ИБ (~20 с), не бесконечно'"),
				ДлительностьСек >= 15 И ДлительностьСек <= 45,
				Строка(ДлительностьСек));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	// ФЗ обязан завершиться (иначе - утечка сеанса/лицензии);
	// ОжидатьЗавершения в 8.5 - процедура (пробы 2026-11-13).
	Если Задание <> Неопределено Тогда
		ДождатьсяЗавершенияФоновогоЗадания(Задание);
	КонецЕсли;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Занят-цикл ожидания (sleep в BSL нет): держит поток заданное число
// секунд (фикстура теста bounded-wait, SRV-01).
//
// Параметры:
//   Секунд - Число - длительность ожидания.
//
Процедура ЗанятыйЦиклСекунд(Секунд)

	ДельтаМс = Секунд * 1000;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СчетчикИтераций = 0;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < ДельтаМс Цикл
		СчетчикИтераций = СчетчикИтераций + 1;	// занят-цикл (sleep в BSL нет)
	КонецЦикла;

КонецПроцедуры

// Ждёт завершения фонового задания (фикстура теста bounded-wait,
// SRV-01): ОжидатьЗавершения в 8.5 - процедура (пробы 2026-11-13);
// недоступность метода не должна подвесить прогон.
//
// Параметры:
//   Задание - ФоновоеЗадание - задание, удерживающее блокировку.
//
Процедура ДождатьсяЗавершенияФоновогоЗадания(Задание)

	Попытка
		Задание.ОжидатьЗавершения(120);
	Исключение
		Попытка
			Задание.ОжидатьЗавершения();
		Исключение
			ТекстОшибки = "Тх_Тесты: не удалось дождаться фонового задания: "
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Тх_Тесты: не удалось дождаться фонового задания'"),
				УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Засевает синтетические строки регистра Тх_ДефицитТехники - клоны первой
// строки снимка сценария с уникальными периодами 2099 года (фикстуры
// периодных тестов SRV-01). Снимок-оригинал НЕ мутируется: восстановление
// после теста уберёт и синтетику.
//
// Параметры:
//   Сценарий - СправочникСсылка - сценарий планирования;
//   Снимок   - ТаблицаЗначений - строки сценария (СнимокДефицита);
//   Периоды  - Массив - структуры «ПериодНачала, ПериодОкончания».
//
// Возвращаемое значение:
//   Булево - Истина - строки засеяны; Ложь - нет шаблона (снимок пуст).
//
Функция ЗасеятьСтрокиДефицита(Сценарий, Снимок, Периоды)

	ПроверитьТестовуюБазу();

	Если Снимок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ТЗДляЗаписи = Снимок.Скопировать();
	Шаблон = ТЗДляЗаписи[0];
	Для Каждого Период Из Периоды Цикл
		Строка = ТЗДляЗаписи.Добавить();
		Строка.Организация = Шаблон.Организация;
		Строка.Подразделение = Шаблон.Подразделение;
		Строка.СценарийПланирования = Сценарий;
		Строка.ПериодНачала = Период.ПериодНачала;
		Строка.ПериодОкончания = Период.ПериодОкончания;
		Строка.ВидРаботы = Шаблон.ВидРаботы;
		Строка.МодельТехники = Шаблон.МодельТехники;
		Строка.ВидТехники = Шаблон.ВидТехники;
		Строка.ИсточникОрганизации = Шаблон.ИсточникОрганизации;
		Строка.ИсточникПодразделения = Шаблон.ИсточникПодразделения;
		Строка.ПотребностьСмен = Шаблон.ПотребностьСмен;
		Строка.ДоступноСмен = Шаблон.ДоступноСмен;
		Строка.НехватаетПослеСвоихСмен = Шаблон.НехватаетПослеСвоихСмен;
		Строка.НехватаетСмен = Шаблон.НехватаетСмен;
		Строка.ДнейПериода = Шаблон.ДнейПериода;
		Строка.СменВДень = Шаблон.СменВДень;
		Строка.КоэффициентНеЗадан = Шаблон.КоэффициентНеЗадан;
		Строка.ПланТехресурсовОтсутствует = Шаблон.ПланТехресурсовОтсутствует;
		Строка.ПеремещеноСмен = Шаблон.ПеремещеноСмен;
	КонецЦикла;

	НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СценарийПланирования.Установить(Сценарий);
	НаборЗаписей.Загрузить(ТЗДляЗаписи);
	НаборЗаписей.Записать(Истина);

	Возврат Истина;

КонецФункции

// Проверяет наличие строк регистра Тх_ДефицитТехники сценария с точным
// периодом (утверждения периодных тестов SRV-01).
//
// Параметры:
//   Сценарий        - СправочникСсылка - сценарий планирования;
//   ПериодНачала    - Дата - начало периода строки;
//   ПериодОкончания - Дата - окончание периода строки.
//
// Возвращаемое значение:
//   Булево - есть ли хоть одна строка с этим периодом.
//
Функция ЕстьСтрокаДефицитаСПериодом(Сценарий, ПериодНачала, ПериодОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего
	|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
	|ГДЕ Д.СценарийПланирования = &Сценарий
	|	И Д.ПериодНачала = &ПериодНачала
	|	И Д.ПериодОкончания = &ПериодОкончания";
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	Запрос.УстановитьПараметр("ПериодНачала", ПериодНачала);
	Запрос.УстановитьПараметр("ПериодОкончания", ПериодОкончания);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Всего > 0;

КонецФункции

// Тест ВалидацииGenericТипов (design §4.1, п. 2, TD-001): ссылка
// «правильного» справочника проходит ВалидироватьТипАПК, другого - нет,
// пустая ссылка - Ложь.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестВалидацииGenericТипов() Экспорт

	Контекст = НовыйКонтекстТеста("ТестВалидацииGenericТипов");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	РаботаСоздана = Ложь;
	МодельСоздана = Ложь;
	Пропуск = "";

	Попытка
		Работа = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Если Работа = Неопределено Тогда
			Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
			РаботаСоздана = Работа <> Неопределено;
		КонецЕсли;
		Модель = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники));
		Если Модель = Неопределено Тогда
			Модель = СоздатьМодель(ВидТехники);
			МодельСоздана = Модель <> Неопределено;
		КонецЕсли;

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось подготовить тестовые данные (справочники АПК)'");
		Иначе
			Проверить(Контекст, НСтр("ru = 'ссылка правильного справочника = Истина'"),
				Тх_ТехникаСервер.ВалидироватьТипАПК(Работа,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));

			Проверить(Контекст, НСтр("ru = 'ссылка другого справочника = Ложь (модель как работа)'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Модель,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));

			Проверить(Контекст, НСтр("ru = 'ссылка другого справочника = Ложь (работа как модель)'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Работа,
					Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники)));

			ПустаяРабота = Справочники[Тх_ТехникаСервер.ИмяСправочникаРабот()].ПустаяСсылка();
			Проверить(Контекст, НСтр("ru = 'пустая ссылка = Ложь'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(ПустаяРабота,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если РаботаСоздана Тогда
		УдалитьСсылку(Работа);
	КонецЕсли;
	Если МодельСоздана Тогда
		УдалитьСсылку(Модель);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Возвращает первый сценарий планирования, по которому в регистрах
// годового плана АПК есть потребность (рантайм-запрос, design §4.1).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - сценарий с потребностью;
//   Неопределено - потребности нет или модуль АПК недоступен.
//
Функция СценарийСПотребностью()

	Результат = Неопределено;

	// Имена таблиц годового плана - динамические (runtime, design 4.1/TD-001).
	// 8.5: таблицы записей (виртуальная таблица оборотов требует измерения
	// в выборке, для проверки существования потребности она не нужна).
	ИмяРегистраМехРабот = "АпкМеханизированныеРаботыПоГодовомуПлану";
	ИмяРегистраТранРабот = "АпкТранспортныеРаботыПоГодовомуПлану";

	// Имена регистров подставляются динамически - анализатор не может
	// разобрать текст запроса (в рантайме запрос корректен).
	// BSLLS:QueryParseError-off
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.СценарийПланирования КАК СценарийПланирования
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			М.СценарийПланирования КАК СценарийПланирования
	|		ИЗ РегистрНакопления." + ИмяРегистраМехРабот + " КАК М
	|		ГДЕ М.СценарийПланирования <> ЗНАЧЕНИЕ(Справочник.АпкСценарииПланирования.ПустаяСсылка)
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Тран.СценарийПланирования
	|		ИЗ РегистрНакопления." + ИмяРегистраТранРабот + " КАК Тран
	|		ГДЕ Тран.СценарийПланирования <> ЗНАЧЕНИЕ(Справочник.АпкСценарииПланирования.ПустаяСсылка)
	|	) КАК Т";
	// BSLLS:QueryParseError-on

	Попытка
		Выборка = Тх_ТехникаСервер.ВыполнитьЗапросАПК(ТекстЗапроса).Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.СценарийПланирования;
		КонецЕсли;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает снимок строк регистра Тх_ДефицитТехники по сценарию
// (для восстановления после сквозных тестов).
//
// Параметры:
//   Сценарий - СправочникСсылка - сценарий планирования.
//
// Возвращаемое значение:
//   ТаблицаЗначений - выгрузка набора записей сценария.
//
Функция СнимокДефицита(Сценарий)

	НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СценарийПланирования.Установить(Сценарий);
	НаборЗаписей.Прочитать();

	Возврат НаборЗаписей.Выгрузить();

КонецФункции

// Восстанавливает строки регистра Тх_ДефицитТехники по сценарию из снимка.
//
// Параметры:
//   Сценарий  - СправочникСсылка - сценарий планирования;
//   Снимок    - ТаблицаЗначений - выгрузка СнимокДефицита.
//
Процедура ВосстановитьДефицит(Сценарий, Снимок)

	ПроверитьТестовуюБазу();

	Попытка
		НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СценарийПланирования.Установить(Сценарий);
		НаборЗаписей.Загрузить(Снимок);
		НаборЗаписей.Записать(Истина);
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Создаёт непроведённый документ-заглушку техкарты для использования
// регистратором строки регистра оборота годового плана (фикстура теста
// ТестПланТехресурсовОтсутствует_ПометкаНеНоль, решение Q-007/Ж1).
//
// Возвращаемое значение:
//   ДокументСсылка.АпкТехнологическиеКартыНаПоле, Неопределено -
//     ссылка созданного документа-регистратора. На 8.5 регистратор -
//     только документ с регистром в списке движений (у КартыНаПоле
//     АпкМеханизированныеРаботыПоГодовомуПлану объявлен; у КартыНаКультуру
//     список движений пуст - проба 2026-11-10).
//
Функция СоздатьРегистратораТехкарту()

	ПроверитьТестовуюБазу();

	Результат = Неопределено;

	Попытка
		Объект = Документы.АпкТехнологическиеКартыНаПоле.СоздатьДокумент();
		Объект.Дата = Дата(2014, 1, 1);
		Объект.Записать(РежимЗаписиДокумента.Запись);
		Результат = Объект.Ссылка;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	// Q-006/TEST-02: документ-регистратор - в реестр тестовых объектов.
	Если Результат <> Неопределено Тогда
		ЗарегистрироватьТестовыйОбъект(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пишет одну строку потребности в регистр оборота годового плана
// (АпкМеханизированныеРаботыПоГодовомуПлану): сценарий и подразделение
// тестовые, плана техресурсов по ним нет - расчёт обязан пометить строку
// флагом ПланТехресурсовОтсутствует и записать дефицит = потребность.
// Пробы 2026-11-10 (прогоны №3-№5, детали в поле Детали раннера):
// на 8.5.4 у набора записей РН нет свойства Активность (у записи - есть,
// новые записи активны по умолчанию), а запись набора с отбором
// по регистратору (Отбор.Регистратор.Установить/Значение) платформа
// отвергает («Не установлен отбор по регистратору»). Канон 8.5 -
// коллекция Движения документа-регистратора: набор привязан
// к регистратору самой коллекцией, запись - КоллекцияДвижений.Записать()
// с явным Записывать = Истина (по умолчанию набор из Движения.Найти()
// имеет Записывать = Ложь и коллекция его пропускает - проба 2026-11-10).
//
// Параметры:
//   Регистратор   - ДокументСсылка - техкарта-заглушка (регистратор записи);
//   Сценарий      - СправочникСсылка - тестовый сценарий планирования;
//   Подразделение - СправочникСсылка - тестовое подразделение без плана;
//   Организация   - СправочникСсылка - тестовая организация (измерение
//                   с запретом пустых значений);
//   ВидРаботы     - СправочникСсылка - тестовый вид работы (то же);
//   Модель        - СправочникСсылка - тестовая модель СХ техники (измерение
//                   Техника, то же);
//   Смен          - Число - потребность в сменах (по умолчанию 5).
//
Процедура ЗаписатьПотребностьБезПлана(Регистратор, Сценарий, Подразделение,
	Организация, ВидРаботы, Модель, Смен = 5)

	ПроверитьТестовуюБазу();

	ИмяРегистра = "АпкМеханизированныеРаботыПоГодовомуПлану";

	ОбъектДок = Регистратор.ПолучитьОбъект();
	Если ОбъектДок = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'документ-регистратор не найден (удалён?)'");
	КонецЕсли;

	НаборДвиж = ОбъектДок.Движения.Найти(ИмяРегистра);
	Если НаборДвиж = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'регистр %1 не входит в движения документа-регистратора'"),
			ИмяРегистра);
	КонецЕсли;

	НаборДвиж.Записывать = Истина;
	НаборДвиж.Очистить();
	ЗаполнитьСтрокуПотребности(НаборДвиж.Добавить(), Сценарий, Подразделение,
		Организация, ВидРаботы, Модель, Смен);
	ОбъектДок.Движения.Записать();

КонецПроцедуры

// Заполняет строку набора записей регистра оборота годового плана
// фикстурой теста ТестПланТехресурсовОтсутствует_ПометкаНеНоль.
//
// Параметры:
//   Запись        - РегистрНакопленияЗапись - заполняемая строка;
//   Сценарий      - СправочникСсылка - тестовый сценарий планирования;
//   Подразделение - СправочникСсылка - тестовое подразделение без плана;
//   Организация   - СправочникСсылка - тестовая организация;
//   ВидРаботы     - СправочникСсылка - тестовый вид работы;
//   Модель        - СправочникСсылка - тестовая модель СХ техники;
//   Смен          - Число - потребность в сменах (по умолчанию 5).
//
Процедура ЗаполнитьСтрокуПотребности(Запись, Сценарий, Подразделение,
	Организация, ВидРаботы, Модель, Смен = 5)

	Запись.Период = Дата(2014, 1, 1);
	Запись.СценарийПланирования = Сценарий;
	Запись.Организация = Организация;
	Запись.Подразделение = Подразделение;
	Запись.ВидРаботы = ВидРаботы;
	Запись.Техника = Модель;
	Запись.ПериодНачала = Дата(2014, 5, 1);
	Запись.ПериодОкончания = Дата(2014, 5, 10);
	Запись.Смен_Мин = Смен;
	Запись.Смен_Вер = Смен;
	Запись.Смен_Макс = Смен;

КонецПроцедуры

// Очистка фикстуры теста ТестПланТехресурсовОтсутствует_ПометкаНеНоль:
// удаляет строки дефицита тестового сценария (строка оборота удаляется
// вместе с документом-регистратором, остаток контролирует
// ОстатокПотребностиРегистратора). Возвращает текст ошибки ("" - успех);
// сбой очистки - видимый провал теста, а не запись журнала «Информация»
// (Q-006/К4а). Проба 2026-11-10 (прогон №4): на 8.5.4 запись пустого
// набора оборотов с отбором по регистратору отклоняется платформой
// («Не установлен отбор по регистратору»), поэтому удаление движений
// ведётся через удаление документа-регистратора.
//
// Параметры:
//   Сценарий - СправочникСсылка, Неопределено - тестовый сценарий.
//
// Возвращаемое значение:
//   Строка - текст ошибки восстановления ("" - успех).
//
Функция ВосстановитьДефицитПоСценарию(Сценарий)

	ПроверитьТестовуюБазу();

	Ошибки = "";

	Если Сценарий = Неопределено Тогда
		Возврат Ошибки;
	КонецЕсли;

	Попытка
		НаборДефицита = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
		НаборДефицита.Отбор.СценарийПланирования.Установить(Сценарий);
		НаборДефицита.Записать(Истина);
		// UI-01 (Q-008c): момент расчёта сценария чистится вместе со строками
		// дефицита - иначе в Тх_МоментРасчета остаётся запись на удаляемый
		// сценарий (висячая ссылка).
		Момент = РегистрыСведений.Тх_МоментРасчета.СоздатьНаборЗаписей();
		Момент.Отбор.СценарийПланирования.Установить(Сценарий);
		Момент.Записать(Истина);
	Исключение
		Ошибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Ошибки;

КонецФункции

// Контроль очистки фикстуры теста
// ТестПланТехресурсовОтсутствует_ПометкаНеНоль: после удаления
// документа-регистратора в регистре оборота годового плана не должно
// остаться строк по нему (движения удаляются платформой вместе
// с документом). Возвращает текст ошибки ("" - успех).
//
// Параметры:
//   Регистратор - ДокументСсылка, Неопределено - удалённая техкарта-заглушка.
//
// Возвращаемое значение:
//   Строка - "" - остатка нет; иначе описание остатка или ошибки.
//
Функция ОстатокПотребностиРегистратора(Регистратор)

	Если Регистратор = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Остаток
		|ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану
		|ГДЕ Регистратор = &Регистратор";
		Запрос.УстановитьПараметр("Регистратор", Регистратор);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Остаток > 0 Тогда
			Возврат СтрШаблон(НСтр("ru = 'осталось строк потребности по регистратору: %1'"),
				Выборка.Остаток) + "; ";
		КонецЕсли;
	Исключение
		Возврат ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "";

КонецФункции

// Возвращает выгрузку строк регистра Тх_ДефицитТехники по сценарию,
// упорядоченную по измерениям (для сравнения повторных расчётов).
//
// Параметры:
//   Сценарий - СправочникСсылка - сценарий планирования.
//
// Возвращаемое значение:
//   ТаблицаЗначений - все измерения и ресурсы регистра.
//
Функция ВыгрузкаДефицита(Сценарий)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Д.Организация КАК Организация,
	|	Д.Подразделение КАК Подразделение,
	|	Д.ПериодНачала КАК ПериодНачала,
	|	Д.ПериодОкончания КАК ПериодОкончания,
	|	Д.ВидРаботы КАК ВидРаботы,
	|	Д.МодельТехники КАК МодельТехники,
	|	Д.ВидТехники КАК ВидТехники,
	|	Д.ПотребностьСмен КАК ПотребностьСмен,
	|	Д.ДоступноСмен КАК ДоступноСмен,
	|	Д.НехватаетСмен КАК НехватаетСмен,
	|	Д.ДнейПериода КАК ДнейПериода,
	|	Д.СменВДень КАК СменВДень,
	|	Д.КоэффициентНеЗадан КАК КоэффициентНеЗадан,
	|	Д.ПланТехресурсовОтсутствует КАК ПланТехресурсовОтсутствует
	|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
	|ГДЕ Д.СценарийПланирования = &Сценарий
	|УПОРЯДОЧИТЬ ПО
	|	Д.Организация,
	|	Д.Подразделение,
	|	Д.ПериодНачала,
	|	Д.ПериодОкончания,
	|	Д.ВидРаботы,
	|	Д.МодельТехники,
	|	Д.ВидТехники,
	|	Д.ИсточникОрганизации,
	|	Д.ИсточникПодразделения";
	Запрос.УстановитьПараметр("Сценарий", Сценарий);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сравнивает две выгрузки регистра построчно и по колонкам.
//
// Параметры:
//   ТаблицаПервая  - ТаблицаЗначений - первая выгрузка;
//   ТаблицаВторая  - ТаблицаЗначений - вторая выгрузка.
//
// Возвращаемое значение:
//   Булево - Истина, если количество строк и все значения совпадают.
//
Функция ТаблицыИдентичны(ТаблицаПервая, ТаблицаВторая)

	Если ТаблицаПервая.Количество() <> ТаблицаВторая.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСтроки = 0 По ТаблицаПервая.Количество() - 1 Цикл
		Для Каждого Колонка Из ТаблицаПервая.Колонки Цикл
			Если ТаблицаПервая[НомерСтроки][Колонка.Имя]
				<> ТаблицаВторая[НомерСтроки][Колонка.Имя] Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции



// Тест доступности через замещение моделей (T6, FR-004/TD-004): потребность
// в оригинале (ширина 2), доступность - замена (ширина 3, К = 1.5):
// 1 машина на 10 дней по 1 смене = 10 смен замены -> эквивалент = 10 / 1.5.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестДоступноСменЧерезЗамещение() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступноСменЧерезЗамещение");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	МодельОригинал = Неопределено;
	МодельЗамены = Неопределено;
	Пропуск = "";

	Попытка
		МодельОригинал = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 2));
		МодельЗамены = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 3));

		Если МодельОригинал = Неопределено ИЛИ МодельЗамены = Неопределено Тогда
			Пропуск = НСтр("ru = 'нет каталогов моделей АПК'");
		Иначе
			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.Организация = "Тх_ТестОрг";
			СтрПотребности.Подразделение = "Тх_ТестПодр";
			СтрПотребности.ВидРаботы = Неопределено;
			СтрПотребности.МодельТехники = МодельОригинал;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			// Одна физическая машина замены, приписанная к строке спроса.
			Доступность = НоваяТаблицаДоступности();
			СтрМашины = Доступность.Добавить();
			СтрМашины.ТС = "Тх_ТС1";
			СтрМашины.МодельТехники = МодельЗамены;
			СтрМашины.ВидТехники = ВидТехники;
			СтрМашины.ОрганизацияПриписки = "Тх_ТестОрг";
			СтрМашины.ПодразделениеПриписки = "Тх_ТестПодр";

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			ИндексУровня1 = Тх_ТехникаСервер.ИндексПрипискиПоОргПодр(Доступность);
			РезультатСопоставления = Тх_ТехникаСервер.ДоступностьСтрокиДвумяУровнями(
				СтрПотребности, ИндексУровня1, Доступность, Дней, 1);

			Ожидаемо = 10 / 1.5;
			Отклонение = Макс(РезультатСопоставления.ДоступноУровень1 - Ожидаемо,
				Ожидаемо - РезультатСопоставления.ДоступноУровень1);
			Проверить(Контекст, НСтр("ru = 'доступность = смены_замены / К = 10 / 1,5'"),
				Отклонение < 0.0001, Строка(РезультатСопоставления.ДоступноУровень1));
			Проверить(Контекст, НСтр("ru = 'коэффициент задан - пометки нет'"),
				НЕ РезультатСопоставления.КоэффициентНеЗадан);
			Проверить(Контекст, НСтр("ru = 'машина своя - уровень 2 не нужен'"),
				РезультатСопоставления.ДоступноУровень2 = 0,
				Строка(РезультатСопоставления.ДоступноУровень2));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельОригинал);
	УдалитьСсылку(МодельЗамены);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест пометки при незаданном замещении (T6, FR-011): у модели замены нет
// реквизитов замещения - модель исключается из пересчёта доступности,
// выставляется КоэффициентНеЗадан (НЕ молчаливый 1,00).
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестДоступноСменЗамещениеНеЗадан() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступноСменЗамещениеНеЗадан");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	МодельОригинал = Неопределено;
	МодельПустая = Неопределено;
	Пропуск = "";

	Попытка
		МодельОригинал = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 2));
		МодельПустая = СоздатьЭлемент("АпкМоделиСХТехники");

		Если МодельОригинал = Неопределено ИЛИ МодельПустая = Неопределено Тогда
			Пропуск = НСтр("ru = 'нет каталогов моделей АПК'");
		Иначе
			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.Организация = "Тх_ТестОрг";
			СтрПотребности.Подразделение = "Тх_ТестПодр";
			СтрПотребности.ВидРаботы = Неопределено;
			СтрПотребности.МодельТехники = МодельОригинал;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			// Одна физическая машина без реквизитов замещения, приписанная
			// к строке спроса.
			Доступность = НоваяТаблицаДоступности();
			СтрМашины = Доступность.Добавить();
			СтрМашины.ТС = "Тх_ТС1";
			СтрМашины.МодельТехники = МодельПустая;
			СтрМашины.ВидТехники = ВидТехники;
			СтрМашины.ОрганизацияПриписки = "Тх_ТестОрг";
			СтрМашины.ПодразделениеПриписки = "Тх_ТестПодр";

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			ИндексУровня1 = Тх_ТехникаСервер.ИндексПрипискиПоОргПодр(Доступность);
			РезультатСопоставления = Тх_ТехникаСервер.ДоступностьСтрокиДвумяУровнями(
				СтрПотребности, ИндексУровня1, Доступность, Дней, 1);

			Проверить(Контекст, НСтр("ru = 'доступность = 0 (модель исключена)'"),
				РезультатСопоставления.ДоступноУровень1 = 0,
				Строка(РезультатСопоставления.ДоступноУровень1));
			Проверить(Контекст, НСтр("ru = 'пометка КоэффициентНеЗадан выставлена'"),
				РезультатСопоставления.КоэффициентНеЗадан);
			Проверить(Контекст, НСтр("ru = 'машина своя - в пул не попадает'"),
				РезультатСопоставления.ДоступноУровень2 = 0,
				Строка(РезультатСопоставления.ДоступноУровень2));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельОригинал);
	УдалитьСсылку(МодельПустая);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции
#КонецОбласти

#Область Тесты_ПотребностьПоТехкартам

// Тест запроса потребности по техкартам (T7, FR-003.1-2, TD-005/TD-006)
// на данных годового плана АПК («зависит от данных ИБ», SKIP при их
// отсутствии). Кросс-чек: сумма смен ПотребностьПоТехкартам должна
// совпадать с суммой релиза-001 ЗапросПотребности по тем же отборам.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестПотребностьПоТехкартам_ДемоДанные() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПотребностьПоТехкартам_ДемоДанные");
	Сценарий = СценарийСПотребностью();

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Попытка
		Параметры = Новый Структура;
		Параметры.Вставить("СценарийПланирования", Сценарий);

		Потребность = Тх_ТехникаСервер.ПотребностьПоТехкартам(Параметры).Выгрузить();

		Проверить(Контекст, НСтр("ru = 'строки потребности найдены'"),
			Потребность.Количество() > 0, Строка(Потребность.Количество()));

		ВсегоСмен = 0;
		СтрокБезСмен = 0;
		Для Каждого Стр Из Потребность Цикл
			ВсегоСмен = ВсегоСмен + Стр.ПотребностьСмен;
			Если Стр.ПотребностьСмен <= 0 Тогда
				СтрокБезСмен = СтрокБезСмен + 1;
			КонецЕсли;
		КонецЦикла;
		Проверить(Контекст, НСтр("ru = 'все строки с положительными сменами'"),
			СтрокБезСмен = 0, Строка(СтрокБезСмен));

		// Кросс-чек с релизом-001: те же регистры, тот же сценарий, те же
		// окна (по умолчанию), тот же суффикс _Вер - суммы обязаны совпасть.
		Эталон = Тх_ТехникаСервер.ЗапросПотребности(Параметры).Выгрузить();
		ВсегоСменЭталон = 0;
		Для Каждого Стр Из Эталон Цикл
			ВсегоСменЭталон = ВсегоСменЭталон + Стр.ПотребностьСмен;
		КонецЦикла;
		Отклонение = Макс(ВсегоСмен - ВсегоСменЭталон, ВсегоСменЭталон - ВсегоСмен);
		Проверить(Контекст, НСтр("ru = 'сумма смен = сумма ЗапросПотребности (кросс-чек)'"),
			Отклонение < 0.0001,
			Строка(ВсегоСмен) + " / " + Строка(ВсегоСменЭталон));
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест фильтра потребности по «чужому» подразделению (T7, design 6.1):
// отбор В ИЕРАРХИИ по подразделению без данных должен возвращать пустой
// результат.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестПотребностьПоТехкартам_ЧужоеПодразделение() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПотребностьПоТехкартам_ЧужоеПодразделение");
	Сценарий = СценарийСПотребностью();
	ЧужоеПодразделение = Неопределено;

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Попытка
		ЧужоеПодразделение = СоздатьЭлемент("СтруктураПредприятия");
		Если ЧужоеПодразделение = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'не удалось создать тестовое подразделение'"));
		Иначе
			Параметры = Новый Структура;
			Параметры.Вставить("СценарийПланирования", Сценарий);
			Параметры.Вставить("Подразделение", ЧужоеПодразделение);

			Потребность = Тх_ТехникаСервер.ПотребностьПоТехкартам(Параметры).Выгрузить();
			Проверить(Контекст, НСтр("ru = 'по чужому подразделению - пусто'"),
				Потребность.Количество() = 0, Строка(Потребность.Количество()));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(ЧужоеПодразделение);

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_ДоступностьМоделей

// Тест карты доступных моделей по документу АпкПланТехническихРесурсов
// (T8, design 6.2): создаёт проведённый план распределения с тестовыми
// ТС (va_prep_data, модель «Тх_Тест Базовая», АпкТипТС = СХТехника),
// приписанных подразделению записями регистра истории ТС
// (Исправно = Истина), и проверяет карту моделей подразделения;
// по «чужому» подразделению - флаг «нет исправных ТС».
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестДоступныеМодели_ПланРаспределения() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступныеМодели_ПланРаспределения");
	Сценарий = СценарийСПотребностью();

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст,
			НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Подразделение = Неопределено;
	ЧужоеПодразделение = Неопределено;

	Попытка
		// Тестовые ТС(va_prep_data): коды ТХТС*, модель «Тх_Тест Базовая».
		ТС = Новый Массив;
		ВыборкаТС = Тх_ТехникаСервер.ВыполнитьЗапросАПК(
			"ВЫБРАТЬ Спр.Ссылка КАК Ссылка
			|ИЗ Справочник.ТранспортныеСредства КАК Спр
			|ГДЕ Спр.Код ПОДОБНО &Шаблон И НЕ Спр.ПометкаУдаления",
			Новый Структура("Шаблон", "ТХТС%")).Выбрать();
		Пока ВыборкаТС.Следующий() Цикл
			ТС.Добавить(ВыборкаТС.Ссылка);
		КонецЦикла;

		Если ТС.Количество() = 0 Тогда
			СообщитьПропуск(Контекст,
				НСтр("ru = 'нет тестовых ТС (va_prep_data)'"));
		Иначе
			Организация = Неопределено;
			ВыборкаОрг = Тх_ТехникаСервер.ВыполнитьЗапросАПК(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Спр.Ссылка КАК Ссылка
				|ИЗ Справочник.Организации КАК Спр
				|ГДЕ НЕ Спр.ПометкаУдаления").Выбрать();
			Если ВыборкаОрг.Следующий() Тогда
				Организация = ВыборкаОрг.Ссылка;
			КонецЕсли;

			Подразделение = СоздатьЭлемент("СтруктураПредприятия");
			ЧужоеПодразделение = СоздатьЭлемент("СтруктураПредприятия");

			Если Подразделение = Неопределено Или ЧужоеПодразделение = Неопределено Тогда
				СообщитьПропуск(Контекст,
					НСтр("ru = 'не удалось создать тестовые подразделения'"));
			Иначе
				// Доступность - записи истории ТС (решение владельца
				// 10.11.2026): приписка тестовых ТС к организации и
				// подразделению отбора, Исправно = Истина.
				Для Каждого ТССылка Из ТС Цикл
					ЗаписатьПрипискуТС(ТССылка, Организация, Подразделение);
				КонецЦикла;

				// Карта по своему подразделению.
				Параметры = Новый Структура;
				Параметры.Вставить("СценарийПланирования", Сценарий);
				Если Организация <> Неопределено Тогда
					Параметры.Вставить("Организация", Организация);
				КонецЕсли;
				Параметры.Вставить("Подразделение", Подразделение);

				Результат = Тх_ТехникаСервер.ДоступныеМоделиПодразделения(Параметры);
				Проверить(Контекст, НСтр("ru = 'исправные ТС есть (флаг сброшен)'"),
					НЕ Результат.ПланОтсутствует);
				Проверить(Контекст, НСтр("ru = 'карта: одна модель (Тх_Тест Базовая)'"),
					Результат.Модели.Количество() = 1,
					Строка(Результат.Модели.Количество()));
				Если Результат.Модели.Количество() = 1 Тогда
					Стр = Результат.Модели[0];
					Проверить(Контекст, НСтр("ru = 'единиц = число тестовых ТС'"),
						Стр.ЕдиницДоступно = ТС.Количество(),
						Строка(Стр.ЕдиницДоступно) + " / " + Строка(ТС.Количество()));
					Проверить(Контекст, НСтр("ru = 'тип ТС = СХТехника (реквизит АпкТипТС)'"),
						Стр.ТипТС = Перечисления.АпкТипыТС.СХТехника);
					МодельБазовая = Неопределено;
					ВыборкаМод = Тх_ТехникаСервер.ВыполнитьЗапросАПК(
						"ВЫБРАТЬ ПЕРВЫЕ 1 Спр.Ссылка КАК Ссылка
						|ИЗ Справочник.АпкМоделиСХТехники КАК Спр
						|ГДЕ Спр.Наименование = &Наименование И НЕ Спр.ПометкаУдаления",
						Новый Структура("Наименование", "Тх_Тест Базовая")).Выбрать();
					Если ВыборкаМод.Следующий() Тогда
						МодельБазовая = ВыборкаМод.Ссылка;
					КонецЕсли;
					Проверить(Контекст, НСтр("ru = 'модель = Тх_Тест Базовая'"),
						Стр.МодельТехники = МодельБазовая);
				КонецЕсли;

				// Чужое подразделение: план не найден, карта пуста.
				ПараметрыЧужие = Новый Структура;
				ПараметрыЧужие.Вставить("СценарийПланирования", Сценарий);
				ПараметрыЧужие.Вставить("Подразделение", ЧужоеПодразделение);
				РезультатЧужой = Тх_ТехникаСервер
					.ДоступныеМоделиПодразделения(ПараметрыЧужие);
				Проверить(Контекст, НСтр("ru = 'чужое подразделение: флаг отсутствия ТС'"),
					РезультатЧужой.ПланОтсутствует);
				Проверить(Контекст, НСтр("ru = 'чужое подразделение: карта пуста'"),
					РезультатЧужой.Модели.Количество() = 0,
					Строка(РезультатЧужой.Модели.Количество()));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	// Очистка: приписки тестовых ТС (записей по ТХТС* в регистре
	// истории быть не должно, Q-006/К4а) и тестовые подразделения;
	// сбой очистки - видимый провал теста.
	ОшибкаОчистки = "";
	ВыборкаОчистки = Тх_ТехникаСервер.ВыполнитьЗапросАПК(
		"ВЫБРАТЬ Спр.Ссылка КАК Ссылка
		|ИЗ Справочник.ТранспортныеСредства КАК Спр
		|ГДЕ Спр.Код ПОДОБНО &Шаблон И НЕ Спр.ПометкаУдаления",
		Новый Структура("Шаблон", "ТХТС%")).Выбрать();
	Пока ВыборкаОчистки.Следующий() Цикл
		ОшибкаОчистки = ОшибкаОчистки + УдалитьПрипискуТС(ВыборкаОчистки.Ссылка);
	КонецЦикла;
	Если ОшибкаОчистки <> "" Тогда
		Проверить(Контекст, НСтр("ru = 'восстановление данных после теста'"),
			Ложь, ОшибкаОчистки);
	КонецЕсли;
	УдалитьСсылку(Подразделение);
	УдалитьСсылку(ЧужоеПодразделение);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест флага «план распределения отсутствует» (T8, design 6.2):
// в срезе истории ТС нет ни одной записи (дата среза 31.12.1999 -
// раньше всех демо-записей регистра с 2000-01-01) - карта пуста,
// флаг установлен (новая семантика: «нет исправных ТС в срезе»);
// контракт карты - три колонки.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестДоступныеМодели_БезПлана() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступныеМодели_БезПлана");
	Сценарий = СоздатьЭлемент("АпкСценарииПланирования");

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст,
			НСтр("ru = 'не удалось создать тестовый сценарий'"));
	Иначе
		Попытка
			// Дата среза 31.12.1999: срез пуст, карта пуста, флаг установлен.
			Параметры = Новый Структура("СценарийПланирования, ДатаНачала",
				Сценарий, Дата(1999, 12, 31));
			Результат = Тх_ТехникаСервер.ДоступныеМоделиПодразделения(Параметры);
			Проверить(Контекст, НСтр("ru = 'флаг: план распределения отсутствует'"),
				Результат.ПланОтсутствует);
			Проверить(Контекст, НСтр("ru = 'карта моделей пуста'"),
				Результат.Модели.Количество() = 0,
				Строка(Результат.Модели.Количество()));
			Проверить(Контекст,
				НСтр("ru = 'колонки карты: МодельТехники/ТипТС/ЕдиницДоступно'"),
				Результат.Модели.Колонки.Количество() = 3,
				Строка(Результат.Модели.Колонки.Количество()));
		Исключение
			Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
				ОписаниеОшибки());
		КонецПопытки;

		УдалитьСсылку(Сценарий);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_ЗаполнитьПланаРабот

// Тест заполнения документа плана работ на демо-данных годового плана АПК
// (T9, design 6.3, SRV-02 §6): полный прогон ЗаполнитьПланРабот по
// сценарию с потребностью; сводка и детализация строк - в Сводке
// (СтрокиПлана), машинные ТЧ документа получают физические ТС.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестЗаполнитьПланРабот_ДемоДанные() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЗаполнитьПланРабот_ДемоДанные");
	Сценарий = СценарийСПотребностью();

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст,
			НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Попытка
		Параметры = Новый Структура;
		Параметры.Вставить("СценарийПланирования", Сценарий);
		Параметры.Вставить("ДнейПериода", 10);
		Параметры.Вставить("СменВдень", 1);

		// Документ только в памяти: запись в БД не выполняется.
		ДокументОбъект = Документы.АпкПланТехническихРесурсов.СоздатьДокумент();
		Результат = Тх_ТехникаСервер.ЗаполнитьПланРабот(ДокументОбъект, Параметры);

		Проверить(Контекст, НСтр("ru = 'строки потребности обработаны'"),
			Результат.КоличествоСтрок > 0, Строка(Результат.КоличествоСтрок));
		Проверить(Контекст, НСтр("ru = 'детализация: строка сводки на строку спроса'"),
			Результат.СтрокиПлана.Количество() = Результат.КоличествоСтрок,
			Строка(Результат.СтрокиПлана.Количество()));
		Проверить(Контекст, НСтр("ru = 'шапка: сценарий'"),
			ДокументОбъект.СценарийПланирования = Сценарий);

		ЕдиницПлан = 0;
		Для Каждого Стр Из Результат.СтрокиПлана Цикл
			ЕдиницПлан = ЕдиницПлан + Стр.Единиц;
			Проверить(Контекст, НСтр("ru = 'модель строки детализации заполнена'"),
				ЗначениеЗаполнено(Стр.МодельТехники));
			Проверить(Контекст, НСтр("ru = 'машин взято неотрицательно'"),
				Стр.Единиц >= 0, Строка(Стр.Единиц));
		КонецЦикла;

		// Машинные ТЧ документа: физические ТС, каждая машина -
		// один раз на документ (SRV-02 §6).
		ЕдиницВДокументе = 0;
		ЗанятыеТС = Новый Соответствие;
		Для Каждого Стр Из ДокументОбъект.Техника Цикл
			ЕдиницВДокументе = ЕдиницВДокументе + 1;
			Проверить(Контекст, НСтр("ru = 'ТС строки ТЧ Техника заполнено'"),
				ЗначениеЗаполнено(Стр.ТранспортноеСредство));
			Проверить(Контекст, НСтр("ru = 'физическая ТС назначена один раз'"),
				ЗанятыеТС.Получить(Стр.ТранспортноеСредство) = Неопределено);
			ЗанятыеТС.Вставить(Стр.ТранспортноеСредство, Истина);
		КонецЦикла;
		Для Каждого Стр Из ДокументОбъект.Оборудование Цикл
			ЕдиницВДокументе = ЕдиницВДокументе + 1;
			Проверить(Контекст, НСтр("ru = 'ТС строки ТЧ Оборудование заполнено'"),
				ЗначениеЗаполнено(Стр.ТранспортноеСредство));
			Проверить(Контекст, НСтр("ru = 'физическая ТС назначена один раз'"),
				ЗанятыеТС.Получить(Стр.ТранспортноеСредство) = Неопределено);
			ЗанятыеТС.Вставить(Стр.ТранспортноеСредство, Истина);
		КонецЦикла;

		Для Каждого Стр Из ДокументОбъект.Автотранспорт Цикл
			ЕдиницВДокументе = ЕдиницВДокументе + 1;
			Проверить(Контекст, НСтр("ru = 'ТС строки ТЧ Автотранспорт заполнено'"),
				ЗначениеЗаполнено(Стр.ТранспортноеСредство));
			Проверить(Контекст, НСтр("ru = 'физическая ТС назначена один раз'"),
				ЗанятыеТС.Получить(Стр.ТранспортноеСредство) = Неопределено);
			ЗанятыеТС.Вставить(Стр.ТранспортноеСредство, Истина);
		КонецЦикла;
		Для Каждого Стр Из ДокументОбъект.Прицепы Цикл
			ЕдиницВДокументе = ЕдиницВДокументе + 1;
			Проверить(Контекст, НСтр("ru = 'ТС строки ТЧ Прицепы заполнено'"),
				ЗначениеЗаполнено(Стр.ТранспортноеСредство));
			Проверить(Контекст, НСтр("ru = 'физическая ТС назначена один раз'"),
				ЗанятыеТС.Получить(Стр.ТранспортноеСредство) = Неопределено);
			ЗанятыеТС.Вставить(Стр.ТранспортноеСредство, Истина);
		КонецЦикла;
		Проверить(Контекст, НСтр("ru = 'машин в ТЧ документа = машин в детализации'"),
			ЕдиницВДокументе = ЕдиницПлан,
			Строка(ЕдиницВДокументе) + " / " + Строка(ЕдиницПлан));
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест сценария пользователя «замещение по ширине 1,5x» (T9, design 6.4,
// Acceptance, SRV-02 §6): потребность 10 смен по модели шириной 2,
// доступна только модель шириной 3 -> замещение с К=1,5, смены 10/1,5;
// вторая строка (кандидат есть, но все реквизиты пусты -> К не задан) ->
// дефицит с пометкой «коэффициент замещения не задан» (design 9); третья
// строка (автотранспорт - кандидатов нет вовсе) -> дефицит без пометки.
// Инварианты - в Сводке (СтрокиПлана) и машинных ТЧ документа.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестЗаполнитьТЧ_ЗамещениеПоШирине() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЗаполнитьТЧ_ЗамещениеПоШирине");

	Оригинал = СоздатьЭлемент("АпкМоделиСХТехники", Новый Структура("ШиринаОбработки", 2));
	Замена = СоздатьЭлемент("АпкМоделиСХТехники", Новый Структура("ШиринаОбработки", 3));
	БезКоэффициента = СоздатьЭлемент("АпкМоделиСХТехники");
	АвтоМодель = СоздатьЭлемент("АпкМоделиАвтотранспорта");
	ТСЗамены1 = СоздатьЭлемент("ТранспортныеСредства",
		Новый Структура("Код, АпкМодель", УникальноеИмя(), Замена));
	ТСЗамены2 = СоздатьЭлемент("ТранспортныеСредства",
		Новый Структура("Код, АпкМодель", УникальноеИмя(), Замена));

	Если Оригинал = Неопределено Или Замена = Неопределено Или БезКоэффициента = Неопределено
			Или АвтоМодель = Неопределено Или ТСЗамены1 = Неопределено
			Или ТСЗамены2 = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'не удалось создать тестовые модели и ТС'"));
	Иначе
		Попытка
			Потребность = НоваяПотребностьТ7();
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
			Стр.МодельТехники = Оригинал;
			Стр.ПотребностьСмен = 10;
			Стр.ПотребностьЧасов = 80;
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
			Стр.МодельТехники = БезКоэффициента;
			Стр.ПотребностьСмен = 5;
			Стр.ПотребностьЧасов = 40;
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт;
			Стр.МодельТехники = АвтоМодель;
			Стр.ПотребностьСмен = 3;
			Стр.ПотребностьЧасов = 24;

			// Карта доступности: модель замены с двумя физическими ТС
			// (кандидат без коэффициента в карту не входит).
			Модели = НоваяКартаДоступностиТ8();
			СтрК = Модели.Добавить();
			СтрК.МодельТехники = Замена;
			СтрК.ТипТС = Перечисления.АпкТипыТС.СХТехника;
			СтрК.ЕдиницДоступно = 4;
			МашиныЗамены = Новый Массив;
			МашиныЗамены.Добавить(ТСЗамены1);
			МашиныЗамены.Добавить(ТСЗамены2);
			ТСПоМоделям = Новый Соответствие;
			ТСПоМоделям.Вставить(Замена, МашиныЗамены);
			Доступность = Новый Структура("Модели, ТСПоМоделям, ПланОтсутствует",
				Модели, ТСПоМоделям, Ложь);

			ДокументОбъект = Документы.АпкПланТехническихРесурсов.СоздатьДокумент();
			Результат = Тх_ТехникаСервер.ЗаполнитьТЧПланаРабот(
				ДокументОбъект, Потребность, Доступность, 10, 1);

			Проверить(Контекст, НСтр("ru = 'строк: 3'"),
				Результат.КоличествоСтрок = 3, Строка(Результат.КоличествоСтрок));
			Проверить(Контекст, НСтр("ru = 'замещённых: 1'"),
				Результат.ЗамещенныхСтрок = 1, Строка(Результат.ЗамещенныхСтрок));
			Проверить(Контекст, НСтр("ru = 'дефицитных: 2'"),
				Результат.ДефицитныхСтрок = 2, Строка(Результат.ДефицитныхСтрок));

			// Замещённой строке нужна 1 машина (6,67 смены / 10 дней) -
			// в ТЧ Техника попадает первая физическая машина замены;
			// строкам без машин ТЧ остаются пустыми (дефицит).
			Проверить(Контекст, НСтр("ru = 'ТЧ Техника: 1 строка (ТС замены)'"),
				ДокументОбъект.Техника.Количество() = 1,
				Строка(ДокументОбъект.Техника.Количество()));
			Проверить(Контекст, НСтр("ru = 'ТЧ Автотранспорт: машин нет'"),
				ДокументОбъект.Автотранспорт.Количество() = 0,
				Строка(ДокументОбъект.Автотранспорт.Количество()));
			Если ДокументОбъект.Техника.Количество() = 1 Тогда
				Проверить(Контекст, НСтр("ru = 'взята первая незанятая машина замены'"),
					ДокументОбъект.Техника[0].ТранспортноеСредство = ТСЗамены1);
			КонецЕсли;

			// Детализация строк: замещение 10/1,5, дефицит с пометкой,
			// авто - дефицит без пометки.
			СтрокаЗамены = Неопределено;
			СтрокаДефицита = Неопределено;
			СтрокаАвто = Неопределено;
			Для Каждого СтрПлана Из Результат.СтрокиПлана Цикл
				Если СтрПлана.МодельТехники = Замена Тогда
					СтрокаЗамены = СтрПлана;
				КонецЕсли;
				Если СтрПлана.МодельТехники = БезКоэффициента Тогда
					СтрокаДефицита = СтрПлана;
				КонецЕсли;
				Если СтрПлана.МодельТехники = АвтоМодель Тогда
					СтрокаАвто = СтрПлана;
				КонецЕсли;
			КонецЦикла;

			Если СтрокаЗамены = Неопределено Или СтрокаДефицита = Неопределено
					Или СтрокаАвто = Неопределено Тогда
				Проверить(Контекст, НСтр("ru = 'строки найдены по моделям'"), Ложь);
			Иначе
				// 10 / 1,5 = 6,(6): границы без глобальных функций.
				Проверить(Контекст, НСтр("ru = 'замещённая: смены 10/1,5'"),
					СтрокаЗамены.ПотребностьСмен < 6.67
						И СтрокаЗамены.ПотребностьСмен > 6.66,
					Строка(СтрокаЗамены.ПотребностьСмен));
				Проверить(Контекст, НСтр("ru = 'замещённая: флаг Замещение'"),
					СтрокаЗамены.Замещение);
				Проверить(Контекст, НСтр("ru = 'замещённая: 1 машина'"),
					СтрокаЗамены.Единиц = 1, Строка(СтрокаЗамены.Единиц));
				Проверить(Контекст, НСтр("ru = 'комментарий: замещение с К'"),
					СтрНайти(СтрокаЗамены.Комментарий, "замещение:") > 0
						И СтрНайти(СтрокаЗамены.Комментарий, "К=1,5") > 0,
					СтрокаЗамены.Комментарий);
				// design 9: кандидат есть, но К не задан -> пометка.
				Проверить(Контекст, НСтр("ru = 'дефицитная: машин нет'"),
					СтрокаДефицита.Единиц = 0, Строка(СтрокаДефицита.Единиц));
				Проверить(Контекст, НСтр("ru = 'дефицитная: пометка К не задан'"),
					СтрокаДефицита.Комментарий
						= НСтр("ru = 'коэффициент замещения не задан'"),
					СтрокаДефицита.Комментарий);
				// Кандидатов нет вовсе -> дефицит без пометки.
				Проверить(Контекст, НСтр("ru = 'авто: машин нет'"),
					СтрокаАвто.Единиц = 0, Строка(СтрокаАвто.Единиц));
				Проверить(Контекст, НСтр("ru = 'авто: без комментария'"),
					СтрокаАвто.Комментарий = "", СтрокаАвто.Комментарий);
			КонецЕсли;
		Исключение
			Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	УдалитьСсылку(Оригинал);
	УдалитьСсылку(Замена);
	УдалитьСсылку(БезКоэффициента);
	УдалитьСсылку(АвтоМодель);
	УдалитьСсылку(ТСЗамены1);
	УдалитьСсылку(ТСЗамены2);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест движка без замещения (T9, design 6.3, SRV-02 §6): своя модель
// доступна - строка не меняется, машин = округление вверх(смен/(дней x
// смен в день)); физические ТС модели попадают в ТЧ Техника документа.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
Функция ТестЗаполнитьТЧ_СвояМодельДоступна() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЗаполнитьТЧ_СвояМодельДоступна");

	Модель = СоздатьЭлемент("АпкМоделиСХТехники", Новый Структура("ШиринаОбработки", 2));
	ТС1 = СоздатьЭлемент("ТранспортныеСредства",
		Новый Структура("Код, АпкМодель", УникальноеИмя(), Модель));
	ТС2 = СоздатьЭлемент("ТранспортныеСредства",
		Новый Структура("Код, АпкМодель", УникальноеИмя(), Модель));

	Если Модель = Неопределено Или ТС1 = Неопределено Или ТС2 = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'не удалось создать тестовую модель и ТС'"));
	Иначе
		Попытка
			Потребность = НоваяПотребностьТ7();
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
			Стр.МодельТехники = Модель;
			Стр.ПотребностьСмен = 25;
			Стр.ПотребностьЧасов = 200;

			Модели = НоваяКартаДоступностиТ8();
			СтрК = Модели.Добавить();
			СтрК.МодельТехники = Модель;
			СтрК.ТипТС = Перечисления.АпкТипыТС.СХТехника;
			СтрК.ЕдиницДоступно = 3;
			Машины = Новый Массив;
			Машины.Добавить(ТС1);
			Машины.Добавить(ТС2);
			ТСПоМоделям = Новый Соответствие;
			ТСПоМоделям.Вставить(Модель, Машины);
			Доступность = Новый Структура("Модели, ТСПоМоделям, ПланОтсутствует",
				Модели, ТСПоМоделям, Ложь);

			ДокументОбъект = Документы.АпкПланТехническихРесурсов.СоздатьДокумент();
			Результат = Тх_ТехникаСервер.ЗаполнитьТЧПланаРабот(
				ДокументОбъект, Потребность, Доступность, 10, 2);

			Проверить(Контекст, НСтр("ru = 'строк: 1'"),
				Результат.КоличествоСтрок = 1, Строка(Результат.КоличествоСтрок));
			Проверить(Контекст, НСтр("ru = 'замещений нет'"),
				Результат.ЗамещенныхСтрок = 0 И Результат.ДефицитныхСтрок = 0);

			// округление вверх(25 / (10 x 2)): 1,25 -> 2 машины.
			СтрокаПлана = Результат.СтрокиПлана[0];
			Проверить(Контекст, НСтр("ru = 'модель не менялась'"),
				СтрокаПлана.МодельТехники = Модель);
			Проверить(Контекст, НСтр("ru = 'машин: 2'"),
				СтрокаПлана.Единиц = 2, Строка(СтрокаПлана.Единиц));
			Проверить(Контекст, НСтр("ru = 'без замещения'"),
				НЕ СтрокаПлана.Замещение);
			Проверить(Контекст, НСтр("ru = 'комментарий пуст'"),
				СтрокаПлана.Комментарий = "", СтрокаПлана.Комментарий);

			// Обе физические машины своей модели - в ТЧ Техника документа.
			Проверить(Контекст, НСтр("ru = 'ТЧ Техника: 2 строки'"),
				ДокументОбъект.Техника.Количество() = 2,
				Строка(ДокументОбъект.Техника.Количество()));
			ЗанятыеТС = Новый Соответствие;
			Для Каждого СтрДок Из ДокументОбъект.Техника Цикл
				Проверить(Контекст, НСтр("ru = 'взята ТС своей модели'"),
					СтрДок.ТранспортноеСредство = ТС1
						Или СтрДок.ТранспортноеСредство = ТС2);
				Проверить(Контекст, НСтр("ru = 'физическая ТС назначена один раз'"),
					ЗанятыеТС.Получить(СтрДок.ТранспортноеСредство) = Неопределено);
				ЗанятыеТС.Вставить(СтрДок.ТранспортноеСредство, Истина);
			КонецЦикла;
		Исключение
			Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	УдалитьСсылку(Модель);
	УдалитьСсылку(ТС1);
	УдалитьСсылку(ТС2);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Строит пустую таблицу потребности в формате ПотребностьПоТехкартам (T7).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: ВидТехники, ВидРаботы, МодельТехники,
//     Оборудование, ПотребностьСмен, ПотребностьЧасов.
//
Функция НоваяПотребностьТ7()

	Потребность = Новый ТаблицаЗначений;
	Потребность.Колонки.Добавить("ВидТехники");
	Потребность.Колонки.Добавить("ВидРаботы");
	Потребность.Колонки.Добавить("МодельТехники");
	Потребность.Колонки.Добавить("Оборудование");
	Потребность.Колонки.Добавить("ПотребностьСмен");
	Потребность.Колонки.Добавить("ПотребностьЧасов");

	Возврат Потребность;

КонецФункции


# language: ru
# Сценарий 2 из 8 (design §11 «Сценарные Vanessa»), обновлён в T6.
# Автозаполнение по мощности удалено вместе с регистром (FR-005):
# мощность двигателя остаётся резервным реквизитом замещения (TD-003,
# design §6.4): К = Мощность(замены)/Мощность(оригинала), когда
# ручные реквизиты (ширина и пр.) не заданы.
# Покрывает: замещение по мощности (100 -> 150 л.с. => К = 1,5) и отказ
# замещения между каталогами разных видов техники (Неопределено).
# Серверный сценарий: без UI (объекты регистра не существуют).

Функционал: Замещение моделей по мощности двигателя

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	# Очистка тест-данных сценария (идемпотентность повторных прогонов)
	Дано я выполняю код встроенного языка на сервере
	|Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.АпкМоделиСХТехники ГДЕ Наименование ПОДОБНО &Шаблон");|
	|Запрос.УстановитьПараметр("Шаблон", "%Тх_VA Мощность%");|
	|Выборка = Запрос.Выполнить().Выбрать();|
	|Пока Выборка.Следующий() Цикл Выборка.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|
	|Запрос2 = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.АпкМоделиПрицепов ГДЕ Наименование ПОДОБНО &Шаблон");|
	|Запрос2.УстановитьПараметр("Шаблон", "%Тх_VA Мощность%");|
	|Выборка2 = Запрос2.Выполнить().Выбрать();|
	|Пока Выборка2.Следующий() Цикл Выборка2.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|

Сценарий: Замещение по мощности - К = 1,5
	Когда я выполняю код встроенного языка на сервере
	|Оригинал = Справочники.АпкМоделиСХТехники.СоздатьЭлемент();|
	|Оригинал.Наименование = "Тх_VA Мощность Оригинал";|
	|Оригинал.МощностьДвигателя = 100;|
	|Оригинал.Записать();|
	|Замена = Справочники.АпкМоделиСХТехники.СоздатьЭлемент();|
	|Замена.Наименование = "Тх_VA Мощность Аналог";|
	|Замена.МощностьДвигателя = 150;|
	|Замена.Записать();|
	# TD-003: ручные реквизиты не заданы - старт по мощности, К = 150/100 = 1,5
	|К = Тх_ТехникаСервер.КоэффициентЗамещения(Оригинал.Ссылка, Замена.Ссылка);|
	|Если К = Неопределено Тогда ВызватьИсключение "К должен быть задан по мощности"; КонецЕсли;|
	|Если К > 1.501 Или К < 1.499 Тогда ВызватьИсключение "ожидался К = 1,5, получен " + Строка(К); КонецЕсли;|
	# Разные каталоги (виды техники): замещение не определено
	|Прицеп = Справочники.АпкМоделиПрицепов.СоздатьЭлемент();|
	|Прицеп.Наименование = "Тх_VA Мощность Прицеп";|
	|Прицеп.Записать();|
	|КПрицеп = Тх_ТехникаСервер.КоэффициентЗамещения(Оригинал.Ссылка, Прицеп.Ссылка);|
	|Если КПрицеп <> Неопределено Тогда ВызватьИсключение "ожидалось Неопределено между каталогами"; КонецЕсли;|
	# Очистка
	|Оригинал.Удалить();|
	|Замена.Удалить();|
	|Прицеп.Удалить();|

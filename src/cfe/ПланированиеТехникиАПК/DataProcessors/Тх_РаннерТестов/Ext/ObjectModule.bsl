// Модуль объекта обработки «Тх_РаннерТестов» (design §11, задача A11).
//
// Точка входа запуска модульных тестов общего модуля Тх_Тесты:
//  - из формы обработки (кнопка «Выполнить тесты»);
//  - headless: COM (V83.COMConnector:
//    Обработки.Тх_РаннерТестов.Создать().ВыполнитьТесты()) или /Execute.
//
// Тесты вызываются явно, поимённо (без Вычислить/Выполнить - они могут быть
// запрещены безопасным режимом расширения); упавший с исключением тест
// помечается провалом и не прерывает прогон остальных.

#Область СлужебныеПроцедурыИФункции

// Последовательно выполняет все 13 тестов модуля Тх_Тесты и возвращает
// результаты прогона.
//
// Возвращаемое значение:
//   Массив - элементы Структура:
//     * Имя            - Строка - имя теста;
//     * Прошёл         - Булево - результат (Истина для SKIP-пропусков);
//     * ДлительностьМс - Число - длительность выполнения, миллисекунды.
//
Функция ВыполнитьТесты() Экспорт

	Результаты = Новый Массив;

	ЗапуститьТестЧислоДнейПериода(Результаты);
	ЗапуститьТестНеПринятыеТСИсключены(Результаты);
	ЗапуститьТестДефицитМаксНуля(Результаты);
	ЗапуститьТестПланТехресурсовОтсутствуетПометкаНеНоль(Результаты);
	ЗапуститьТестДетерминированностьПовторногоРасчета(Результаты);
	ЗапуститьТестВалидацииGenericТипов(Результаты);
	ЗапуститьТестДоступноСменЧерезЗамещение(Результаты);
	ЗапуститьТестДоступноСменЗамещениеНеЗадан(Результаты);
	ЗапуститьТестВалидацииСцепки(Результаты);
	ЗапуститьТестКоэффициентЗамещенияПриоритетРучного(Результаты);
	ЗапуститьТестКоэффициентЗамещенияПоШирине(Результаты);
	ЗапуститьТестКоэффициентЗамещенияСтартИПроч(Результаты);
	ЗапуститьТестКоэффициентЗамещенияНеЗадан(Результаты);

	Возврат Результаты;

КонецФункции

// Фиксирует результат одного теста с длительностью выполнения.
//
// Параметры:
//   Результаты  - Массив - накапливаемые результаты прогона;
//   ИмяТеста    - Строка - имя теста;
//   Прошёл      - Булево - результат теста;
//   НачалоТеста - Число - момент старта теста (универсальное время, мс).
//
Процедура ЗафиксироватьРезультат(Результаты, ИмяТеста, Прошёл, НачалоТеста)

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоТеста;
	Результаты.Добавить(Новый Структура("Имя, Прошёл, ДлительностьМс",
		ИмяТеста, Прошёл, Длительность));

КонецПроцедуры

// Выводит сообщение об исключении теста (тест не прерывает прогон).
//
// Параметры:
//   ИмяТеста - Строка - имя теста;
//   ТекстОшибки - Строка - описание исключения.
//
Процедура СообщитьОбИсключенииТеста(ИмяТеста, ТекстОшибки)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(НСтр("ru = 'Тест %1 упал с исключением: %2'"),
		ИмяТеста, ТекстОшибки);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область ВызовТестов

// Обёртка вызова теста ТестЧислоДнейПериода.
//
Процедура ЗапуститьТестЧислоДнейПериода(Результаты)

	ИмяТеста = "ТестЧислоДнейПериода";
	НачалоТеста = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Прошёл = Ложь;
	Попытка
		Прошёл = Тх_Тесты.ТестЧислоДнейПериода();
	Исключение
		Прошёл = Ложь;
		СообщитьОбИсключенииТеста(ИмяТеста, ОписаниеОшибки());
	КонецПопытки;
	ЗафиксироватьРезультат(Результаты, ИмяТеста, Прошёл, НачалоТеста);

КонецПроцедуры










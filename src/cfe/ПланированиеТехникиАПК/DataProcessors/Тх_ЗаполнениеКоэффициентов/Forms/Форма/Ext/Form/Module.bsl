// Форма обработки «Тх_ЗаполнениеКоэффициентов» (design §4.6):
// параметры автозаполнения коэффициентов пересчёта работ по мощности
// двигателя и запуск серверной процедуры Тх_ТехникаСервер.АвтозаполнениеПоМощности.
//
// Формы выбора типовых справочников открываются по строковым именам (FAQ Q8,
// TD-001), сообщения пользователю - немодальные (NFR-001).

&НаКлиенте
Процедура РаботаНачалоВыбора(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник." + ИмяСправочникаРабот() + ".ФормаВыбора", , Элемент);

КонецПроцедуры

&НаКлиенте
Процедура БазоваяМодельНачалоВыбора(Элемент, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(ВидТехники) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала укажите вид техники.'"));
		Возврат;
	КонецЕсли;

	ИмяСправочника = ИмяСправочникаМоделей(ВидТехники);
	Если ИмяСправочника = "" Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Для выбранного вида техники каталог моделей не определён.'"));
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник." + ИмяСправочника + ".ФормаВыбора", , Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоМощностиОбработка(Команда)

	Если НЕ ПроверитьЗаполнениеПолей() Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьПоМощностиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоМощностиНаСервере()

	// Серверная логика и повторная валидация - в Тх_ТехникаСервер (design §4.6).
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Работа", Работа);
	ПараметрыЗаполнения.Вставить("ВидТехники", ВидТехники);
	ПараметрыЗаполнения.Вставить("Период", Период);
	ПараметрыЗаполнения.Вставить("БазоваяМодель", БазоваяМодель);

	Тх_ТехникаСервер.АвтозаполнениеПоМощности(ПараметрыЗаполнения);

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПолей()

	Если НЕ ЗначениеЗаполнено(Работа) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите работу.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ВидТехники) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите вид техники.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Период) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите период «действует с».'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(БазоваяМодель) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите базовую модель.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Локальные константы имён (design §4.1, п. 3): канонические значения хранит
// общий модуль Тх_ТехникаСервер; в клиентском модуле формы продублированы
// для открытия форм выбора по строковым именам (серверный модуль с клиента
// недоступен, FAQ Q8).

&НаКлиенте
Функция ИмяСправочникаРабот()

	Возврат "ВидыРаботСотрудников";

КонецФункции

&НаКлиенте
Функция ИмяСправочникаМоделей(ВидТехники)

	Если ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника Тогда
		Возврат "АпкМоделиСХТехники";
	ИначеЕсли ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		Возврат "АпкМоделиАвтотранспорта";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

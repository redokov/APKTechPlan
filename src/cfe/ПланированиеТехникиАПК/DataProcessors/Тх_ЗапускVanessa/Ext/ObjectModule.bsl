// Запуск сценариев Vanessa Automation из кода 1С (TEST-04, пункт 2:
// перенос scripts/run_va_feature.py и скрипта оркестровки ролей на
// встроенный язык). Обработка не заменяет Vanessa: она собирает VAParams,
// запускает тонкий клиент в режиме /TESTMANAGER, дожидается завершения и
// строго разбирает два артефакта вердикта - машинный файл статуса и
// строку журнала 1С (fail-closed: конфликт или отсутствие обоих - UNKNOWN,
// а не успех). Снимок/восстановление ролей Тх_ и очистка остатков фикстур
// выполняются в гарантированном блоке; сбой очистки - видимый провал
// прогона (TEST-02, Q-006).

#Область ПрограммныйИнтерфейс

// Выполняет один файл сценариев (.feature) и возвращает строгий вердикт.
//
// Параметры:
//   Параметры - Структура:
//     * КаталогФич                 - Строка - полный путь к .feature-файлу (обязателен);
//     * ПутьКVanessaAutomation     - Строка - полный путь к epf (обязателен);
//     * ПутьКТонкогоКлиента        - Строка - путь к 1cv8c.exe (обязателен);
//     * СтрокаБазы                 - Строка - кластер\база, например localhost\dev_erpapk_demo;
//     * ИмяПользователя            - Строка - пользователь сеанса TestManager;
//     * КаталогЛогов               - Строка - каталог артефактов прогона;
//     * ИмяПользователяТестКлиента - Строка, Неопределено - пользователь
//       тест-клиента; по умолчанию совпадает с ИмяПользователя, вместе с
//       ним выполняется оркестровка ролей Тх_ (снимок, гарантия, восстановление);
//     * ПортТестКлиента            - Строка - по умолчанию "1538";
//     * ВерсияПлатформы            - Строка - по умолчанию "8.5.4";
//     * КаталогПоиска1cv8          - Строка - каталог установки платформы 1С
//       (обязателен: без него Vanessa не найдёт версию для тест-клиента).
//
// Возвращаемое значение:
//   Структура:
//     * Вердикт       - Строка - "PASS" / "FAIL" / "UNKNOWN" (fail-closed);
//     * Источник      - Строка - "status-artifact" / "1c-log" / "conflict" / "none" / "cleanup";
//     * Описание      - Строка - первая содержательная строка журнала или причина;
//     * ОшибкаОчистки - Строка - "" или причина сбоя гарантированного блока.
//
Функция ВыполнитьСценарий(Параметры) Экспорт

	Тх_Тесты.ПроверитьТестовуюБазу();

	Результат = Новый Структура("Вердикт, Источник, Описание, ОшибкаОчистки",
		"UNKNOWN", "none", "", "");

	ИмяФичи = ИмяФайлаБезРасширения(Параметры.КаталогФич);
	ИмяПользователяТК = ЗначениеЛокально(Параметры, "ИмяПользователяТестКлиента",
		Параметры.ИмяПользователя);
	ОркестровкаРолей = (ИмяПользователяТК = Параметры.ИмяПользователя);

	ЛогВыполнения = Параметры.КаталогЛогов + "\va_exec_" + ИмяФичи + ".txt";
	ФайлСтатуса   = Параметры.КаталогЛогов + "\va_status_" + ИмяФичи + ".log";
	Лог1С         = Параметры.КаталогЛогов + "\va_1c_" + ИмяФичи + ".log";
	ФайлVAParams  = Параметры.КаталогЛогов + "\vap_" + ИмяФичи + ".json";

	СнимокРолей = Неопределено;

	Попытка
		// (1) Оркестровка ролей: снимок и гарантия перед запуском (Q-006).
		Если ОркестровкаРолей Тогда
			СнимокРолей = СписокРолейТх(Параметры.ИмяПользователя);
			Если СнимокРолей = Неопределено Тогда
				ВызватьИсключение "пользователь ИБ не найден: "
					+ Параметры.ИмяПользователя;
			КонецЕсли;
			Если НЕ ПрименитьРолиТх(Параметры.ИмяПользователя, ИменаРолейТх(), Истина) Тогда
				ВызватьИсключение "не удалось назначить роли Тх_ перед прогоном";
			КонецЕсли;
		КонецЕсли;

		// (2) Артефакты прошлого прогона не имеют права фабриковать вердикт.
		УдалитьАртефактВердикта(ЛогВыполнения);
		УдалитьАртефактВердикта(ФайлСтатуса);
		УдалитьАртефактВердикта(Лог1С);

		// (3) VAParams и командная строка TestManager.
		ЗаписатьVAParams(ФайлVAParams, Параметры, ИмяПользователяТК,
			ЛогВыполнения, ФайлСтатуса, ИмяФичи);

		КомандаЗапуска = КоманднаяСтрокаТестМенеджера(Параметры, ИмяПользователяТК,
			ФайлVAParams, Лог1С);
		ЗапуститьПриложение(КомандаЗапуска, , Истина);

		// (4) Строгий разбор артефактов (fail-closed).
		ВердиктСтатуса = ВердиктИзФайлаСтатуса(ФайлСтатуса);
		ВердиктЛога    = ВердиктИзЛога1С(Лог1С);

		Если ВердиктСтатуса <> "" И ВердиктЛога <> "" И ВердиктСтатуса <> ВердиктЛога Тогда
			Результат.Вердикт  = "UNKNOWN";
			Результат.Источник = "conflict";
			Результат.Описание = "статус: " + ВердиктСтатуса + ", журнал 1С: " + ВердиктЛога;
		ИначеЕсли ВердиктСтатуса <> "" Тогда
			Результат.Вердикт  = ВердиктСтатуса;
			Результат.Источник = "status-artifact";
		ИначеЕсли ВердиктЛога <> "" Тогда
			Результат.Вердикт  = ВердиктЛога;
			Результат.Источник = "1c-log";
		Иначе
			Результат.Описание = ПерваяСтрокаЖурнала(Лог1С, ЛогВыполнения);
		КонецЕсли;

	Исключение
		Результат.Вердикт  = "UNKNOWN";
		Результат.Источник = "none";
		Результат.Описание = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// (5) Гарантированный блок: восстановление ролей и уборка остатков.
	// Возвратов внутри Попытка выше нет - блок выполняется всегда.
	Попытка
		Если ОркестровкаРолей И СнимокРолей <> Неопределено Тогда
			Если НЕ ВосстановитьРолиТх(Параметры.ИмяПользователя, СнимокРолей) Тогда
				Результат.ОшибкаОчистки = "восстановление ролей Тх_ не подтверждено";
			КонецЕсли;
		КонецЕсли;
		Остатки = Тх_Тесты.УбратьОстаткиПоМаскам();
		Если Остатки.Количество() > 0 Тогда
			Результат.ОшибкаОчистки = Результат.ОшибкаОчистки
				+ "остатки фикстур: " + СтрСоединить(Остатки, "; ");
		КонецЕсли;
	Исключение
		Результат.ОшибкаОчистки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Результат.ОшибкаОчистки <> "" И Результат.Вердикт = "PASS" Тогда
		Результат.Вердикт  = "FAIL";
		Результат.Источник = "cleanup";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Список ролей Тх_ пользователя ИБ.
//
// Параметры:
//   ИмяПользователя - Строка - имя пользователя информационной базы.
//
// Возвращаемое значение:
//   Массив из Строка, Неопределено - имена назначенных ролей Тх_;
//   Неопределено - пользователь не найден.
//
Функция СписокРолейТх(ИмяПользователя) Экспорт

	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат РолиТхПользователя(Пользователь);

КонецФункции

// Назначает роли Тх_ пользователю ИБ (с проверкой результата по перечитке).
//
// Возвращаемое значение:
//   Булево - Ложь, если пользователь не найден или состав ролей не подтвердился.
//
Функция ДобавитьРолиТх(ИмяПользователя, ИменаРолей) Экспорт
	Возврат ПрименитьРолиТх(ИмяПользователя, ИменаРолей, Истина);
КонецФункции

// Снимает роли Тх_ с пользователя ИБ (с проверкой результата по перечитке).
//
// Возвращаемое значение:
//   Булево - Ложь, если пользователь не найден или состав ролей не подтвердился.
//
Функция УдалитьРолиТх(ИмяПользователя, ИменаРолей) Экспорт
	Возврат ПрименитьРолиТх(ИмяПользователя, ИменаРолей, Ложь);
КонецФункции

#КонецОбласти

#Область СлужебныеПрограммныйИнтерфейс

// Полный перечень ролей Тх_ расширения (граница TEST-02).
//
Функция ИменаРолейТх()

	Имена = Новый Массив;
	Имена.Добавить("Тх_Чтение");
	Имена.Добавить("Тх_Редактирование");
	Возврат Имена;

КонецФункции

// Соответствие имя роли -> метаданные роли (без индексированного доступа
// к коллекции ролей: состав ролей фиксирован границей TEST-02).
//
Функция РолиТхМетаданные()

	Результат = Новый Структура;
	Результат.Вставить("Тх_Чтение",         Метаданные.Роли.Тх_Чтение);
	Результат.Вставить("Тх_Редактирование", Метаданные.Роли.Тх_Редактирование);
	Возврат Результат;

КонецФункции

// Роли Тх_, назначенные пользователю прямо сейчас.
//
Функция РолиТхПользователя(Пользователь)

	Результат = Новый Массив;
	Роли = РолиТхМетаданные();
	Для Каждого КлючЗначение Из Роли Цикл
		Если Пользователь.Роли.Содержит(КлючЗначение.Значение) Тогда
			Результат.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Назначает или снимает роли Тх_, затем перечитывает пользователя и
// сверяет фактический состав (доверяй, но проверяй).
//
Функция ПрименитьРолиТх(ИмяПользователя, ИменаРолей, Добавить)

	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Роли = РолиТхМетаданные();
	Изменено = Ложь;
	Для Каждого ИмяРоли Из ИменаРолей Цикл
		Роль = Неопределено;
		Если НЕ Роли.Свойство(ИмяРоли, Роль) Тогда
			Продолжить; // чужая роль - не наша граница
		КонецЕсли;
		Есть = Пользователь.Роли.Содержит(Роль);
		Если Добавить И НЕ Есть Тогда
			Пользователь.Роли.Добавить(Роль);
			Изменено = Истина;
		ИначеЕсли НЕ Добавить И Есть Тогда
			Пользователь.Роли.Удалить(Роль);
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Изменено Тогда
		Пользователь.Записать();
	КонецЕсли;

	// Контроль по свежей перечитке.
	ПользовательПосле = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательПосле = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Фактически = РолиТхПользователя(ПользовательПосле);
	Для Каждого ИмяРоли Из ИменаРолей Цикл
		Если Роли.Свойство(ИмяРоли) Тогда
			ДолжнаБыть = Добавить;
			ЕстьТеперь = (Фактически.Найти(ИмяРоли) <> Неопределено);
			Если ЕстьТеперь <> ДолжнаБыть Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Возвращает пользователю точный состав ролей Тх_ из снимка, сделанного
// до прогона, и сверяет результат по перечитке.
//
Функция ВосстановитьРолиТх(ИмяПользователя, СнимокРолей)

	НужныеДобавить = Новый Массив;
	НужныеСнять    = Новый Массив;
	Для Каждого КлючЗначение Из РолиТхМетаданные() Цикл
		ИмяРоли = КлючЗначение.Ключ;
		Если СнимокРолей.Найти(ИмяРоли) <> Неопределено Тогда
			НужныеДобавить.Добавить(ИмяРоли);
		Иначе
			НужныеСнять.Добавить(ИмяРоли);
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПрименитьРолиТх(ИмяПользователя, НужныеДобавить, Истина) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ПрименитьРолиТх(ИмяПользователя, НужныеСнять, Ложь) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Финальная сверка со снимком.
	Фактически = СписокРолейТх(ИмяПользователя);
	Если Фактически = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат (Фактически.Количество() = СнимокРолей.Количество());

КонецФункции

// Собирает и записывает JSON VAParams (перенос рецепта run_va_feature.py;
// булевы значения передаются СТРОКАМИ "Истина" - так ожидает Vanessa).
//
Процедура ЗаписатьVAParams(ФайлVAParams, Параметры, ИмяПользователяТК,
		ЛогВыполнения, ФайлСтатуса, ИмяФичи)

	Порт = ЗначениеЛокально(Параметры, "ПортТестКлиента", "1538");
	Версия = ЗначениеЛокально(Параметры, "ВерсияПлатформы", "8.5.4");
	КаталогПоиска = ЗначениеЛокально(Параметры, "КаталогПоиска1cv8", "");
	Если КаталогПоиска = "" Тогда
		ВызватьИсключение "не задан параметр КаталогПоиска1cv8 (каталог установки платформы 1С)";
	КонецЕсли;

	// Путь для VA: прямые слэши (рецепт).
	КаталогФич  = СтрЗаменить(Параметры.КаталогФич, "\", "/");
	ПутьVanessa = СтрЗаменить(Параметры.ПутьКVanessaAutomation, "\", "/");

	Клиент = Новый Структура;
	Клиент.Вставить("Имя", "Основной");
	Клиент.Вставить("ПутьКИнфобазе", "/S""" + Параметры.СтрокаБазы + """ /N""" + ИмяПользователяТК + """ /P""""");
	Клиент.Вставить("ДопПараметры", "/DisableStartupMessages /DisableStartupDialogs");
	Клиент.Вставить("ТипКлиента", "Тонкий");
	Клиент.Вставить("ИмяКомпьютера", "localhost");
	Клиент.Вставить("ПортЗапускаТестКлиента", Порт);

	Клиенты = Новый Массив;
	Клиенты.Добавить(Клиент);

	VAParams = Новый Структура;
	VAParams.Вставить("ИмяСборки", "TEST-04 " + ИмяФичи);
	VAParams.Вставить("ВерсияПлатформы", Версия);
	VAParams.Вставить("КаталогПоискаВерсииПлатформы", КаталогПоиска);
	VAParams.Вставить("СтрокаПодключенияКБазе", "ENTERPRISE /S""" + Параметры.СтрокаБазы + """ /N""" + Параметры.ИмяПользователя + """ /P""""");
	VAParams.Вставить("ПутьКVanessaAutomation", ПутьVanessa);
	VAParams.Вставить("КаталогФич", КаталогФич);
	VAParams.Вставить("КаталогиБиблиотек", Новый Массив);
	VAParams.Вставить("КлиентыТестирования", Клиенты);
	VAParams.Вставить("ВыполнитьСценарии", "Истина");
	VAParams.Вставить("ЗавершитьРаботуСистемы", "Истина");
	VAParams.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", "Истина");
	VAParams.Вставить("ДелатьЛогВыполненияСценариевВТекстовыйФайл", "Истина");
	VAParams.Вставить("ИмяФайлаЛогВыполненияСценариев", ЛогВыполнения);
	VAParams.Вставить("ВыгружатьСтатусВыполненияСценариевВФайл", "Истина");
	VAParams.Вставить("ПутьКФайлуДляВыгрузкиСтатусаВыполненияСценариев", ФайлСтатуса);
	VAParams.Вставить("ТаймаутЗапуска1С", "600");

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ФайлVAParams);
	ЗаписатьJSON(Запись, VAParams);
	Запись.Закрыть();

КонецПроцедуры

// Командная строка TestManager (glued-ключи, /Out для журнала 1С).
//
Функция КоманднаяСтрокаТестМенеджера(Параметры, ИмяПользователя, ФайлVAParams, Лог1С)

	Возврат Параметры.ПутьКТонкогоКлиента + " ENTERPRISE /TESTMANAGER" + " /S""" + Параметры.СтрокаБазы + """" + " /N""" + ИмяПользователя + """ /P""""" + " /Execute""" + СтрЗаменить(Параметры.ПутьКVanessaAutomation, "\", "/") + """" + " /CStartFeaturePlayer;VAParams=" + СтрЗаменить(ФайлVAParams, "\", "/") + " /DisableStartupDialogs /DisableStartupMessages" + " /Out""" + Лог1С + """";

КонецФункции

// Вердикт из машинного файла статуса: содержимое - ТОЛЬКО число ошибок.
// Всё, что не «цифры после обрезки BOM/пробелов/переводов строк», -
// не вердикт ("" = неизвестно).
//
Функция ВердиктИзФайлаСтатуса(ФайлСтатуса)

	Если НЕ ФайлСуществуетЛокально(ФайлСтатуса) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ПрочитатьТекстФайлаЛокально(ФайлСтатуса);
	Текст = СтрЗаменить(Текст, Символ(65279), "");
	С = СтрЗаменить(Текст, Символы.ПС, "");
	С = СтрЗаменить(С, Символы.ВК, "");
	С = СокрЛП(С);

	Если С = "" Тогда
		Возврат "";
	КонецЕсли;
	Для Ном = 1 По СтрДлина(С) Цикл
		Если Найти("0123456789", Сред(С, Ном, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат ?(С = "0", "PASS", "FAIL");

КонецФункции

// Вердикт из журнала 1С: строгое предложение Vanessa в КОНЦЕ строки
// («Выполнение сценариев закончено. Ошибок не было.» / «...БЫЛИ ОШИБКИ.»,
// завершающая точка необязательна). Несколько или разнородные строки -
// не вердикт.
//
Функция ВердиктИзЛога1С(Лог1С)

	Если НЕ ФайлСуществуетЛокально(Лог1С) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ПрочитатьТекстФайлаЛокально(Лог1С);
	Текст = СтрЗаменить(Текст, Символ(65279), "");

	Было = 0;
	Были = 0;
	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	Для Каждого Строка Из Строки Цикл
		С = СокрЛП(Строка);
		Если СтрЗаканчиваетсяНа(С, ".") Тогда
			С = Лев(С, СтрДлина(С) - 1);
		КонецЕсли;
		Если СтрЗаканчиваетсяНа(С, "Выполнение сценариев закончено. Ошибок не было") Тогда
			Было = Было + 1;
		ИначеЕсли СтрЗаканчиваетсяНа(С, "Выполнение сценариев закончено. БЫЛИ ОШИБКИ") Тогда
			Были = Были + 1;
		КонецЕсли;
	КонецЦикла;

	Если Было > 0 И Были = 0 Тогда
		Возврат "PASS";
	ИначеЕсли Были > 0 И Было = 0 Тогда
		Возврат "FAIL";
	КонецЕсли;
	Возврат "";

КонецФункции

// Удаляет артефакт предыдущего прогона, если существует.
//
Процедура УдалитьАртефактВердикта(Путь)

	Если ФайлСуществуетЛокально(Путь) Тогда
		УдалитьФайлы(Путь);
	КонецЕсли;

КонецПроцедуры

// Первая содержательная строка журнала (для описания UNKNOWN).
//
Функция ПерваяСтрокаЖурнала(Лог1С, ЛогВыполнения)

	Для Каждого Путь Из СтрРазделить(Лог1С + "|" + ЛогВыполнения, "|", Ложь) Цикл
		Если НЕ ФайлСуществуетЛокально(Путь) Тогда
			Продолжить;
		КонецЕсли;
		Текст = ПрочитатьТекстФайлаЛокально(Путь);
		Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
		Для Каждого Строка Из Строки Цикл
			С = СокрЛП(Строка);
			Если С <> "" Тогда
				Возврат С;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "нет убедительного артефакта вердикта";

КонецФункции

// Имя файла без каталога и расширения (для именования артефактов).
//
Функция ИмяФайлаБезРасширения(Путь)

	Части = СтрРазделить(СтрЗаменить(Путь, "/", "\"), "\", Ложь);
	Имя = Части[Части.ВГраница()];
	Поз = СтрНайти(Имя, ".");
	Если Поз > 0 Тогда
		Имя = Лев(Имя, Поз - 1);
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Чтение текстового файла в UTF-8 (артефакты прогона пишутся в UTF-8).
// Логи в однобайтных кодировках дают нечитаемые строки и, как следствие,
// вердикт UNKNOWN - это осознанный fail-closed.
//
Функция ПрочитатьТекстФайлаЛокально(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	// На пустом файле Прочитать() возвращает Неопределено (8.5).
	Если Текст = Неопределено Тогда
		Текст = "";
	КонецЕсли;
	Возврат Текст;

КонецФункции


// Существование файла (в 8.5 нет глобальной ФайлСуществует - только
// метод объекта Файл.Существует).
//
Функция ФайлСуществуетЛокально(Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();

КонецФункции

// Значение ключа структуры с умолчанием (локальная копия рецепта
// Тх_ТехникаСервер, там функция не экспортная).
//
Функция ЗначениеЛокально(Структура, Ключ, ПоУмолчанию)

	Значение = Неопределено;
	Если Структура.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти

			КонтрольныйНабор.Отбор.Период.Установить(Дата(2025, 1, 1));
			КонтрольныйНабор.Отбор.Работа.Установить(Работа);
			КонтрольныйНабор.Отбор.ВидТехники.Установить(ВидТехники);
			КонтрольныйНабор.Прочитать();

			НайденаСтрокаБезМощности = Ложь;
			НайденаСтрокаБазовой = Ложь;
			Для Каждого Запись Из КонтрольныйНабор Цикл
				Если Запись.МодельТехники = МодельБезМощности Тогда
					НайденаСтрокаБезМощности = Истина;
				ИначеЕсли Запись.МодельТехники = МодельБазовая Тогда
					НайденаСтрокаБазовой = Истина;
				КонецЕсли;
			КонецЦикла;

			Проверить(Контекст, НСтр("ru = 'строка для модели без мощности не создана'"),
				НЕ НайденаСтрокаБезМощности);
			Проверить(Контекст, НСтр("ru = 'строка базовой модели создана'"),
				НайденаСтрокаБазовой);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());

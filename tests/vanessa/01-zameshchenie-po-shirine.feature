# language: ru
# Сценарий 1 из 8 (design §11 «Сценарные Vanessa»), обновлён в T6.
# Регистр Тх_КоэффициентыПересчетаРабот удалён (FR-005); коэффициент
# замещения моделей считается на лету из реквизитов моделей (FR-004,
# design §6.4): К = Реквизит(замены)/Реквизит(оригинала).
# Покрывает: замещение по ширине обработки (acceptance: ширина 1,5x ->
# К = 1,5), идентичная модель -> К = 1, отсутствие реквизитов ->
# Неопределено (не молчаливая единица).
# Серверный сценарий: без UI (объекты регистра не существуют).

Функционал: Коэффициент замещения моделей по ширине обработки

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	# Очистка тест-данных сценария (идемпотентность повторных прогонов)
	Дано я выполняю код встроенного языка на сервере
	|Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.АпкМоделиСХТехники ГДЕ Наименование ПОДОБНО &Шаблон");|
	|Запрос.УстановитьПараметр("Шаблон", "%Тх_VA Замещение%");|
	|Выборка = Запрос.Выполнить().Выбрать();|
	|Пока Выборка.Следующий() Цикл Выборка.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|

Сценарий: Замещение по ширине обработки - К = 1,5
	Когда я выполняю код встроенного языка на сервере
	|Оригинал = Справочники.АпкМоделиСХТехники.СоздатьЭлемент();|
	|Оригинал.Наименование = "Тх_VA Замещение Оригинал";|
	|Оригинал.ШиринаОбработки = 2;|
	|Оригинал.Записать();|
	|Замена = Справочники.АпкМоделиСХТехники.СоздатьЭлемент();|
	|Замена.Наименование = "Тх_VA Замещение Аналог";|
	|Замена.ШиринаОбработки = 3;|
	|Замена.Записать();|
	# FR-004: К = ширина_замены / ширина_оригинала = 3 / 2 = 1,5
	|К = Тх_ТехникаСервер.КоэффициентЗамещения(Оригинал.Ссылка, Замена.Ссылка);|
	|Если К = Неопределено Тогда ВызватьИсключение "К должен быть задан (ширина есть у обеих)"; КонецЕсли;|
	|Если К > 1.501 Или К < 1.499 Тогда ВызватьИсключение "ожидался К = 1,5, получен " + Строка(К); КонецЕсли;|
	# Идентичная модель: К = 1 (замена сама себя замещает один к одному)
	|КСам = Тх_ТехникаСервер.КоэффициентЗамещения(Оригинал.Ссылка, Оригинал.Ссылка);|
	|Если КСам <> 1 Тогда ВызватьИсключение "ожидался К = 1 для идентичной модели, получен " + Строка(КСам); КонецЕсли;|
	# Обратное направление: К = 2/3 (оригинал как замена широкой модели)
	|КОбр = Тх_ТехникаСервер.КоэффициентЗамещения(Замена.Ссылка, Оригинал.Ссылка);|
	|Если КОбр > 0.667 Или КОбр < 0.666 Тогда ВызватьИсключение "ожидался К = 2/3, получен " + Строка(КОбр); КонецЕсли;|
	# Без реквизитов замещения: Неопределено (FR-011 - не молчаливая единица)
	|Пустая = Справочники.АпкМоделиСХТехники.СоздатьЭлемент();|
	|Пустая.Наименование = "Тх_VA Замещение Пустая";|
	|Пустая.Записать();|
	|КПустая = Тх_ТехникаСервер.КоэффициентЗамещения(Оригинал.Ссылка, Пустая.Ссылка);|
	|Если КПустая <> Неопределено Тогда ВызватьИсключение "ожидалось Неопределено, получен " + Строка(КПустая); КонецЕсли;|
	# Очистка
	|Оригинал.Удалить();|
	|Замена.Удалить();|
	|Пустая.Удалить();|

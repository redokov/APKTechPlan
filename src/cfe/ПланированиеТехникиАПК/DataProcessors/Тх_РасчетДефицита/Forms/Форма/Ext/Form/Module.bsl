// Форма обработки «Тх_РасчетДефицита» (design §4.8): отборы и параметры запуска
// расчёта дефицита техники (design §4.7), серверный вызов
// Тх_ТехникаСервер.РассчитатьДефицит и открытие отчёта «Анализ дефицита техники»
// (фаза 1 двухфазной схемы, TD-002/TD-003).
//
// Без модальности и фоновых заданий (NFR-001). Форма выбора типового справочника
// сценариев открывается по строковому имени (FAQ Q8, TD-001).

&НаКлиенте
Процедура СценарийПланированияНачалоВыбора(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник." + ИмяСправочникаСценариев() + ".ФормаВыбора", , Элемент);

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИОткрытьОтчет(Команда)

	// Сценарий планирования обязателен: без него расчёт невозможен (design §4.7).
	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите сценарий планирования.'"));
		Возврат;
	КонецЕсли;

	КоличествоЗаписей = РассчитатьДефицитНаСервере();

	Если КоличествоЗаписей > 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Расчет дефицита'"), ,
			СтрШаблон(НСтр("ru = 'Записей в отчёте: %1'"), КоличествоЗаписей));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Расчет дефицита'"), ,
			НСтр("ru = 'Данные для отчёта не рассчитаны. Выполните «Расчет дефицита» и повторите формирование.'"));
	КонецЕсли;

	// Отчёт открывается БЕЗ указания имени формы: собственной формы у отчёта нет,
	// платформа генерирует форму по основной СКД (отступление от design §4.8).
	ОткрытьФорму("Отчет.Тх_ДефицитТехники");

КонецПроцедуры

&НаСервере
Функция РассчитатьДефицитНаСервере()

	// Сборка параметров расчёта (design §4.7) и вызов серверного алгоритма;
	// повторная валидация - внутри Тх_ТехникаСервер.РассчитатьДефицит.
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СценарийПланирования", СценарийПланирования);
	ПараметрыРасчета.Вставить("Организация", Организация);
	ПараметрыРасчета.Вставить("Подразделение", Подразделение);
	ПараметрыРасчета.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыРасчета.Вставить("ДатаОкончания", ДатаОкончания);
	ПараметрыРасчета.Вставить("ВидТехники", ВидТехники);
	ПараметрыРасчета.Вставить("СменВДень", СменВДень);
	ПараметрыРасчета.Вставить("СуффиксОбъема", СуффиксОбъема());

	Возврат Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Умолчания (Q-001/FAQ Q2, FAQ Q3): СменВДень = 1, ВариантОбъема = «Вероятный».
	Если НЕ ЗначениеЗаполнено(СменВДень) Тогда
		СменВДень = 1;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ВариантОбъема) Тогда
		ВариантОбъема = "Вероятный";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СуффиксОбъема()

	// Вариант объёма работ -> суффикс ресурса годового плана (FAQ Q3, TD-002):
	// Минимальный -> «_Мин», Максимальный -> «_Макс», иначе -> «_Вер».
	Если ВариантОбъема = "Минимальный" Тогда
		Возврат "_Мин";
	ИначеЕсли ВариантОбъема = "Максимальный" Тогда
		Возврат "_Макс";
	Иначе
		Возврат "_Вер";
	КонецЕсли;

КонецФункции

// Локальная константа имени (design §4.1, п. 3): каноническое значение хранит
// Тх_ТехникаСервер.ИмяСправочникаСценариевПланирования; серверный модуль с
// клиента недоступен (FAQ Q8), значение продублировано в клиентском модуле
// (как в Тх_ЗаполнениеКоэффициентов).

&НаКлиенте
Функция ИмяСправочникаСценариев()

	Возврат "АпкСценарииПланирования";

КонецФункции

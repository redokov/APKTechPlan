// Тест ЧислоДнейПериода: календарные дни периода, границы включены
// (FAQ Q1, FR-001): 01.03..10.03 = 10, один день = 1, пустые даты = 0.
//
// Возвращаемое значение:
//   Структура - результат теста: Имя, Статус ("PASS"/"FAIL"/"SKIP"), Провалы.
//
// UI-01, Q-008 вариант b (решение владельца 15.11.2026): текст "Данных нет"
// выводится программно, а не настройкой схемы компоновки.
// Проверки:
//  1) механизм вывода текста пишет строку в пустой табличный документ;
//  2) на реальной схеме отчёта пустой отбор (недостижимая граница периода)
//     даёт результат высотой ровно в шапку, а без отбора - выше.
//
// Высота табличного документа, полученного компоновкой с указанным макетом.
//
Функция ВысотаРезультата(МакетКомпоновки)

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки, ,
		Новый ДанныеРасшифровкиКомпоновкиДанных);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Документ = Новый ТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Документ);
	ПроцессорВывода.Вывести(Процессор);
	Возврат Документ.ВысотаТаблицы;

КонецФункции

Функция ТестТекстОтсутствияДанных() Экспорт

	Контекст = НовыйКонтекстТеста("ТестТекстОтсутствияДанных");

	Попытка
		Отчет = Отчеты.Тх_ДефицитТехники.Создать();

		Документ = Новый ТабличныйДокумент;
		Отчет.ВывестиТекстОтсутствияДанных(Документ);
		Проверить(Контекст, НСтр("ru = 'текст выводится в пустой документ'"),
			Документ.НайтиТекст(НСтр("ru = 'Данных нет'")) <> Неопределено);

		Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(
			Тип("ЭлементОтбораКомпоновкиДанных"));
		// Отбор с ПУСТЫМ значением схема компоновки трактует как «не задан»
		// и пропускает (проверено прогоном 15.11.2026), поэтому берём заведомо
		// недостижимую границу периода: в базе нет строк с периодом 2100 года
		// (демо-данные 2014-2015, фикстуры проверок 1999 и 2098-2099).
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПериодНачала");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = Дата(2100, 1, 1);

		ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;

		// Замер 1: с заведомо недостижимым отбором.
		МакетПустой = КомпоновщикМакета.Выполнить(
			Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"), Настройки);
		ВысотаПустая = ВысотаРезультата(МакетПустой);

		// Замер 2: без отбора.
		НастройкиБезОтбора = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
		ВысотаПолная = ВысотаРезультата(
			КомпоновщикМакета.Выполнить(
				Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"), НастройкиБезОтбора));

		// Отчёт без заголовка, группировок и итогов: пустой результат - одна
		// строка заголовка колонок. Это свойство использует модуль отчёта,
		// поэтому оно закреплено здесь.
		Проверить(Контекст, НСтр("ru = 'высота пустого результата = высота шапки'"),
			ВысотаПустая = 5, "высота=" + Формат(ВысотаПустая, "ЧГ=0"));
		Проверить(Контекст, НСтр("ru = 'полный результат выше пустого'"),
			ВысотаПолная > 1, "высота=" + Формат(ВысотаПолная, "ЧГ=0"));
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

Функция ТестЧислоДнейПериода() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЧислоДнейПериода");

	Попытка
		Проверить(Контекст, НСтр("ru = '01.03..10.03 = 10 дней (границы включены)'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10)) = 10);

		Проверить(Контекст, НСтр("ru = 'один день = 1'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 5), Дата(2025, 3, 5)) = 1);

		Проверить(Контекст, НСтр("ru = 'пустые даты = 0'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(1, 1, 1), Дата(1, 1, 1)) = 0);

		Проверить(Контекст, НСтр("ru = 'интервал после окончания = 0 (не отрицательный)'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 10), Дата(2025, 3, 1)) = 0);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);


#КонецОбласти

#Область Тесты_ПересчетДефицита

// Возвращает таблицу значений, моделирующую строки потребности (формат
// колонок запроса Тх_ТехникаСервер.ЗапросПотребности).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: СценарийПланирования, Организация, Подразделение,
//     ПериодНачала, ПериодОкончания, ВидРаботы, МодельТехники, ВидТехники,
//     ПотребностьСмен.
//
Функция НоваяТаблицаПотребности()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СценарийПланирования");
	Таблица.Колонки.Добавить("Организация");
	Таблица.Колонки.Добавить("Подразделение");
	Таблица.Колонки.Добавить("ПериодНачала", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ПериодОкончания", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ВидРаботы");
	Таблица.Колонки.Добавить("МодельТехники");
	Таблица.Колонки.Добавить("ВидТехники");
	Таблица.Колонки.Добавить("ПотребностьСмен", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

// Возвращает таблицу значений, моделирующую строки доступности (формат
// колонок запроса Тх_ТехникаСервер.ЗапросДоступности).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: СценарийПланирования, Подразделение,
//     МодельТехники, ВидТехники, ЕдиницДоступно.
//
Функция НоваяТаблицаДоступности()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СценарийПланирования");
	Таблица.Колонки.Добавить("Подразделение");
	Таблица.Колонки.Добавить("МодельТехники");
	Таблица.Колонки.Добавить("ВидТехники");
	Таблица.Колонки.Добавить("ЕдиницДоступно", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

// ПРОВЕРКА КОНТРАКТА TD-004: зеркало приватной функции
// Тх_ТехникаСервер.ДоступноСменСтроки (не экспортируется намеренно).
// Повторяет её формулу сопоставления (design §4.7, шаги 4-5; D-007, FR-011),
// реальные коэффициенты берёт через Тх_ТехникаСервер.КоэффициентНаДату.
// При изменении формулы в Тх_ТехникаСервер зеркало должно быть актуализировано.
//
// Параметры:
//   СтрПотребности    - СтрокаТаблицыЗначений - строка потребности;
//   СтрокиДоступности - ТаблицаЗначений - строки доступности подразделения;
//   Дней              - Число - календарных дней интервала строки;
//   СменВДень         - Число - смен в день (FAQ Q1).
//
// Возвращаемое значение:
//   Структура - свойства: Доступно (Число), КоэффициентНеЗадан (Булево).
//
Функция ДоступноСменКонтракт(СтрПотребности, СтрокиДоступности, Дней, СменВДень)

	Доступно = 0;
	КоэффициентНеЗадан = Ложь;

	Если СтрПотребности.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		// Модель в модель, без пересчёта через K (D-007, FAQ Q4).
		Для Каждого СтрДост Из СтрокиДоступности Цикл
			Если СтрДост.ВидТехники = СтрПотребности.ВидТехники
				И СтрДост.МодельТехники = СтрПотребности.МодельТехники Тогда
				Доступно = Доступно + СтрДост.ЕдиницДоступно * Дней * СменВДень;
			КонецЕсли;
		КонецЦикла;
	Иначе
		// СХТехника: эквивалент аналога в сменах базовой модели (TD-004).
		Для Каждого СтрДост Из СтрокиДоступности Цикл
			Если СтрДост.ВидТехники <> СтрПотребности.ВидТехники Тогда
				Продолжить;
			КонецЕсли;

			СменМодели = СтрДост.ЕдиницДоступно * Дней * СменВДень;

			Если СтрДост.МодельТехники = СтрПотребности.МодельТехники Тогда
				Доступно = Доступно + СменМодели;
			Иначе
				К = Тх_ТехникаСервер.КоэффициентНаДату(СтрПотребности.ВидРаботы,
					СтрДост.МодельТехники, СтрПотребности.ВидТехники,
					СтрПотребности.ПериодНачала);
				Если К = Неопределено ИЛИ К = 0 Тогда
					// Модель исключена из пересчёта, пометка вместо молчаливого 1,00 (FR-011).
					КоэффициентНеЗадан = Истина;
				Иначе
					// TD-004: эквивалент аналога в сменах базовой = смены_аналога / K.
					Доступно = Доступно + СменМодели / К;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Доступно, КоэффициентНеЗадан", Доступно, КоэффициентНеЗадан);

КонецФункции

// ПРОВЕРКА КОНТРАКТА FR-012: дефицит неотрицателен (зеркало формулы
// функции Тх_ТехникаСервер.РассчитатьДефицит, округление 2 знака).
//
// Параметры:
//   ПотребностьСмен - Число - потребность в сменах;
//   ДоступноСмен    - Число - доступно смен.
//
// Возвращаемое значение:
//   Число - дефицит (не меньше нуля).
//
Функция ДефицитКонтракт(ПотребностьСмен, ДоступноСмен)

	Возврат Макс(0, Окр(ПотребностьСмен - ДоступноСмен, 2));

КонецФункции

// Тест ПересчетДоступностиЧерезКоэффициент (TD-004): эквивалент аналога
// в сменах базовой = смены_аналога / K. Потребность 10 смен базовой модели,
// аналог: 1 единица на 10 дней, 1 смена в день, K = 0,8 - доступность
// 10 / 0,8 = 12,5.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестПересчетДоступностиЧерезКоэффициент() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПересчетДоступностиЧерезКоэффициент");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	МодельБазовая = Неопределено;
	МодельАналог = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		МодельБазовая = СоздатьМодель(ВидТехники);
		МодельАналог = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ МодельБазовая = Неопределено ИЛИ МодельАналог = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// K аналога = 0,8 (кейс s02), запись в реальный регистр.
			НаборЗаписей = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Работа.Установить(Работа);
			НаборЗаписей.Отбор.МодельТехники.Установить(МодельАналог);
			НаборЗаписей.Отбор.ВидТехники.Установить(ВидТехники);

			Запись = НаборЗаписей.Добавить();
			Запись.Период = Дата(2025, 1, 1);
			Запись.Работа = Работа;
			Запись.МодельТехники = МодельАналог;
			Запись.ВидТехники = ВидТехники;
			Запись.Коэффициент = 0.8;
			Запись.БазоваяМодель = Ложь;
			НаборЗаписей.Записать(Истина);

			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.ВидРаботы = Работа;
			СтрПотребности.МодельТехники = МодельБазовая;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрДоступности = Доступность.Добавить();
			СтрДоступности.МодельТехники = МодельАналог;
			СтрДоступности.ВидТехники = ВидТехники;
			СтрДоступности.ЕдиницДоступно = 1;

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			РезультатСопоставления = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);

			Отклонение = Макс(РезультатСопоставления.Доступно - 12.5,
				12.5 - РезультатСопоставления.Доступно);
			Проверить(Контекст, НСтр("ru = 'доступность = смены_аналога / K = 10 / 0,8 = 12,5'"),
				Отклонение < 0.0001,
				Строка(РезультатСопоставления.Доступно));
			Проверить(Контекст, НСтр("ru = 'коэффициент задан - пометка не выставлена'"),
				НЕ РезультатСопоставления.КоэффициентНеЗадан);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Работа <> Неопределено И МодельАналог <> Неопределено Тогда
		ОчиститьКоэффициенты(Работа, ВидТехники, МодельАналог);
	КонецЕсли;
	УдалитьСсылку(Работа);
	УдалитьСсылку(МодельБазовая);
	УдалитьСсылку(МодельАналог);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест КоэффициентНеЗадан_МодельИсключенаИСтрокаПомечена (FR-011): аналог
// без записи K не добавляет доступность и даёт пометку КоэффициентНеЗадан
// (в РассчитатьДефицит пометка материализуется в ресурс регистра
// Тх_ДефицитТехники; на контракт-уровне фиксируются параметры пометки).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентНеЗадан_МодельИсключенаИСтрокаПомечена() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентНеЗадан_МодельИсключенаИСтрокаПомечена");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	МодельБазовая = Неопределено;
	МодельАналог = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		МодельБазовая = СоздатьМодель(ВидТехники);
		МодельАналог = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ МодельБазовая = Неопределено ИЛИ МодельАналог = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// Записи K для аналога НЕТ - модель исключена из пересчёта.
			Проверить(Контекст, НСтр("ru = 'КоэффициентНаДату для аналога - Неопределено'"),
				Тх_ТехникаСервер.КоэффициентНаДату(Работа, МодельАналог, ВидТехники,
					Дата(2025, 3, 1)) = Неопределено);

			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.ВидРаботы = Работа;
			СтрПотребности.МодельТехники = МодельБазовая;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрДоступности = Доступность.Добавить();
			СтрДоступности.МодельТехники = МодельАналог;
			СтрДоступности.ВидТехники = ВидТехники;
			СтрДоступности.ЕдиницДоступно = 1;

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			РезультатСопоставления = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);

			Проверить(Контекст, НСтр("ru = 'аналог без K не добавляет доступность (0, не 10)'"),
				РезультатСопоставления.Доступно = 0,
				Строка(РезультатСопоставления.Доступно));
			Проверить(Контекст, НСтр("ru = 'пометка КоэффициентНеЗадан выставлена'"),
				РезультатСопоставления.КоэффициентНеЗадан);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(Работа);
	УдалитьСсылку(МодельБазовая);
	УдалитьСсылку(МодельАналог);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест НеПринятыеТСИсключены (FR-007): реальный путь через
// Тх_ТехникаСервер.ЗапросДоступности - документ плана техресурсов с двумя
// строками одной модели (принятая и не принятая): в доступность попадает
// только принятая (ЕдиницДоступно = 2, а не 7).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестНеПринятыеТСИсключены() Экспорт

	Контекст = НовыйКонтекстТеста("ТестНеПринятыеТСИсключены");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Сценарий = Неопределено;
	Модель = Неопределено;
	Организация = Неопределено;
	Подразделение = Неопределено;
	ТС1 = Неопределено;
	ТС2 = Неопределено;
	ДокументСсылка = Неопределено;
	СценарийСоздан = Ложь;
	МодельСоздана = Ложь;
	ТССозданы = Ложь;
	Пропуск = "";

	Попытка
		Сценарий = НайтиПервыйЭлемент("АпкСценарииПланирования");
		Если Сценарий = Неопределено Тогда
			Сценарий = СоздатьЭлемент("АпкСценарииПланирования");
			СценарийСоздан = Сценарий <> Неопределено;
		КонецЕсли;
		Модель = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники));
		Если Модель = Неопределено Тогда
			Модель = СоздатьМодель(ВидТехники);
			МодельСоздана = Модель <> Неопределено;
		КонецЕсли;

		Если Сценарий = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось подготовить тестовые данные (справочники АПК)'");
		Иначе
			// Шапка документа: организация/подразделение обязательны
			// (ОбработкаПроведения отклоняет пустую шапку), дата документа
			// не может быть пустой - заполняем текущей датой сеанса.
			Организация = НайтиПервыйЭлемент("Организации");
			Подразделение = НайтиПервыйЭлемент("СтруктураПредприятия");

			// Уникальные ТС: контроль дублей ТС в документе; у справочника
			// ТранспортныеСредства Код (= «госномер») уникален и не
			// автонумеруется - задаём GUID вручную.
			ТС1 = СоздатьЭлемент("ТранспортныеСредства",
				Новый Структура("Код", УникальноеИмя()));
			ТС2 = СоздатьЭлемент("ТранспортныеСредства",
				Новый Структура("Код", УникальноеИмя()));
			ТССозданы = ТС1 <> Неопределено И ТС2 <> Неопределено;

			Если Организация = Неопределено ИЛИ Подразделение = Неопределено
				ИЛИ НЕ ТССозданы Тогда
				Пропуск = НСтр("ru = 'не удалось подготовить шапку документа (организация/подразделение/ТС)'");
			Иначе
				// Синтетический план: 2 принятые + 5 НЕ принятых единиц одной модели.
				Документ = Документы.Тх_ПланТехническихРесурсов.СоздатьДокумент();
				Документ.Дата = ТекущаяДатаСеанса();
				Документ.Организация = Организация;
				Документ.Подразделение = Подразделение;
				Документ.СценарийПланирования = Сценарий;

				СтрокаПринятая = Документ.ОсновнаяТехника.Добавить();
				СтрокаПринятая.ТранспортноеСредство = ТС1;
				СтрокаПринятая.МодельТехники = Модель;
				СтрокаПринятая.Принят = Истина;
				СтрокаПринятая.Количество = 2;

				СтрокаНеПринятая = Документ.ОсновнаяТехника.Добавить();
				СтрокаНеПринятая.ТранспортноеСредство = ТС2;
				СтрокаНеПринятая.МодельТехники = Модель;
				СтрокаНеПринятая.Принят = Ложь;
				СтрокаНеПринятая.Количество = 5;

				Документ.Записать(РежимЗаписиДокумента.Проведение);
				ДокументСсылка = Документ.Ссылка;

				ПараметрыЗапроса = Новый Структура(
					"СценарийПланирования, Организация, Подразделение",
					Сценарий, Неопределено, Неопределено);
				РезультатЗапроса = Тх_ТехникаСервер.ЗапросДоступности(ПараметрыЗапроса);

				ЕдиницДоступно = 0;
				СтрокаНайдена = Ложь;
				Выборка = РезультатЗапроса.Выбрать();
				Пока Выборка.Следующий() Цикл
					Если Выборка.МодельТехники = Модель
						И Выборка.ВидТехники = ВидТехники Тогда
						СтрокаНайдена = Истина;
						ЕдиницДоступно = Выборка.ЕдиницДоступно;
					КонецЕсли;
				КонецЦикла;

				Проверить(Контекст, НСтр("ru = 'строка доступности по модели найдена'"),
					СтрокаНайдена);
				Проверить(Контекст, НСтр("ru = 'в доступности только принятые ТС (2, а не 7)'"),
					ЕдиницДоступно = 2,
					Строка(ЕдиницДоступно));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьДокумент(ДокументСсылка);
	Если СценарийСоздан Тогда
		УдалитьСсылку(Сценарий);
	КонецЕсли;
	Если МодельСоздана Тогда
		УдалитьСсылку(Модель);
	КонецЕсли;
	Если ТССозданы Тогда
		УдалитьСсылку(ТС1);
		УдалитьСсылку(ТС2);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Удаляет созданный тестом документ плана техресурсов (с отменой проведения).
//
// Параметры:
//   ДокументСсылка - ДокументСсылка.Тх_ПланТехническихРесурсов, Неопределено -
//                    ссылка на документ теста.
//
Процедура УдалитьДокумент(ДокументСсылка)

	Если ДокументСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Объект = ДокументСсылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Объект.Удалить();
		КонецЕсли;
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Тест ДефицитМаксНуля (FR-012): доступность больше потребности -
// НехватаетСмен = 0, не отрицательное (контракт формулы РассчитатьДефицит).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестДефицитМаксНуля() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДефицитМаксНуля");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Модель = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// Потребность 10 смен, доступность своей модели 2 ед. x 10 дней = 20 смен.
			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.ВидРаботы = Работа;
			СтрПотребности.МодельТехники = Модель;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрДоступности = Доступность.Добавить();
			СтрДоступности.МодельТехники = Модель;
			СтрДоступности.ВидТехники = ВидТехники;
			СтрДоступности.ЕдиницДоступно = 2;

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			РезультатСопоставления = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);

			Проверить(Контекст, НСтр("ru = 'доступность своей модели = 2 x 10 x 1 = 20 смен'"),
				РезультатСопоставления.Доступно = 20,
				Строка(РезультатСопоставления.Доступно));

			Дефицит = ДефицитКонтракт(СтрПотребности.ПотребностьСмен,
				РезультатСопоставления.Доступно);
			Проверить(Контекст, НСтр("ru = 'дефицит = 0 при доступности больше потребности'"),
				Дефицит = 0,
				Строка(Дефицит));
			Проверить(Контекст, НСтр("ru = 'дефицит неотрицательный (FR-012)'"),
				Дефицит >= 0);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(Работа);
	УдалитьСсылку(Модель);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ТранспортныеРаботыМодельВМодельБезКоэффициентов (D-007, FAQ Q4):
// для автотранспорта K не применяется вообще - доступность =
// единицы x дни x смены; записанный для модели K игнорируется.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестТранспортныеРаботыМодельВМодельБезКоэффициентов() Экспорт

	Контекст = НовыйКонтекстТеста("ТестТранспортныеРаботыМодельВМодельБезКоэффициентов");
	ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт;
	Работа = Неопределено;
	МодельАвто = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		МодельАвто = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ МодельАвто = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// Ловушка: K для модели автотранспорта записан - не должен применяться.
			НаборЗаписей = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Работа.Установить(Работа);
			НаборЗаписей.Отбор.МодельТехники.Установить(МодельАвто);
			НаборЗаписей.Отбор.ВидТехники.Установить(ВидТехники);

			Запись = НаборЗаписей.Добавить();
			Запись.Период = Дата(2025, 1, 1);
			Запись.Работа = Работа;
			Запись.МодельТехники = МодельАвто;
			Запись.ВидТехники = ВидТехники;
			Запись.Коэффициент = 0.5;
			Запись.БазоваяМодель = Ложь;
			НаборЗаписей.Записать(Истина);

			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 5);
			СтрПотребности.ВидРаботы = Работа;
			СтрПотребности.МодельТехники = МодельАвто;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрДоступности = Доступность.Добавить();
			СтрДоступности.МодельТехники = МодельАвто;
			СтрДоступности.ВидТехники = ВидТехники;
			СтрДоступности.ЕдиницДоступно = 2;

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 5));
			РезультатСопоставления = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);

			Проверить(Контекст, НСтр("ru = 'доступность = единицы x дни x смены = 2 x 5 x 1 = 10'"),
				РезультатСопоставления.Доступно = 10,
				Строка(РезультатСопоставления.Доступно));
			Проверить(Контекст, НСтр("ru = 'K не применялся (иначе было бы 20)'"),
				РезультатСопоставления.Доступно <> 20);
			Проверить(Контекст, НСтр("ru = 'пометка КоэффициентНеЗадан не выставлена'"),
				НЕ РезультатСопоставления.КоэффициентНеЗадан);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Работа <> Неопределено И МодельАвто <> Неопределено Тогда
		ОчиститьКоэффициенты(Работа, ВидТехники, МодельАвто);
	КонецЕсли;
	УдалитьСсылку(Работа);
	УдалитьСсылку(МодельАвто);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ПланТехресурсовОтсутствует_ПометкаНеНоль (NFR-005, рек. B).
// ЗАВИСИТ ОТ ДАННЫХ ИБ: сквозной расчёт по реальному сценарию годового
// плана; строки подразделений без плана техресурсов получают
// ПланТехресурсовОтсутствует = Истина и НехватаетСмен = ПотребностьСмен
// (вся потребность), НЕ 0. При пустой потребности или отсутствии
// подразделений без плана - SKIP.
//
// Возвращаемое значение:
//   Булево - Истина, если проверки пройдены (или SKIP).
//
Функция ТестПланТехресурсовОтсутствует_ПометкаНеНоль() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПланТехресурсовОтсутствует_ПометкаНеНоль");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			// Снимок строк сценария - восстановить после теста (чужие расчёты не портим).
			СнимокРегистра = СнимокДефицита(Сценарий);

			ПараметрыРасчета = Новый Структура(
				"СценарийПланирования, Организация, Подразделение, СуффиксОбъема",
				Сценарий, Неопределено, Неопределено, "_Вер");
			ЗаписаноСтрок = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

			Проверить(Контекст, НСтр("ru = 'расчёт по сценарию записал строки'"),
				ЗаписаноСтрок > 0);

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	Д.ПотребностьСмен КАК ПотребностьСмен,
			|	Д.НехватаетСмен КАК НехватаетСмен
			|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
			|ГДЕ Д.СценарийПланирования = &Сценарий
			|	И Д.ПланТехресурсовОтсутствует";
			Запрос.УстановитьПараметр("Сценарий", Сценарий);

			ПомеченныеСтроки = 0;
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ПомеченныеСтроки = ПомеченныеСтроки + 1;
				Проверить(Контекст, НСтр("ru = 'помеченная строка: дефицит = вся потребность, не 0'"),
					Выборка.НехватаетСмен = Выборка.ПотребностьСмен
						И Выборка.ПотребностьСмен > 0,
					СтрШаблон(НСтр("ru = 'НехватаетСмен = %1, ПотребностьСмен = %2'"),
						Выборка.НехватаетСмен, Выборка.ПотребностьСмен));
			КонецЦикла;

			Если ПомеченныеСтроки = 0 Тогда
				Пропуск = НСтр("ru = 'у всех подразделений сценария есть план техресурсов - помеченных строк нет'");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ДетерминированностьПовторногоРасчета (NFR-005).
// ЗАВИСИТ ОТ ДАННЫХ ИБ: два расчёта с теми же параметрами - число строк
// и значения ресурсов идентичны (сравнение выгрузок регистра).
// При пустой потребности - SKIP.
//
// Возвращаемое значение:
//   Булево - Истина, если проверки пройдены (или SKIP).
//
Функция ТестДетерминированностьПовторногоРасчета() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДетерминированностьПовторногоРасчета");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			СнимокРегистра = СнимокДефицита(Сценарий);

			ПараметрыРасчета = Новый Структура(
				"СценарийПланирования, Организация, Подразделение, СуффиксОбъема",
				Сценарий, Неопределено, Неопределено, "_Вер");

			ЗаписаноПервый = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);
			ТаблицаПервая = ВыгрузкаДефицита(Сценарий);

			ЗаписаноВторой = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);
			ТаблицаВторая = ВыгрузкаДефицита(Сценарий);

			Проверить(Контекст, НСтр("ru = 'число записанных строк одинаково'"),
				ЗаписаноПервый = ЗаписаноВторой,
				СтрШаблон(НСтр("ru = '%1 и %2'"), ЗаписаноПервый, ЗаписаноВторой));
			Проверить(Контекст, НСтр("ru = 'число строк регистра одинаково'"),
				ТаблицаПервая.Количество() = ТаблицаВторая.Количество());
			Проверить(Контекст, НСтр("ru = 'значения всех строк идентичны'"),
				ТаблицыИдентичны(ТаблицаПервая, ТаблицаВторая));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ВалидацииGenericТипов (design §4.1, п. 2, TD-001): ссылка
// «правильного» справочника проходит ВалидироватьТипАПК, другого - нет,
// пустая ссылка - Ложь.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестВалидацииGenericТипов() Экспорт

	Контекст = НовыйКонтекстТеста("ТестВалидацииGenericТипов");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	РаботаСоздана = Ложь;
	МодельСоздана = Ложь;
	Пропуск = "";

	Попытка
		Работа = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Если Работа = Неопределено Тогда
			Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
			РаботаСоздана = Работа <> Неопределено;
		КонецЕсли;
		Модель = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники));
		Если Модель = Неопределено Тогда
			Модель = СоздатьМодель(ВидТехники);
			МодельСоздана = Модель <> Неопределено;
		КонецЕсли;

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось подготовить тестовые данные (справочники АПК)'");
		Иначе
			Проверить(Контекст, НСтр("ru = 'ссылка правильного справочника = Истина'"),
				Тх_ТехникаСервер.ВалидироватьТипАПК(Работа,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));

			Проверить(Контекст, НСтр("ru = 'ссылка другого справочника = Ложь (модель как работа)'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Модель,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));

			Проверить(Контекст, НСтр("ru = 'ссылка другого справочника = Ложь (работа как модель)'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Работа,
					Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники)));

			ПустаяРабота = Справочники[Тх_ТехникаСервер.ИмяСправочникаРабот()].ПустаяСсылка();
			Проверить(Контекст, НСтр("ru = 'пустая ссылка = Ложь'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(ПустаяРабота,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если РаботаСоздана Тогда
		УдалитьСсылку(Работа);
	КонецЕсли;
	Если МодельСоздана Тогда
		УдалитьСсылку(Модель);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Возвращает первый сценарий планирования, по которому в регистрах
// годового плана АПК есть потребность (рантайм-запрос, design §4.1).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - сценарий с потребностью;
//   Неопределено - потребности нет или модуль АПК недоступен.
//
Функция СценарийСПотребностью()

	Результат = Неопределено;

	// Имена таблиц годового плана - динамические (runtime, design 4.1/TD-001).
	// 8.5: таблицы записей (виртуальная таблица оборотов требует измерения
	// в выборке, для проверки существования потребности она не нужна).
	ИмяРегистраМехРабот = "АпкМеханизированныеРаботыПоГодовомуПлану";
	ИмяРегистраТранРабот = "АпкТранспортныеРаботыПоГодовомуПлану";

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.СценарийПланирования КАК СценарийПланирования
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			М.СценарийПланирования КАК СценарийПланирования
	|		ИЗ РегистрНакопления." + ИмяРегистраМехРабот + " КАК М
	|		ГДЕ М.СценарийПланирования <> ЗНАЧЕНИЕ(Справочник.АпкСценарииПланирования.ПустаяСсылка)
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Тран.СценарийПланирования
	|		ИЗ РегистрНакопления." + ИмяРегистраТранРабот + " КАК Тран
	|		ГДЕ Тран.СценарийПланирования <> ЗНАЧЕНИЕ(Справочник.АпкСценарииПланирования.ПустаяСсылка)
	|	) КАК Т";

	Попытка
		Выборка = Тх_ТехникаСервер.ВыполнитьЗапросАПК(ТекстЗапроса).Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.СценарийПланирования;
		КонецЕсли;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает снимок строк регистра Тх_ДефицитТехники по сценарию
// (для восстановления после сквозных тестов).
//
// Параметры:
//   Сценарий - СправочникСсылка - сценарий планирования.
//
// Возвращаемое значение:
//   ТаблицаЗначений - выгрузка набора записей сценария.
//
Функция СнимокДефицита(Сценарий)

	НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СценарийПланирования.Установить(Сценарий);
	НаборЗаписей.Прочитать();

	Возврат НаборЗаписей.Выгрузить();

КонецФункции

// Восстанавливает строки регистра Тх_ДефицитТехники по сценарию из снимка.
//
// Параметры:
//   Сценарий  - СправочникСсылка - сценарий планирования;
//   Снимок    - ТаблицаЗначений - выгрузка СнимокДефицита.
//
Процедура ВосстановитьДефицит(Сценарий, Снимок)

	Попытка
		НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СценарийПланирования.Установить(Сценарий);
		НаборЗаписей.Загрузить(Снимок);
		НаборЗаписей.Записать(Истина);
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Возвращает выгрузку строк регистра Тх_ДефицитТехники по сценарию,
// упорядоченную по измерениям (для сравнения повторных расчётов).
//
// Параметры:
//   Сценарий - СправочникСсылка - сценарий планирования.
//
// Возвращаемое значение:
//   ТаблицаЗначений - все измерения и ресурсы регистра.
//
Функция ВыгрузкаДефицита(Сценарий)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Д.Организация КАК Организация,
	|	Д.Подразделение КАК Подразделение,
	|	Д.ПериодНачала КАК ПериодНачала,
	|	Д.ПериодОкончания КАК ПериодОкончания,
	|	Д.ВидРаботы КАК ВидРаботы,
	|	Д.МодельТехники КАК МодельТехники,
	|	Д.ВидТехники КАК ВидТехники,
	|	Д.ПотребностьСмен КАК ПотребностьСмен,
	|	Д.ДоступноСмен КАК ДоступноСмен,
	|	Д.НехватаетСмен КАК НехватаетСмен,
	|	Д.ДнейПериода КАК ДнейПериода,
	|	Д.СменВДень КАК СменВДень,
	|	Д.КоэффициентНеЗадан КАК КоэффициентНеЗадан,
	|	Д.ПланТехресурсовОтсутствует КАК ПланТехресурсовОтсутствует
	|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
	|ГДЕ Д.СценарийПланирования = &Сценарий
	|УПОРЯДОЧИТЬ ПО
	|	Д.Организация,
	|	Д.Подразделение,
	|	Д.ПериодНачала,
	|	Д.ПериодОкончания,
	|	Д.ВидРаботы,
	|	Д.МодельТехники,
	|	Д.ВидТехники";
	Запрос.УстановитьПараметр("Сценарий", Сценарий);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сравнивает две выгрузки регистра построчно и по колонкам.
//
// Параметры:
//   ТаблицаПервая  - ТаблицаЗначений - первая выгрузка;
//   ТаблицаВторая  - ТаблицаЗначений - вторая выгрузка.
//
// Возвращаемое значение:
//   Булево - Истина, если количество строк и все значения совпадают.
//
Функция ТаблицыИдентичны(ТаблицаПервая, ТаблицаВторая)

	Если ТаблицаПервая.Количество() <> ТаблицаВторая.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСтроки = 0 По ТаблицаПервая.Количество() - 1 Цикл
		Для Каждого Колонка Из ТаблицаПервая.Колонки Цикл
			Если ТаблицаПервая[НомерСтроки][Колонка.Имя]
				<> ТаблицаВторая[НомерСтроки][Колонка.Имя] Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Тесты_Сцепка

// Тест ВалидироватьСцепку (FR-002, design 5.3): совместимые пары
// (СХ-техника + СХ-оборудование, автотранспорт + прицеп) проходят,
// несовместимые отклоняются, незаполненная половина сцепкой не считается.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестВалидацииСцепки() Экспорт

	Контекст = НовыйКонтекстТеста("ТестВалидацииСцепки");

	МодельСХ = Неопределено;
	МодельАвто = Неопределено;
	ОборудованиеСХ = Неопределено;
	Прицеп = Неопределено;

	Попытка
		МодельСХ = СоздатьМодель(Перечисления.Тх_ВидыТехники.СХТехника);
		МодельАвто = СоздатьМодель(Перечисления.Тх_ВидыТехники.Автотранспорт);
		ОборудованиеСХ = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделейСХОборудования());
		Прицеп = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделейПрицепов());

		Если МодельСХ = Неопределено ИЛИ МодельАвто = Неопределено
			ИЛИ ОборудованиеСХ = Неопределено ИЛИ Прицеп = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Проверить(Контекст, НСтр("ru = 'СХ-техника + СХ-оборудование = совместимо'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, ОборудованиеСХ));

		Проверить(Контекст, НСтр("ru = 'автотранспорт + прицеп = совместимо'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельАвто, Прицеп));

		Проверить(Контекст, НСтр("ru = 'СХ-техника + прицеп = несовместимо'"),
			НЕ Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, Прицеп));

		Проверить(Контекст, НСтр("ru = 'автотранспорт + СХ-оборудование = несовместимо'"),
			НЕ Тх_ТехникаСервер.ВалидироватьСцепку(МодельАвто, ОборудованиеСХ));

		Проверить(Контекст, НСтр("ru = 'пустое оборудование - сцепка не проверяется'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, Неопределено));

		Проверить(Контекст, НСтр("ru = 'пустая модель - сцепка не проверяется'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(Неопределено, ОборудованиеСХ));

	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельСХ);
	УдалитьСсылку(МодельАвто);
	УдалитьСсылку(ОборудованиеСХ);
	УдалитьСсылку(Прицеп);

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_КоэффициентЗамещения

// Тест приоритета ручных реквизитов замещения (FR-004, design 6.4):
// у моделей СХ-техники заполнены ручной коэффициент, ширина и мощность -
// базовым должен стать ручной КоэффициентПереводаВУЭГА; К = 6/4 = 1.5.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияПриоритетРучного() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияПриоритетРучного");

	МодельА = Неопределено;
	МодельБ = Неопределено;

	Попытка
		МодельА = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 4));
		МодельБ = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 6));

		Если МодельА = Неопределено ИЛИ МодельБ = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(МодельА);

		Проверить(Контекст, НСтр("ru = 'базовый реквизит возвращается'"),
			Реквизит <> Неопределено);

		Если Реквизит <> Неопределено Тогда
			Проверить(Контекст, НСтр("ru = 'приоритет ручного КоэффициентПереводаВУЭГА'"),
				Реквизит.Реквизит = "КоэффициентПереводаВУЭГА");

			К = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ);
			Проверить(Контекст, НСтр("ru = 'К = 6/4 = 1.5'"),
				К <> Неопределено И К > 1.499 И К < 1.501);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельА);
	УдалитьСсылку(МодельБ);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест замещения по ширине обработки (FR-004, acceptance: ширина 1.5x):
// модели СХ-техники без ручных реквизитов, ширина 2 и 3 - К = 1.5.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияПоШирине() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияПоШирине");

	МодельА = Неопределено;
	МодельБ = Неопределено;

	Попытка
		МодельА = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 2));
		МодельБ = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 3));

		Если МодельА = Неопределено ИЛИ МодельБ = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(МодельА);
		Проверить(Контекст, НСтр("ru = 'базовый реквизит - ШиринаОбработки'"),
			Реквизит <> Неопределено И Реквизит.Реквизит = "ШиринаОбработки");

		К = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ);
		Проверить(Контекст, НСтр("ru = 'К = 3/2 = 1.5 (ширина 1.5x)'"),
			К <> Неопределено И К > 1.499 И К < 1.501);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельА);
	УдалитьСсылку(МодельБ);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест стартового расчёта по мощности двигателя и прочих каталогов:
// СХ-техника без ручных реквизитов - старт по МощностьДвигателя (К = 1.5);
// автотранспорт по Грузоподъемность (К = 2); прицепы по Вместимость (К = 2).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияСтартИПрочиеКаталоги() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияСтартИПрочиеКаталоги");

	Модели = Новый Массив;

	Попытка
		Трактор100 = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 100));
		Трактор150 = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 150));
		Грузовик5 = СоздатьЭлемент("АпкМоделиАвтотранспорта",
			Новый Структура("Грузоподъемность", 5));
		Грузовик10 = СоздатьЭлемент("АпкМоделиАвтотранспорта",
			Новый Структура("Грузоподъемность", 10));
		Прицеп10 = СоздатьЭлемент("АпкМоделиПрицепов",
			Новый Структура("Вместимость", 10));
		Прицеп20 = СоздатьЭлемент("АпкМоделиПрицепов",
			Новый Структура("Вместимость", 20));
		Модели.Добавить(Трактор100);
		Модели.Добавить(Трактор150);
		Модели.Добавить(Грузовик5);
		Модели.Добавить(Грузовик10);
		Модели.Добавить(Прицеп10);
		Модели.Добавить(Прицеп20);

		Если Трактор100 = Неопределено ИЛИ Грузовик5 = Неопределено ИЛИ Прицеп10 = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(Трактор100);
		Проверить(Контекст, НСтр("ru = 'старт по МощностьДвигателя'"),
			Реквизит <> Неопределено И Реквизит.Реквизит = "МощностьДвигателя");

		КМощь = Тх_ТехникаСервер.КоэффициентЗамещения(Трактор100, Трактор150);
		Проверить(Контекст, НСтр("ru = 'К по мощности = 150/100 = 1.5'"),
			КМощь <> Неопределено И КМощь > 1.499 И КМощь < 1.501);

		КГруз = Тх_ТехникаСервер.КоэффициентЗамещения(Грузовик5, Грузовик10);
		Проверить(Контекст, НСтр("ru = 'К по грузоподъемности = 10/5 = 2'"),
			КГруз <> Неопределено И КГруз > 1.999 И КГруз < 2.001);

		КПрицеп = Тх_ТехникаСервер.КоэффициентЗамещения(Прицеп10, Прицеп20);
		Проверить(Контекст, НСтр("ru = 'К по вместимости прицепов = 20/10 = 2'"),
			КПрицеп <> Неопределено И КПрицеп > 1.999 И КПрицеп < 2.001);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Для Каждого Модель Из Модели Цикл
		УдалитьСсылку(Модель);
	КонецЦикла;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест КоэффициентНеЗадан (FR-004): пустые реквизиты, разные базовые
// реквизиты, разные каталоги - везде Неопределено.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияНеЗадан() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияНеЗадан");

	Модели = Новый Массив;

	Попытка
		ОборудованиеПустое = СоздатьЭлемент("АпкМоделиСХОборудования");
		ОборудованиеШирокое = СоздатьЭлемент("АпкМоделиСХОборудования",
			Новый Структура("ШиринаОбработки", 4));
		МодельРучная = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 4));
		МодельМощная = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 100));
		Модели.Добавить(ОборудованиеПустое);
		Модели.Добавить(ОборудованиеШирокое);
		Модели.Добавить(МодельРучная);
		Модели.Добавить(МодельМощная);

		Если ОборудованиеПустое = Неопределено ИЛИ МодельРучная = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Проверить(Контекст, НСтр("ru = 'СХ-оборудование без ширины - Неопределено'"),
			Тх_ТехникаСервер.РеквизитЗамещения(ОборудованиеПустое) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'у замены не заполнен реквизит - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(ОборудованиеШирокое, ОборудованиеПустое) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'разные базовые реквизиты - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(МодельРучная, МодельМощная) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'разные каталоги - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(МодельМощная, ОборудованиеШирокое) = Неопределено);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Для Каждого Модель Из Модели Цикл
		УдалитьСсылку(Модель);
	КонецЦикла;

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

// Тест АвтозаполнениеПоМощности (design §4.6, TD-004/TD-005, кейс s02):
// K = Мб/Ма; базовая модель получает K = 1,0000 и БазоваяМодель = Истина.
// Создаются две модели с мощностью 100 и 125 л.с.: K аналога = 100/125 = 0,8.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестАвтозаполнениеПоМощности() Экспорт

	Контекст = НовыйКонтекстТеста("ТестАвтозаполнениеПоМощности");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	МодельБазовая = Неопределено;
	МодельАналог = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		МодельБазовая = СоздатьМодель(ВидТехники, 100);
		МодельАналог = СоздатьМодель(ВидТехники, 125);

		Если Работа = Неопределено ИЛИ МодельБазовая = Неопределено ИЛИ МодельАналог = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			ПараметрыАвтозаполнения = Новый Структура(
				"Работа, ВидТехники, Период, БазоваяМодель",
				Работа, ВидТехники, Дата(2025, 1, 1), МодельБазовая);
			Тх_ТехникаСервер.АвтозаполнениеПоМощности(ПараметрыАвтозаполнения);

			КонтрольныйНабор = РегистрыСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
			КонтрольныйНабор.Отбор.Период.Установить(Дата(2025, 1, 1));
			КонтрольныйНабор.Отбор.Работа.Установить(Работа);
			КонтрольныйНабор.Отбор.ВидТехники.Установить(ВидТехники);
			КонтрольныйНабор.Прочитать();

			СтрокаБазовой = Неопределено;
			СтрокаАналога = Неопределено;
			Для Каждого Запись Из КонтрольныйНабор Цикл
				Если Запись.МодельТехники = МодельБазовая Тогда
					СтрокаБазовой = Запись;
				ИначеЕсли Запись.МодельТехники = МодельАналог Тогда
					СтрокаАналога = Запись;
				КонецЕсли;
			КонецЦикла;

			Проверить(Контекст, НСтр("ru = 'строка базовой модели создана'"),
				СтрокаБазовой <> Неопределено);
			Если СтрокаБазовой <> Неопределено Тогда
				Проверить(Контекст, НСтр("ru = 'базовая модель: K = 1'"),
					СтрокаБазовой.Коэффициент = 1);
				Проверить(Контекст, НСтр("ru = 'базовая модель: признак БазоваяМодель'"),
					СтрокаБазовой.БазоваяМодель);
			КонецЕсли;

			Проверить(Контекст, НСтр("ru = 'строка аналога создана'"),
				СтрокаАналога <> Неопределено);
			Если СтрокаАналога <> Неопределено Тогда
				Проверить(Контекст, НСтр("ru = 'аналог: K = Мб/Ма = 100/125 = 0,8 (кейс s02)'"),
					СтрокаАналога.Коэффициент = 0.8);
				Проверить(Контекст, НСтр("ru = 'аналог: не базовая модель'"),
					НЕ СтрокаАналога.БазоваяМодель);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Работа <> Неопределено Тогда
		ОчиститьКоэффициенты(Работа, ВидТехники);
	КонецЕсли;
	УдалитьСсылку(Работа);
	УдалитьСсылку(МодельБазовая);
	УдалитьСсылку(МодельАналог);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции


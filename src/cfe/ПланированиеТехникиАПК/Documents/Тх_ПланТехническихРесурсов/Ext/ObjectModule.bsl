// Модуль объекта документа «Тх_ПланТехническихРесурсов».
//
// Проведение (design 4.4):
//  (а) заполненность шапки: Организация, Подразделение, СценарийПланирования;
//      сценарий - generic-ссылка, тип проверяется рантаймом (design 4.1, TD-001);
//  (б) строки табличных частей: транспортное средство обязательно (Q-003),
//      количество больше нуля;
//  (в) транспортное средство не может повторяться в документе (в пределах
//      одной ТЧ и между ТЧ) - отказ;
//  (г) то же ТС принято в другом подразделении того же сценария -
//      неблокирующее предупреждение (FAQ Q5), проведение проходит.
//  (д) сцепка «модель + оборудование» в ТЧ ОсновнаяТехника/Автотранспорт -
//      отказ записи при несочетаемой паре (FR-002, T4).
//
// Движения документ не создаёт (FAQ Q9): расчёт дефицита (A7) читает
// табличные части запросом по Проведен = ИСТИНА.

// Проверяет совместимость сцепки «модель + оборудование» в строках ТЧ
// ОсновнаяТехника и Автотранспорт при любой записи документа (FR-002,
// design 5.3): несочетаемая пара - отказ записи. ТЧ Оборудование сцепки
// не содержит (единственная модель, FAQ Q1).
//
// Параметры:
//   Отказ         - Булево - признак отказа записи;
//   РежимЗаписи   - РежимЗаписиДокумента - режим записи (не используется);
//   РежимПроведения - РежимПроведенияДокумента - режим проведения (не используется).
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ПроверитьСцепкуТабличныхЧастей(Отказ);

КонецПроцедуры

// Перебирает строки ТЧ с колонками «МодельТехники» и «Оборудование»
// и фиксирует отказ для несовместимых сцепок.
//
// Параметры:
//   Отказ - Булево - признак отказа записи.
//
Процедура ПроверитьСцепкуТабличныхЧастей(Отказ)

	Пары = Новый Массив;
	Пары.Добавить(Новый Структура("Коллекция, ИмяТЧ", ОсновнаяТехника, "Основная техника"));
	Пары.Добавить(Новый Структура("Коллекция, ИмяТЧ", Автотранспорт, "Автотранспорт"));

	Для Каждого Пара Из Пары Цикл
		НомерСтроки = 0;
		Для Каждого СтрокаТЧ Из Пара.Коллекция Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НЕ Тх_ТехникаСервер.ВалидироватьСцепку(СтрокаТЧ.МодельТехники, СтрокаТЧ.Оборудование) Тогда
				Отказ = Истина;
				СообщитьОбОшибке(СтрШаблон("Табличная часть «%1», строка %2:
					|несовместимая сцепка - модель «%3» и оборудование «%4».",
					Пара.ИмяТЧ, НомерСтроки, СтрокаТЧ.МодельТехники, СтрокаТЧ.Оборудование));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроверитьШапку(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ЗанятыеТС = Новый Соответствие;
	ПринятыеТС = Новый Соответствие;

	ПроверитьТабличнуюЧасть(ОсновнаяТехника, "Основная техника", ЗанятыеТС, ПринятыеТС, Отказ);
	ПроверитьТабличнуюЧасть(Оборудование, "Оборудование", ЗанятыеТС, ПринятыеТС, Отказ);
	ПроверитьТабличнуюЧасть(Автотранспорт, "Автотранспорт", ЗанятыеТС, ПринятыеТС, Отказ);

	Если НЕ Отказ Тогда
		ПредупредитьОПриемкеВДругихПодразделениях(ПринятыеТС);
	КонецЕсли;

КонецПроцедуры

// Проверяет заполненность шапки и тип сценария планирования (design 4.1, п. 2).
//
// Параметры:
//   Отказ - Булево - признак отказа проведения.
//
Процедура ПроверитьШапку(Отказ)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не заполнена организация.");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не заполнено подразделение.");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не заполнен сценарий планирования.");
	Иначе
		ТипСценария = ТипСценарияПланирования();
		Если ТипСценария <> Неопределено
			И ТипЗнч(СценарийПланирования) <> ТипСценария Тогда
			Отказ = Истина;
			СообщитьОбОшибке("Сценарий планирования должен быть элементом справочника
				|«АпкСценарииПланирования».");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Проверяет строки табличной части: заполненность ТС, положительное количество,
// уникальность ТС в документе. Накапливает множество принятых ТС для предупреждения.
//
// Параметры:
//   Коллекция  - ТабличнаяЧасть - проверяемая табличная часть документа;
//   ИмяТЧ      - Строка - представление табличной части для сообщений;
//   ЗанятыеТС  - Соответствие - ТС всего документа (ключ - строка ссылки ТС);
//   ПринятыеТС - Соответствие - ТС с Принят = Истина;
//   Отказ      - Булево - признак отказа проведения.
Процедура ПроверитьТабличнуюЧасть(Коллекция, ИмяТЧ, ЗанятыеТС, ПринятыеТС, Отказ)

	НомерСтроки = 0;
	Для Каждого СтрокаТЧ Из Коллекция Цикл
		НомерСтроки = НомерСтроки + 1;

		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ТранспортноеСредство) Тогда
			Отказ = Истина;
			СообщитьОбОшибке(СтрШаблон("Табличная часть «%1», строка %2:
				|не заполнено транспортное средство.", ИмяТЧ, НомерСтроки));
			Продолжить;
		КонецЕсли;

		Если СтрокаТЧ.Количество <= 0 Тогда
			Отказ = Истина;
			СообщитьОбОшибке(СтрШаблон("Табличная часть «%1», строка %2 (%3):
				|количество должно быть больше нуля.",
				ИмяТЧ, НомерСтроки, СтрокаТЧ.ТранспортноеСредство));
		КонецЕсли;

		КлючТС = Строка(СтрокаТЧ.ТранспортноеСредство);
		Если ЗанятыеТС[КлючТС] <> Неопределено Тогда
			Отказ = Истина;
			СообщитьОбОшибке(СтрШаблон("Транспортное средство «%1» указано
				|в документе более одного раза.", СтрокаТЧ.ТранспортноеСредство));
		Иначе
			ЗанятыеТС.Вставить(КлючТС, СтрокаТЧ.ТранспортноеСредство);
		КонецЕсли;

		Если СтрокаТЧ.Принят Тогда
			ПринятыеТС.Вставить(КлючТС, СтрокаТЧ.ТранспортноеСредство);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Неблокирующее предупреждение (design 4.4, edge cases): то же ТС уже принято
// в проведённом плане другого подразделения того же сценария.
// Предупреждение не препятствует проведению.
//
// Параметры:
//   ПринятыеТС - Соответствие - принятые ТС текущего документа.
Процедура ПредупредитьОПриемкеВДругихПодразделениях(ПринятыеТС)

	Если ПринятыеТС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Реквизиты Проведен/СценарийПланирования/Подразделение - шапка документа,
	// источник строк - табличная часть: обязательное соединение с таблицей
	// документа (как в ЗапросДоступности), иначе «Поле не найдено».
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Осн.ТранспортноеСредство КАК ТранспортноеСредство
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.ОсновнаяТехника КАК Осн
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
		|		ПО Осн.Ссылка = Д.Ссылка
		|ГДЕ
		|	Д.Ссылка <> &Ссылка
		|	И Д.Проведен
		|	И Осн.Принят
		|	И Д.СценарийПланирования = &СценарийПланирования
		|	И Д.Подразделение <> &Подразделение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Обор.ТранспортноеСредство
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.Оборудование КАК Обор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д2
		|		ПО Обор.Ссылка = Д2.Ссылка
		|ГДЕ
		|	Д2.Ссылка <> &Ссылка
		|	И Д2.Проведен
		|	И Обор.Принят
		|	И Д2.СценарийПланирования = &СценарийПланирования
		|	И Д2.Подразделение <> &Подразделение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Авто.ТранспортноеСредство
		|ИЗ
		|	Документ.Тх_ПланТехническихРесурсов.Автотранспорт КАК Авто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д3
		|		ПО Авто.Ссылка = Д3.Ссылка
		|ГДЕ
		|	Д3.Ссылка <> &Ссылка
		|	И Д3.Проведен
		|	И Авто.Принят
		|	И Д3.СценарийПланирования = &СценарийПланирования
		|	И Д3.Подразделение <> &Подразделение");

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СценарийПланирования", СценарийПланирования);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПринятыеТС[Строка(Выборка.ТранспортноеСредство)] <> Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Транспортное средство «%1» уже принято
				|в плане технических ресурсов другого подразделения (тот же сценарий).",
				Выборка.ТранспортноеСредство);
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает тип справочника сценариев планирования (design 4.1, п. 3).
// Если расширение №1 «Расширение_АПК» отключено, Тип() вызывает исключение -
// возвращается Неопределено, и проверка типа пропускается (объекты расширения №2
// остаются работоспособными, design §3, ФАКТ-1).
//
// Возвращаемое значение:
//   Тип - тип «СправочникСсылка.АпкСценарииПланирования»;
//   Неопределено - целевой объект недоступен (модуль АПК отключён).
Функция ТипСценарияПланирования()

	Попытка
		Возврат Тип("СправочникСсылка.АпкСценарииПланирования");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Выводит немодальное сообщение об ошибке проведения (NFR-001).
//
// Параметры:
//   Текст - Строка - текст сообщения.
Процедура СообщитьОбОшибке(Текст)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

// Общий модуль «Тх_ТехникаСервер» - единое место серверной логики расширения
// «ПланированиеТехникиАПК» (design §4.7):
//  - константы строковых имён объектов АПК (design §4.1, п. 3, TD-001);
//  - обёртка рантайм-запросов к расширению №1 с диагностикой «модуль АПК
//    отключён» (design §5);
//  - функции дат и выборки коэффициентов на дату (FAQ Q1, FR-001);
//  - запросы потребности (регистры годового плана АПК) и доступности
//    (документ Тх_ПланТехническихРесурсов) - подготовка к расчёту дефицита (A7);
//  - автозаполнение коэффициентов пересчёта по мощности (design §4.6, TD-005).
//
// Модуль серверный и привилегированный: доступ к данным расширения №1
// выполняется рантайм-запросами по строковым именам таблиц (design §4.1).

#Область ИменаОбъектовАПК

// Возвращает строковое имя справочника видов работ (core ERP, digest §4).
//
// Возвращаемое значение:
//   Строка - имя справочника "ВидыРаботСотрудников".
//
Функция ИмяСправочникаРабот() Экспорт

	Возврат "ВидыРаботСотрудников";

КонецФункции

// Возвращает строковое имя справочника сценариев планирования
// (расширение №1, design §4.1).
//
// Возвращаемое значение:
//   Строка - имя справочника "АпкСценарииПланирования".
//
Функция ИмяСправочникаСценариевПланирования() Экспорт

	Возврат "АпкСценарииПланирования";

КонецФункции

// Возвращает строковое имя справочника моделей техники по виду техники
// (design §4.1: АпкМоделиСХТехники / АпкМоделиАвтотранспорта).
// Для вида «Оборудование» целевой каталог моделей не определён.
//
// Параметры:
//   ВидТехники - ПеречислениеСсылка.Тх_ВидыТехники - вид техники.
//
// Возвращаемое значение:
//   Строка - имя справочника моделей; пустая строка - каталог не определён.
//
Функция ИмяСправочникаМоделей(ВидТехники) Экспорт

	Если ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника Тогда
		Возврат "АпкМоделиСХТехники";
	ИначеЕсли ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		Возврат "АпкМоделиАвтотранспорта";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Возвращает строковое имя типа ссылок справочника моделей по виду техники
// (для рантайм-валидации generic-ссылок, design §4.1, п. 2).
//
// Параметры:
//   ВидТехники - ПеречислениеСсылка.Тх_ВидыТехники - вид техники.
//
// Возвращаемое значение:
//   Строка - имя типа ("СправочникСсылка.АпкМоделиСХТехники" и т.п.);
//            пустая строка - каталог моделей не определён.
//
Функция ИмяТипаМодели(ВидТехники) Экспорт

	ИмяСправочника = ИмяСправочникаМоделей(ВидТехники);
	Если ИмяСправочника = "" Тогда
		Возврат "";
	КонецЕсли;

	Возврат "СправочникСсылка." + ИмяСправочника;

КонецФункции

// Возвращает строковое имя справочника моделей с/х оборудования
// (расширение №1, digest §1, §3).
//
// Возвращаемое значение:
//   Строка - имя справочника "АпкМоделиСХОборудования".
//
Функция ИмяСправочникаМоделейСХОборудования() Экспорт

	Возврат "АпкМоделиСХОборудования";

КонецФункции

// Возвращает строковое имя справочника моделей прицепов
// (расширение №1, digest §1, §3).
//
// Возвращаемое значение:
//   Строка - имя справочника "АпкМоделиПрицепов".
//
Функция ИмяСправочникаМоделейПрицепов() Экспорт

	Возврат "АпкМоделиПрицепов";

КонецФункции

#КонецОбласти

#Область РантаймДоступКДаннымАПК

// Выполняет запрос к таблицам расширения №1 (рантайм-компиляция текста,
// design §4.1, п. 1). При недоступности модуля АПК прерывает расчёт
// понятным сообщением (design §5, §8).
//
// Параметры:
//   Текст      - Строка - текст запроса (имена таблиц - явные строковые);
//   Параметры  - Структура, Неопределено - параметры запроса.
//
// Возвращаемое значение:
//   РезультатЗапроса - результат выполнения запроса.
//
// Пример:
//   ВызватьИсключение с текстом «Модуль АПК отключён, расчёт невозможен».
//
Функция ВыполнитьЗапросАПК(Текст, Параметры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = Текст;

	Если Параметры <> Неопределено Тогда
		Для Каждого КлючЗначение Из Параметры Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Модуль АПК отключён, расчёт невозможен: %1'"),
			ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверяет, что значение - ссылка справочника с указанным именем
// (рантайм-валидация generic-ссылок, design §4.1, п. 2).
//
// Параметры:
//   Значение    - ЛюбаяСсылка - проверяемое значение;
//   ИмяОбъекта  - Строка - имя справочника (например, "ВидыРаботСотрудников").
//
// Возвращаемое значение:
//   Булево - Истина, если тип значения совпадает с типом справочника.
//
Функция ВалидироватьТипАПК(Значение, ИмяОбъекта) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Значение) = Тип("СправочникСсылка." + ИмяОбъекта);

КонецФункции

// Возвращает мощность двигателя модели техники (рантайм-запрос, design §4.1:
// реквизит недоступен типами расширения №2, только запросом).
//
// Параметры:
//   Модель - СправочникСсылка - ссылка на элемент каталога моделей АПК.
//
// Возвращаемое значение:
//   Число - мощность двигателя модели; 0 - не заполнена или не найдена.
//
Функция МощностьДвигателяМодели(Модель) Экспорт

	Результат = 0;

	Если НЕ ЗначениеЗаполнено(Модель) Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяСправочника = ИмяСправочникаПоТипуСсылки(Модель);
	Если ИмяСправочника = "" Тогда
		Возврат Результат;
	КонецЕсли;

	// TODO-VERIFY: реквизит «МощностьДвигателя» подтверждён по исходникам АПК 2.5
	// только для справочника «АпкМоделиСХТехники» (digest §4); для остальных
	// каталогов моделей имя реквизита не проверено (проверка при B3/B5).
	ТекстЗапроса = "ВЫБРАТЬ
	|	Спр.МощностьДвигателя КАК МощностьДвигателя
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ Спр.Ссылка = &Модель";

	РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса, Новый Структура("Модель", Модель));
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.МощностьДвигателя;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает имя справочника по строковому представлению типа ссылки.
//
// Параметры:
//   Значение - СправочникСсылка - значение ссылки.
//
// Возвращаемое значение:
//   Строка - имя справочника; пустая строка - значение не ссылка справочника.
//
Функция ИмяСправочникаПоТипуСсылки(Значение)

	ИмяТипа = Строка(ТипЗнч(Значение));
	Префикс = "СправочникСсылка.";
	Если СтрНачинаетсяС(ИмяТипа, Префикс) Тогда
		Возврат Сред(ИмяТипа, СтрДлина(Префикс) + 1);
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ФункцииДатИКоэффициентов

// Возвращает число календарных дней периода, границы включены (FAQ Q1):
// (Окончание - Начало + 1) день. Производственный календарь - v2.
//
// Параметры:
//   НачалоПериода  - Дата - дата начала интервала;
//   ОкончаниеПериода - Дата - дата окончания интервала.
//
// Возвращаемое значение:
//   Число - число календарных дней; 0 - даты не заполнены или интервал пуст.
//
Функция ЧислоДнейПериода(НачалоПериода, ОкончаниеПериода) Экспорт

	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
		Возврат 0;
	КонецЕсли;

	Дней = РазностьДат(НачалоДня(НачалоПериода), НачалоДня(ОкончаниеПериода), "ДЕНЬ") + 1;

	Возврат Макс(Дней, 0);

КонецФункции

// Возвращает точность округления коэффициента пересчёта (разрядность ресурса
// «Коэффициент» регистра Тх_КоэффициентыПересчетаРабот - 4 знака, design §4.3).
//
// Возвращаемое значение:
//   Число - число знаков округления.
//
Функция ТочностьКоэффициента()

	Возврат 4;

КонецФункции

// Возвращает коэффициент пересчёта на дату: последняя запись регистра
// Тх_КоэффициентыПересчетаРабот с Период <= ДатаВзятия (design §4.3, FR-001).
//
// Параметры:
//   Работа          - СправочникСсылка - вид работы (ВидыРаботСотрудников);
//   МодельТехники   - СправочникСсылка - модель техники;
//   ВидТехники      - ПеречислениеСсылка.Тх_ВидыТехники - вид техники;
//   ДатаВзятия      - Дата - дата, на которую берётся коэффициент.
//
// Возвращаемое значение:
//   Число, Неопределено - коэффициент; Неопределено - записей нет (FR-011).
//
Функция КоэффициентНаДату(Работа, МодельТехники, ВидТехники, ДатаВзятия) Экспорт

	Если НЕ ЗначениеЗаполнено(Работа) ИЛИ НЕ ЗначениеЗаполнено(МодельТехники)
		ИЛИ НЕ ЗначениеЗаполнено(ВидТехники) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДатаОтбора = ?(ЗначениеЗаполнено(ДатаВзятия), ДатаВзятия, ТекущаяДатаСеанса());

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Коэф.Коэффициент КАК Коэффициент
	|ИЗ РегистрСведений.Тх_КоэффициентыПересчетаРабот КАК Коэф
	|ГДЕ Коэф.Работа = &Работа
	|	И Коэф.МодельТехники = &МодельТехники
	|	И Коэф.ВидТехники = &ВидТехники
	|	И Коэф.Период <= &ДатаВзятия
	|УПОРЯДОЧИТЬ ПО Коэф.Период УБЫВ";
	Запрос.УстановитьПараметр("Работа", Работа);
	Запрос.УстановитьПараметр("МодельТехники", МодельТехники);
	Запрос.УстановитьПараметр("ВидТехники", ВидТехники);
	Запрос.УстановитьПараметр("ДатаВзятия", ДатаОтбора);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Коэффициент;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ЗапросыРасчетаДефицита

// Возвращает потребность в сменах по регистрам годового плана АПК
// (design §4.7, шаг 1, TD-002): UNION ALL механизированных работ
// (техника, вид СХТехника) и транспортных работ (автомобиль, вид
// Автотранспорт), агрегировано до интервалов строк техкарт.
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор, если заполнено;
//     * ДатаНачала      - Дата - левая граница диапазона запуска;
//     * ДатаОкончания   - Дата - правая граница диапазона запуска;
//     * СуффиксОбъема   - Строка - "_Мин"/"_Вер"/"_Макс" (FAQ Q3, default "_Вер").
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: СценарийПланирования, Организация, Подразделение,
//     ПериодНачала, ПериодОкончания, ВидРаботы, МодельТехники, ВидТехники,
//     ПотребностьСмен.
//
Функция ЗапросПотребности(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос потребности невозможен.'");
	КонецЕсли;

	Суффикс = СуффиксОбъема(Параметры);

	ДатаНачала = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1));
	ДатаОкончания = ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31));

	УсловияМеханизированных = "М.СценарийПланирования = &СценарийПланирования
	|	И М.ПериодОкончания >= &ДатаНачала
	|	И М.ПериодНачала <= &ДатаОкончания";
	УсловияТранспортных = "Тран.СценарийПланирования = &СценарийПланирования
	|	И Тран.ПериодОкончания >= &ДатаНачала
	|	И Тран.ПериодНачала <= &ДатаОкончания";

	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Организация = &Организация";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Организация = &Организация";
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Подразделение = &Подразделение";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Подразделение = &Подразделение";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.СценарийПланирования КАК СценарийПланирования,
	|	Т.Организация КАК Организация,
	|	Т.Подразделение КАК Подразделение,
	|	Т.ПериодНачала КАК ПериодНачала,
	|	Т.ПериодОкончания КАК ПериодОкончания,
	|	Т.ВидРаботы КАК ВидРаботы,
	|	Т.МодельТехники КАК МодельТехники,
	|	Т.ВидТехники КАК ВидТехники,
	|	СУММА(Т.Смен) КАК ПотребностьСмен
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			М.СценарийПланирования КАК СценарийПланирования,
	|			М.Организация КАК Организация,
	|			М.Подразделение КАК Подразделение,
	|			М.ПериодНачала КАК ПериодНачала,
	|			М.ПериодОкончания КАК ПериодОкончания,
	|			М.ВидРаботы КАК ВидРаботы,
	|			М.Техника КАК МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника) КАК ВидТехники,
	|			М.Смен" + Суффикс + " КАК Смен
	|		ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлануОбороты КАК М
	|		ГДЕ " + УсловияМеханизированных + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Тран.СценарийПланирования,
	|			Тран.Организация,
	|			Тран.Подразделение,
	|			Тран.ПериодНачала,
	|			Тран.ПериодОкончания,
	|			Тран.ВидРаботы,
	|			Тран.Автомобиль,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт),
	|			Тран.Смен" + Суффикс + "
	|		ИЗ РегистрНакопления.АпкТранспортныеРаботыПоГодовомуПлануОбороты КАК Тран
	|		ГДЕ " + УсловияТранспортных + "
	|	) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.СценарийПланирования,
	|	Т.Организация,
	|	Т.Подразделение,
	|	Т.ПериодНачала,
	|	Т.ПериодОкончания,
	|	Т.ВидРаботы,
	|	Т.МодельТехники,
	|	Т.ВидТехники";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СценарийПланирования", Параметры.СценарийПланирования);
	ПараметрыЗапроса.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыЗапроса.Вставить("ДатаОкончания", ДатаОкончания);
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Параметры.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Параметры.Подразделение);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Возвращает доступность техники по документам Тх_ПланТехническихРесурсов
// (design §4.7, шаг 2): проведённые документы, принятые ТС, группировка
// по подразделению, модели и виду техники.
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор, если заполнено.
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: СценарийПланирования, Подразделение,
//     МодельТехники, ВидТехники, ЕдиницДоступно.
//
Функция ЗапросДоступности(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос доступности невозможен.'");
	КонецЕсли;

	УсловияОтбора = "Д.Проведен
	|	И Д.СценарийПланирования = &СценарийПланирования";
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		УсловияОтбора = УсловияОтбора + "
	|	И Д.Организация = &Организация";
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда
		УсловияОтбора = УсловияОтбора + "
	|	И Д.Подразделение = &Подразделение";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.СценарийПланирования КАК СценарийПланирования,
	|	Т.Подразделение КАК Подразделение,
	|	Т.МодельТехники КАК МодельТехники,
	|	Т.ВидТехники КАК ВидТехники,
	|	СУММА(Т.Количество) КАК ЕдиницДоступно
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			Д.СценарийПланирования КАК СценарийПланирования,
	|			Д.Подразделение КАК Подразделение,
	|			Осн.МодельТехники КАК МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника) КАК ВидТехники,
	|			Осн.Количество КАК Количество
	|		ИЗ Документ.Тх_ПланТехническихРесурсов.ОсновнаяТехника КАК Осн
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
	|			ПО Осн.Ссылка = Д.Ссылка
	|		ГДЕ Осн.Принят
	|			И " + УсловияОтбора + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Д.СценарийПланирования,
	|			Д.Подразделение,
	|			Обор.МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Оборудование),
	|			Обор.Количество
	|		ИЗ Документ.Тх_ПланТехническихРесурсов.Оборудование КАК Обор
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
	|			ПО Обор.Ссылка = Д.Ссылка
	|		ГДЕ Обор.Принят
	|			И " + УсловияОтбора + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Д.СценарийПланирования,
	|			Д.Подразделение,
	|			Авто.МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт),
	|			Авто.Количество
	|		ИЗ Документ.Тх_ПланТехническихРесурсов.Автотранспорт КАК Авто
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
	|			ПО Авто.Ссылка = Д.Ссылка
	|		ГДЕ Авто.Принят
	|			И " + УсловияОтбора + "
	|	) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.СценарийПланирования,
	|	Т.Подразделение,
	|	Т.МодельТехники,
	|	Т.ВидТехники";

	ПараметрыЗапроса = Новый Структура("СценарийПланирования", Параметры.СценарийПланирования);
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Параметры.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Параметры.Подразделение);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Возвращает суффикс ресурса объёма из параметров с проверкой допустимости
// (FAQ Q3: тройные ресурсы "_Мин"/"_Вер"/"_Макс", default "_Вер").
//
// Параметры:
//   Параметры - Структура - параметры запуска расчёта.
//
// Возвращаемое значение:
//   Строка - суффикс ресурса регистра годового плана.
//
Функция СуффиксОбъема(Параметры)

	Суффикс = "_Вер";
	Если ЗначениеЗаполнено(Параметры.СуффиксОбъема) Тогда
		Суффикс = Параметры.СуффиксОбъема;
	КонецЕсли;

	Если Суффикс <> "_Мин" И Суффикс <> "_Вер" И Суффикс <> "_Макс" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Недопустимый вариант объёма работ: %1'"), Суффикс);
	КонецЕсли;

	Возврат Суффикс;

КонецФункции

// Возвращает значение ключа структуры или значение по умолчанию, если ключ
// отсутствует.
//
// Параметры:
//   Структура      - Структура - источник значений;
//   Ключ           - Строка - имя ключа;
//   ПоУмолчанию    - Произвольный - значение по умолчанию.
//
// Возвращаемое значение:
//   Произвольный - значение ключа или значение по умолчанию.
//
Функция ЗначениеПоУмолчанию(Структура, Ключ, ПоУмолчанию)

	Если Структура.Свойство(Ключ) Тогда
		Возврат Структура[Ключ];
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти

#Область АвтозаполнениеПоМощности

// Автозаполняет регистр Тх_КоэффициентыПересчетаРабот коэффициентами
// пересчёта по мощности двигателя (design §4.6, TD-004/TD-005):
//   K = МощностьДвигателя(базовой) / МощностьДвигателя(аналога), 4 знака;
//   базовая модель - K = 1,0000, БазоваяМодель = Истина;
//   модели без мощности - строка не создаётся, имена - в сообщении (§18.6);
//   существующие записи того же ключа не перезаписываются (ручные правки).
//
// Параметры:
//   Параметры - Структура:
//     * Работа         - СправочникСсылка - вид работы (ВидыРаботСотрудников);
//     * ВидТехники     - ПеречислениеСсылка.Тх_ВидыТехники - вид техники;
//     * Период         - Дата - «действует с»;
//     * БазоваяМодель  - СправочникСсылка - базовая модель каталога АПК.
//
Процедура АвтозаполнениеПоМощности(Параметры) Экспорт

	Если НЕ ПроверитьПараметрыАвтозаполнения(Параметры) Тогда
		Возврат;
	КонецЕсли;

	ВидТехники = Параметры.ВидТехники;
	ИмяСправочника = ИмяСправочникаМоделей(ВидТехники);

	МощностьБазовой = МощностьДвигателяМодели(Параметры.БазоваяМодель);
	Если МощностьБазовой <= 0 Тогда
		СообщениеПользователю(НСтр(
			"ru = 'У базовой модели не заполнена мощность двигателя - автозаполнение невозможно.'"));
		Возврат;
	КонецЕсли;

	// Один запрос на все модели каталога (NFR-002).
	// TODO-VERIFY: реквизит «МощностьДвигателя» подтверждён для «АпкМоделиСХТехники»
	// (digest §4); для «АпкМоделиАвтотранспорта» имя реквизита не проверено (B3/B5).
	ТекстЗапроса = "ВЫБРАТЬ
	|	Спр.Ссылка КАК Модель,
	|	Спр.Наименование КАК Наименование,
	|	Спр.МощностьДвигателя КАК МощностьДвигателя
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ НЕ Спр.ПометкаУдаления
	|	И НЕ Спр.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО Спр.Наименование";

	Модели = ВыполнитьЗапросАПК(ТекстЗапроса).Выгрузить();

	НаборЗаписей = РегистрСведений.Тх_КоэффициентыПересчетаРабот.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Параметры.Период);
	НаборЗаписей.Отбор.Работа.Установить(Параметры.Работа);
	НаборЗаписей.Отбор.ВидТехники.Установить(ВидТехники);

	Создано = 0;
	ПропущеноСуществующих = 0;
	ПропущеноБезМощности = 0;
	ИменаБезМощности = "";

	НачатьТранзакцию();
	Попытка
		НаборЗаписей.Прочитать();
		Существующие = Новый Соответствие;
		Для Каждого Запись Из НаборЗаписей Цикл
			Существующие.Вставить(Запись.МодельТехники, Истина);
		КонецЦикла;

		Для Каждого Строка Из Модели Цикл

			РезультатСтроки = ДобавитьКоэффициентМодели(Строка, Параметры, ВидТехники,
				МощностьБазовой, Существующие, НаборЗаписей);

			Если РезультатСтроки = "БезМощности" Тогда
				ПропущеноБезМощности = ПропущеноБезМощности + 1;
				ИменаБезМощности = ИменаБезМощности
					+ ?(ИменаБезМощности = "", "", ", ") + Строка.Наименование;
			ИначеЕсли РезультатСтроки = "Существует" Тогда
				ПропущеноСуществующих = ПропущеноСуществующих + 1;
			Иначе
				Создано = Создано + 1;
			КонецЕсли;

		КонецЦикла;

		Если Создано > 0 Тогда
			НаборЗаписей.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ШаблонИтога = НСтр("ru = 'Автозаполнение по мощности: создано строк - %1,
		|пропущено существующих записей - %2, моделей без мощности - %3.'");
	ТекстИтога = СтрШаблон(ШаблонИтога, Создано, ПропущеноСуществующих, ПропущеноБезМощности);
	СообщениеПользователю(ТекстИтога);

	Если ПропущеноБезМощности > 0 Тогда
		ШаблонПропущенных = НСтр(
			"ru = 'Модели без мощности двигателя (строки не созданы): %1'");
		ТекстПропущенных = СтрШаблон(ШаблонПропущенных, ИменаБезМощности);
		СообщениеПользователю(ТекстПропущенных);
	КонецЕсли;

КонецПроцедуры

// Добавляет в набор записей коэффициент одной модели либо пропускает её
// (design §4.6): без мощности - пропустить; существующая - не перезаписывать;
// базовая - K = 1, БазоваяМодель = Истина; прочие - K = Мб/Ма (TD-004/TD-005).
//
// Параметры:
//   Строка          - СтрокаТаблицыЗначений - колонки: Модель, Наименование,
//                     МощностьДвигателя;
//   Параметры       - Структура - параметры автозаполнения;
//   ВидТехники      - ПеречислениеСсылка.Тх_ВидыТехники - вид техники;
//   МощностьБазовой - Число - мощность двигателя базовой модели;
//   Существующие    - Соответствие - модели, уже записанные в регистре;
//   НаборЗаписей    - РегистрСведенийНаборЗаписей.Тх_КоэффициентыПересчетаРабот
//                     - набор записей для добавления.
//
// Возвращаемое значение:
//   Строка - результат: "Добавлена", "БезМощности", "Существует".
//
Функция ДобавитьКоэффициентМодели(Строка, Параметры, ВидТехники, МощностьБазовой,
	Существующие, НаборЗаписей)

	Если Строка.МощностьДвигателя <= 0 Тогда
		Возврат "БезМощности";
	КонецЕсли;

	Если Существующие.Получить(Строка.Модель) <> Неопределено Тогда
		// Существующие записи не перезаписываются (design §4.6, п. 5).
		Возврат "Существует";
	КонецЕсли;

	Запись = НаборЗаписей.Добавить();
	Запись.Период = Параметры.Период;
	Запись.Работа = Параметры.Работа;
	Запись.ВидТехники = ВидТехники;
	Запись.МодельТехники = Строка.Модель;

	Если Строка.Модель = Параметры.БазоваяМодель Тогда
		Запись.Коэффициент = 1;
		Запись.БазоваяМодель = Истина;
	Иначе
		Запись.Коэффициент = Окр(МощностьБазовой / Строка.МощностьДвигателя,
			ТочностьКоэффициента());
		Запись.БазоваяМодель = Ложь;
	КонецЕсли;

	Существующие.Вставить(Строка.Модель, Истина);

	Возврат "Добавлена";

КонецФункции

// Проверяет параметры автозаполнения (заполненность и типы generic-ссылок,
// design §4.1, п. 2); о нарушении - сообщение пользователю.
//
// Параметры:
//   Параметры - Структура - параметры процедуры АвтозаполнениеПоМощности.
//
// Возвращаемое значение:
//   Булево - Истина, если параметры корректны.
//
Функция ПроверитьПараметрыАвтозаполнения(Параметры)

	Если НЕ ЗначениеЗаполнено(Параметры.Работа)
		ИЛИ НЕ ВалидироватьТипАПК(Параметры.Работа, ИмяСправочникаРабот()) Тогда
		СообщениеПользователю(НСтр(
			"ru = 'Укажите работу - элемент справочника «ВидыРаботСотрудников».'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Параметры.ВидТехники) Тогда
		СообщениеПользователю(НСтр("ru = 'Укажите вид техники.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ИмяСправочникаМоделей(Параметры.ВидТехники) = "" Тогда
		СообщениеПользователю(НСтр(
			"ru = 'Для выбранного вида техники каталог моделей не определён.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Параметры.Период) Тогда
		СообщениеПользователю(НСтр("ru = 'Укажите период «действует с».'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ВалидироватьТипАПК(Параметры.БазоваяМодель,
		ИмяСправочникаМоделей(Параметры.ВидТехники)) Тогда
		СообщениеПользователю(НСтр(
			"ru = 'Укажите базовую модель - элемент каталога моделей выбранного вида техники.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Выводит немодальное сообщение пользователю (NFR-001).
//
// Параметры:
//   Текст - Строка - текст сообщения.
//
Процедура СообщениеПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

// Модуль формы обработки «Тх_РаннерТестов» (design §11, задача A11).
//
// Запуск тестов - только по команде «Выполнить тесты» (ПриСозданииНаСервере
// автозапуска нет): серверный вызов, таблица результатов, итоговое
// немодальное сообщение с раздельными счётчиками PASS/FAIL/SKIP.
// Терминальный вердикт прогона и политика SKIP в форме не решаются (Q-007).

#Область ОбработчикиКомандФормы

// Команда «Выполнить тесты»: серверный прогон всех тестов Тх_Тесты,
// заполнение таблицы результатов и вывод итоговой сводки.
//
// Параметры:
//   Команда - КомандаФормы - команда формы.
//
&НаКлиенте
Процедура ВыполнитьТесты(Команда)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ВыполнитьТестовНаСервере();
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет все тесты модульного прогона на сервере, заполняет таблицу
// результатов формы и возвращает сводку прогона.
//
// Потребляет контракт раннера: Статус ("PASS"/"FAIL"/"SKIP") и Провалы
// каждого результата; счётчики PASS/FAIL/SKIP раздельны.
//
// Возвращаемое значение:
//   Строка - сводка прогона: всего тестов и раздельные счётчики.
//
&НаСервере
Функция ВыполнитьТестовНаСервере()

	РезультатыЗапуска = Обработки.Тх_РаннерТестов.Создать().ВыполнитьТесты();

	Результаты.Очистить();
	Прошло = 0;
	Провалено = 0;
	Пропущено = 0;

	Для Каждого Результат Из РезультатыЗапуска Цикл
		СтрокаРезультата = Результаты.Добавить();
		СтрокаРезультата.Тест = Результат.Имя;
		СтрокаРезультата.Результат = ПредставлениеСтатуса(
			Результат.Статус, Результат.Провалы);
		Если Результат.Статус = "PASS" Тогда
			Прошло = Прошло + 1;
		КонецЕсли;
		Если Результат.Статус = "FAIL" Тогда
			Провалено = Провалено + 1;
		КонецЕсли;
		Если Результат.Статус = "SKIP" Тогда
			Пропущено = Пропущено + 1;
		КонецЕсли;
	КонецЦикла;

	ВсегоТестов = Результаты.Количество();

	Возврат СтрШаблон(НСтр("ru = 'Тестов: %1. PASS: %2, FAIL: %3, SKIP: %4.'"),
		ВсегоТестов, Прошло, Провалено, Пропущено);

КонецФункции

// Возвращает представление статуса теста для колонки «Результат»:
// статусы PASS/FAIL/SKIP различимы; для FAIL добавляется число
// проваленных проверок из Провалов.
//
// Параметры:
//   Статус  - Строка - статус теста из результата прогона;
//   Провалы - Массив - имена проваленных проверок.
//
// Возвращаемое значение:
//   Строка - отображаемое представление статуса.
//
Функция ПредставлениеСтатуса(Статус, Провалы)

	Если Статус = "FAIL" И Провалы.Количество() > 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'FAIL (провалов проверок: %1)'"),
			Провалы.Количество());
	КонецЕсли;

	Возврат Статус;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область РантаймДоступКДаннымАПК

// Выполняет запрос к таблицам расширения №1 (рантайм-компиляция текста,
// design §4.1, п. 1). При недоступности модуля АПК прерывает расчёт
// понятным сообщением (design §5, §8).
//
// Параметры:
//   Текст      - Строка - текст запроса (имена таблиц - явные строковые);
//   Параметры  - Структура, Неопределено - параметры запроса.
//
// Возвращаемое значение:
//   РезультатЗапроса - результат выполнения запроса.
//
// Пример:
//   ВызватьИсключение с текстом «Модуль АПК отключён, расчёт невозможен».
//
Функция ВыполнитьЗапросАПК(Текст, Параметры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = Текст;

	Если Параметры <> Неопределено Тогда
		Для Каждого КлючЗначение Из Параметры Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		// Разделяем два сценария: модуль АПК не подключён (нет типа
		// Справочник.АпкМодели... / Документ... из расширения №1) - это
		// фатальная ошибка, остальные - ошибки исполнения запроса.
		// Классификация запросных ошибок - только здесь; наличие реквизита
		// модели классифицируется метаданными, не текстом ошибки (Q-005 Р1).
		ТекстОшибки = ОписаниеОшибки();
		Если ЭтоОтключениеМодуляАПК(ТекстОшибки) Тогда
			// модуль АПК отключён - фатально, прерываем расчёт
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Тх_ТехникаСервер: модуль АПК отключён'"),
				УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Модуль АПК отключён, расчёт невозможен: %1. Подробности записаны в журнал регистрации.'"),
				ТекстОшибки);
		Иначе
			// ошибка исполнения запроса (права, исполнение и т.п.) -
			// инфраструктурный сбой: ЖР Error и остановка расчёта (Q-005 Р1).
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Тх_ТехникаСервер: ошибка запроса АПК'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				СтрШаблон(НСтр("ru = 'Текст: %1'"), ТекстОшибки));
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Ошибка выполнения запроса АПК: %1. Подробности записаны в журнал регистрации.'"),
				ТекстОшибки);
		КонецЕсли;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Классифицирует текст платформенной ошибки как признак отключённого
// модуля АПК (P1-2): при выполнении запроса к таблицам отключённого
// расширения №1 возникает «Неизвестный тип значения «Справочник.Апк...».
// Единственное место чтения текста ошибки: наличие реквизита модели
// определяется метаданными, а не текстом (Q-005 Р1, SRV-03 §2.1).
// Проверка числовая: СтрНайти возвращает число (P1-2, b8d621e).
//
// Параметры:
//   ТекстОшибки - Строка - ОписаниеОшибки() из исключения запроса.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибка означает отключённый модуль АПК.
//
Функция ЭтоОтключениеМодуляАПК(ТекстОшибки) Экспорт

	Возврат СтрНачинаетсяС(ТекстОшибки, НСтр("ru = 'Неизвестный тип значения'"))
		И СтрНайти(ТекстОшибки, "Справочник.Апк") > 0;

КонецФункции

// Проверяет, что значение - ссылка справочника с указанным именем
// (рантайм-валидация generic-ссылок, design §4.1, п. 2).
//
// Параметры:
//   Значение    - ЛюбаяСсылка - проверяемое значение;
//   ИмяОбъекта  - Строка - имя справочника (например, "ВидыРаботСотрудников").
//
// Возвращаемое значение:
//   Булево - Истина, если тип значения совпадает с типом справочника.
//
Функция ВалидироватьТипАПК(Значение, ИмяОбъекта) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Значение) = Тип("СправочникСсылка." + ИмяОбъекта);

КонецФункции

// Проверяет совместимость сцепки «модель техники + оборудование» (FR-002,
// design 5.3): АпкМоделиСХТехники - только АпкМоделиСХОборудования;
// АпкМоделиАвтотранспорта - только АпкМоделиПрицепов. Незаполненная модель
// или оборудование сцепкой не считается (Истина). Типы разбираются по
// полному имени метаданных ссылки (ИмяСправочникаПоТипуСсылки), без Тип() -
// устойчиво к отключённому расширению №1.
//
// Параметры:
//   Модель       - СправочникСсылка - модель техники;
//   Оборудование - СправочникСсылка - модель оборудования/прицепа.
//
// Возвращаемое значение:
//   Булево - Истина, если пара совместима (или одно из значений не заполнено).
//
Функция ВалидироватьСцепку(Модель, Оборудование) Экспорт

	Если НЕ ЗначениеЗаполнено(Модель) ИЛИ НЕ ЗначениеЗаполнено(Оборудование) Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяМодели = ИмяСправочникаПоТипуСсылки(Модель);
	Если ИмяМодели = "АпкМоделиСХТехники" Тогда
		Возврат ИмяСправочникаПоТипуСсылки(Оборудование) = "АпкМоделиСХОборудования";
	ИначеЕсли ИмяМодели = "АпкМоделиАвтотранспорта" Тогда
		Возврат ИмяСправочникаПоТипуСсылки(Оборудование) = "АпкМоделиПрицепов";
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Возвращает мощность двигателя модели техники (рантайм-запрос, design §4.1:
// реквизит недоступен типами расширения №2, только запросом).
//
// Параметры:
//   Модель - СправочникСсылка - ссылка на элемент каталога моделей АПК.
//
// Возвращаемое значение:
//   Число - мощность двигателя модели; 0 - не заполнена или не найдена.
//
Функция МощностьДвигателяМодели(Модель) Экспорт

	Результат = 0;

	Если НЕ ЗначениеЗаполнено(Модель) Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяСправочника = ИмяСправочникаПоТипуСсылки(Модель);
	Если ИмяСправочника = "" Тогда
		Возврат Результат;
	КонецЕсли;

	// TODO-VERIFY: реквизит «МощностьДвигателя» подтверждён по исходникам АПК 2.5
	// только для справочника «АпкМоделиСХТехники» (digest §4); для остальных
	// каталогов моделей имя реквизита не проверено (проверка при B3/B5).
	ТекстЗапроса = "ВЫБРАТЬ
	|	Спр.МощностьДвигателя КАК МощностьДвигателя
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ Спр.Ссылка = &Модель";

	РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса, Новый Структура("Модель", Модель));
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.МощностьДвигателя;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает значение числового реквизита модели рантайм-запросом
// (реквизиты каталогов АПК недоступны расширению статически, design 4.1;
// обобщение МощностьДвигателяМодели).
//
// Классификация ошибок - Q-005 Р1 (SRV-03): наличие реквизита проверяется
// ПО МЕТАДАННЫМ каталога до запроса; отсутствующий реквизит = несовпадение
// версий АПК → ЖР Предупреждение, значение «не заполнено» (0), расчёт
// продолжается. Любой сбой запроса к СУЩЕСТВУЮЩЕМУ реквизиту =
// инфраструктура (права, отключённый модуль, ошибка исполнения) → ЖР Error
// (внутри ВыполнитьЗапросАПК) и исключение → остановка расчёта.
// Глушение «любое исключение → 0» удалено (P1-3): неизвестный сбой никогда
// не превращается в 0. Третьего состояния результата нет (Q-005 Р1).
//
// Параметры:
//   Модель       - СправочникСсылка - ссылка на элемент каталога моделей;
//   ИмяРеквизита - Строка - имя числового реквизита;
//   КэшРасчета   - Структура, Неопределено - кэш расчёта
//       (НовыйКэшРасчета / ПостроитьКэшРеквизитовМоделей, SRV-04):
//       пакетные значения, кэш метаданных, дроссель ЖР; живёт один
//       расчёт, передаётся вызывающим кодом (переменные уровня общего
//       модуля платформой не поддерживаются). Неопределено - разовый
//       вызов (поштучная ветка, запись ЖР безусловно).
//
// Возвращаемое значение:
//   Число - значение реквизита; 0 - не заполнен или отсутствует в метаданных.
//
Функция ЗначениеРеквизитаМодели(Модель, ИмяРеквизита, КэшРасчета = Неопределено) Экспорт

	Результат = 0;

	Если НЕ ЗначениеЗаполнено(Модель) Тогда
		Возврат Результат;
	КонецЕсли;

	// SRV-04 (P1-4): пакетный кэш расчёта - значения уже прочитаны
	// выборкой на каталог (ПостроитьКэшРеквизитовМоделей); классификация
	// по метаданным и дросселированные предупреждения выполнены при
	// построении кэша. Числовая эквивалентность поштучному чтению
	// доказывается тестом (SRV-04 §2.5).
	Если КэшРасчета <> Неопределено Тогда
		ЗначенияМодели = КэшРасчета.Модели.Получить(Модель);
		Если ЗначенияМодели <> Неопределено Тогда
			ЗначениеИзКэша = ЗначенияМодели.Получить(ИмяРеквизита);
			Если ЗначениеИзКэша <> Неопределено Тогда
				Возврат ЗначениеИзКэша;
			КонецЕсли;
			// Реквизит вне пакетного набора каталога - ниже поштучная
			// ветка (метаданные + дросселированное ЖР + запрос).
		КонецЕсли;
	КонецЕсли;

	ИмяСправочника = ИмяСправочникаПоТипуСсылки(Модель);
	Если ИмяСправочника = "" Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЕстьРеквизитСправочника(ИмяСправочника, ИмяРеквизита, КэшРасчета) Тогда
		// Реквизит отсутствует в метаданных каталога - несовпадение версий
		// АПК (Q-005 Р1): ЖР Предупреждение, свойство «не заполнено» (0),
		// расчёт продолжается. ЖР - единственная согласованная видимость;
		// дросселирование - владелец 13.11, вопрос 6.
		ПредупредитьОбОтсутствующемРеквизите(ИмяСправочника, ИмяРеквизита, КэшРасчета);
		Возврат Результат;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ Спр." + ИмяРеквизита + " КАК Значение
		|ИЗ Справочник." + ИмяСправочника + " КАК Спр
		|ГДЕ Спр.Ссылка = &Модель";
	РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса, Новый Структура("Модель", Модель));
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Значение;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет наличие реквизита в метаданных справочника (Q-005 Р1, SRV-03:
// классификация по метаданным, не по тексту ошибки).
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника (например, "АпкМоделиСХТехники");
//   ИмяРеквизита   - Строка - имя пользовательского реквизита;
//   КэшРасчета     - Структура, Неопределено - кэш расчёта (результат
//                    кэшируется на расчёт, SRV-04); Неопределено - без кэша.
//
// Возвращаемое значение:
//   Булево - Истина, если реквизит есть в метаданных каталога.
//
Функция ЕстьРеквизитСправочника(ИмяСправочника, ИмяРеквизита, КэшРасчета = Неопределено)

	// SRV-04: проверка метаданных кэшируется на расчёт (владелец 13.11,
	// вопрос 6): обход Метаданные.Справочники.Найти на каждой паре
	// модель х реквизит не нужен.
	КлючПроверки = ИмяСправочника + "." + ИмяРеквизита;
	Если КэшРасчета <> Неопределено Тогда
		КэшированныйРезультат = КэшРасчета.РеквизитыКаталогов.Получить(КлючПроверки);
		Если КэшированныйРезультат <> Неопределено Тогда
			Возврат КэшированныйРезультат;
		КонецЕсли;
	КонецЕсли;

	МетаСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Результат = МетаСправочник <> Неопределено
		И МетаСправочник.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;

	Если КэшРасчета <> Неопределено Тогда
		КэшРасчета.РеквизитыКаталогов.Вставить(КлючПроверки, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пишет дросселированное ЖР Предупреждение о несуществующем реквизите
// каталога (Q-005 Р1, SRV-03/SRV-04): одна запись на пару
// "каталог.реквизит" в рамках расчёта (решение владельца 13.11,
// вопрос 6); без кэша (разовый вызов) - безусловно.
//
// Параметры:
//   ИмяСправочника - Строка - имя каталога моделей;
//   ИмяРеквизита   - Строка - имя реквизита;
//   КэшРасчета     - Структура, Неопределено - кэш расчёта.
//
Процедура ПредупредитьОбОтсутствующемРеквизите(ИмяСправочника, ИмяРеквизита, КэшРасчета = Неопределено)

	ПисатьПредупреждение = Истина;
	Если КэшРасчета <> Неопределено Тогда
		КлючПредупреждения = ИмяСправочника + "." + ИмяРеквизита;
		ПисатьПредупреждение = КэшРасчета.Предупреждения.Получить(КлючПредупреждения) = Неопределено;
		Если ПисатьПредупреждение Тогда
			КэшРасчета.Предупреждения.Вставить(КлючПредупреждения, Истина);
		КонецЕсли;
	КонецЕсли;
	Если ПисатьПредупреждение Тогда
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Тх_ТехникаСервер: реквизит модели отсутствует в метаданных каталога (несовпадение версий АПК)'"),
			УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон(НСтр("ru = 'Справочник %1, реквизит %2: свойство считаем незаполненным, расчёт продолжается.'"),
				ИмяСправочника, ИмяРеквизита));
	КонецЕсли;

КонецПроцедуры

// Создаёт кэш расчёта (SRV-04, P1-4): пакетные значения реквизитов
// моделей, кэш проверок метаданных и дроссель предупреждений ЖР.
//
// Возвращаемое значение:
//   Структура - поля: Модели (Соответствие: Ссылка -> Соответствие
//               реквизит -> значение), Предупреждения (Соответствие),
//               РеквизитыКаталогов (Соответствие).
//
Функция НовыйКэшРасчета() Экспорт

	Возврат Новый Структура("Предупреждения, Модели, РеквизитыКаталогов",
		Новый Соответствие, Новый Соответствие, Новый Соответствие);

КонецФункции

// Пакетная загрузка реквизитов моделей (SRV-04, P1-4): все модели
// расчёта х все используемые реквизиты их каталогов - ОДНА выборка на
// каталог (ГДЕ Ссылка В (&Модели)) вместо поштучного запроса на каждую
// пару модель х реквизит. Контракт Q-005 Р1 сохранён буквально:
// отсутствующий в метаданных реквизит = ЖР Предупреждение (дроссель на
// расчёт) + значение 0 «не заполнено» + расчёт продолжается; сбой
// выборки = инфраструктура -> ЖР Error + исключение (ВыполнитьЗапросАПК)
// -> остановка, откат, без частичных строк. Виртуальных таблиц нет
// (plain select каталога), имена таблиц строковые - нюанс 8.5 соблюдён.
//
// Параметры:
//   Модели     - Массив - ссылки элементов каталогов моделей АПК
//                (пустые и не-ссылки пропускаются, дубли допустимы);
//   КэшРасчета - Структура, Неопределено - кэш расчёта (дозаполняется);
//                Неопределено - создаётся новый.
//
// Возвращаемое значение:
//   Структура - кэш расчёта (переданный или новый).
//
Функция ПостроитьКэшРеквизитовМоделей(Модели, КэшРасчета = Неопределено) Экспорт

	Если КэшРасчета = Неопределено Тогда
		КэшРасчета = НовыйКэшРасчета();
	КонецЕсли;

	// Группировка по каталогам; мягкая ветка не-ссылок (SRV-03):
	// ИмяСправочникаПоТипуСсылки уже пишет ЖР Предупреждение.
	ПоКаталогам = Новый Соответствие;
	Для Каждого Модель Из Модели Цикл
		Если НЕ ЗначениеЗаполнено(Модель) Тогда
			Продолжить;
		КонецЕсли;
		ИмяСправочника = ИмяСправочникаПоТипуСсылки(Модель);
		Если ИмяСправочника = "" Тогда
			Продолжить;
		КонецЕсли;
		МоделиКаталога = ПоКаталогам.Получить(ИмяСправочника);
		Если МоделиКаталога = Неопределено Тогда
			МоделиКаталога = Новый Массив;
			ПоКаталогам.Вставить(ИмяСправочника, МоделиКаталога);
		КонецЕсли;
		МоделиКаталога.Добавить(Модель);
	КонецЦикла;

	Для Каждого КлючЗначение Из ПоКаталогам Цикл
		ИмяСправочника = КлючЗначение.Ключ;
		МоделиКаталога = КлючЗначение.Значение;

		// Состав используемых реквизитов каталога - ровно тот, что читает
		// поштучный код (приоритеты замещения + стартовый).
		Приоритеты = ПриоритетРеквизитовКаталога(ИмяСправочника);
		Если Приоритеты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РеквизитыКаталога = Новый Массив;
		Для Каждого ИмяРеквизита Из Приоритеты.Приоритетные Цикл
			Если РеквизитыКаталога.Найти(ИмяРеквизита) = Неопределено Тогда
				РеквизитыКаталога.Добавить(ИмяРеквизита);
			КонецЕсли;
		КонецЦикла;
		Если Приоритеты.Стартовый <> ""
			И РеквизитыКаталога.Найти(Приоритеты.Стартовый) = Неопределено Тогда
			РеквизитыКаталога.Добавить(Приоритеты.Стартовый);
		КонецЕсли;

		// Разделение по метаданным (Q-005 Р1): существующие - в выборку,
		// отсутствующие - дросселированное ЖР + «не заполнено» (0).
		РеквизитыВыборки = Новый Массив;
		Для Каждого ИмяРеквизита Из РеквизитыКаталога Цикл
			Если ЕстьРеквизитСправочника(ИмяСправочника, ИмяРеквизита, КэшРасчета) Тогда
				РеквизитыВыборки.Добавить(ИмяРеквизита);
			Иначе
				ПредупредитьОбОтсутствующемРеквизите(ИмяСправочника, ИмяРеквизита, КэшРасчета);
			КонецЕсли;
		КонецЦикла;

		Если РеквизитыВыборки.Количество() > 0 Тогда
			// Одна выборка на каталог (P1-4).
			ТекстЗапроса = "ВЫБРАТЬ Спр.Ссылка КАК Модель";
			Для Каждого ИмяРеквизита Из РеквизитыВыборки Цикл
				ТекстЗапроса = ТекстЗапроса + "
				|	, Спр." + ИмяРеквизита + " КАК " + ИмяРеквизита;
			КонецЦикла;
			ТекстЗапроса = ТекстЗапроса + "
				|ИЗ Справочник." + ИмяСправочника + " КАК Спр
				|ГДЕ Спр.Ссылка В (&Модели)";
			РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса,
				Новый Структура("Модели", МоделиКаталога));
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ЗначенияМодели = Новый Соответствие;
				Для Каждого ИмяРеквизита Из РеквизитыВыборки Цикл
					ЗначенияМодели.Вставить(ИмяРеквизита, Выборка[ИмяРеквизита]);
				КонецЦикла;
				// Отсутствующие в метаданных реквизиты каталога - «не
				// заполнено» (0), как в поштучной ветке.
				Для Каждого ИмяРеквизита Из РеквизитыКаталога Цикл
					Если ЗначенияМодели.Получить(ИмяРеквизита) = Неопределено Тогда
						ЗначенияМодели.Вставить(ИмяРеквизита, 0);
					КонецЕсли;
				КонецЦикла;
				КэшРасчета.Модели.Вставить(Выборка.Модель, ЗначенияМодели);
			КонецЦикла;
		Иначе
			// Все реквизиты каталога отсутствуют в метаданных - выборки
			// нет, все значения «не заполнено» (0).
			Для Каждого Модель Из МоделиКаталога Цикл
				ЗначенияМодели = Новый Соответствие;
				Для Каждого ИмяРеквизита Из РеквизитыКаталога Цикл
					ЗначенияМодели.Вставить(ИмяРеквизита, 0);
				КонецЦикла;
				КэшРасчета.Модели.Вставить(Модель, ЗначенияМодели);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат КэшРасчета;

КонецФункции

// Возвращает приоритеты реквизитов замещения по каталогу модели (FR-004,
// design 6.4; состав реквизитов сверен с исходниками АПК 2.5.27.88).
//
// Параметры:
//   Модель - СправочникСсылка - модель.
//
// Возвращаемое значение:
//   Структура - свойства: Приоритетные (Массив из Строка), Стартовый (Строка);
//   Неопределено - модель не из каталогов моделей АПК.
//
Функция ПриоритетРеквизитовЗамещения(Модель) Экспорт

	Возврат ПриоритетРеквизитовКаталога(ИмяСправочникаПоТипуСсылки(Модель));

КонецФункции

// Возвращает приоритеты реквизитов замещения по ИМЕНИ каталога моделей
// (SRV-04: пакетной загрузке нужен состав реквизитов до выборки; состав
// сверен с исходниками АПК 2.5.27.88).
//
// Параметры:
//   ИмяСправочника - Строка - имя каталога моделей.
//
// Возвращаемое значение:
//   Структура - свойства: Приоритетные (Массив из Строка), Стартовый (Строка);
//   Неопределено - каталог не из числа каталогов моделей АПК.
//
Функция ПриоритетРеквизитовКаталога(ИмяСправочника)

	Если ИмяСправочника = "АпкМоделиСХТехники" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("КоэффициентПереводаВУЭГА");
		Приоритетные.Добавить("ШиринаОбработки");
		Приоритетные.Добавить("ОбъемБункера");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "МощностьДвигателя");
	ИначеЕсли ИмяСправочника = "АпкМоделиСХОборудования" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("ШиринаОбработки");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "");
	ИначеЕсли ИмяСправочника = "АпкМоделиАвтотранспорта" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("Грузоподъемность");
		Приоритетные.Добавить("Вместимость");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "МощностьДвигателя");
	ИначеЕсли ИмяСправочника = "АпкМоделиПрицепов" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("Грузоподъемность");
		Приоритетные.Добавить("Вместимость");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Возвращает базовый реквизит замещения модели: первый заполненный из
// приоритетных; если все пусты - стартовый МощностьДвигателя (там, где есть).
//
// Параметры:
//   Модель - СправочникСсылка - модель техники/оборудования/прицепа;
//   КэшРасчета - Структура, Неопределено - кэш расчёта
//       (см. ЗначениеРеквизитаМодели).
//
// Возвращаемое значение:
//   Структура - свойства: Реквизит (Строка), Значение (Число);
//   Неопределено - ни один реквизит не заполнен (КоэффициентНеЗадан).
//
Функция РеквизитЗамещения(Модель, КэшРасчета = Неопределено) Экспорт

	Приоритеты = ПриоритетРеквизитовЗамещения(Модель);
	Если Приоритеты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ИмяРеквизита Из Приоритеты.Приоритетные Цикл
		Значение = ЗначениеРеквизитаМодели(Модель, ИмяРеквизита, КэшРасчета);
		Если Значение > 0 Тогда
			Возврат Новый Структура("Реквизит, Значение", ИмяРеквизита, Значение);
		КонецЕсли;
	КонецЦикла;

	Если Приоритеты.Стартовый <> "" Тогда
		Значение = ЗначениеРеквизитаМодели(Модель, Приоритеты.Стартовый, КэшРасчета);
		Если Значение > 0 Тогда
			Возврат Новый Структура("Реквизит, Значение", Приоритеты.Стартовый, Значение);
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Коэффициент замещения моделей (FR-004, TD-003, design 6.4):
// К = Реквизит(МодельЗамены) / Реквизит(МодельОригинала) по одному и тому
// же базовому реквизиту. Смены замены = смены оригинала / К (ширина замены
// в 1.5 раза больше - смен в 1.5 раза меньше).
//
// Параметры:
//   МодельОригинал - СправочникСсылка - модель оригинала;
//   МодельЗамены   - СправочникСсылка - модель замены;
//   КэшРасчета     - Структура, Неопределено - кэш расчёта
//       (см. ЗначениеРеквизитаМодели).
//
// Возвращаемое значение:
//   Число - коэффициент замещения К > 0 (может быть < 1 - замена медленнее);
//   Неопределено - коэффициент не задан: модели из разных каталогов,
//                  нет заполненных реквизитов или базовые реквизиты
//                  оригинала и замены различаются (КоэффициентНеЗадан).
//
Функция КоэффициентЗамещения(МодельОригинал, МодельЗамены, КэшРасчета = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(МодельОригинал) ИЛИ НЕ ЗначениеЗаполнено(МодельЗамены) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ИмяСправочникаПоТипуСсылки(МодельОригинал) <> ИмяСправочникаПоТипуСсылки(МодельЗамены) Тогда
		Возврат Неопределено;
	КонецЕсли;

	РеквизитОригинала = РеквизитЗамещения(МодельОригинал, КэшРасчета);
	РеквизитЗамены = РеквизитЗамещения(МодельЗамены, КэшРасчета);

	Если РеквизитОригинала = Неопределено ИЛИ РеквизитЗамены = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если РеквизитОригинала.Реквизит <> РеквизитЗамены.Реквизит Тогда
		// Базовые реквизиты различаются (у одной ручной, у другой стартовый) -
		// честный КоэффициентНеЗадан.
		Возврат Неопределено;
	КонецЕсли;

	Возврат РеквизитЗамены.Значение / РеквизитОригинала.Значение;

КонецФункции

// Возвращает имя справочника по ссылке на его элемент.
//
// 8.5: Строка(ТипЗнч()) возвращает синоним типа (например, «Модель с/х
// техники»), а не имя вида «СправочникСсылка.<Имя>» - разбор строки
// ненадёжен (доказано COM-пробой B5). ПолноеИмя() метаданных объекта
// ссылки от языка сессии не зависит: «Справочник.<Имя>».
//
// P1-3/SRV-03: молчаливая деградация удалена. Пустая ссылка - легитимный
// случай (""). Ссылка ДРУГОГО справочника - легитимный случай (имя,
// вызывающий код обрабатывает). Не-ссылка или ссылка не-справочника
// (документ и т.п.) - нарушение контракта модельных параметров (регистр
// Тх_ДефицитТехники и ТС.АпкМодель типизированы только каталогами
// АпкМодели*): ЖР Error + исключение, тихие 0/Ложь недопустимы.
//
// Параметры:
//   Значение - СправочникСсылка - значение ссылки.
//
// Возвращаемое значение:
//   Строка - имя справочника; "" - пустая ссылка, не-ссылка или ссылка
//            объекта не-справочника (мягкая ветка, решение владельца
//            13.11, вопрос 4: ЖР Предупреждение, расчёт продолжается).
//            Жёсткой остаётся только ветка двойного сбоя чтения
//            ПолноеИмя()/.ПолноеИмя - ЖР Error + исключение (Р1).
//
Функция ИмяСправочникаПоТипуСсылки(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		МетаОбъект = Значение.Метаданные();
		Попытка
			// 8.5: ПолноеИмя() - метод (доказано COM-пробой B5); 8.3 - свойство.
			ПолноеИмяОбъекта = МетаОбъект.ПолноеИмя();
		Исключение
			ПолноеИмяОбъекта = МетаОбъект.ПолноеИмя;
		КонецПопытки;
	Исключение
		// Значение - не ссылка на объект метаданных (примитив и т.п.):
		// мягкая ветка (решение владельца 13.11, вопрос 4) - ЖР
		// Предупреждение и продолжение расчёта (пустое имя), вызывающий
		// код обрабатывает как раньше (0/Ложь).
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Тх_ТехникаСервер: ожидалась ссылка справочника, получено значение другого типа'"),
			УровеньЖурналаРегистрации.Предупреждение,,, ТекстОшибки);
		Возврат "";
	КонецПопытки;

	Если ПолноеИмяОбъекта = "" Тогда
		// Оба способа чтения ПолноеИмя сбойнули - инфраструктурный сбой
		// платформы: останавливаем расчёт (тишина недопустима, SRV-03 §2.3).
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Тх_ТехникаСервер: не удалось прочитать полное имя метаданных объекта'"),
			УровеньЖурналаРегистрации.Ошибка,,, "ПолноеИмя: <пусто>");
		ВызватьИсключение НСтр(
			"ru = 'Не удалось прочитать полное имя метаданных объекта ссылки. Расчёт остановлен, подробности в журнале регистрации.'");
	КонецЕсли;

	Префикс = "Справочник.";
	Если СтрНачинаетсяС(ПолноеИмяОбъекта, Префикс) Тогда
		Возврат Сред(ПолноеИмяОбъекта, СтрДлина(Префикс) + 1);
	КонецЕсли;

	// Ссылка не-справочника (документ и т.п.) в модельных параметрах -
	// мягкая ветка (решение владельца 13.11, вопрос 4): ЖР
	// Предупреждение и продолжение расчёта (пустое имя), вызывающий
	// код обрабатывает как раньше (0/Ложь).
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Тх_ТехникаСервер: ожидалась ссылка справочника, получена ссылка объекта другого вида'"),
		УровеньЖурналаРегистрации.Предупреждение,,, "ПолноеИмя: " + ПолноеИмяОбъекта);
	Возврат "";

КонецФункции

// Возвращает модель и хозяйственный номер транспортного средства
// (рантайм-запрос к реквизитам АпкМодель / АпкХозНомер справочника
// транспортных средств, design §4.4; без модуля АПК запрос падает -
// исключение «Модуль АПК отключён» пробрасывается вызывающему коду).
//
// Параметры:
//   ТранспортноеСредство - СправочникСсылка.ТранспортныеСредства - выбранное ТС.
//
// Возвращаемое значение:
//   Структура - поля:
//     * МодельТехники - СправочникСсылка, Неопределено - модель ТС (АпкМодель);
//     * ХозНомер      - Строка - хозяйственный номер ТС (АпкХозНомер).
//
Функция ДанныеТранспортногоСредства(ТранспортноеСредство) Экспорт

	Результат = Новый Структура("МодельТехники, ХозНомер", Неопределено, "");
	Если НЕ ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	ТС.АпкМодель КАК МодельТехники,
	|	ТС.АпкХозНомер КАК ХозНомер
	|ИЗ
	|	Справочник." + ИмяСправочникаТранспортныхСредств() + " КАК ТС
	|ГДЕ
	|	ТС.Ссылка = &ТранспортноеСредство";

	РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса,
		Новый Структура("ТранспортноеСредство", ТранспортноеСредство));
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.МодельТехники = Выборка.МодельТехники;
		Результат.ХозНомер = Выборка.ХозНомер;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ФункцииДат

// Возвращает число календарных дней периода, границы включены (FAQ Q1):
// (Окончание - Начало + 1) день. Производственный календарь - v2.
//
// Параметры:
//   НачалоПериода  - Дата - дата начала интервала;
//   ОкончаниеПериода - Дата - дата окончания интервала.
//
// Возвращаемое значение:
//   Число - число календарных дней; 0 - даты не заполнены или интервал пуст.
//
Функция ЧислоДнейПериода(НачалоПериода, ОкончаниеПериода) Экспорт

	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
		Возврат 0;
	КонецЕсли;

	Дней = (НачалоДня(ОкончаниеПериода) - НачалоДня(НачалоПериода)) / 86400 + 1;

	Возврат Макс(Дней, 0);

КонецФункции



#КонецОбласти

#Область ЗапросыРасчетаДефицита

// Возвращает потребность в сменах по регистрам годового плана АПК
// (design §4.7, шаг 1, TD-002; SRV-02 §5): UNION ALL механизированных
// работ (техника - СХТехника) и транспортных работ (автомобиль -
// Автотранспорт, прицеп - Прицеп), агрегировано до интервалов строк
// техкарт.
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор, если заполнено;
//     * ДатаНачала      - Дата - левая граница диапазона запуска;
//     * ДатаОкончания   - Дата - правая граница диапазона запуска;
//     * СуффиксОбъема   - Строка - "_Мин"/"_Вер"/"_Макс" (FAQ Q3, default "_Вер").
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: СценарийПланирования, Организация, Подразделение,
//     ПериодНачала, ПериодОкончания, ВидРаботы, МодельТехники, ВидТехники,
//     ПотребностьСмен.
//
Функция ЗапросПотребности(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос потребности невозможен.'");
	КонецЕсли;

	Суффикс = СуффиксОбъема(Параметры);
	// Необязательные ключи (докстринг: "отбор, если заполнена"):
	Организация = ЗначениеПоУмолчанию(Параметры, "Организация", Неопределено);
	Подразделение = ЗначениеПоУмолчанию(Параметры, "Подразделение", Неопределено);

	ДатаНачала = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1));
	ДатаОкончания = ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31));

	УсловияМеханизированных = "М.СценарийПланирования = &СценарийПланирования
	|	И М.ПериодОкончания >= &ДатаНачала
	|	И М.ПериодНачала <= &ДатаОкончания";
	УсловияТранспортных = "Тран.СценарийПланирования = &СценарийПланирования
	|	И Тран.ПериодОкончания >= &ДатаНачала
	|	И Тран.ПериодНачала <= &ДатаОкончания";

	Если ЗначениеЗаполнено(Организация) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Организация = &Организация";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Организация = &Организация";
	КонецЕсли;

	Если ЗначениеЗаполнено(Подразделение) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Подразделение = &Подразделение";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Подразделение = &Подразделение";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.СценарийПланирования КАК СценарийПланирования,
	|	Т.Организация КАК Организация,
	|	Т.Подразделение КАК Подразделение,
	|	Т.ПериодНачала КАК ПериодНачала,
	|	Т.ПериодОкончания КАК ПериодОкончания,
	|	Т.ВидРаботы КАК ВидРаботы,
	|	Т.МодельТехники КАК МодельТехники,
	|	Т.ВидТехники КАК ВидТехники,
	|	СУММА(Т.Смен) КАК ПотребностьСмен
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			М.СценарийПланирования КАК СценарийПланирования,
	|			М.Организация КАК Организация,
	|			М.Подразделение КАК Подразделение,
	|			М.ПериодНачала КАК ПериодНачала,
	|			М.ПериодОкончания КАК ПериодОкончания,
	|			М.ВидРаботы КАК ВидРаботы,
	|			М.Техника КАК МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника) КАК ВидТехники,
	|			М.Смен" + Суффикс + "Оборот КАК Смен
	|		ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану.Обороты() КАК М
	|		ГДЕ " + УсловияМеханизированных + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Тран.СценарийПланирования,
	|			Тран.Организация,
	|			Тран.Подразделение,
	|			Тран.ПериодНачала,
	|			Тран.ПериодОкончания,
	|			Тран.ВидРаботы,
	|			Тран.Автомобиль,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт),
	|			Тран.Смен" + Суффикс + "Оборот
	|		ИЗ РегистрНакопления.АпкТранспортныеРаботыПоГодовомуПлану.Обороты() КАК Тран
	|		ГДЕ " + УсловияТранспортных + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Тран.СценарийПланирования,
	|			Тран.Организация,
	|			Тран.Подразделение,
	|			Тран.ПериодНачала,
	|			Тран.ПериодОкончания,
	|			Тран.ВидРаботы,
	|			Тран.Прицеп,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Прицеп),
	|			Тран.Смен" + Суффикс + "Оборот
	|		ИЗ РегистрНакопления.АпкТранспортныеРаботыПоГодовомуПлану.Обороты() КАК Тран
	|		ГДЕ " + УсловияТранспортных + "
	|	) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.СценарийПланирования,
	|	Т.Организация,
	|	Т.Подразделение,
	|	Т.ПериодНачала,
	|	Т.ПериодОкончания,
	|	Т.ВидРаботы,
	|	Т.МодельТехники,
	|	Т.ВидТехники";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СценарийПланирования", Параметры.СценарийПланирования);
	ПараметрыЗапроса.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыЗапроса.Вставить("ДатаОкончания", ДатаОкончания);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Подразделение);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Возвращает доступность техники по регистру
// АпкИсторияТранспортныхСредств (решение владельца 10.11.2026,
// docs/review/decision-dostupnost-2026-11-10.md; SRV-02 §1-2,
// design §4.7, шаг 2): ТС доступно, если на дату среза есть запись
// истории (срез последних) с Исправно = Истина. Один срез даёт и
// доступность, и приписку (Организация + ЭксплуатирующееПодразделение);
// данные Документ.АпкПланТехническихРесурсов как источник не читаются
// вовсе. Модель - через составной реквизит АпкМодель справочника
// ТранспортныеСредства, вид техники - через реквизит АпкТипТС
// (перечисление АпкТипыТС, приводится к Тх_ВидыТехники); ТС без записи
// в регистре в пуле не существует. Отборы организации/подразделения
// не применяются: пул уровня 2 межорганизационный, уровень 1 выделяется
// припиской строк (SRV-02 §2).
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен;
//       пул от сценария больше не зависит, параметр сохранён для
//       совместимости контракта вызова);
//     * ДатаСреза - Дата - дата среза истории ТС; пустая - текущая дата
//                   сеанса.
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: ТС, МодельТехники, ВидТехники,
//     ОрганизацияПриписки, ПодразделениеПриписки.
//
Функция ЗапросДоступности(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос доступности невозможен.'");
	КонецЕсли;

	// Дата среза: если не передана - текущая дата сеанса (решение
	// владельца 10.11.2026: ветка «самая поздняя дата плана» удалена
	// вместе с чтением планов). Пост-защита: СрезПоследних(&ПустаяДата)
	// падает «Несоответствие типов», пустое значение заменяется
	// на Дата(1, 1, 1).
	ДатаСреза = ЗначениеПоУмолчанию(Параметры, "ДатаСреза", Неопределено);
	Если НЕ ЗначениеЗаполнено(ДатаСреза) Тогда
		ДатаСреза = ТекущаяДатаСеанса();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаСреза) Тогда
		ДатаСреза = Дата(1, 1, 1);
	КонецЕсли;

	// Пул = срез последних записей истории ТС, Исправно = Истина.
	// Вид техники - реквизит АпкТипТС (АпкТипыТС -> Тх_ВидыТехники):
	// СХТехника -> СХТехника, Автотранспорт -> Автотранспорт,
	// СХОборудование -> Оборудование, Прицепы -> Прицеп; ТС с пустым
	// типом в пул входит, но ни с одной строкой спроса не
	// сопоставляется (пустая ссылка вида).
	ТекстЗапроса = "ВЫБРАТЬ
	|	Ист.ТранспортноеСредство КАК ТС,
	|	СпрТС.АпкМодель КАК МодельТехники,
	|	ВЫБОР
	|		КОГДА СпрТС.АпкТипТС = ЗНАЧЕНИЕ(Перечисление.АпкТипыТС.СХТехника)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника)
	|		КОГДА СпрТС.АпкТипТС = ЗНАЧЕНИЕ(Перечисление.АпкТипыТС.Автотранспорт)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт)
	|		КОГДА СпрТС.АпкТипТС = ЗНАЧЕНИЕ(Перечисление.АпкТипыТС.СХОборудование)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Оборудование)
	|		КОГДА СпрТС.АпкТипТС = ЗНАЧЕНИЕ(Перечисление.АпкТипыТС.Прицепы)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Прицеп)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.ПустаяСсылка)
	|	КОНЕЦ КАК ВидТехники,
	|	Ист.Организация КАК ОрганизацияПриписки,
	|	Ист.ЭксплуатирующееПодразделение КАК ПодразделениеПриписки
	|ИЗ РегистрСведений.АпкИсторияТранспортныхСредств.СрезПоследних(&ДатаСреза) КАК Ист
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТранспортныеСредства КАК СпрТС
	|		ПО СпрТС.Ссылка = Ист.ТранспортноеСредство
	|ГДЕ Ист.Исправно";

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, Новый Структура("ДатаСреза", ДатаСреза));

КонецФункции

// Возвращает суффикс ресурса объёма из параметров с проверкой допустимости
// (FAQ Q3: тройные ресурсы "_Мин"/"_Вер"/"_Макс", default "_Вер").
//
// Параметры:
//   Параметры - Структура - параметры запуска расчёта.
//
// Возвращаемое значение:
//   Строка - суффикс ресурса регистра годового плана.
//
Функция СуффиксОбъема(Параметры)

	// T7: ключ СуффиксОбъема в параметрах необязателен (T7-функция
	// ПотребностьПоТехкартам его не передаёт - всегда базовый "_Вер").
	Суффикс = "_Вер";
	Если Параметры.Свойство("СуффиксОбъема") Тогда
		Суффикс = Параметры.СуффиксОбъема;
	КонецЕсли;

	Если Суффикс <> "_Мин" И Суффикс <> "_Вер" И Суффикс <> "_Макс" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Недопустимый вариант объёма работ: %1'"), Суффикс);
	КонецЕсли;

	Возврат Суффикс;

КонецФункции

// Возвращает значение ключа структуры или значение по умолчанию, если ключ
// отсутствует.
//
// Параметры:
//   Структура      - Структура - источник значений;
//   Ключ           - Строка - имя ключа;
//   ПоУмолчанию    - Произвольный - значение по умолчанию.
//
// Возвращаемое значение:
//   Произвольный - значение ключа или значение по умолчанию.
//
Функция ЗначениеПоУмолчанию(Структура, Ключ, ПоУмолчанию)

	Если Структура.Свойство(Ключ) Тогда
		Возврат Структура[Ключ];
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти

#Область ФормированиеПланаРабот

// Возвращает агрегированную потребность в технике по оборотам регистров
// годового плана АПК (design 6.1, TD-005/TD-006, FR-003.1-2):
// суммы Смен_Вер/Часов_Вер (вероятностный план - базовый вариант АПК;
// *_Мин/_Макс не читаем, переключатель - релиз 2) по виду работ, модели
// техники и оборудованию, отдельно для СХ-техники и автотранспорта.
//
// Источники - обороты ДВУХ регистров накопления (TD-005):
//   АпкМеханизированныеРаботыПоГодовомуПлану (Техника/Оборудование) и
//   АпкТранспортныеРаботыПоГодовомуПлану (Автомобиль/Прицеп).
// Период - пересечение ПериодНачала/ПериодОкончания строк техкарт с окном
// запроса (FAQ Q2). Подразделение выращивания - отбор В ИЕРАРХИИ
// (включая дочерние, если указано групповое).
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор В ИЕРАРХИИ, если заполнено;
//     * ДатаНачала      - Дата - левая граница окна (пусто - без ограничения);
//     * ДатаОкончания   - Дата - правая граница окна (пусто - без ограничения).
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: ВидТехники, ВидРаботы, МодельТехники
//     (СХТехника - АпкМоделиСХТехники; Автотранспорт - АпкМоделиАвтотранспорта),
//     Оборудование (СХТехника - АпкМоделиСХОборудования; Автотранспорт -
//     АпкМоделиПрицепов), ПотребностьСмен, ПотребностьЧасов.
//
Функция ПотребностьПоТехкартам(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос потребности по техкартам невозможен.'");
	КонецЕсли;

	Суффикс = СуффиксОбъема(Параметры);
	// Необязательные ключи: локальные переменные через ЗначениеПоУмолчанию
	Организация = ЗначениеПоУмолчанию(Параметры, "Организация", Неопределено);
	Подразделение = ЗначениеПоУмолчанию(Параметры, "Подразделение", Неопределено);

	ДатаНачала = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1));
	ДатаОкончания = ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31));

	УсловияМеханизированных = "М.СценарийПланирования = &СценарийПланирования
	|	И М.ПериодОкончания >= &ДатаНачала
	|	И М.ПериодНачала <= &ДатаОкончания";
	УсловияТранспортных = "Тран.СценарийПланирования = &СценарийПланирования
	|	И Тран.ПериодОкончания >= &ДатаНачала
	|	И Тран.ПериодНачала <= &ДатаОкончания";

	Если ЗначениеЗаполнено(Организация) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Организация = &Организация";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Организация = &Организация";
	КонецЕсли;

	Если ЗначениеЗаполнено(Подразделение) Тогда
		// Отбор по подразделению выращивания В ИЕРАРХИИ (design 6.1):
		// групповое подразделение включает дочерние.
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Подразделение В ИЕРАРХИИ(&Подразделение)";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Подразделение В ИЕРАРХИИ(&Подразделение)";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.ВидТехники КАК ВидТехники,
	|	Т.ВидРаботы КАК ВидРаботы,
	|	Т.МодельТехники КАК МодельТехники,
	|	Т.Оборудование КАК Оборудование,
	|	СУММА(Т.Смен) КАК ПотребностьСмен,
	|	СУММА(Т.Часов) КАК ПотребностьЧасов
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника) КАК ВидТехники,
	|			М.ВидРаботы КАК ВидРаботы,
	|			М.Техника КАК МодельТехники,
	|			М.Оборудование КАК Оборудование,
	|			М.Смен" + Суффикс + "Оборот КАК Смен,
	|			М.Часов" + Суффикс + "Оборот КАК Часов
	|		ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану.Обороты() КАК М
	|		ГДЕ " + УсловияМеханизированных + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт),
	|			Тран.ВидРаботы,
	|			Тран.Автомобиль,
	|			Тран.Прицеп,
	|			Тран.Смен" + Суффикс + "Оборот,
	|			Тран.Часов" + Суффикс + "Оборот
	|		ИЗ РегистрНакопления.АпкТранспортныеРаботыПоГодовомуПлану.Обороты() КАК Тран
	|		ГДЕ " + УсловияТранспортных + "
	|	) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.ВидТехники,
	|	Т.ВидРаботы,
	|	Т.МодельТехники,
	|	Т.Оборудование";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СценарийПланирования", Параметры.СценарийПланирования);
	ПараметрыЗапроса.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыЗапроса.Вставить("ДатаОкончания", ДатаОкончания);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Подразделение);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Возвращает карту доступных моделей техники подразделения по проведённым
// Возвращает карту доступных моделей подразделения по регистру
// АпкИсторияТранспортныхСредств (решение владельца 10.11.2026,
// docs/review/decision-dostupnost-2026-11-10.md; T8, design 6.2,
// FR-003.4, TD-007): исправные ТС (срез последних на дату среза,
// Исправно = Истина), приписанные к организации/подразделению отбора
// (подразделение - вместе с родителями, прежняя семантика «в иерархии»);
// модель - через составной реквизит АпкМодель справочника
// ТранспортныеСредства, вид (ТипТС) - реквизит АпкТипТС (АпкТипыТС);
// количество единиц = число строк физических ТС (SRV-02 §6);
// данные Документ.АпкПланТехническихРесурсов как источник
// не читаются.
//
// Если по отборам в срезе нет ни одного исправного ТС - карта пустая
// и ПланОтсутствует = Истина (новая семантика флага: «нет исправных
// ТС в срезе», паттерн релиза 001).
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка.АпкСценарииПланирования -
//                              обязательный отбор (карта от сценария
//                              больше не зависит - машины общие для всех
//                              сценариев; параметр сохранён для
//                              совместимости контракта вызова);
//     * Организация   - СправочникСсылка - отбор по приписке, если заполнена;
//     * Подразделение - СправочникСсылка.СтруктураПредприятия - отбор
//                       по приписке (включая родителей), если заполнено;
//     * ДатаНачала    - Дата - дата среза истории ТС; пустая - текущая
//                       дата сеанса.
//
// Возвращаемое значение:
//   Структура:
//     * Модели          - ТаблицаЗначений: МодельТехники, ТипТС, ЕдиницДоступно;
//     * ТСПоМоделям     - Соответствие: МодельТехники -> Массив различаемых
//                         ссылок ТС модели (подбор физических машин, SRV-02 §6);
//     * ПланОтсутствует - Булево - нет исправных ТС по отборам в срезе.
//
Функция ДоступныеМоделиПодразделения(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Не задан сценарий планирования: карта доступности невозможна.'");
	КонецЕсли;

	Подразделение = Неопределено;
	Параметры.Свойство("Подразделение", Подразделение);
	Организация = Неопределено;
	Параметры.Свойство("Организация", Организация);

	// Подразделение отбора - вместе с родителями: приписка
	// (ЭксплуатирующееПодразделение) признаётся своей, если равна
	// подразделению или одному из его родителей.
	ИерархияПодразделений = Неопределено;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ИерархияПодразделений = Новый Массив;
		Текущий = Подразделение;
		Пока ЗначениеЗаполнено(Текущий) Цикл
			ИерархияПодразделений.Добавить(Текущий);
			Текущий = Текущий.Родитель;
		КонецЦикла;
	КонецЕсли;

	// Дата среза: ДатаНачала окна потребности, иначе текущая дата сеанса
	// (решение владельца 10.11.2026); пост-защита типа Дата для среза.
	ДатаСреза = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Неопределено);
	Если НЕ ЗначениеЗаполнено(ДатаСреза) Тогда
		ДатаСреза = ТекущаяДатаСеанса();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаСреза) Тогда
		ДатаСреза = Дата(1, 1, 1);
	КонецЕсли;

	// Отборы карты - по приписке строк среза; Исправно - всегда.
	УсловияОтбора = "Ист.Исправно";
	Если ЗначениеЗаполнено(Организация) Тогда
		УсловияОтбора = УсловияОтбора + "
	|	И Ист.Организация = &Организация";
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		УсловияОтбора = УсловияОтбора + "
	|	И Ист.ЭксплуатирующееПодразделение В (&ИерархияПодразделений)";
	КонецЕсли;

	ТекстКарты = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СпрТС.АпкМодель КАК МодельТехники,
	|	СпрТС.АпкТипТС КАК ТипТС,
	|	Ист.ТранспортноеСредство КАК ТС
	|ИЗ РегистрСведений.АпкИсторияТранспортныхСредств.СрезПоследних(&ДатаСреза) КАК Ист
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТранспортныеСредства КАК СпрТС
	|		ПО СпрТС.Ссылка = Ист.ТранспортноеСредство
	|ГДЕ " + УсловияОтбора;

	ПараметрыЗапроса = Новый Структура("ДатаСреза", ДатаСреза);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ПараметрыЗапроса.Вставить("ИерархияПодразделений",
			ИерархияПодразделений);
	КонецЕсли;

	СтрокиКарты = ВыполнитьЗапросАПК(ТекстКарты, ПараметрыЗапроса).Выгрузить();

	Модели = Новый ТаблицаЗначений;
	Модели.Колонки.Добавить("МодельТехники");
	Модели.Колонки.Добавить("ТипТС");
	Модели.Колонки.Добавить("ЕдиницДоступно");

	ТСПоМоделям = Новый Соответствие;

	Результат = Новый Структура(
		"Модели, ТСПоМоделям, ПланОтсутствует",
		Модели, ТСПоМоделям, СтрокиКарты.Количество() = 0);
	Если Результат.ПланОтсутствует Тогда
		Возврат Результат;
	КонецЕсли;

	// Агрегация в коде: единицы = число строк ТС по паре (модель, тип),
	// параллельно - массивы различаемых ТС по моделям (SRV-02 §6).
	СтрокиПоТипам = Новый Соответствие;
	Для Каждого СтрК Из СтрокиКарты Цикл
		// ТС без модели в карту не входят (пустые значения составного типа).
		Если НЕ ЗначениеЗаполнено(СтрК.МодельТехники) Тогда
			Продолжить;
		КонецЕсли;

		ПоТипам = СтрокиПоТипам.Получить(СтрК.МодельТехники);
		Если ПоТипам = Неопределено Тогда
			ПоТипам = Новый Соответствие;
			СтрокиПоТипам.Вставить(СтрК.МодельТехники, ПоТипам);
		КонецЕсли;
		СтрокаМодели = ПоТипам.Получить(СтрК.ТипТС);
		Если СтрокаМодели = Неопределено Тогда
			СтрокаМодели = Модели.Добавить();
			СтрокаМодели.МодельТехники = СтрК.МодельТехники;
			СтрокаМодели.ТипТС = СтрК.ТипТС;
			СтрокаМодели.ЕдиницДоступно = 0;
			ПоТипам.Вставить(СтрК.ТипТС, СтрокаМодели);
		КонецЕсли;
		СтрокаМодели.ЕдиницДоступно = СтрокаМодели.ЕдиницДоступно + 1;

		МашиныМодели = ТСПоМоделям.Получить(СтрК.МодельТехники);
		Если МашиныМодели = Неопределено Тогда
			МашиныМодели = Новый Массив;
			ТСПоМоделям.Вставить(СтрК.МодельТехники, МашиныМодели);
		КонецЕсли;
		Если МашиныМодели.Найти(СтрК.ТС) = Неопределено Тогда
			МашиныМодели.Добавить(СтрК.ТС);
		КонецЕсли;
	КонецЦикла;

	Результат.Модели = Модели;

	Возврат Результат;

КонецФункции

// Округляет положительное число вверх до целого (потолок): 1,25 -> 2,
// 2,0 -> 2. Глобальной функции потолка в языке нет (есть только Окр/Цел),
// семантика design 6.3 «Количество = округление вверх» реализована здесь.
//
// Параметры:
//   Значение - Число - положительное число (смены / (дней x смен в день)).
//
// Возвращаемое значение:
//   Число - минимальное целое, >= Значения.
//
Функция ОкруглитьВверх(Значение) Экспорт

	ЦелаяЧасть = Цел(Значение);
	Возврат ЦелаяЧасть + ?(Значение > ЦелаяЧасть, 1, 0);

КонецФункции

// Заполняет документ АпкПланТехническихРесурсов по потребности техкарт и
// карте доступности моделей подразделения (design 6.3, FR-003.3/5, TD-008;
// SRV-02 §6): шапка из параметров (сценарий, организация; подразделение -
// одна строка ТЧ «Подразделения»), строки - физические ТС по видам техники
// (Техника / Оборудование / Автотранспорт / Прицепы); недоступные модели
// замещаются по design 6.4.
//
// Документ только наполняется: запись и проведение - на вызывающем
// (форма обработки, тесты).
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.АпкПланТехническихРесурсов - заполняемый
//                    документ (новый или существующий);
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - обязательный отбор;
//     * Организация / Подразделение - ссылки, если заполнены (шапка + отборы);
//     * ДатаНачала / ДатаОкончания - окно потребности (FAQ Q2);
//     * ДнейПериода - Число - если не задан, = ЧислоДнейПериода окна;
//     * СменВдень - Число - если не задан, = 1.
//
// Возвращаемое значение:
//   Структура - сводка заполнения (см. ЗаполнитьТЧПланаРабот).
//
Функция ЗаполнитьПланРабот(ДокументОбъект, Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Не задан сценарий планирования: заполнение плана работ невозможно.'");
	КонецЕсли;

	ДнейПериода = ЗначениеПоУмолчанию(Параметры, "ДнейПериода", 0);
	Если ДнейПериода = 0 Тогда
		ДнейПериода = ЧислоДнейПериода(
			ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1)),
			ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31)));
	КонецЕсли;
	Если ДнейПериода <= 0 Тогда
		ВызватьИсключение НСтр(
			"ru = 'Не задан период планирования: заполнение плана работ невозможно.'");
	КонецЕсли;

	СменВдень = ЗначениеПоУмолчанию(Параметры, "СменВдень", 0);
	Если СменВдень < 0 Тогда
		ВызватьИсключение НСтр("ru = 'Число смен в день не может быть отрицательным.'");
	КонецЕсли;
	Если СменВдень = 0 Тогда
		СменВдень = 1;
	КонецЕсли;

	// Шапка документа из параметров (design 5.4).
	ДокументОбъект.СценарийПланирования = Параметры.СценарийПланирования;
	Организация = ЗначениеПоУмолчанию(Параметры, "Организация", Неопределено);
	Если Организация <> Неопределено Тогда
		ДокументОбъект.Организация = Организация;
	КонецЕсли;
	// Подразделение - строка ТЧ «Подразделения» документа плана ресурсов
	// (SRV-02 §6): перезаполнение очищает ТЧ и добавляет одну строку.
	ДокументОбъект.Подразделения.Очистить();
	Подразделение = ЗначениеПоУмолчанию(Параметры, "Подразделение", Неопределено);
	Если Подразделение <> Неопределено И ЗначениеЗаполнено(Подразделение) Тогда
		СтрокаПодразделения = ДокументОбъект.Подразделения.Добавить();
		СтрокаПодразделения.Подразделение = Подразделение;
	КонецЕсли;

	Потребность = ПотребностьПоТехкартам(Параметры).Выгрузить();
	Доступность = ДоступныеМоделиПодразделения(Параметры);

	Возврат ЗаполнитьТЧПланаРабот(
		ДокументОбъект, Потребность, Доступность, ДнейПериода, СменВдень);

КонецФункции

// Подбирает модель замещения для недоступной модели строки (design 6.4,
// FR-004): среди доступных моделей того же вида (сцепка совместима по
// построению, T4) - максимальный К >= 1; если ни у одной К >= 1 -
// максимальный К < 1 (замена медленнее).
//
// Параметры:
//   МодельОригинал - СправочникСсылка - недоступная модель строки;
//   Модели         - ТаблицаЗначений - карта доступности T8;
//   ТипКандидата   - ПеречислениеСсылка.АпкТипыТС - вид кандидатов;
//   КэшРасчета     - Структура, Неопределено - кэш расчёта
//       (см. ЗначениеРеквизитаМодели); не передан - создаётся на вызов
//       этой функции (дроссель ЖР работает, батчинга нет).
//
// Возвращаемое значение:
//   Структура:
//     * Модель  - СправочникСсылка, Неопределено - замена (Неопределено -
//                 подходящей нет);
//     * К       - Число - коэффициент замещения замены;
//     * Единиц  - Число - доступно единиц замены;
//     * КНеЗадан - Булево - были кандидаты без коэффициента (design 9).
//
Функция ПодобратьЗамещение(МодельОригинал, Модели, ТипКандидата, КэшРасчета = Неопределено)

	Замена = Неопределено;
	ЛучшийК = 0;
	ЕдиницыЗамены = 0;
	ЗамМедленнее = Неопределено;
	ЛучшийКМеньше1 = 0;
	ЕдиницыЗаменыМедленнее = 0;
	КНеЗадан = Ложь;

	// Кэш расчёта на подбор (SRV-04): не передан - создаётся на вызов
	// этой функции (дроссель ЖР работает, батчинга нет).
	Если КэшРасчета = Неопределено Тогда
		КэшРасчета = НовыйКэшРасчета();
	КонецЕсли;

	Для Каждого СтрК Из Модели Цикл
		Если СтрК.ТипТС <> ТипКандидата
				Или СтрК.ЕдиницДоступно <= 0
				Или СтрК.МодельТехники = МодельОригинал Тогда
			Продолжить;
		КонецЕсли;
		К = КоэффициентЗамещения(МодельОригинал, СтрК.МодельТехники, КэшРасчета);
		Если К = Неопределено Или К <= 0 Тогда
			КНеЗадан = Истина;
			Продолжить;
		КонецЕсли;
		Если К >= 1 Тогда
			Если Замена = Неопределено Или К > ЛучшийК Тогда
				Замена = СтрК.МодельТехники;
				ЛучшийК = К;
				ЕдиницыЗамены = СтрК.ЕдиницДоступно;
			КонецЕсли;
		Иначе
			Если ЗамМедленнее = Неопределено Или К > ЛучшийКМеньше1 Тогда
				ЗамМедленнее = СтрК.МодельТехники;
				ЛучшийКМеньше1 = К;
				ЕдиницыЗаменыМедленнее = СтрК.ЕдиницДоступно;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Замена = Неопределено И ЗамМедленнее <> Неопределено Тогда
		Замена = ЗамМедленнее;
		ЛучшийК = ЛучшийКМеньше1;
		ЕдиницыЗамены = ЕдиницыЗаменыМедленнее;
	КонецЕсли;

	Возврат Новый Структура("Модель, К, Единиц, КНеЗадан",
		Замена, ЛучшийК, ЕдиницыЗамены, КНеЗадан);

КонецФункции

// Движок заполнения табличных частей документа АпкПланТехническихРесурсов
// ФИЗИЧЕСКИМИ транспортными средствами (SRV-02 §6, design 6.3-6.4, FR-004):
// по таблице потребности (T7) и карте доступности (T8). Для каждой строки
// (пустая основная модель игнорируется, design 9):
//   - единиц нужно = округление вверх(ПотребностьСмен / (дней x СменВдень));
//   - своя модель доступна - берутся её различаемые ТС из ТСПоМоделям
//     (каждая машина назначается один раз на документ);
//   - недоступная: замещение (design 6.4) - среди доступных моделей того
//     же вида максимальный К >= 1, иначе максимальный К < 1 (замена
//     медленнее); смены и часы пересчитаны / К;
//   - замещение не найдено или ТС меньше, чем нужно - дефицитная строка;
//     пометка «коэффициент замещения не задан» (design 9).
// Строки добавляются в категорийную ТЧ по виду техники строки (СХТехника -
// Техника, Автотранспорт - Автотранспорт, Оборудование - Оборудование,
// Прицеп - Прицепы). Детали строк - в ТЗ СтрокиПлана сводки (тост и тесты;
// комментарий в документе не сохраняется, SRV-02 §6).
// Пользователь правит всё вручную после заполнения.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.АпкПланТехническихРесурсов -
//                   заполняемый документ;
//   Потребность  - ТаблицаЗначений - колонки ПотребностьПоТехкартам
//                  (ВидТехники, ВидРаботы, МодельТехники, Оборудование,
//                  ПотребностьСмен, ПотребностьЧасов);
//   Доступность  - Структура - результат ДоступныеМоделиПодразделения
//                  (Модели, ТСПоМоделям, ПланОтсутствует);
//   ДнейПериода  - Число - дней в периоде ( > 0);
//   СменВдень    - Число - смен в день ( > 0).
//
// Возвращаемое значение:
//   Структура:
//     * КоличествоСтрок   - Число - строк потребности обработано;
//     * ВсегоСмен / ВсегоЧасов - Число - суммы исходной потребности;
//     * ЗамещенныхСтрок   - Число - строк с выполненным замещением;
//     * ДефицитныхСтрок   - Число - строк, где взято ТС меньше нужного;
//     * ПланОтсутствует   - Булево - флаг карты доступности (T8);
//     * СтрокиПлана       - ТаблицаЗначений - колонки: МодельТехники,
//                          ВидРаботы, ПотребностьСмен, ПотребностьЧасов,
//                          Единиц, Замещение, Комментарий.
//
Функция ЗаполнитьТЧПланаРабот(ДокументОбъект, Потребность, Доступность,
	ДнейПериода, СменВдень) Экспорт

	СтрокиПлана = Новый ТаблицаЗначений;
	СтрокиПлана.Колонки.Добавить("МодельТехники");
	СтрокиПлана.Колонки.Добавить("ВидРаботы");
	СтрокиПлана.Колонки.Добавить("ПотребностьСмен");
	СтрокиПлана.Колонки.Добавить("ПотребностьЧасов");
	СтрокиПлана.Колонки.Добавить("Единиц");
	СтрокиПлана.Колонки.Добавить("Замещение");
	СтрокиПлана.Колонки.Добавить("Комментарий");

	Сводка = Новый Структура(
		"КоличествоСтрок, ВсегоСмен, ВсегоЧасов, ЗамещенныхСтрок, ДефицитныхСтрок, ПланОтсутствует, СтрокиПлана",
		0, 0, 0, 0, 0, Доступность.ПланОтсутствует, СтрокиПлана);

	// Индекс карты доступности: модель -> единиц (КандидатБезКоэффициента
	// отслеживается отдельно, design 9).
	ЕдиницыМоделей = Новый Соответствие;
	Для Каждого СтрК Из Доступность.Модели Цикл
		ЕдиницыМоделей.Вставить(СтрК.МодельТехники, СтрК.ЕдиницДоступно);
	КонецЦикла;

	// Каждая физическая машина назначается один раз на документ (SRV-02 §6).
	ИспользованныеТС = Новый Соответствие;

	ДокументОбъект.Техника.Очистить();
	ДокументОбъект.Оборудование.Очистить();
	ДокументОбъект.Автотранспорт.Очистить();
	ДокументОбъект.Прицепы.Очистить();

	Потребность.Сортировать("ВидРаботы");

	// Пакетный кэш реквизитов моделей (SRV-04, P1-4): модели потребности
	// и карты доступности - одна выборка на каталог; включает кэш
	// проверок метаданных и дроссель ЖР (владелец 13.11, вопрос 6).
	МоделиЗаполнения = Новый Массив;
	Для Каждого Стр Из Потребность Цикл
		МоделиЗаполнения.Добавить(Стр.МодельТехники);
	КонецЦикла;
	Для Каждого СтрК Из Доступность.Модели Цикл
		МоделиЗаполнения.Добавить(СтрК.МодельТехники);
	КонецЦикла;
	КэшРасчета = ПостроитьКэшРеквизитовМоделей(МоделиЗаполнения);

	Для Каждого Стр Из Потребность Цикл

		// Крайний случай (design 9): строка без основной техники
		// игнорируется (оборудование без техники сцепкой не считается).
		Если НЕ ЗначениеЗаполнено(Стр.МодельТехники) Тогда
			Продолжить;
		КонецЕсли;

		// Категорийная ТЧ документа по виду техники строки спроса
		// (SRV-02 §6): маршрут строки - физическое ТС.
		Если Стр.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника Тогда
			ТЧМашин = ДокументОбъект.Техника;
			ТипКандидата = Перечисления.АпкТипыТС.СХТехника;
		ИначеЕсли Стр.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
			ТЧМашин = ДокументОбъект.Автотранспорт;
			ТипКандидата = Перечисления.АпкТипыТС.Автотранспорт;
		ИначеЕсли Стр.ВидТехники = Перечисления.Тх_ВидыТехники.Оборудование Тогда
			ТЧМашин = ДокументОбъект.Оборудование;
			ТипКандидата = Перечисления.АпкТипыТС.СХОборудование;
		Иначе
			// Прицеп (значение перечисления добавлено параллельной стадией).
			ТЧМашин = ДокументОбъект.Прицепы;
			ТипКандидата = Перечисления.АпкТипыТС.Прицепы;
		КонецЕсли;

		Сводка.КоличествоСтрок = Сводка.КоличествоСтрок + 1;
		Сводка.ВсегоСмен = Сводка.ВсегоСмен + Стр.ПотребностьСмен;
		Сводка.ВсегоЧасов = Сводка.ВсегоЧасов + Стр.ПотребностьЧасов;

		// Своя модель; если её нет в карте - замещение (design 6.4):
		// смены и часы замены пересчитываются / К.
		МодельСтроки = Стр.МодельТехники;
		СменСтроки = Стр.ПотребностьСмен;
		ЧасовСтроки = Стр.ПотребностьЧасов;
		Замещение = Ложь;
		Комментарий = "";

		ЕдиницДоступно = ЕдиницыМоделей.Получить(Стр.МодельТехники);
		Если ЕдиницДоступно = Неопределено Тогда
			ЕдиницДоступно = 0;
		КонецЕсли;

		Если ЕдиницДоступно <= 0 Тогда
			// Замещение (design 6.4) - подбор в отдельной функции.
			Подбор = ПодобратьЗамещение(Стр.МодельТехники,
				Доступность.Модели, ТипКандидата, КэшРасчета);
			Если Подбор.Модель <> Неопределено Тогда
				МодельСтроки = Подбор.Модель;
				СменСтроки = Стр.ПотребностьСмен / Подбор.К;
				ЧасовСтроки = Стр.ПотребностьЧасов / Подбор.К;
				Замещение = Истина;
				Комментарий = СтрШаблон(НСтр("ru = 'замещение: %1, К=%2'"),
					Строка(Стр.МодельТехники), Формат(Подбор.К, "ЧДЦ=3"));
				Если Подбор.К < 1 Тогда
					Комментарий = Комментарий + НСтр("ru = ' (замена медленнее)'");
				КонецЕсли;
				Сводка.ЗамещенныхСтрок = Сводка.ЗамещенныхСтрок + 1;
			Иначе
				Если Подбор.КНеЗадан Тогда
					Комментарий = НСтр("ru = 'коэффициент замещения не задан'");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// Единиц нужно: округление вверх до целых единиц (TD-008);
		// замещённые строки - по пересчитанным сменам.
		ЕдиницНужно = 0;
		Если СменСтроки > 0 Тогда
			ЕдиницНужно = ОкруглитьВверх(СменСтроки / (ДнейПериода * СменВдень));
		КонецЕсли;

		// Физические ТС конечной модели, ещё не занятые в документе.
		МашиныМодели = Доступность.ТСПоМоделям.Получить(МодельСтроки);
		Если МашиныМодели = Неопределено Тогда
			МашиныМодели = Новый Массив;
		КонецЕсли;

		ЕдиницВзято = 0;
		Для Каждого ТСКарта Из МашиныМодели Цикл
			Если ЕдиницВзято >= ЕдиницНужно Тогда
				Прервать;
			КонецЕсли;
			Если ИспользованныеТС.Получить(ТСКарта) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = ТЧМашин.Добавить();
			НовСтр.ТранспортноеСредство = ТСКарта;
			ИспользованныеТС.Вставить(ТСКарта, Истина);
			ЕдиницВзято = ЕдиницВзято + 1;
		КонецЦикла;

		Если ЕдиницВзято < ЕдиницНужно Тогда
			Сводка.ДефицитныхСтрок = Сводка.ДефицитныхСтрок + 1;
		КонецЕсли;

		// Деталь строки для тоста и тестов (в документе не сохраняется).
		СтрокаПлана = СтрокиПлана.Добавить();
		СтрокаПлана.МодельТехники = МодельСтроки;
		СтрокаПлана.ВидРаботы = Стр.ВидРаботы;
		СтрокаПлана.ПотребностьСмен = СменСтроки;
		СтрокаПлана.ПотребностьЧасов = ЧасовСтроки;
		СтрокаПлана.Единиц = ЕдиницВзято;
		СтрокаПлана.Замещение = Замещение;
		СтрокаПлана.Комментарий = Комментарий;

	КонецЦикла;

	Возврат Сводка;

КонецФункции

#КонецОбласти

#Область РасчетДефицита

// Выполняет расчёт дефицита техники и записывает результат в регистр
// сведений Тх_ДефицитТехники (design §4.7, шаги 3-5; TD-002, TD-003;
// SRV-02 §2-3; SRV-01: Q-001 B + Q-004 C1): очистка ДИАПАЗОНА ЗАПУСКА -
// удаляются только строки, чей период пересекается с диапазоном хотя бы
// одним днём; транзакция с точной блокировкой ключей (ИсточникДанных-ТЗ,
// вариант A: чтения-до только для области + страж состава), сопоставление
// потребности (годовой план АПК) с доступностью ДВУМЯ УРОВНЯМИ
// (уровень 1 - машины, приписанные к организации/подразделению строки,
// по срезу истории ТС; уровень 2 - межорганизационный пул по источникам),
// пересчёт аналогов через коэффициенты (TD-004) и запись строк дефицита
// и перемещений (строки с заполненными источниками).
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор, если заполнено;
//     * ДатаНачала      - Дата - левая граница диапазона запуска
//                         (пустая - вся глубина, как в ЗапросПотребности);
//                         она же - дата среза приписки ТС (SRV-02 §2);
//     * ДатаОкончания   - Дата - правая граница диапазона запуска;
//     * СменВДень       - Число - смен в день (FAQ Q1, default 1);
//     * СуффиксОбъема   - Строка - "_Мин"/"_Вер"/"_Макс" (FAQ Q3, default "_Вер").
//
// Возвращаемое значение:
//   Число - число записанных строк регистра.
//
Функция РассчитатьДефицит(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: расчёт дефицита невозможен.'");
	КонецЕсли;

	// Ранняя валидация варианта объёма (суффикс ресурса годового плана, FAQ Q3).
	СуффиксОбъема(Параметры);

	СменВДень = ЗначениеПоУмолчанию(Параметры, "СменВДень", 1);
	Если НЕ ЗначениеЗаполнено(СменВДень) ИЛИ СменВДень <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Параметр «Смен в день» должен быть положительным числом.'");
	КонецЕсли;

	// Отбор по виду техники (design §4.7): если задан - в расчёт идут только
	// строки потребности этого вида (пустой - все виды).
	ВидТехники = ЗначениеПоУмолчанию(Параметры, "ВидТехники", Неопределено);

	// Границы диапазона запуска (SRV-01, Q-001 B): символьно те же дефолты,
	// что и в ЗапросПотребности (:577-580), - одно правило пересечения
	// для потребности и очистки (P0-2). Пустые даты = вся глубина.
	ДатаНачалаЗапуска = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1));
	ДатаОкончанияЗапуска = ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31));

	Записано = 0;
	НачатьТранзакцию();	// без параметра: 8.3-таймаут транзакции в 8.5 удалён (пробы F7)
	Попытка
		// Чтения-до (SRV-01 дизайн §5, вариант A п.1): ТОЛЬКО для состава
		// области блокировки; в расчёт эти данные НЕ идут - авторитет
		// только у чтений после блокировки.
		ТЗПотребностьДо = ЗапросПотребности(Параметры).Выгрузить();
		ТЗОчисткиДо = ЗапросКлючейОчистки(Параметры, ДатаНачалаЗапуска, ДатаОкончанияЗапуска).Выгрузить();

		// Блокировка точным набором ключей (Q-004 C1; канон доказан пробами
		// F2-F5): ИсточникДанных = ТЗ ключей, маппинг 8 измерений без
		// Источник* - строки перемещений любого источника покрыты ключом
		// спроса. Элемент без значений блокирует всё пространство - пустые
		// ТЗ здесь безопасны (F5), но маппинг обязателен (F4).
		// Ожидание ограничено настройкой ИБ «ВремяОжиданияБлокировкиДанных»
		// (дефолт 20 с): по истечении - исключение -> полный откат, БЕЗ
		// автоповтора. Закрыть БлокировкаДанных нельзя (нет finally) -
		// держится до конца транзакции.
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Тх_ДефицитТехники");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.ИсточникДанных = ТЗКлючейБлокировки(ТЗОчисткиДо, ТЗПотребностьДо, ВидТехники);
		Для Каждого ИмяИзмерения Из ИзмеренияБлокировкиДефицита() Цикл
			Элемент.ИспользоватьИзИсточникаДанных(ИмяИзмерения, ИмяИзмерения);
		КонецЦикла;
		Блокировка.Заблокировать();

		// Авторитетные чтения ПОСЛЕ блокировки (ядро C1): потребность №2,
		// доступность и delete-set №2 (перезапрос - решение владельца).
		// Дата среза истории ТС - сырой параметр ДатаНачала (SRV-02 §2,
		// НЕ дефолт 0001-01-01); пустая дата внутри ЗапросДоступности
		// заменяется текущей датой сеанса (решение владельца 10.11.2026).
		ТЗПотребность = ЗапросПотребности(Параметры).Выгрузить();
		ПараметрыДоступности = Новый Структура("СценарийПланирования, ДатаСреза",
			Параметры.СценарийПланирования,
			ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Неопределено));
		ТЗДоступность = ЗапросДоступности(ПараметрыДоступности).Выгрузить();
		ТЗОчистки = ЗапросКлючейОчистки(Параметры, ДатаНачалаЗапуска, ДатаОкончанияЗапуска).Выгрузить();

		// Индекс уровня 1: приписка «организация|подразделение» -> машины;
		// пул уровня 2 - вся таблица доступности (SRV-02 §2); строится из
		// авторитетного чтения - после блокировки.
		ИндексУровня1 = ИндексПрипискиПоОргПодр(ТЗДоступность);

		// Страж области (дизайн §5, вариант A п.4): состав ключей чтений-до
		// обязан совпасть с составом после блокировки; расхождение = параллельное
		// изменение между чтением-до и блокировкой -> полный откат, без автоповтора.
		Если НЕ НаборыКлючейДефицитаИдентичны(ТЗПотребностьДо, ТЗПотребность, ВидТехники, Ложь)
			ИЛИ НЕ НаборыКлючейДефицитаИдентичны(ТЗОчисткиДо, ТЗОчистки, ВидТехники, Истина) Тогда
			ВызватьИсключение НСтр("ru = 'Состав строк расчёта изменился во время ожидания блокировки: запустите расчёт повторно.'");
		КонецЕсли;

		// Очистка диапазона (Q-001 B): удаляются ТОЛЬКО строки, чей период
		// пересекается с диапазоном запуска хотя бы одним днём (канон F1:
		// полно-ключевой отбор по 10 измерениям + Записать(Истина) пустым);
		// строки вне диапазона не попадают ни в delete-set, ни в набор записи.
		УдалитьСтрокиДефицитаПоКлючам(ТЗОчистки);

		НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
		УстановитьОтборыЗапуска(НаборЗаписей.Отбор, Параметры);

		// Защита от дублей ключа (10 измерений): потребность уже сгруппирована
		// запросом, дублей быть не должно; при совпадении остаётся первая строка
		// (дубль ключа в наборе записей - ошибка записи в 1С).
		КлючиСтрок = Новый Соответствие;

		// Шаги 4-5: по каждой строке потребности - двухуровневое сопоставление
		// (SRV-02 §2) и запись строки дефицита + строк перемещений.
		// Пакетный кэш реквизитов моделей (SRV-04, P1-4): все модели
		// расчёта (потребность + доступность) х реквизиты их каталогов -
		// одна выборка на каталог вместо поштучных запросов; включает
		// кэш проверок метаданных и дроссель ЖР (владелец 13.11, вопрос 6).
		МоделиРасчета = Новый Массив;
		Для Каждого Стр Из ТЗПотребность Цикл
			МоделиРасчета.Добавить(Стр.МодельТехники);
		КонецЦикла;
		Для Каждого Стр Из ТЗДоступность Цикл
			МоделиРасчета.Добавить(Стр.МодельТехники);
		КонецЦикла;
		КэшРасчета = ПостроитьКэшРеквизитовМоделей(МоделиРасчета);
		Для Каждого Стр Из ТЗПотребность Цикл

			Если ЗначениеЗаполнено(ВидТехники) И Стр.ВидТехники <> ВидТехники Тогда
				Продолжить;
			КонецЕсли;

			Ключ = КлючЗаписиДефицита(Стр);
			Если КлючиСтрок.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КлючиСтрок.Вставить(Ключ, Истина);

			Дней = ЧислоДнейПериода(Стр.ПериодНачала, Стр.ПериодОкончания);

			Сопоставление = ДоступностьСтрокиДвумяУровнями(
				Стр, ИндексУровня1, ТЗДоступность, Дней, СменВДень, КэшРасчета);

			// Дефицит неотрицателен, округление 2 знака (FR-012); два уровня
			// доступности: свои машины + межорганизационный пул (SRV-02 §2).
			НехваткаПослеСвоих = Макс(0,
				Окр(Стр.ПотребностьСмен - Сопоставление.ДоступноУровень1, 2));
			Дефицит = Макс(0, Окр(НехваткаПослеСвоих - Сопоставление.ДоступноУровень2, 2));

			// Строка дефицита: измерения-источники пустые (SRV-02 §3).
			Запись = НаборЗаписей.Добавить();
			Запись.Организация = Стр.Организация;
			Запись.Подразделение = Стр.Подразделение;
			Запись.СценарийПланирования = Стр.СценарийПланирования;
			Запись.ПериодНачала = Стр.ПериодНачала;
			Запись.ПериодОкончания = Стр.ПериодОкончания;
			Запись.ВидРаботы = Стр.ВидРаботы;
			Запись.МодельТехники = Стр.МодельТехники;
			Запись.ВидТехники = Стр.ВидТехники;
			Запись.ПотребностьСмен = Стр.ПотребностьСмен;
			Запись.ДоступноСмен = Окр(
				Сопоставление.ДоступноУровень1 + Сопоставление.ДоступноУровень2, 2);
			Запись.НехватаетПослеСвоихСмен = НехваткаПослеСвоих;
			Запись.НехватаетСмен = Дефицит;
			Запись.ДнейПериода = Дней;
			Запись.СменВДень = СменВДень;
			Запись.КоэффициентНеЗадан = Сопоставление.КоэффициентНеЗадан;
			// Нет машин, приписанных к организации/подразделению строки (A2).
			Запись.ПланТехресурсовОтсутствует =
				ИндексУровня1.Получить(КлючПриписки(Стр.Организация, Стр.Подразделение))
					= Неопределено;

			Записано = Записано + 1;

			// Строки перемещений: источник = приписка покрывающих машин (B2);
			// контекст - строка спроса, ресурсы - нули (SRV-02 §3).
			Для Каждого Перемещение Из Сопоставление.Перемещения Цикл
				ЗаписьПеремещения = НаборЗаписей.Добавить();
				ЗаписьПеремещения.Организация = Стр.Организация;
				ЗаписьПеремещения.Подразделение = Стр.Подразделение;
				ЗаписьПеремещения.СценарийПланирования = Стр.СценарийПланирования;
				ЗаписьПеремещения.ПериодНачала = Стр.ПериодНачала;
				ЗаписьПеремещения.ПериодОкончания = Стр.ПериодОкончания;
				ЗаписьПеремещения.ВидРаботы = Стр.ВидРаботы;
				ЗаписьПеремещения.МодельТехники = Стр.МодельТехники;
				ЗаписьПеремещения.ВидТехники = Стр.ВидТехники;
				Если ЗначениеЗаполнено(Перемещение.Организация) Тогда
					ЗаписьПеремещения.ИсточникОрганизации = Перемещение.Организация;
				КонецЕсли;
				Если ЗначениеЗаполнено(Перемещение.Подразделение) Тогда
					ЗаписьПеремещения.ИсточникПодразделения = Перемещение.Подразделение;
				КонецЕсли;
				ЗаписьПеремещения.ПотребностьСмен = Стр.ПотребностьСмен;
				ЗаписьПеремещения.ПеремещеноСмен = Окр(Перемещение.Смен, 2);

				Записано = Записано + 1;
			КонецЦикла;

		КонецЦикла;

		Если Записано > 0 Тогда
			НаборЗаписей.Записать(Ложь);
		КонецЕсли;

		// UI-01 (Q-008c): момент успешного расчёта по сценарию - основа
		// пометки устаревания (та же транзакция: либо расчёт и момент,
		// либо ничего).
		ЗаписатьМоментРасчета(Параметры.СценарийПланирования, ТекущаяУниверсальнаяДата());
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// Явное сообщение пользователю, БЕЗ автоповтора (C1): исходная
		// причина - в КраткоеПредставлениеОшибки (вкл. текст таймаута
		// блокировки и срабатывания стража).
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Расчёт дефицита не выполнен: повторите запуск вручную. Причина: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Записано;

КонецФункции

// Записывает момент расчёта дефицита по сценарию (UI-01, Q-008 вариант c).
//
// Параметры:
//   Сценарий         - СправочникСсылка.АпкСценарииПланирования - сценарий расчёта;
//   МоментРасчета    - Дата - момент успешного завершения расчёта.
//
Процедура ЗаписатьМоментРасчета(Сценарий, МоментРасчета)

	Запись = РегистрыСведений.Тх_МоментРасчета.СоздатьМенеджерЗаписи();
	Запись.СценарийПланирования = Сценарий;
	Запись.МоментРасчета = МоментРасчета;
	Запись.Записать();

КонецПроцедуры

// Возвращает момент последнего расчёта дефицита по сценарию.
//
// Параметры:
//   Сценарий - СправочникСсылка.АпкСценарииПланирования - сценарий расчёта.
//
// Возвращаемое значение:
//   Дата - момент расчёта; '00010101' - расчёт не выполнялся.
//
Функция МоментРасчетаДефицита(Сценарий) Экспорт

	Если НЕ ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.МоментРасчета КАК МоментРасчета
	|ИЗ
	|	РегистрСведений.Тх_МоментРасчета КАК Т
	|ГДЕ
	|	Т.СценарийПланирования = &Сценарий";
	Запрос.УстановитьПараметр("Сценарий", Сценарий);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.МоментРасчета) Тогда
		Возврат Выборка.МоментРасчета;
	КонецЕсли;

	Возврат Дата(1, 1, 1);

КонецФункции

// Проверяет, изменялись ли источники потребности после последнего расчёта
// (UI-01, Q-008 вариант c). Признак изменения - дата регистратора записей
// годового плана АПК новее сохранённого момента расчёта; собственных
// бизнес-правил «что считать изменением» не вводится.
//
// Параметры:
//   Сценарий - СправочникСсылка.АпкСценарииПланирования - сценарий расчёта.
//
// Возвращаемое значение:
//   Структура:
//     * Устарели          - Булево - источники изменялись после расчёта;
//     * МоментРасчета     - Дата - момент последнего расчёта;
//     * ПоследнееИзменение - Дата - самая поздняя дата регистратора источников.
//
Функция ДанныеРасчетаУстарели(Сценарий) Экспорт

	Результат = Новый Структура("Устарели, МоментРасчета, ПоследнееИзменение",
		Ложь, МоментРасчетаДефицита(Сценарий), Дата(1, 1, 1));

	Если НЕ ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Результат;
	КонецЕсли;

	Момент = Результат.МоментРасчета;
	Если Момент = Дата(1, 1, 1) Тогда
		// Расчёта ещё не было - устаревать нечему (пометка не выводится).
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(П.Период) КАК Период
		|ИЗ
		|	РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану КАК П
		|ГДЕ
		|	П.СценарийПланирования = &Сценарий
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	МАКСИМУМ(П.Период) КАК Период
		|ИЗ
		|	РегистрНакопления.АпкТранспортныеРаботыПоГодовомуПлану КАК П
		|ГДЕ
		|	П.СценарийПланирования = &Сценарий";
		Запрос.УстановитьПараметр("Сценарий", Сценарий);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Период)
				И Выборка.Период > Результат.ПоследнееИзменение Тогда
				Результат.ПоследнееИзменение = Выборка.Период;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Источники недоступны (нет модуля АПК / нет прав): пометку не
		// выводим, но и не роняем открытие формы - причина в ЖР.
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Тх_ТехникаСервер: не удалось проверить устаревание данных расчёта'"),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Результат.Устарели = Результат.ПоследнееИзменение > Момент;

	Возврат Результат;

КонецФункции

// Держит блокировку области расчёта дефицита N секунд (экспортная
// фикстура теста bounded-wait, Q-004 C1, дизайн §6.5): та же область
// и тот же состав ключей, что в РассчитатьДефицит. Ничего не пишет:
// транзакция откатывается по завершении удержания (sleep в BSL нет -
// занят-цикл по ТекущаяУниверсальнаяДатаВМиллисекундах).
// Пробы ФЗ 2026-11-13: ФоновыеЗадания.Выполнить возвращает «Фоновое
// задание» с УникальныйИдентификатор/ИмяМетода/Состояние (Идентификатор
// 8.3 удалён); ОжидатьЗавершения - процедура.
//
// Параметры:
//   Параметры        - Структура - параметры запуска расчёта (как
//                      РассчитатьДефицит: СценарийПланирования обязателен);
//   СекундУдержания  - Число - сколько держать блокировку.
//
Процедура ДержатьБлокировкуДефицита(Параметры, СекундУдержания) Экспорт

	ВидТехники = ЗначениеПоУмолчанию(Параметры, "ВидТехники", Неопределено);
	ДатаНачалаЗапуска = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1));
	ДатаОкончанияЗапуска = ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31));

	ТЗПотребность = ЗапросПотребности(Параметры).Выгрузить();
	ТЗОчистки = ЗапросКлючейОчистки(Параметры, ДатаНачалаЗапуска, ДатаОкончанияЗапуска).Выгрузить();

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Тх_ДефицитТехники");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.ИсточникДанных = ТЗКлючейБлокировки(ТЗОчистки, ТЗПотребность, ВидТехники);
		Для Каждого ИмяИзмерения Из ИзмеренияБлокировкиДефицита() Цикл
			Элемент.ИспользоватьИзИсточникаДанных(ИмяИзмерения, ИмяИзмерения);
		КонецЦикла;
		Блокировка.Заблокировать();

		// Занят-цикл: держим транзакцию и блокировку заданное время.
		ДельтаМс = СекундУдержания * 1000;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СчетчикИтераций = 0;
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < ДельтаМс Цикл
			СчетчикИтераций = СчетчикИтераций + 1;	// занят-цикл (sleep в BSL нет)
		КонецЦикла;

		// Ничего не меняли: фиксация пустой транзакции эквивалентна откату
		// (пары Начать/Зафиксировать по стандарту).
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Тх_ТехникаСервер: удержание блокировки области расчёта не выполнено'"),
			УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Возвращает строковый ключ приписки ТС «организация|подразделение»
// (SRV-02 §2: уровень 1 сопоставляет машины по приписке спроса).
//
// Параметры:
//   Организация   - СправочникСсылка, Неопределено - организация приписки;
//   Подразделение - СправочникСсылка, Неопределено - подразделение приписки.
//
// Возвращаемое значение:
//   Строка - ключ приписки.
//
Функция КлючПриписки(Организация, Подразделение)

	Возврат Строка(Организация) + "|" + Строка(Подразделение);

КонецФункции

// Возвращает индекс приписки машин по «организация|подразделение»
// (SRV-02 §2, уровень 1 A2): один проход по таблице доступности (NFR-002);
// машины без приписки (нет записи среза истории ТС) в индекс не попадают -
// они остаются в общем пуле уровня 2.
//
// Параметры:
//   ТЗДоступность - ТаблицаЗначений - колонки: ТС, МодельТехники, ВидТехники,
//                   ОрганизацияПриписки, ПодразделениеПриписки.
//
// Возвращаемое значение:
//   Соответствие - Строка(Орг)|Строка(Подр) -> Массив строк таблицы
//                  доступности с этой припиской.
//
Функция ИндексПрипискиПоОргПодр(ТЗДоступность) Экспорт

	Индекс = Новый Соответствие;
	Для Каждого Машина Из ТЗДоступность Цикл
		// Машины без записи истории (приписка пустая) - только пул уровня 2.
		Если НЕ ЗначениеЗаполнено(Машина.ОрганизацияПриписки)
			И НЕ ЗначениеЗаполнено(Машина.ПодразделениеПриписки) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючПриписки(Машина.ОрганизацияПриписки, Машина.ПодразделениеПриписки);
		МашиныПриписки = Индекс.Получить(Ключ);
		Если МашиныПриписки = Неопределено Тогда
			МашиныПриписки = Новый Массив;
			Индекс.Вставить(Ключ, МашиныПриписки);
		КонецЕсли;
		МашиныПриписки.Добавить(Машина);
	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Возвращает вклад одной машины доступности в покрытие строки спроса
// (правила сопоставления моделей, SRV-02 §2):
//   точная модель - полная ёмкость (Дней x СменВДень);
//   другая модель того же вида - только для СХТехники: ёмкость / К
//   (КоэффициентЗамещения, TD-004; Автотранспорт и Прицеп -
//   модель в модель, FAQ Q4).
//
// Параметры:
//   Машина  - СтрокаТаблицыЗначений - строка таблицы доступности;
//   Стр     - СтрокаТаблицыЗначений - строка потребности;
//   Емкость - Число - смен на машину за интервал строки (Дней x СменВДень);
//   КэшРасчета - Структура, Неопределено - кэш расчёта
//       (см. ЗначениеРеквизитаМодели).
//
// Возвращаемое значение:
//   Число - вклад машины в сменах; 0 - машина не сопоставляется;
//   Неопределено - коэффициент замещения не задан (КоэффициентНеЗадан).
//
Функция ДоступностьМашиныДляСтроки(Машина, Стр, Емкость, КэшРасчета = Неопределено)

	// Сопоставляются только машины того же вида техники, что у строки
	// спроса (D-007).
	Если Машина.ВидТехники <> Стр.ВидТехники Тогда
		Возврат 0;
	КонецЕсли;

	// Точная модель - без пересчёта через К (D-007).
	Если Машина.МодельТехники = Стр.МодельТехники Тогда
		Возврат Емкость;
	КонецЕсли;

	// Замена другой моделью - только для СХТехники (design 6.4, TD-004);
	// Автотранспорт и Прицеп - строго модель в модель (FAQ Q4).
	Если Стр.ВидТехники <> Перечисления.Тх_ВидыТехники.СХТехника Тогда
		Возврат 0;
	КонецЕсли;

	К = КоэффициентЗамещения(Стр.МодельТехники, Машина.МодельТехники, КэшРасчета);
	Если К = Неопределено Тогда
		// У модели нет реквизитов замещения (или разные базовые) -
		// пометка вместо молчаливого 1,00 (FR-011).
		Возврат Неопределено;
	КонецЕсли;

	Возврат Емкость / К;

КонецФункции

// Устанавливает отборы набора записи регистра Тх_ДефицитТехники по отборам
// запуска: сценарий - всегда, организация и подразделение - если заполнены,
// вид техники - если задан (design §4.7, шаг 3; SRV-01: набор используется
// только для записи новых строк с Записать(Ложь); очистка выполняется
// отдельно, по ключам delete-set - УдалитьСтрокиДефицитаПоКлючам).
//
// Параметры:
//   Отбор     - ОтборНабораЗаписейСведений - отбор набора записей регистра;
//   Параметры - Структура - параметры запуска расчёта.
//
Процедура УстановитьОтборыЗапуска(Отбор, Параметры)

	Отбор.СценарийПланирования.Установить(Параметры.СценарийПланирования);
	// Через ЗначениеПоУмолчанию (как ВидТехники ниже): ключ структуры
	// необязателен - запуск может быть без отбора организации/подразделения
	// (SRV-01: периодные тесты передают только сценарий и даты).
	Организация = ЗначениеПоУмолчанию(Параметры, "Организация", Неопределено);
	Если ЗначениеЗаполнено(Организация) Тогда
		Отбор.Организация.Установить(Организация);
	КонецЕсли;
	Подразделение = ЗначениеПоУмолчанию(Параметры, "Подразделение", Неопределено);
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Отбор.Подразделение.Установить(Подразделение);
	КонецЕсли;
	ВидТехники = ЗначениеПоУмолчанию(Параметры, "ВидТехники", Неопределено);
	Если ЗначениеЗаполнено(ВидТехники) Тогда
		Отбор.ВидТехники.Установить(ВидТехники);
	КонецЕсли;

КонецПроцедуры

// Возвращает строковый ключ записи дефицита по 10 измерениям (защита
// от дублей ключа при записи набора): 8 измерений строки спроса +
// источник перемещения (для строк дефицита - пустые ссылки).
//
// Параметры:
//   Стр - СтрокаТаблицыЗначений - строка потребности (запрос ЗапросПотребности);
//   ИсточникОрганизации   - СправочникСсылка, Неопределено - организация источника;
//   ИсточникПодразделения - СправочникСсылка, Неопределено - подразделение источника.
//
// Возвращаемое значение:
//   Строка - ключ по значениям всех измерений.
//
Функция КлючЗаписиДефицита(Стр, ИсточникОрганизации = Неопределено, ИсточникПодразделения = Неопределено)

	Возврат Строка(Стр.Организация) + "|" + Строка(Стр.Подразделение) + "|"
		+ Строка(Стр.СценарийПланирования) + "|" + Строка(Стр.ПериодНачала) + "|"
		+ Строка(Стр.ПериодОкончания) + "|" + Строка(Стр.ВидРаботы) + "|"
		+ Строка(Стр.МодельТехники) + "|" + Строка(Стр.ВидТехники) + "|"
		+ Строка(ИсточникОрганизации) + "|" + Строка(ИсточникПодразделения);

КонецФункции

// Возвращает имена 8 измерений области блокировки регистра
// Тх_ДефицитТехники (SRV-01 дизайн §5, вариант A п.2): Источник* НЕ
// входит - строки перемещений любого источника покрыты ключом спроса
// (8 измерений строки); маппинг 1:1 «измерение = колонка ТЗ» (проба F3).
//
// Возвращаемое значение:
//   Массив - имена измерений.
//
Функция ИзмеренияБлокировкиДефицита()

	Возврат СтрРазделить("Организация,Подразделение,СценарийПланирования,"
		+ "ПериодНачала,ПериодОкончания,ВидРаботы,МодельТехники,ВидТехники", ",");

КонецФункции

// Запрос delete-set - ключей (10 измерений) строк регистра
// Тх_ДефицитТехники под отборами запуска И правилом пересечения периодов
// (Q-001 B, дизайн §3-4): ПериодОкончания >= ДатаНачала И ПериодНачала <=
// ДатаОкончания - символьно то же условие, что отбор потребности в
// ЗапросПотребности (:577-580). Пустые даты вызывающий раскрывает в
// 0001-01-01 / 3999-12-31 - пересечение захватывает все строки сценария
// (осознанный кейс «пустые даты = полная перезапись», дизайн §3).
//
// Параметры:
//   Параметры     - Структура - параметры запуска (СценарийПланирования
//                   обязателен; Организация/Подразделение/ВидТехники -
//                   отбор, если заполнены);
//   ДатаНачала    - Дата - левая граница диапазона запуска;
//   ДатаОкончания - Дата - правая граница диапазона запуска.
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: 10 измерений регистра.
//
Функция ЗапросКлючейОчистки(Параметры, ДатаНачала, ДатаОкончания)

	Условия = "Д.СценарийПланирования = &СценарийПланирования
	|И Д.ПериодОкончания >= &ДатаНачала
	|И Д.ПериодНачала <= &ДатаОкончания";

	Организация = ЗначениеПоУмолчанию(Параметры, "Организация", Неопределено);
	Если ЗначениеЗаполнено(Организация) Тогда
		Условия = Условия + "
		|И Д.Организация = &Организация";
	КонецЕсли;

	Подразделение = ЗначениеПоУмолчанию(Параметры, "Подразделение", Неопределено);
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Условия = Условия + "
		|И Д.Подразделение = &Подразделение";
	КонецЕсли;

	ВидТехники = ЗначениеПоУмолчанию(Параметры, "ВидТехники", Неопределено);
	Если ЗначениеЗаполнено(ВидТехники) Тогда
		Условия = Условия + "
		|И Д.ВидТехники = &ВидТехники";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|Д.Организация КАК Организация,
	|Д.Подразделение КАК Подразделение,
	|Д.СценарийПланирования КАК СценарийПланирования,
	|Д.ПериодНачала КАК ПериодНачала,
	|Д.ПериодОкончания КАК ПериодОкончания,
	|Д.ВидРаботы КАК ВидРаботы,
	|Д.МодельТехники КАК МодельТехники,
	|Д.ВидТехники КАК ВидТехники,
	|Д.ИсточникОрганизации КАК ИсточникОрганизации,
	|Д.ИсточникПодразделения КАК ИсточникПодразделения
	|ИЗ
	|РегистрСведений.Тх_ДефицитТехники КАК Д
	|ГДЕ " + Условия;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СценарийПланирования", Параметры.СценарийПланирования);
	ПараметрыЗапроса.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыЗапроса.Вставить("ДатаОкончания", ДатаОкончания);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидТехники) Тогда
		ПараметрыЗапроса.Вставить("ВидТехники", ВидТехники);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Возвращает ТЗ источника данных блокировки (проба F3): строки - кортежи
// 8 измерений (БЕЗ Источник*) из delete-set и потребности, дедупликация
// по КлючЗаписиДефицита (источники-параметры пустые - ключ по 8 измерениям
// строки); фильтр вида техники - как в цикле расчёта.
//
// Параметры:
//   ТЗОчистки     - ТаблицаЗначений - строки ЗапросКлючейОчистки (10 колонок);
//   ТЗПотребность - ТаблицаЗначений - строки ЗапросПотребности;
//   ВидТехники    - ПеречислениеСсылка, Неопределено - фильтр вида техники.
//
// Возвращаемое значение:
//   ТаблицаЗначений - 8 колонок-измерений, без дублей.
//
Функция ТЗКлючейБлокировки(ТЗОчистки, ТЗПотребность, ВидТехники)

	ТЗ = Новый ТаблицаЗначений;
	Для Каждого ИмяИзмерения Из ИзмеренияБлокировкиДефицита() Цикл
		ТЗ.Колонки.Добавить(ИмяИзмерения);
	КонецЦикла;

	ВставленныеКлючи = Новый Соответствие;

	Для Каждого ИсточникСтрок Из ТЗПотребность Цикл
		Если ЗначениеЗаполнено(ВидТехники) И ИсточникСтрок.ВидТехники <> ВидТехники Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючЗаписиДефицита(ИсточникСтрок);
		Если ВставленныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВставленныеКлючи.Вставить(Ключ, Истина);
		СтрокаБлокировки = ТЗ.Добавить();
		СтрокаБлокировки.Организация = ИсточникСтрок.Организация;
		СтрокаБлокировки.Подразделение = ИсточникСтрок.Подразделение;
		СтрокаБлокировки.СценарийПланирования = ИсточникСтрок.СценарийПланирования;
		СтрокаБлокировки.ПериодНачала = ИсточникСтрок.ПериодНачала;
		СтрокаБлокировки.ПериодОкончания = ИсточникСтрок.ПериодОкончания;
		СтрокаБлокировки.ВидРаботы = ИсточникСтрок.ВидРаботы;
		СтрокаБлокировки.МодельТехники = ИсточникСтрок.МодельТехники;
		СтрокаБлокировки.ВидТехники = ИсточникСтрок.ВидТехники;
	КонецЦикла;

	Для Каждого ИсточникСтрок Из ТЗОчистки Цикл
		Если ЗначениеЗаполнено(ВидТехники) И ИсточникСтрок.ВидТехники <> ВидТехники Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючЗаписиДефицита(ИсточникСтрок);
		Если ВставленныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВставленныеКлючи.Вставить(Ключ, Истина);
		СтрокаБлокировки = ТЗ.Добавить();
		СтрокаБлокировки.Организация = ИсточникСтрок.Организация;
		СтрокаБлокировки.Подразделение = ИсточникСтрок.Подразделение;
		СтрокаБлокировки.СценарийПланирования = ИсточникСтрок.СценарийПланирования;
		СтрокаБлокировки.ПериодНачала = ИсточникСтрок.ПериодНачала;
		СтрокаБлокировки.ПериодОкончания = ИсточникСтрок.ПериодОкончания;
		СтрокаБлокировки.ВидРаботы = ИсточникСтрок.ВидРаботы;
		СтрокаБлокировки.МодельТехники = ИсточникСтрок.МодельТехники;
		СтрокаБлокировки.ВидТехники = ИсточникСтрок.ВидТехники;
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

// Удаляет строки регистра Тх_ДефицитТехники перечислением ключей
// (канон удаления непериодического регистра, доказан пробой F1):
// набор записей с полно-ключевым отбором по 10 измерениям + Записать(Истина)
// пустым набором удаляет ровно одну строку. Пересечение периодов не
// выражается отбором набора (ПериодНачала/ПериодОкончания - измерения,
// не стандартный Период), поэтому удаление построчное.
//
// Параметры:
//   ТЗКлючей - ТаблицаЗначений - строки ЗапросКлючейОчистки (10 колонок).
//
Процедура УдалитьСтрокиДефицитаПоКлючам(ТЗКлючей)

	Для Каждого Стр Из ТЗКлючей Цикл
		НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
		Отбор = НаборЗаписей.Отбор;
		Отбор.Организация.Установить(Стр.Организация);
		Отбор.Подразделение.Установить(Стр.Подразделение);
		Отбор.СценарийПланирования.Установить(Стр.СценарийПланирования);
		Отбор.ПериодНачала.Установить(Стр.ПериодНачала);
		Отбор.ПериодОкончания.Установить(Стр.ПериодОкончания);
		Отбор.ВидРаботы.Установить(Стр.ВидРаботы);
		Отбор.МодельТехники.Установить(Стр.МодельТехники);
		Отбор.ВидТехники.Установить(Стр.ВидТехники);
		Отбор.ИсточникОрганизации.Установить(Стр.ИсточникОрганизации);
		Отбор.ИсточникПодразделения.Установить(Стр.ИсточникПодразделения);
		НаборЗаписей.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Страж области блокировки (SRV-01 дизайн §5, вариант A п.4): сравнивает
// наборы ключей двух чтений - до блокировки и после. Расхождение =
// параллельное изменение между чтением-до и блокировкой - вызывающий
// обязан откатиться и сообщить, БЕЗ автоповтора.
//
// Параметры:
//   ТЗ1        - ТаблицаЗначений - первое чтение (до блокировки);
//   ТЗ2        - ТаблицаЗначений - второе чтение (после блокировки);
//   ВидТехники - ПеречислениеСсылка, Неопределено - фильтр вида техники;
//   ЭтоОчистка - Булево - Истина: строки delete-set (ключи с источниками
//                из полей строки), Ложь: строки потребности (ключ по 8
//                измерениям, источники-параметры пустые).
//
// Возвращаемое значение:
//   Булево - Истина - наборы ключей идентичны.
//
Функция НаборыКлючейДефицитаИдентичны(ТЗ1, ТЗ2, ВидТехники, ЭтоОчистка)

	Ключи1 = КлючиНабораДефицита(ТЗ1, ВидТехники, ЭтоОчистка);
	Ключи2 = КлючиНабораДефицита(ТЗ2, ВидТехники, ЭтоОчистка);

	Если Ключи1.Количество() <> Ключи2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючЗначение Из Ключи2 Цикл
		Если Ключи1.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Возвращает соответствствие «ключ записи дефицита -> Истина» для строк
// таблицы (вспомогательная функция стража НаборыКлючейДефицитаИдентичны).
//
// Параметры:
//   ТЗ         - ТаблицаЗначений - строки потребности или delete-set;
//   ВидТехники - ПеречислениеСсылка, Неопределено - фильтр вида техники;
//   ЭтоОчистка - Булево - состав ключа: с источниками из полей строки
//                (delete-set) или по 8 измерениям (потребность).
//
// Возвращаемое значение:
//   Соответствие - ключ -> Истина.
//
Функция КлючиНабораДефицита(ТЗ, ВидТехники, ЭтоОчистка)

	Ключи = Новый Соответствие;
	Для Каждого Стр Из ТЗ Цикл
		Если ЗначениеЗаполнено(ВидТехники) И Стр.ВидТехники <> ВидТехники Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоОчистка Тогда
			Ключи.Вставить(КлючЗаписиДефицита(Стр,
				Стр.ИсточникОрганизации, Стр.ИсточникПодразделения), Истина);
		Иначе
			Ключи.Вставить(КлючЗаписиДефицита(Стр), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Ключи;

КонецФункции

// Возвращает доступность по строке спроса ДВУМЯ УРОВНЯМИ (SRV-02 §2,
// A2/B2; design §4.7, шаги 4-5; TD-004, FR-011, D-007):
//   уровень 1 - машины, приписанные к организации и подразделению строки
//   (срез истории ТС): точная модель - полная ёмкость, другая модель того
//   же вида - только СХТехника через КоэффициентЗамещения (Неопределено -
//   КоэффициентНеЗадан = Истина, НЕ молчаливый 1,00);
//   уровень 2 - если своим не хватило: оставшиеся машины сценария того же
//   вида, сгруппированные по приписке-источнику (без приписки - отдельная
//   группа); источники потребляются в стабильном порядке (по организации,
//   затем подразделению), каждый даёт до ёмкости своих машин, суммарное
//   покрытие не превышает нехватки после своих смен.
//
// Параметры:
//   Стр           - СтрокаТаблицыЗначений - строка потребности;
//   ИндексУровня1 - Соответствие - индекс ИндексПрипискиПоОргПодр;
//   Пул           - ТаблицаЗначений - вся таблица доступности (уровень 2);
//   Дней          - Число - календарных дней интервала строки;
//   СменВДень     - Число - смен в день (FAQ Q1);
//   КэшРасчета    - Структура, Неопределено - кэш расчёта
//       (см. ЗначениеРеквизитаМодели).
//
// Возвращаемое значение:
//   Структура:
//     * ДоступноУровень1  - Число - смен машин своей приписки;
//     * ДоступноУровень2  - Число - смен машин других приписок/без приписки;
//     * КоэффициентНеЗадан - Булево - были кандидаты без коэффициента;
//     * Перемещения - ТаблицаЗначений - колонки: Организация, Подразделение,
//                     Смен - вклад каждого источника уровня 2.
//
Функция ДоступностьСтрокиДвумяУровнями(Стр, ИндексУровня1, Пул, Дней, СменВДень, КэшРасчета = Неопределено) Экспорт

	Емкость = Дней * СменВДень;
	КоэффициентНеЗадан = Ложь;

	// Уровень 1 (A2): машины с припиской (организация, подразделение) строки.
	ДоступноУровень1 = 0;
	МашиныСвои = ИндексУровня1.Получить(КлючПриписки(Стр.Организация, Стр.Подразделение));
	Если МашиныСвои <> Неопределено Тогда
		Для Каждого Машина Из МашиныСвои Цикл
			Вклад = ДоступностьМашиныДляСтроки(Машина, Стр, Емкость, КэшРасчета);
			Если Вклад = Неопределено Тогда
				КоэффициентНеЗадан = Истина;
			Иначе
				ДоступноУровень1 = ДоступноУровень1 + Вклад;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Перемещения = Новый ТаблицаЗначений;
	Перемещения.Колонки.Добавить("Организация");
	Перемещения.Колонки.Добавить("Подразделение");
	Перемещения.Колонки.Добавить("Смен");

	// Уровень 2 (B2): своим не хватило - общий пул сценария по источникам.
	ДоступноУровень2 = 0;
	НехваткаПослеСвоих = Макс(0, Окр(Стр.ПотребностьСмен - ДоступноУровень1, 2));
	Если НехваткаПослеСвоих > 0 Тогда

		КлючСпроса = КлючПриписки(Стр.Организация, Стр.Подразделение);

		// Группировка пул-машин по приписке-источнику (пустая приписка -
		// отдельная группа «без приписки»).
		Источники = Новый ТаблицаЗначений;
		Источники.Колонки.Добавить("КлючОрг");
		Источники.Колонки.Добавить("КлючПодр");
		Источники.Колонки.Добавить("Организация");
		Источники.Колонки.Добавить("Подразделение");
		Источники.Колонки.Добавить("Машины");
		НайденныеИсточники = Новый Соответствие;

		Для Каждого Машина Из Пул Цикл
			Если Машина.ВидТехники <> Стр.ВидТехники Тогда
				Продолжить;
			КонецЕсли;
			КлючОрг = Строка(Машина.ОрганизацияПриписки);
			КлючПодр = Строка(Машина.ПодразделениеПриписки);
			Если КлючОрг + "|" + КлючПодр = КлючСпроса Тогда
				// Приписка совпадает со спросом - это уровень 1.
				Продолжить;
			КонецЕсли;
			Источник = НайденныеИсточники.Получить(КлючОрг + "|" + КлючПодр);
			Если Источник = Неопределено Тогда
				Источник = Источники.Добавить();
				Источник.КлючОрг = КлючОрг;
				Источник.КлючПодр = КлючПодр;
				Источник.Организация = Машина.ОрганизацияПриписки;
				Источник.Подразделение = Машина.ПодразделениеПриписки;
				Источник.Машины = Новый Массив;
				НайденныеИсточники.Вставить(КлючОрг + "|" + КлючПодр, Источник);
			КонецЕсли;
			Источник.Машины.Добавить(Машина);
		КонецЦикла;

		// Стабильный порядок потребления: по организации, затем подразделению.
		Источники.Сортировать("КлючОрг, КлючПодр");

		Осталось = НехваткаПослеСвоих;
		Для Каждого Источник Из Источники Цикл
			Если Осталось <= 0 Тогда
				Прервать;
			КонецЕсли;
			ЕмкостьИсточника = 0;
			Для Каждого Машина Из Источник.Машины Цикл
				Вклад = ДоступностьМашиныДляСтроки(Машина, Стр, Емкость, КэшРасчета);
				Если Вклад = Неопределено Тогда
					КоэффициентНеЗадан = Истина;
				Иначе
					ЕмкостьИсточника = ЕмкостьИсточника + Вклад;
				КонецЕсли;
			КонецЦикла;
			Перемещено = Мин(ЕмкостьИсточника, Осталось);
			Если Перемещено > 0 Тогда
				СтрокаПеремещения = Перемещения.Добавить();
				СтрокаПеремещения.Организация = Источник.Организация;
				СтрокаПеремещения.Подразделение = Источник.Подразделение;
				СтрокаПеремещения.Смен = Перемещено;
				ДоступноУровень2 = ДоступноУровень2 + Перемещено;
				Осталось = Осталось - Перемещено;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Новый Структура(
		"ДоступноУровень1, ДоступноУровень2, КоэффициентНеЗадан, Перемещения",
		ДоступноУровень1, ДоступноУровень2, КоэффициентНеЗадан, Перемещения);

КонецФункции

#КонецОбласти

#Область СлужебныеТестированиеБ6

// Возвращает ссылку элемента справочника по наименованию (служебная функция
// для Vanessa-сценариев B6: поля формы записи с конкретными типами
// заполняются из кода клиента тестирования).
//
// Параметры:
//	 ИмяСправочника - Строка - имя справочника конфигурации;
//	 Наименование   - Строка - искомое наименование.
//
// Возвращаемое значение:
//	 СправочникСсылка - найденный элемент или пустая ссылка.
//
Функция Тх_СсылкаПоНаименованию(Знач ИмяСправочника, Знач Наименование) Экспорт

	Возврат Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);

КонецФункции

#КонецОбласти



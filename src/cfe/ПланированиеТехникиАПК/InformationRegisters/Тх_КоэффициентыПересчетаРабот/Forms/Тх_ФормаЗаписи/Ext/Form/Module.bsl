// Модуль формы записи коэффициента пересчёта работ.
//
// B6, 2026-10-09 (v4): поля generic-составного типа (TypeSet CatalogRef,
// TD-001) в 8.5 при нажатии выбора всегда открывают окно «Выбор типа
// данных», а МенеджерЗаписи.Записать() не вызывает ПередЗаписью набора -
// контроль FR-003 в модуле набора обходился. Поэтому:
//  1) ввод выполняется в реквизиты формы с конкретными типами
//     (РаботаВвод, МодельСХТехники, МодельАвтотранспорта), видимые всегда
//     (НТТ-выбор значений не порождает OnChange - видимость не переключаем);
//     для видов техники без каталога моделей остаётся generic-поле;
//  2) валидация выполняется вызовом
//     Тх_ТехникаСервер.ПроверитьЗаписьКоэффициента из ПередЗаписью.

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	// Перенос значений из реквизитов ввода в запись.
	Запись.Работа = РаботаВвод;
	Запись.МодельТехники = МодельТехникиПоВиду();

	// FR-003(б): у базовой строки коэффициент принудительно 1,0000.
	Если Запись.БазоваяМодель Тогда
		Запись.Коэффициент = 1;
	КонецЕсли;

	Сообщения = ПроверитьКоэффициентНаСервере(Запись.Работа, Запись.Период,
		Запись.ВидТехники, Запись.МодельТехники, Запись.Коэффициент,
		Запись.БазоваяМодель);
	Если Сообщения.Количество() > 0 Тогда
		Отказ = Истина;
		Для Каждого Текст Из Сообщения Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Текст;
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Перенос значений записи в реквизиты ввода конкретных типов
	// (при редактировании существующей записи).
	Если Тх_ТехникаСервер.ВалидироватьТипАПК(Запись.Работа,
		Тх_ТехникаСервер.ИмяСправочникаРабот()) Тогда
		РаботаВвод = Запись.Работа;
	КонецЕсли;
	УстановитьМодельПоВиду();

КонецПроцедуры

// Возвращает значение модели из реквизита конкретного типа,
// соответствующего виду техники; для видов без каталога моделей -
// значение generic-поля.
//
// Возвращаемое значение:
//	 СправочникСсылка - модель техники.
&НаСервере
Функция МодельТехникиПоВиду()

	Если Запись.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника Тогда
		Возврат МодельСХТехники;
	ИначеЕсли Запись.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		Возврат МодельАвтотранспорта;
	Иначе
		Возврат Запись.МодельТехники;
	КонецЕсли;

КонецФункции

// Переносит значение записи в реквизит модели соответствующего каталога.
&НаСервере
Процедура УстановитьМодельПоВиду()

	Если Запись.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника Тогда
		Если Тх_ТехникаСервер.ВалидироватьТипАПК(Запись.МодельТехники,
			Тх_ТехникаСервер.ИмяСправочникаМоделейСХТехники()) Тогда
			МодельСХТехники = Запись.МодельТехники;
		КонецЕсли;
	ИначеЕсли Запись.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		Если Тх_ТехникаСервер.ВалидироватьТипАПК(Запись.МодельТехники,
			Тх_ТехникаСервер.ИмяСправочникаМоделей(Запись.ВидТехники)) Тогда
			МодельАвтотранспорта = Запись.МодельТехники;
		КонецЕсли;
	Иначе
		// Для видов без каталога моделей ввод - в generic-поле МодельТехники.
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьКоэффициентНаСервере(Знач Работа, Знач Период,
	Знач ВидТехники, Знач МодельТехники, Знач Коэффициент,
	Знач БазоваяМодель)

	Возврат Тх_ТехникаСервер.ПроверитьЗаписьКоэффициента(Работа, Период,
		ВидТехники, МодельТехники, Коэффициент, БазоваяМодель);

КонецФункции

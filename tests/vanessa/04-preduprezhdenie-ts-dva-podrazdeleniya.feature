# language: ru
# Сценарий 4 из 8 (design §11 «Сценарные Vanessa»), SRV-02 §9.4.
# Двухуровневый расчёт дефицита (A2/B2) и строки перемещений (Q-002).
# Прежняя тема файла - НЕБЛОКИРУЮЩЕЕ предупреждение о приёме одного ТС
# в двух подразделениях - умерла вместе с удалённым документом расширения
# (признак «Принят» и его проверка при проведении больше не существуют);
# файл полностью переписан под новую семантику SRV-02:
#  * спрос - подразделение «Отделение №2» (НИВА) по техкартам годового
#    плана, у него НЕТ приписанных машин (A2: НехватаетПослеСвоихСмен > 0);
#  * тестовые ТС (модель из строки спроса, количество - по ёмкости,
#    АпкТипТС = СХТехника) приписаны ДРУГОМУ подразделению через записи
#    регистра сведений АпкИсторияТранспортныхСредств (Исправно = Истина;
#    решение владельца 10.11.2026 - план как источник не читается вовсе)
#    -> межорганизационный пул (B2) покрывает дефицит: НехватаетСмен = 0,
#    в регистр пишется строка перемещения с ИсточникПодразделения =
#    приписка машин и ПеремещеноСмен > 0.
# Дата среза 31.12.1999 (ДатаНачала расчёта): срез раньше всех демо-записей
# регистра (2000-01-01) - пул изолирован тестовыми приписками, окно спроса
# 2014-2015 целиком правее границы. Записи истории создаются в серверной
# подготовке сценария и удаляются в очистке контекста.

Функционал: Покрытие дефицита машинами другой приписки (A2/B2)

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	# Очистка прошлого прогона (идемпотентность) и изоляция доступности:
	# записи истории тестовых ТС (Тх_VA% ТС% - свои и чужие (03) приписки
	# ломят изоляцию среза 31.12.1999), сами тестовые ТС; остатки планов
	# прошлых прогонов (маркер «Тх_VA_04%») источником больше не являются,
	# но удаляются для чистоты базы (Q-006/К4а).
	Дано я выполняю код встроенного языка на сервере
	|ЗапросУд = Новый Запрос("ВЫБРАТЬ С.Ссылка ИЗ Документ.АпкПланТехническихРесурсов КАК С ГДЕ С.Комментарий ПОДОБНО ""Тх_VA_04%""");|
	|ВыбУд = ЗапросУд.Выполнить().Выбрать();|
	|Пока ВыбУд.Следующий() Цикл ВыбУд.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|
	|Запрос2 = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Д.Ссылка ИЗ Документ.АпкПланТехническихРесурсов КАК Д ГДЕ Д.Проведен И Д.СценарийПланирования = &Сцен2");|
	|Запрос2.УстановитьПараметр("Сцен2", Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной"));|
	|Выб2 = Запрос2.Выполнить().Выбрать();|
	|Пока Выб2.Следующий() Цикл Выб2.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|
	|ЗапросТС = Новый Запрос("ВЫБРАТЬ Спр.Ссылка ИЗ Справочник.ТранспортныеСредства КАК Спр ГДЕ Спр.Наименование ПОДОБНО ""Тх_VA% ТС%""");|
	|ВыбТС = ЗапросТС.Выполнить().Выбрать();|
	|Пока ВыбТС.Следующий() Цикл|
	|	НаборИст = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|	НаборИст.Отбор.ТранспортноеСредство.Установить(ВыбТС.Ссылка);|
	|	НаборИст.Записать(Истина);|
	|ВыбТС.Ссылка.ПолучитьОбъект().Удалить();|
	|КонецЦикла;|
	|ЗапросТХТС = Новый Запрос("ВЫБРАТЬ Спр.Ссылка ИЗ Справочник.ТранспортныеСредства КАК Спр ГДЕ Спр.Код ПОДОБНО ""ТХТС%"" И НЕ Спр.ПометкаУдаления");|
	|ВыбТХТС = ЗапросТХТС.Выполнить().Выбрать();|
	|Пока ВыбТХТС.Следующий() Цикл|
	|	НаборТХТС = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|	НаборТХТС.Отбор.ТранспортноеСредство.Установить(ВыбТХТС.Ссылка);|
	|	НаборТХТС.Записать(Истина);|
	|КонецЦикла;|

Сценарий: Своих машин нет - пул другой приписки покрывает и пишет перемещения
	# 1. Подготовка: строка спроса техкарт (НИВА/Отделение №2/«Основной»,
	#    2014-2015) задаёт модель и число машин; тестовые ТС этой модели
	#    (АпкТипТС = СХТехника) приписываются ДРУГОМУ подразделению
	#    (записи истории, Исправно = Истина, период 01.01.1999); расчёт
	#    дефицита - серверный вызов с датой среза 31.12.1999, параметры -
	#    как у формы «Расчет дефицита» в 05.
	Когда я выполняю код встроенного языка на сервере
	|Сценарий = Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной");|
	|Орг = Справочники.Организации.НайтиПоНаименованию("НИВА");|
	|Подр = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отделение №2");|
	|ЗапрПодрБ = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Спр.Ссылка КАК ПодрБ ИЗ Справочник.СтруктураПредприятия КАК Спр ГДЕ НЕ Спр.ПометкаУдаления И Спр.Ссылка <> &Подр УПОРЯДОЧИТЬ ПО Спр.Наименование");|
	|ЗапрПодрБ.УстановитьПараметр("Подр", Подр);|
	|ВыбПодрБ = ЗапрПодрБ.Выполнить().Выбрать();|
	|Если НЕ ВыбПодрБ.Следующий() Тогда ВызватьИсключение "нет второго подразделения для приписки тестовых ТС"; КонецЕсли;|
	|ПодрБ = ВыбПодрБ.ПодрБ;|
	|ТекстСпроса = "ВЫБРАТЬ Т.Техника КАК МодельТехники, Т.ПериодНачала КАК ПериодНачала, Т.ПериодОкончания КАК ПериодОкончания, Т.ВидРаботы КАК ВидРаботы, СУММА(Т.Смен_ВерОборот) КАК ПотребностьСмен, РАЗНОСТЬДАТ(Т.ПериодНачала, Т.ПериодОкончания, ДЕНЬ) КАК РазнДней ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану.Обороты() КАК Т ГДЕ Т.СценарийПланирования = &Сценарий И Т.Организация = &Орг И Т.Подразделение = &Подр И Т.ПериодОкончания >= ДАТАВРЕМЯ(2014, 1, 1) И Т.ПериодНачала <= ДАТАВРЕМЯ(2015, 12, 31, 23, 59, 59) И Т.Техника <> ЗНАЧЕНИЕ(Справочник.АпкМоделиСХТехники.ПустаяСсылка) СГРУППИРОВАТЬ ПО Т.Техника, Т.ПериодНачала, Т.ПериодОкончания, Т.ВидРаботы УПОРЯДОЧИТЬ ПО Т.Техника, Т.ПериодНачала, Т.ПериодОкончания, Т.ВидРаботы";|
	|ЗапрСпрос = Новый Запрос(ТекстСпроса);|
	|ЗапрСпрос.УстановитьПараметр("Сценарий", Сценарий);|
	|ЗапрСпрос.УстановитьПараметр("Орг", Орг);|
	|ЗапрСпрос.УстановитьПараметр("Подр", Подр);|
	|ВыбМодель = ЗапрСпрос.Выполнить().Выбрать();|
	|Модель = Неопределено;|
	|Пока ВыбМодель.Следующий() Цикл|
	|	Если ВыбМодель.ПотребностьСмен > 0 И ВыбМодель.РазнДней >= 0 Тогда|
	|		Модель = ВыбМодель.МодельТехники;|
	|		Прервать;|
	|	КонецЕсли;|
	|КонецЦикла;|
	|Если Модель = Неопределено Тогда ВызватьИсключение "нет подходящей строки спроса (НИВА/Отделение №2/Основной, 2014-2015)"; КонецЕсли;|
	|ВыбЕдиниц = ЗапрСпрос.Выполнить().Выбрать();|
	|ЕдиницНужно = 1;|
	|Пока ВыбЕдиниц.Следующий() Цикл|
	|	Если ВыбЕдиниц.МодельТехники = Модель И ВыбЕдиниц.ПотребностьСмен > 0 И ВыбЕдиниц.РазнДней >= 0 Тогда|
	|		ДнейСтроки = ВыбЕдиниц.РазнДней + 1;|
	|		ЕдиницСтроки = Цел(ВыбЕдиниц.ПотребностьСмен / ДнейСтроки);|
	|		Если ЕдиницСтроки * ДнейСтроки < ВыбЕдиниц.ПотребностьСмен Тогда|
	|			ЕдиницСтроки = ЕдиницСтроки + 1;|
	|		КонецЕсли;|
	|		Если ЕдиницСтроки > ЕдиницНужно Тогда|
	|			ЕдиницНужно = ЕдиницСтроки;|
	|		КонецЕсли;|
	|	КонецЕсли;|
	|КонецЦикла;|
	|Для Инд = 1 По ЕдиницНужно Цикл|
	|	ТСИ = Справочники.ТранспортныеСредства.СоздатьЭлемент();|
	|	ТСИ.Код = "ТХВА04" + Строка(Инд);|
	|	ТСИ.Наименование = "Тх_VA_04 ТС " + Строка(Инд);|
	|	ТСИ.АпкМодель = Модель;|
	|	ТСИ.АпкТипТС = Перечисления.АпкТипыТС.СХТехника;|
	|	ТСИ.Записать();|
	|	НаборИст = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|	НаборИст.Отбор.ТранспортноеСредство.Установить(ТСИ.Ссылка);|
	|	ЗаписьИст = НаборИст.Добавить();|
	|	ЗаписьИст.Период = Дата(1999, 1, 1);|
	|	ЗаписьИст.ТранспортноеСредство = ТСИ.Ссылка;|
	|	ЗаписьИст.Организация = Орг;|
	|	ЗаписьИст.ЭксплуатирующееПодразделение = ПодрБ;|
	|	ЗаписьИст.Исправно = Истина;|
	|	НаборИст.Записать(Истина);|
	|КонецЦикла;|
	|ПараметрыРасчета = Новый Структура("СценарийПланирования, Организация, Подразделение, ДатаНачала, ДатаОкончания, СменВДень", Сценарий, Орг, Подр, Дата(1999, 12, 31), Дата(2015, 12, 31, 23, 59, 59), 1);|
	|Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);|
	# 2. Инвариант A2: у (НИВА, Отделение №2) нет приписанных машин -
	#    НехватаетПослеСвоихСмен = ПотребностьСмен > 0, пометка
	#    «ПланТехресурсовОтсутствует»; инвариант B2: пул приписки тестовых
	#    ТС покрывает дефицит - НехватаетСмен = 0, ДоступноСмен = потребности,
	#    строка перемещения с источником = приписка машин (срез 31.12.1999).
	И я выполняю код встроенного языка на сервере
	|Орг = Справочники.Организации.НайтиПоНаименованию("НИВА");|
	|Подр = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отделение №2");|
	|Сценарий = Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной");|
	|ТС1 = Справочники.ТранспортныеСредства.НайтиПоНаименованию("Тх_VA_04 ТС 1");|
	|Если НЕ ЗначениеЗаполнено(ТС1) Тогда ВызватьИсключение "тестовое ТС не найдено"; КонецЕсли;|
	|ЗапрИст = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ист.Организация КАК ОргИст, Ист.ЭксплуатирующееПодразделение КАК ПодрИст ИЗ РегистрСведений.АпкИсторияТранспортныхСредств.СрезПоследних(ДАТАВРЕМЯ(1999, 12, 31)) КАК Ист ГДЕ Ист.ТранспортноеСредство = &ТС И Ист.Исправно");|
	|ЗапрИст.УстановитьПараметр("ТС", ТС1);|
	|ВыбИст = ЗапрИст.Выполнить().Выбрать();|
	|Если НЕ ВыбИст.Следующий() Тогда ВызватьИсключение "нет записи приписки тестового ТС на дату среза"; КонецЕсли;|
	|ЗапрДеф = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н, СУММА(ВЫБОР КОГДА Р.НехватаетПослеСвоихСмен = Р.ПотребностьСмен И Р.НехватаетСмен = 0 И Р.ДоступноСмен = Р.ПотребностьСмен И Р.ПланТехресурсовОтсутствует ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК Ошибки ИЗ РегистрСведений.Тх_ДефицитТехники КАК Р ГДЕ Р.Организация = &Орг И Р.Подразделение = &Подр И Р.СценарийПланирования = &Сценарий И Р.МодельТехники = &Модель И Р.ИсточникОрганизации = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) И Р.ИсточникПодразделения = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) И Р.ДнейПериода > 0 И Р.ПотребностьСмен > 0");|
	|ЗапрДеф.УстановитьПараметр("Орг", Орг);|
	|ЗапрДеф.УстановитьПараметр("Подр", Подр);|
	|ЗапрДеф.УстановитьПараметр("Сценарий", Сценарий);|
	|ЗапрДеф.УстановитьПараметр("Модель", ТС1.АпкМодель);|
	|ТЗДеф = ЗапрДеф.Выполнить().Выгрузить();|
	|Если ТЗДеф.Количество() = 0 ИЛИ ТЗДеф[0].Н = 0 Тогда ВызватьИсключение "нет строк дефицита по модели тестовых ТС (A2: у подразделения спроса нет своих машин)"; КонецЕсли;|
	|Если ТЗДеф[0].Ошибки > 0 Тогда ВызватьИсключение "инвариант A2/B2 нарушен: НехватаетПослеСвоихСмен = ПотребностьСмен > 0, НехватаетСмен = 0, пометка «нет своего плана»"; КонецЕсли;|
	|ЗапрПерем = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н, СУММА(ВЫБОР КОГДА Р.ПеремещеноСмен = Р.ПотребностьСмен И Р.ИсточникОрганизации = &ОргИст И Р.ИсточникПодразделения = &ПодрИст ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК Ошибки ИЗ РегистрСведений.Тх_ДефицитТехники КАК Р ГДЕ Р.Организация = &Орг И Р.Подразделение = &Подр И Р.СценарийПланирования = &Сценарий И Р.МодельТехники = &Модель И Р.ПеремещеноСмен > 0");|
	|ЗапрПерем.УстановитьПараметр("Орг", Орг);|
	|ЗапрПерем.УстановитьПараметр("Подр", Подр);|
	|ЗапрПерем.УстановитьПараметр("Сценарий", Сценарий);|
	|ЗапрПерем.УстановитьПараметр("Модель", ТС1.АпкМодель);|
	|ЗапрПерем.УстановитьПараметр("ОргИст", ВыбИст.ОргИст);|
	|ЗапрПерем.УстановитьПараметр("ПодрИст", ВыбИст.ПодрИст);|
	|ТЗПерем = ЗапрПерем.Выполнить().Выгрузить();|
	|Если ТЗПерем.Количество() = 0 ИЛИ ТЗПерем[0].Н = 0 Тогда ВызватьИсключение "нет строк перемещений (B2: чужая приписка не покрыла дефицит)"; КонецЕсли;|
	|Если ТЗПерем[0].Н <> ТЗДеф[0].Н Тогда ВызватьИсключение "число строк перемещений не равно числу строк дефицита модели"; КонецЕсли;|
	|Если ТЗПерем[0].Ошибки > 0 Тогда ВызватьИсключение "строки перемещений: источник или объём не совпадают с припиской тестовых ТС и нехваткой после своих смен"; КонецЕсли;|
	|Сообщить("ТХ_04 дефицитных строк: " + Строка(ТЗДеф[0].Н) + ", перемещений: " + Строка(ТЗПерем[0].Н));|

	# 3. Teardown (Q-006/К4а): приписки тестовых ТС убираются набором пустых
	#    записей, сами ТС удаляются - срез 31.12.1999 и справочник чисты
	#    для следующих сценариев (зеркало teardown фичи 03).
	И я выполняю код встроенного языка на сервере
	|ЗапросТС = Новый Запрос("ВЫБРАТЬ Спр.Ссылка ИЗ Справочник.ТранспортныеСредства КАК Спр ГДЕ Спр.Наименование ПОДОБНО ""Тх_VA_04 ТС%""");|
	|ВыбТС = ЗапросТС.Выполнить().Выбрать();|
	|Пока ВыбТС.Следующий() Цикл|
	|	НаборИст = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|	НаборИст.Отбор.ТранспортноеСредство.Установить(ВыбТС.Ссылка);|
	|	НаборИст.Записать(Истина);|
	|	ВыбТС.Ссылка.ПолучитьОбъект().Удалить();|
	|КонецЦикла;|

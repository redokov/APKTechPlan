// Общий модуль «Тх_Тесты» - серверные модульные тесты расширения
// «ПланированиеТехникиАПК» (design §11, задача A11).
//
// Упрощённый xUnit-паттерн: 20 экспортных функций Тест*(), вызываемых
// обработкой-раннером Тх_РаннерТестов (кнопка формы, COM или /Execute).
// Каждый тест:
//  - создаёт собственные данные (уникальные имена через Новый
//    УникальныйИдентификатор - конфликты повторных прогонов исключены);
//  - выполняет проверки через Проверить (провал - Сообщить с префиксом
//    имени теста и фиксация в контексте теста);
//  - очищает данные за собой в finally-стиле: очистка выполняется и при
//    успешном завершении, и при исключении;
//  - возвращает структуру результата (Имя, Статус, Провалы): Статус
//    "PASS"/"FAIL"/"SKIP" (SKIP - нет данных ИБ), Провалы - имена
//    проваленных проверок; терминальная политика SKIP для прогона
//    здесь не решается.
//
// Синтетика потребности (тесты пересчёта дефицита). Записи в регистры
// накопления годового плана АПК (Апк*РаботыПоГодовомуПлану) расширением
// невозможны, поэтому:
//  - тесты формул пересчёта доступности через замещение моделей
//    (ТестДоступноСменЧерезЗамещение, ТестДоступноСменЗамещениеНеЗадан,
//    ТестДефицитМаксНуля) проверяют контракт TD-004 на уровне
//    сценария замещения: реальные КоэффициентЗамещения/ЧислоДнейПериода
//    + таблицы значений,
//    моделирующие строки потребности и доступности (доступность - по
//    физическим машинам, одна строка ТЗ = одна машина); формула
//    сопоставления уровня 1 продублирована зеркалом ДоступноСменКонтракт
//    (S7: эталон экспортной Тх_ТехникаСервер.ДоступностьСтрокиДвумяУровнями,
//    сверяется с продакшеном в тесте ТестДефицитМаксНуля);
//  - сквозные тесты (ТестДублиТСНеУвеличиваютДоступность,
//    ТестПланТехресурсовОтсутствует_..., ТестДетерминированность...)
//    идут по реальным экспортным функциям Тх_ТехникаСервер
//    (ЗапросДоступности / РассчитатьДефицит); тесты, которым нужна
//    потребность годового плана, помечены «зависит от данных ИБ» и при
//    пустой потребности возвращают Истина с сообщением SKIP.
//
// Модуль серверный, НЕ привилегированный: тесты выполняются под правами
// запустившего и работают только с собственными данными расширения.

#Область Инфраструктура

// Создаёт контекст теста: имя + массив провалов.
//
// Параметры:
//   ИмяТеста - Строка - имя тестовой функции (префикс сообщений).
//
// Возвращаемое значение:
//   Структура - свойства: Имя (Строка), Провалы (Массив).
//
Функция НовыйКонтекстТеста(ИмяТеста)

	// Q-006/TEST-02: маркер тестовой ИБ - единая точка всех тестовых
	// входов (каждый из 29 тестов начинает с этой функции; пишущие
	// хелперы дополнительно защищены собственной проверкой).
	ПроверитьТестовуюБазу();

	Возврат Новый Структура("Имя, Статус, Провалы", ИмяТеста, "PASS", Новый Массив);

КонецФункции

// Фиксирует проверку теста: провал заносится в контекст, выводится
// сообщение с префиксом имени теста.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста (НовыйКонтекстТеста);
//   ИмяПроверки    - Строка - краткое имя проверки;
//   Условие        - Булево - условие успешности проверки;
//   Детали         - Строка - детали провала (фактические значения).
//
Процедура Проверить(СтруктураТеста, ИмяПроверки, Условие, Детали = "")

	Если НЕ Условие Тогда
		ЭлементПровала = ИмяПроверки;
		Если Детали <> "" Тогда
			ЭлементПровала = ЭлементПровала + " (" + Детали + ")";
		КонецЕсли;
		СтруктураТеста.Провалы.Добавить(ЭлементПровала);
		Текст = СтрШаблон(НСтр("ru = '[%1] ПРОВАЛ: %2'"),
			СтруктураТеста.Имя, ЭлементПровала);
		СообщитьТекстом(Текст);
	КонецЕсли;

КонецПроцедуры

// Возвращает итоговый контекст теста. Если есть проваленные проверки,
// статус FAIL (провал не маскируется ранее выставленным SKIP);
// иначе сохранённый статус: PASS или SKIP.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста.
//
// Возвращаемое значение:
//   Структура - Имя (Строка), Статус ("PASS"/"FAIL"/"SKIP"), Провалы (Массив).
//
Функция РезультатТеста(СтруктураТеста)

	Если СтруктураТеста.Провалы.Количество() > 0 Тогда
		СтруктураТеста.Статус = "FAIL";
	КонецЕсли;

	Возврат СтруктураТеста;

КонецФункции

// Выводит сообщение SKIP: тест пропущен (нет данных ИБ), считается пройденным.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста;
//   Причина        - Строка - причина пропуска.
//
Процедура СообщитьПропуск(СтруктураТеста, Причина)

	СтруктураТеста.Статус = "SKIP";
	СообщитьТекстом(СтрШаблон(НСтр("ru = '[%1] SKIP: %2'"),
		СтруктураТеста.Имя, Причина));

КонецПроцедуры

// Выводит немодальное сообщение пользователю.
//
// Параметры:
//   Текст - Строка - текст сообщения.
//
Процедура СообщитьТекстом(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

// Возвращает псевдослучайное уникальное имя (генератор, устойчивый
// к повторным прогонам тестов).
//
// Возвращаемое значение:
//   Строка - строковое представление нового уникального идентификатора.
//
Функция УникальноеИмя()

	Возврат Строка(Новый УникальныйИдентификатор());

КонецФункции

// Ищет первый существующий элемент справочника АПК (тесты сначала ищут
// готовые ссылки, новые создают только при необходимости).
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника (например, "АпкМоделиСХТехники").
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка первого элемента;
//   Неопределено - элементов нет или каталог недоступен.
//
Функция НайтиПервыйЭлемент(ИмяСправочника)

	Результат = Неопределено;


	// Имя метаданного подставляется динамически - анализатор не может
	// разобрать текст запроса (в рантайме запрос корректен).
	// BSLLS:QueryParseError-off
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ НЕ Спр.ПометкаУдаления";
	// BSLLS:QueryParseError-on

	Попытка
		Выборка = Тх_ТехникаСервер.ВыполнитьЗапросАПК(ТекстЗапроса).Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Создаёт новый элемент справочника с уникальным наименованием
// (созданное тесты удаляют за собой).
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника;
//   Поля - Структура, Неопределено - значения реквизитов
//          (например, МощностьДвигателя).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка созданного элемента;
//   Неопределено - создать не удалось (обязательные реквизиты, отсутствие каталога).
//
Функция СоздатьЭлемент(ИмяСправочника, Поля = Неопределено)

	ПроверитьТестовуюБазу();

	Результат = Неопределено;

	Попытка
		Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
		Объект.Наименование = УникальноеИмя();
		Если Поля <> Неопределено Тогда
			Для Каждого КлючЗначение Из Поля Цикл
				Объект[КлючЗначение.Ключ] = КлючЗначение.Значение;
			КонецЦикла;
		КонецЕсли;
		Объект.Записать();
		Результат = Объект.Ссылка;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	// Q-006/TEST-02: созданное - в реестр тестовых объектов; снимает
	// УдалитьСсылку при удалении. Неудачная регистрация - громкое
	// исключение (тест упадёт видимым образом).
	Если Результат <> Неопределено Тогда
		ЗарегистрироватьТестовыйОбъект(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Создаёт новую модель техники каталога вида техники (уникальное имя,
// опционально - мощность двигателя).
//
// Параметры:
//   ВидТехники - ПеречислениеСсылка.Тх_ВидыТехники - вид техники;
//   Мощность   - Число, Неопределено - мощность двигателя (Неопределено/0 -
//                модель «без мощности»).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка созданной модели.
//
Функция СоздатьМодель(ВидТехники, Мощность = Неопределено)

	ИмяСправочника = Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники);
	Если ИмяСправочника = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = Неопределено;
	Если Мощность <> Неопределено Тогда
		Поля = Новый Структура("МощностьДвигателя", Мощность);
	КонецЕсли;

	Возврат СоздатьЭлемент(ИмяСправочника, Поля);

КонецФункции

// Удаляет созданный тестом элемент справочника (существующие данные
// тесты не трогают, поэтому удаляются только созданные ссылки).
//
// Параметры:
//   Ссылка - СправочникСсылка, ДокументСсылка, Неопределено -
//            ссылка на удаление (владельцем данных не является).
//
Процедура УдалитьСсылку(Ссылка)

	ПроверитьТестовуюБазу();

	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Q-006/TEST-02: успех -> строка реестра снимается; неудача ->
	// строка остаётся и превращается в видимый FAIL прогона
	// (финальная проверка ЧистотаТестовыхДанных). ЖР Информация в
	// УдалитьОбъектТихо - только диагностика, НЕ доказательство
	// очистки (пункт 6 чек-листа).
	Если УдалитьОбъектТихо(Ссылка) Тогда
		СнятьОбъектСРеестра(Ссылка);
	КонецЕсли;

КонецПроцедуры

// Пытается удалить объект (элемент, документ); исключение гасится,
// результат - успех операции. ЖР Информация при неудаче - только
// диагностика (Q-006/TEST-02, п.6: доказательство чистоты - пустой
// реестр и пустой sweep, не запись журнала).
//
// Параметры:
//   Ссылка - ЛюбаяСсылка - объект на удаление.
//
// Возвращаемое значение:
//   Булево - Истина, если объект удалён или уже отсутствовал.
//
Функция УдалитьОбъектТихо(Ссылка)

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.Удалить();
		КонецЕсли;
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Прерывает выполнение явным исключением, если константа-маркер
// тестовой ИБ не установлена (Q-006, TEST-02): в немаркированной базе
// тестовые записи запрещены. Вызывается из НовогоКонтекстаТеста (все
// тестовые входы) и каждого пишущего хелпера.
//
Процедура ПроверитьТестовуюБазу() Экспорт

	Если НЕ Константы.Тх_ТестоваяБаза.Получить() Тогда
		ВызватьИсключение НСтр("ru = 'Тх_Тесты: константа Тх_ТестоваяБаза не установлена - база не маркирована как тестовая (Q-006/TEST-02), тестовые записи запрещены.'");
	КонецЕсли;

КонецПроцедуры

// Регистрирует созданный тестом объект в реестре тестовых объектов
// (Q-006, TEST-02): строка снимается УдалитьСсылкой; остаток после
// прогона = видимый FAIL (ЧистотаТестовыхДанных).
//
// Параметры:
//   Ссылка - ЛюбаяСсылка - созданный объект (элемент, документ).
//
Процедура ЗарегистрироватьТестовыйОбъект(Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.Тх_РеестрТестовыхОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Ссылка);
	НаборЗаписей.Добавить().Объект = Ссылка;
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Снимает строку реестра тестовых объектов после удаления объекта
// (Q-006, TEST-02). Снятие не зарегистрированной ссылки безопасно
// (пустая запись поверх пустого отбора).
//
// Параметры:
//   Ссылка - ЛюбаяСсылка - удалённый (или уже отсутствующий) объект.
//
Процедура СнятьОбъектСРеестра(Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.Тх_РеестрТестовыхОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Ссылка);
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Возвращает ссылки, оставшиеся в реестре тестовых объектов.
//
// Возвращаемое значение:
//   Массив - ссылки объектов с незавершённой очисткой.
//
Функция ОстаткиРеестра()

	Ссылки = Новый Массив;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Реестр.Объект КАК Объект
		|ИЗ РегистрСведений.Тх_РеестрТестовыхОбъектов КАК Реестр");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(Выборка.Объект);
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// Стартовая очистка раннера (Q-006, TEST-02): хвосты упавших прогонов -
// удалить объекты по строкам реестра, затем sweep фикстур по маскам
// имён. Неудаляемое остаётся и попадает в финальную проверку
// (ОстаткиПослеПрогона) - очистка не обязана быть тихой удачей.
//
Процедура УдалитьОстаткиПрошлыхПрогонов() Экспорт

	ПроверитьТестовуюБазу();

	Для Каждого Ссылка Из ОстаткиРеестра() Цикл
		УдалитьСсылку(Ссылка);
	КонецЦикла;

	УбратьОстаткиПоМаскам();

КонецПроцедуры

// Sweep фикстур по маскам имён (Q-006, TEST-02): Тх_Тест% и Тх_VA_%
// (маски чек-листа; предусмотренный набор va_prep_data с префиксом
// ТХТС_ в маски сознательно не входит). GUID-имён не трогает (их
// покрывает реестр) - дополняет реестр для сценариев VA и ручных
// прогонов. Сканирует каталоги фактического инвентаря фикстур.
//
// Возвращаемое значение:
//   Массив - описания найденных, но НЕ удалённых элементов (остаток).
//
Функция УбратьОстаткиПоМаскам() Экспорт

	ПроверитьТестовуюБазу();

	Остаток = Новый Массив;

	// Стабильный набор данных для сценариев (features 01-09 и тест
	// ТестДоступныеМодели_ПланРаспределения зависят от него; создаётся
	// обработкой подготовки тестовых данных идемпотентно, поиск по имени/коду): под маски
	// Тх_Тест% попадает по имени, но НЕ является остатком - исключён
	// из sweep явным списком (коллизия масок чек-листа со стабильным
	// набором, найдена живым прогоном 2026-11-14).
	Стабильные = Новый Массив;
	Стабильные.Добавить("Тх_Тест Базовая");
	Стабильные.Добавить("Тх_Тест Аналог");
	Стабильные.Добавить("Тх_Тест БезМощности");
	Стабильные.Добавить("Тх_Тест Работа");
	Стабильные.Добавить("Тх_Тест ТС 001");
	Стабильные.Добавить("Тх_Тест ТС 002");
	Стабильные.Добавить("Тх_Тест ТС 003");
	Стабильные.Добавить("Тх_Тест ТС 004");

	// Один статический запрос на все каталоги фактического инвентаря
	// фикстур: объединение выборок, по секции на каталог х маску (без

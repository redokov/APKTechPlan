Процедура ПериодПриИзменении(Элемент)

	// Отбор по измерению «Период» («действует с») - реквизит шапки, как в референсе s02.
	Список.Отбор.Период.Использование = ЗначениеЗаполнено(Период);
	Если ЗначениеЗаполнено(Период) Тогда
		Список.Отбор.Период.ВидСравнения = ВидСравнения.Равно;
		Список.Отбор.Период.Значение = Период;
	КонецЕсли;

КонецПроцедуры

// Общий модуль «Тх_ТехникаСервер» - единое место серверной логики расширения
// «ПланированиеТехникиАПК» (design §4.7):
//  - константы строковых имён объектов АПК (design §4.1, п. 3, TD-001);
//  - обёртка рантайм-запросов к расширению №1 с диагностикой «модуль АПК
//    отключён» (design §5);
//  - функции дат (FAQ Q1);
//  - коэффициенты замещения моделей из реквизитов (design 6.4, TD-003);
//  - запросы потребности (регистры годового плана АПК) и доступности
//    (документ Тх_ПланТехническихРесурсов) - подготовка к расчёту дефицита (A7);
//  - расчёт дефицита техники и материализация результата в регистр
//    Тх_ДефицитТехники (design §4.7, шаги 3-5, TD-003);
//  - автозаполнение коэффициентов пересчёта по мощности (design §4.6, TD-005).
//
// Модуль серверный и привилегированный: доступ к данным расширения №1
// выполняется рантайм-запросами по строковым именам таблиц (design §4.1).

#Область ИменаОбъектовАПК

// Возвращает строковое имя справочника видов работ (core ERP, digest §4).
//
// Возвращаемое значение:
//   Строка - имя справочника "ВидыРаботСотрудников".
//
Функция ИмяСправочникаРабот() Экспорт

	Возврат "ВидыРаботСотрудников";

КонецФункции

// Возвращает строковое имя справочника сценариев планирования
// (расширение №1, design §4.1).
//
// Возвращаемое значение:
//   Строка - имя справочника "АпкСценарииПланирования".
//
Функция ИмяСправочникаСценариевПланирования() Экспорт

	Возврат "АпкСценарииПланирования";

КонецФункции

// Возвращает строковое имя справочника моделей техники по виду техники
// (design §4.1: АпкМоделиСХТехники / АпкМоделиАвтотранспорта).
// Для вида «Оборудование» целевой каталог моделей не определён.
//
// Параметры:
//   ВидТехники - ПеречислениеСсылка.Тх_ВидыТехники - вид техники.
//
// Возвращаемое значение:
//   Строка - имя справочника моделей; пустая строка - каталог не определён.
//
Функция ИмяСправочникаМоделей(ВидТехники) Экспорт

	Если ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника Тогда
		Возврат "АпкМоделиСХТехники";
	ИначеЕсли ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		Возврат "АпкМоделиАвтотранспорта";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции


// Возвращает строковое имя справочника моделей с/х оборудования
// (расширение №1, digest §1, §3).
//
// Возвращаемое значение:
//   Строка - имя справочника "АпкМоделиСХОборудования".
//
Функция ИмяСправочникаМоделейСХОборудования() Экспорт

	Возврат "АпкМоделиСХОборудования";

КонецФункции

// Возвращает строковое имя справочника моделей прицепов
// (расширение №1, digest §1, §3).
//
// Возвращаемое значение:
//   Строка - имя справочника "АпкМоделиПрицепов".
//
Функция ИмяСправочникаМоделейПрицепов() Экспорт

	Возврат "АпкМоделиПрицепов";

КонецФункции

// Возвращает строковое имя справочника транспортных средств
// (core ERP, digest §4; прямой тип CatalogRef.ТранспортныеСредства допустим
// по TD-001, но запрос к реквизитам Апк* выполняется рантаймом).
//
// Возвращаемое значение:
//   Строка - имя справочника "ТранспортныеСредства".
//
Функция ИмяСправочникаТранспортныхСредств() Экспорт

	Возврат "ТранспортныеСредства";

КонецФункции

#КонецОбласти

#Область РантаймДоступКДаннымАПК

// Выполняет запрос к таблицам расширения №1 (рантайм-компиляция текста,
// design §4.1, п. 1). При недоступности модуля АПК прерывает расчёт
// понятным сообщением (design §5, §8).
//
// Параметры:
//   Текст      - Строка - текст запроса (имена таблиц - явные строковые);
//   Параметры  - Структура, Неопределено - параметры запроса.
//
// Возвращаемое значение:
//   РезультатЗапроса - результат выполнения запроса.
//
// Пример:
//   ВызватьИсключение с текстом «Модуль АПК отключён, расчёт невозможен».
//
Функция ВыполнитьЗапросАПК(Текст, Параметры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = Текст;

	Если Параметры <> Неопределено Тогда
		Для Каждого КлючЗначение Из Параметры Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Модуль АПК отключён, расчёт невозможен: %1'"),
			ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверяет, что значение - ссылка справочника с указанным именем
// (рантайм-валидация generic-ссылок, design §4.1, п. 2).
//
// Параметры:
//   Значение    - ЛюбаяСсылка - проверяемое значение;
//   ИмяОбъекта  - Строка - имя справочника (например, "ВидыРаботСотрудников").
//
// Возвращаемое значение:
//   Булево - Истина, если тип значения совпадает с типом справочника.
//
Функция ВалидироватьТипАПК(Значение, ИмяОбъекта) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Значение) = Тип("СправочникСсылка." + ИмяОбъекта);

КонецФункции

// Проверяет совместимость сцепки «модель техники + оборудование» (FR-002,
// design 5.3): АпкМоделиСХТехники - только АпкМоделиСХОборудования;
// АпкМоделиАвтотранспорта - только АпкМоделиПрицепов. Незаполненная модель
// или оборудование сцепкой не считается (Истина). Типы разбираются по
// полному имени метаданных ссылки (ИмяСправочникаПоТипуСсылки), без Тип() -
// устойчиво к отключённому расширению №1.
//
// Параметры:
//   Модель       - СправочникСсылка - модель техники;
//   Оборудование - СправочникСсылка - модель оборудования/прицепа.
//
// Возвращаемое значение:
//   Булево - Истина, если пара совместима (или одно из значений не заполнено).
//
Функция ВалидироватьСцепку(Модель, Оборудование) Экспорт

	Если НЕ ЗначениеЗаполнено(Модель) ИЛИ НЕ ЗначениеЗаполнено(Оборудование) Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяМодели = ИмяСправочникаПоТипуСсылки(Модель);
	Если ИмяМодели = "АпкМоделиСХТехники" Тогда
		Возврат ИмяСправочникаПоТипуСсылки(Оборудование) = "АпкМоделиСХОборудования";
	ИначеЕсли ИмяМодели = "АпкМоделиАвтотранспорта" Тогда
		Возврат ИмяСправочникаПоТипуСсылки(Оборудование) = "АпкМоделиПрицепов";
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Возвращает мощность двигателя модели техники (рантайм-запрос, design §4.1:
// реквизит недоступен типами расширения №2, только запросом).
//
// Параметры:
//   Модель - СправочникСсылка - ссылка на элемент каталога моделей АПК.
//
// Возвращаемое значение:
//   Число - мощность двигателя модели; 0 - не заполнена или не найдена.
//
Функция МощностьДвигателяМодели(Модель) Экспорт

	Результат = 0;

	Если НЕ ЗначениеЗаполнено(Модель) Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяСправочника = ИмяСправочникаПоТипуСсылки(Модель);
	Если ИмяСправочника = "" Тогда
		Возврат Результат;
	КонецЕсли;

	// TODO-VERIFY: реквизит «МощностьДвигателя» подтверждён по исходникам АПК 2.5
	// только для справочника «АпкМоделиСХТехники» (digest §4); для остальных
	// каталогов моделей имя реквизита не проверено (проверка при B3/B5).
	ТекстЗапроса = "ВЫБРАТЬ
	|	Спр.МощностьДвигателя КАК МощностьДвигателя
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ Спр.Ссылка = &Модель";

	РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса, Новый Структура("Модель", Модель));
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.МощностьДвигателя;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает значение числового реквизита модели рантайм-запросом
// (реквизиты каталогов АПК недоступны расширению статически, design 4.1;
// обобщение МощностьДвигателяМодели).
//
// Параметры:
//   Модель       - СправочникСсылка - ссылка на элемент каталога моделей;
//   ИмяРеквизита - Строка - имя числового реквизита.
//
// Возвращаемое значение:
//   Число - значение реквизита; 0 - не заполнен, реквизит/каталог не найден.
//
Функция ЗначениеРеквизитаМодели(Модель, ИмяРеквизита)

	Результат = 0;

	Если НЕ ЗначениеЗаполнено(Модель) Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяСправочника = ИмяСправочникаПоТипуСсылки(Модель);
	Если ИмяСправочника = "" Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТекстЗапроса = "ВЫБРАТЬ Спр." + ИмяРеквизита + " КАК Значение
			|ИЗ Справочник." + ИмяСправочника + " КАК Спр
			|ГДЕ Спр.Ссылка = &Модель";
		РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса, Новый Структура("Модель", Модель));
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Значение;
		КонецЕсли;
	Исключение
		// Реквизит отсутствует в каталоге - считаем незаполненным.
		Результат = 0;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает приоритеты реквизитов замещения по каталогу модели (FR-004,
// design 6.4; состав реквизитов сверен с исходниками АПК 2.5.27.88).
//
// Параметры:
//   Модель - СправочникСсылка - модель.
//
// Возвращаемое значение:
//   Структура - свойства: Приоритетные (Массив из Строка), Стартовый (Строка);
//   Неопределено - модель не из каталогов моделей АПК.
//
Функция ПриоритетРеквизитовЗамещения(Модель)

	ИмяСправочника = ИмяСправочникаПоТипуСсылки(Модель);

	Если ИмяСправочника = "АпкМоделиСХТехники" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("КоэффициентПереводаВУЭГА");
		Приоритетные.Добавить("ШиринаОбработки");
		Приоритетные.Добавить("ОбъемБункера");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "МощностьДвигателя");
	ИначеЕсли ИмяСправочника = "АпкМоделиСХОборудования" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("ШиринаОбработки");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "");
	ИначеЕсли ИмяСправочника = "АпкМоделиАвтотранспорта" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("Грузоподъемность");
		Приоритетные.Добавить("Вместимость");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "МощностьДвигателя");
	ИначеЕсли ИмяСправочника = "АпкМоделиПрицепов" Тогда
		Приоритетные = Новый Массив;
		Приоритетные.Добавить("Грузоподъемность");
		Приоритетные.Добавить("Вместимость");
		Возврат Новый Структура("Приоритетные, Стартовый", Приоритетные, "");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Возвращает базовый реквизит замещения модели: первый заполненный из
// приоритетных; если все пусты - стартовый МощностьДвигателя (там, где есть).
//
// Параметры:
//   Модель - СправочникСсылка - модель техники/оборудования/прицепа.
//
// Возвращаемое значение:
//   Структура - свойства: Реквизит (Строка), Значение (Число);
//   Неопределено - ни один реквизит не заполнен (КоэффициентНеЗадан).
//
Функция РеквизитЗамещения(Модель) Экспорт

	Приоритеты = ПриоритетРеквизитовЗамещения(Модель);
	Если Приоритеты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ИмяРеквизита Из Приоритеты.Приоритетные Цикл
		Значение = ЗначениеРеквизитаМодели(Модель, ИмяРеквизита);
		Если Значение > 0 Тогда
			Возврат Новый Структура("Реквизит, Значение", ИмяРеквизита, Значение);
		КонецЕсли;
	КонецЦикла;

	Если Приоритеты.Стартовый <> "" Тогда
		Значение = ЗначениеРеквизитаМодели(Модель, Приоритеты.Стартовый);
		Если Значение > 0 Тогда
			Возврат Новый Структура("Реквизит, Значение", Приоритеты.Стартовый, Значение);
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Коэффициент замещения моделей (FR-004, TD-003, design 6.4):
// К = Реквизит(МодельЗамены) / Реквизит(МодельОригинала) по одному и тому
// же базовому реквизиту. Смены замены = смены оригинала / К (ширина замены
// в 1.5 раза больше - смен в 1.5 раза меньше).
//
// Параметры:
//   МодельОригинал - СправочникСсылка - модель оригинала;
//   МодельЗамены   - СправочникСсылка - модель замены.
//
// Возвращаемое значение:
//   Число - коэффициент замещения К > 0 (может быть < 1 - замена медленнее);
//   Неопределено - коэффициент не задан: модели из разных каталогов,
//                  нет заполненных реквизитов или базовые реквизиты
//                  оригинала и замены различаются (КоэффициентНеЗадан).
//
Функция КоэффициентЗамещения(МодельОригинал, МодельЗамены) Экспорт

	Если НЕ ЗначениеЗаполнено(МодельОригинал) ИЛИ НЕ ЗначениеЗаполнено(МодельЗамены) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ИмяСправочникаПоТипуСсылки(МодельОригинал) <> ИмяСправочникаПоТипуСсылки(МодельЗамены) Тогда
		Возврат Неопределено;
	КонецЕсли;

	РеквизитОригинала = РеквизитЗамещения(МодельОригинал);
	РеквизитЗамены = РеквизитЗамещения(МодельЗамены);

	Если РеквизитОригинала = Неопределено ИЛИ РеквизитЗамены = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если РеквизитОригинала.Реквизит <> РеквизитЗамены.Реквизит Тогда
		// Базовые реквизиты различаются (у одной ручной, у другой стартовый) -
		// честный КоэффициентНеЗадан.
		Возврат Неопределено;
	КонецЕсли;

	Возврат РеквизитЗамены.Значение / РеквизитОригинала.Значение;

КонецФункции

// Возвращает имя справочника по ссылке на его элемент.
//
// 8.5: Строка(ТипЗнч()) возвращает синоним типа (например, «Модель с/х
// техники»), а не имя вида «СправочникСсылка.<Имя>» - разбор строки
// ненадёжен (доказано COM-пробой B5). ПолноеИмя() метаданных объекта
// ссылки от языка сессии не зависит: «Справочник.<Имя>».
//
// Параметры:
//   Значение - СправочникСсылка - значение ссылки.
//
// Возвращаемое значение:
//   Строка - имя справочника; пустая строка - значение не ссылка справочника.
//
Функция ИмяСправочникаПоТипуСсылки(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		МетаОбъект = Значение.Метаданные();
		Попытка
			// 8.5: ПолноеИмя() - метод (доказано COM-пробой B5); 8.3 - свойство.
			ПолноеИмяОбъекта = МетаОбъект.ПолноеИмя();
		Исключение
			ПолноеИмяОбъекта = МетаОбъект.ПолноеИмя;
		КонецПопытки;
	Исключение
		// Значение - не ссылка на объект метаданных (примитив и т.п.):
		// не справочник - пустое имя, вызывающий код обработает.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_ТехникаСервер: имя справочника - значение не ссылка'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

	Префикс = "Справочник.";
	Если СтрНачинаетсяС(ПолноеИмяОбъекта, Префикс) Тогда
		Возврат Сред(ПолноеИмяОбъекта, СтрДлина(Префикс) + 1);
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает модель и хозяйственный номер транспортного средства
// (рантайм-запрос к реквизитам АпкМодель / АпкХозНомер справочника
// транспортных средств, design §4.4; без модуля АПК запрос падает -
// исключение «Модуль АПК отключён» пробрасывается вызывающему коду).
//
// Параметры:
//   ТранспортноеСредство - СправочникСсылка.ТранспортныеСредства - выбранное ТС.
//
// Возвращаемое значение:
//   Структура - поля:
//     * МодельТехники - СправочникСсылка, Неопределено - модель ТС (АпкМодель);
//     * ХозНомер      - Строка - хозяйственный номер ТС (АпкХозНомер).
//
Функция ДанныеТранспортногоСредства(ТранспортноеСредство) Экспорт

	Результат = Новый Структура("МодельТехники, ХозНомер", Неопределено, "");
	Если НЕ ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	ТС.АпкМодель КАК МодельТехники,
	|	ТС.АпкХозНомер КАК ХозНомер
	|ИЗ
	|	Справочник." + ИмяСправочникаТранспортныхСредств() + " КАК ТС
	|ГДЕ
	|	ТС.Ссылка = &ТранспортноеСредство";

	РезультатЗапроса = ВыполнитьЗапросАПК(ТекстЗапроса,
		Новый Структура("ТранспортноеСредство", ТранспортноеСредство));
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.МодельТехники = Выборка.МодельТехники;
		Результат.ХозНомер = Выборка.ХозНомер;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ФункцииДат

// Возвращает число календарных дней периода, границы включены (FAQ Q1):
// (Окончание - Начало + 1) день. Производственный календарь - v2.
//
// Параметры:
//   НачалоПериода  - Дата - дата начала интервала;
//   ОкончаниеПериода - Дата - дата окончания интервала.
//
// Возвращаемое значение:
//   Число - число календарных дней; 0 - даты не заполнены или интервал пуст.
//
Функция ЧислоДнейПериода(НачалоПериода, ОкончаниеПериода) Экспорт

	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
		Возврат 0;
	КонецЕсли;

	Дней = (НачалоДня(ОкончаниеПериода) - НачалоДня(НачалоПериода)) / 86400 + 1;

	Возврат Макс(Дней, 0);

КонецФункции



#КонецОбласти

#Область ЗапросыРасчетаДефицита

// Возвращает потребность в сменах по регистрам годового плана АПК
// (design §4.7, шаг 1, TD-002): UNION ALL механизированных работ
// (техника, вид СХТехника) и транспортных работ (автомобиль, вид
// Автотранспорт), агрегировано до интервалов строк техкарт.
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор, если заполнено;
//     * ДатаНачала      - Дата - левая граница диапазона запуска;
//     * ДатаОкончания   - Дата - правая граница диапазона запуска;
//     * СуффиксОбъема   - Строка - "_Мин"/"_Вер"/"_Макс" (FAQ Q3, default "_Вер").
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: СценарийПланирования, Организация, Подразделение,
//     ПериодНачала, ПериодОкончания, ВидРаботы, МодельТехники, ВидТехники,
//     ПотребностьСмен.
//
Функция ЗапросПотребности(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос потребности невозможен.'");
	КонецЕсли;

	Суффикс = СуффиксОбъема(Параметры);
	// Необязательные ключи (докстринг: "отбор, если заполнена"):
	Организация = ЗначениеПоУмолчанию(Параметры, "Организация", Неопределено);
	Подразделение = ЗначениеПоУмолчанию(Параметры, "Подразделение", Неопределено);

	ДатаНачала = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1));
	ДатаОкончания = ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31));

	УсловияМеханизированных = "М.СценарийПланирования = &СценарийПланирования
	|	И М.ПериодОкончания >= &ДатаНачала
	|	И М.ПериодНачала <= &ДатаОкончания";
	УсловияТранспортных = "Тран.СценарийПланирования = &СценарийПланирования
	|	И Тран.ПериодОкончания >= &ДатаНачала
	|	И Тран.ПериодНачала <= &ДатаОкончания";

	Если ЗначениеЗаполнено(Организация) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Организация = &Организация";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Организация = &Организация";
	КонецЕсли;

	Если ЗначениеЗаполнено(Подразделение) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Подразделение = &Подразделение";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Подразделение = &Подразделение";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.СценарийПланирования КАК СценарийПланирования,
	|	Т.Организация КАК Организация,
	|	Т.Подразделение КАК Подразделение,
	|	Т.ПериодНачала КАК ПериодНачала,
	|	Т.ПериодОкончания КАК ПериодОкончания,
	|	Т.ВидРаботы КАК ВидРаботы,
	|	Т.МодельТехники КАК МодельТехники,
	|	Т.ВидТехники КАК ВидТехники,
	|	СУММА(Т.Смен) КАК ПотребностьСмен
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			М.СценарийПланирования КАК СценарийПланирования,
	|			М.Организация КАК Организация,
	|			М.Подразделение КАК Подразделение,
	|			М.ПериодНачала КАК ПериодНачала,
	|			М.ПериодОкончания КАК ПериодОкончания,
	|			М.ВидРаботы КАК ВидРаботы,
	|			М.Техника КАК МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника) КАК ВидТехники,
	|			М.Смен" + Суффикс + "Оборот КАК Смен
	|		ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану.Обороты() КАК М
	|		ГДЕ " + УсловияМеханизированных + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Тран.СценарийПланирования,
	|			Тран.Организация,
	|			Тран.Подразделение,
	|			Тран.ПериодНачала,
	|			Тран.ПериодОкончания,
	|			Тран.ВидРаботы,
	|			Тран.Автомобиль,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт),
	|			Тран.Смен" + Суффикс + "Оборот
	|		ИЗ РегистрНакопления.АпкТранспортныеРаботыПоГодовомуПлану.Обороты() КАК Тран
	|		ГДЕ " + УсловияТранспортных + "
	|	) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.СценарийПланирования,
	|	Т.Организация,
	|	Т.Подразделение,
	|	Т.ПериодНачала,
	|	Т.ПериодОкончания,
	|	Т.ВидРаботы,
	|	Т.МодельТехники,
	|	Т.ВидТехники";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СценарийПланирования", Параметры.СценарийПланирования);
	ПараметрыЗапроса.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыЗапроса.Вставить("ДатаОкончания", ДатаОкончания);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Подразделение);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Возвращает доступность техники по документам Тх_ПланТехническихРесурсов
// (design §4.7, шаг 2): проведённые документы, принятые ТС, группировка
// по подразделению, модели и виду техники.
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор, если заполнено.
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: СценарийПланирования, Подразделение,
//     МодельТехники, ВидТехники, ЕдиницДоступно.
//
Функция ЗапросДоступности(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос доступности невозможен.'");
	КонецЕсли;

	УсловияОтбора = "Д.Проведен
	|	И Д.СценарийПланирования = &СценарийПланирования";
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		УсловияОтбора = УсловияОтбора + "
	|	И Д.Организация = &Организация";
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда
		УсловияОтбора = УсловияОтбора + "
	|	И Д.Подразделение = &Подразделение";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.СценарийПланирования КАК СценарийПланирования,
	|	Т.Подразделение КАК Подразделение,
	|	Т.МодельТехники КАК МодельТехники,
	|	Т.ВидТехники КАК ВидТехники,
	|	СУММА(Т.Количество) КАК ЕдиницДоступно
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			Д.СценарийПланирования КАК СценарийПланирования,
	|			Д.Подразделение КАК Подразделение,
	|			Осн.МодельТехники КАК МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника) КАК ВидТехники,
	|			Осн.Количество КАК Количество
	|		ИЗ Документ.Тх_ПланТехническихРесурсов.ОсновнаяТехника КАК Осн
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
	|			ПО Осн.Ссылка = Д.Ссылка
	|		ГДЕ Осн.Принят
	|			И " + УсловияОтбора + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Д.СценарийПланирования,
	|			Д.Подразделение,
	|			Обор.МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Оборудование),
	|			Обор.Количество
	|		ИЗ Документ.Тх_ПланТехническихРесурсов.Оборудование КАК Обор
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
	|			ПО Обор.Ссылка = Д.Ссылка
	|		ГДЕ Обор.Принят
	|			И " + УсловияОтбора + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Д.СценарийПланирования,
	|			Д.Подразделение,
	|			Авто.МодельТехники,
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт),
	|			Авто.Количество
	|		ИЗ Документ.Тх_ПланТехническихРесурсов.Автотранспорт КАК Авто
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Тх_ПланТехническихРесурсов КАК Д
	|			ПО Авто.Ссылка = Д.Ссылка
	|		ГДЕ Авто.Принят
	|			И " + УсловияОтбора + "
	|	) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.СценарийПланирования,
	|	Т.Подразделение,
	|	Т.МодельТехники,
	|	Т.ВидТехники";

	ПараметрыЗапроса = Новый Структура("СценарийПланирования", Параметры.СценарийПланирования);
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Параметры.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Параметры.Подразделение);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Возвращает суффикс ресурса объёма из параметров с проверкой допустимости
// (FAQ Q3: тройные ресурсы "_Мин"/"_Вер"/"_Макс", default "_Вер").
//
// Параметры:
//   Параметры - Структура - параметры запуска расчёта.
//
// Возвращаемое значение:
//   Строка - суффикс ресурса регистра годового плана.
//
Функция СуффиксОбъема(Параметры)

	// T7: ключ СуффиксОбъема в параметрах необязателен (T7-функция
	// ПотребностьПоТехкартам его не передаёт - всегда базовый "_Вер").
	Суффикс = "_Вер";
	Если Параметры.Свойство("СуффиксОбъема") Тогда
		Суффикс = Параметры.СуффиксОбъема;
	КонецЕсли;

	Если Суффикс <> "_Мин" И Суффикс <> "_Вер" И Суффикс <> "_Макс" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Недопустимый вариант объёма работ: %1'"), Суффикс);
	КонецЕсли;

	Возврат Суффикс;

КонецФункции

// Возвращает значение ключа структуры или значение по умолчанию, если ключ
// отсутствует.
//
// Параметры:
//   Структура      - Структура - источник значений;
//   Ключ           - Строка - имя ключа;
//   ПоУмолчанию    - Произвольный - значение по умолчанию.
//
// Возвращаемое значение:
//   Произвольный - значение ключа или значение по умолчанию.
//
Функция ЗначениеПоУмолчанию(Структура, Ключ, ПоУмолчанию)

	Если Структура.Свойство(Ключ) Тогда
		Возврат Структура[Ключ];
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти

#Область ФормированиеПланаРабот

// Возвращает агрегированную потребность в технике по оборотам регистров
// годового плана АПК (design 6.1, TD-005/TD-006, FR-003.1-2):
// суммы Смен_Вер/Часов_Вер (вероятностный план - базовый вариант АПК;
// *_Мин/_Макс не читаем, переключатель - релиз 2) по виду работ, модели
// техники и оборудованию, отдельно для СХ-техники и автотранспорта.
//
// Источники - обороты ДВУХ регистров накопления (TD-005):
//   АпкМеханизированныеРаботыПоГодовомуПлану (Техника/Оборудование) и
//   АпкТранспортныеРаботыПоГодовомуПлану (Автомобиль/Прицеп).
// Период - пересечение ПериодНачала/ПериодОкончания строк техкарт с окном
// запроса (FAQ Q2). Подразделение выращивания - отбор В ИЕРАРХИИ
// (включая дочерние, если указано групповое).
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор В ИЕРАРХИИ, если заполнено;
//     * ДатаНачала      - Дата - левая граница окна (пусто - без ограничения);
//     * ДатаОкончания   - Дата - правая граница окна (пусто - без ограничения).
//
// Возвращаемое значение:
//   РезультатЗапроса - колонки: ВидТехники, ВидРаботы, МодельТехники
//     (СХТехника - АпкМоделиСХТехники; Автотранспорт - АпкМоделиАвтотранспорта),
//     Оборудование (СХТехника - АпкМоделиСХОборудования; Автотранспорт -
//     АпкМоделиПрицепов), ПотребностьСмен, ПотребностьЧасов.
//
Функция ПотребностьПоТехкартам(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: запрос потребности по техкартам невозможен.'");
	КонецЕсли;

	Суффикс = СуффиксОбъема(Параметры);
	// Необязательные ключи: локальные переменные через ЗначениеПоУмолчанию
	Организация = ЗначениеПоУмолчанию(Параметры, "Организация", Неопределено);
	Подразделение = ЗначениеПоУмолчанию(Параметры, "Подразделение", Неопределено);

	ДатаНачала = ЗначениеПоУмолчанию(Параметры, "ДатаНачала", Дата(1, 1, 1));
	ДатаОкончания = ЗначениеПоУмолчанию(Параметры, "ДатаОкончания", Дата(3999, 12, 31));

	УсловияМеханизированных = "М.СценарийПланирования = &СценарийПланирования
	|	И М.ПериодОкончания >= &ДатаНачала
	|	И М.ПериодНачала <= &ДатаОкончания";
	УсловияТранспортных = "Тран.СценарийПланирования = &СценарийПланирования
	|	И Тран.ПериодОкончания >= &ДатаНачала
	|	И Тран.ПериодНачала <= &ДатаОкончания";

	Если ЗначениеЗаполнено(Организация) Тогда
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Организация = &Организация";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Организация = &Организация";
	КонецЕсли;

	Если ЗначениеЗаполнено(Подразделение) Тогда
		// Отбор по подразделению выращивания В ИЕРАРХИИ (design 6.1):
		// групповое подразделение включает дочерние.
		УсловияМеханизированных = УсловияМеханизированных + "
	|	И М.Подразделение В ИЕРАРХИИ(&Подразделение)";
		УсловияТранспортных = УсловияТранспортных + "
	|	И Тран.Подразделение В ИЕРАРХИИ(&Подразделение)";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.ВидТехники КАК ВидТехники,
	|	Т.ВидРаботы КАК ВидРаботы,
	|	Т.МодельТехники КАК МодельТехники,
	|	Т.Оборудование КАК Оборудование,
	|	СУММА(Т.Смен) КАК ПотребностьСмен,
	|	СУММА(Т.Часов) КАК ПотребностьЧасов
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.СХТехника) КАК ВидТехники,
	|			М.ВидРаботы КАК ВидРаботы,
	|			М.Техника КАК МодельТехники,
	|			М.Оборудование КАК Оборудование,
	|			М.Смен" + Суффикс + "Оборот КАК Смен,
	|			М.Часов" + Суффикс + "Оборот КАК Часов
	|		ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану.Обороты() КАК М
	|		ГДЕ " + УсловияМеханизированных + "
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			ЗНАЧЕНИЕ(Перечисление.Тх_ВидыТехники.Автотранспорт),
	|			Тран.ВидРаботы,
	|			Тран.Автомобиль,
	|			Тран.Прицеп,
	|			Тран.Смен" + Суффикс + "Оборот,
	|			Тран.Часов" + Суффикс + "Оборот
	|		ИЗ РегистрНакопления.АпкТранспортныеРаботыПоГодовомуПлану.Обороты() КАК Тран
	|		ГДЕ " + УсловияТранспортных + "
	|	) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.ВидТехники,
	|	Т.ВидРаботы,
	|	Т.МодельТехники,
	|	Т.Оборудование";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СценарийПланирования", Параметры.СценарийПланирования);
	ПараметрыЗапроса.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыЗапроса.Вставить("ДатаОкончания", ДатаОкончания);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыЗапроса.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ПараметрыЗапроса.Вставить("Подразделение", Подразделение);
	КонецЕсли;

	Возврат ВыполнитьЗапросАПК(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

#КонецОбласти

#Область РасчетДефицита

// Выполняет расчёт дефицита техники и записывает результат в регистр
// сведений Тх_ДефицитТехники (design §4.7, шаги 3-5; TD-002, TD-003):
// очистка регистра по отборам запуска, сопоставление потребности (годовой
// план АПК) с доступностью (принятые ТС), пересчёт аналогов через
// коэффициенты (TD-004) и запись строк дефицита.
//
// Параметры:
//   Параметры - Структура:
//     * СценарийПланирования - СправочникСсылка - сценарий (обязателен);
//     * Организация     - СправочникСсылка - отбор, если заполнена;
//     * Подразделение   - СправочникСсылка - отбор, если заполнено;
//     * ДатаНачала      - Дата - левая граница диапазона запуска
//                         (пустая - вся глубина, как в ЗапросПотребности);
//     * ДатаОкончания   - Дата - правая граница диапазона запуска;
//     * СменВДень       - Число - смен в день (FAQ Q1, default 1);
//     * СуффиксОбъема   - Строка - "_Мин"/"_Вер"/"_Макс" (FAQ Q3, default "_Вер").
//
// Возвращаемое значение:
//   Число - число записанных строк регистра.
//
Функция РассчитатьДефицит(Параметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий планирования: расчёт дефицита невозможен.'");
	КонецЕсли;

	// Ранняя валидация варианта объёма (суффикс ресурса годового плана, FAQ Q3).
	СуффиксОбъема(Параметры);

	СменВДень = ЗначениеПоУмолчанию(Параметры, "СменВДень", 1);
	Если НЕ ЗначениеЗаполнено(СменВДень) ИЛИ СменВДень <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Параметр «Смен в день» должен быть положительным числом.'");
	КонецЕсли;

	// Отбор по виду техники (design §4.7): если задан - в расчёт идут только
	// строки потребности этого вида (пустой - все виды).
	ВидТехники = ЗначениеПоУмолчанию(Параметры, "ВидТехники", Неопределено);

	// Шаги 1-2 (design §4.7): потребность и доступность - выгрузкой таблиц
	// значений, один проход по каждой (NFR-002).
	ТЗПотребность = ЗапросПотребности(Параметры).Выгрузить();
	ТЗДоступность = ЗапросДоступности(Параметры).Выгрузить();

	// Индекс: подразделение - строки доступности (любой вид техники);
	// пустой индекс по подразделению = план техресурсов отсутствует (NFR-005,
	// рек. B: дефицит = вся потребность).
	ИндексДоступности = ИндексДоступностиПоПодразделениям(ТЗДоступность);

	Записано = 0;
	НачатьТранзакцию();
	Попытка
		// Шаг 3: очистка регистра по отборам запуска (NFR-005 - детерминизм):
		// удаляются записи по сценарию/организации/подразделению запуска;
		// строки вне запрошенного периода от прошлых запусков не трогаются.
		НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
		УстановитьОтборыЗапуска(НаборЗаписей.Отбор, Параметры);
		НаборЗаписей.Записать(Истина);

		// Защита от дублей ключа (8 измерений): потребность уже сгруппирована
		// запросом, дублей быть не должно; при совпадении остаётся первая строка
		// (дубль ключа в наборе записей - ошибка записи в 1С).
		КлючиСтрок = Новый Соответствие;

		// Шаги 4-5: по каждой строке потребности - сопоставление и запись.
		Для Каждого Стр Из ТЗПотребность Цикл

			Если ЗначениеЗаполнено(ВидТехники) И Стр.ВидТехники <> ВидТехники Тогда
				Продолжить;
			КонецЕсли;

			Ключ = КлючЗаписиДефицита(Стр);
			Если КлючиСтрок.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КлючиСтрок.Вставить(Ключ, Истина);

			Дней = ЧислоДнейПериода(Стр.ПериодНачала, Стр.ПериодОкончания);

			СтрокиДоступности = ИндексДоступности.Получить(Стр.Подразделение);
			Если СтрокиДоступности = Неопределено Тогда
				СтрокиДоступности = Новый Массив;
			КонецЕсли;

			РезультатСопоставления = ДоступноСменСтроки(
				Стр, СтрокиДоступности, Дней, СменВДень);

			// Дефицит неотрицателен, округление 2 знака (FR-012).
			Дефицит = Макс(0, Окр(Стр.ПотребностьСмен - РезультатСопоставления.Доступно, 2));

			Запись = НаборЗаписей.Добавить();
			Запись.Организация = Стр.Организация;
			Запись.Подразделение = Стр.Подразделение;
			Запись.СценарийПланирования = Стр.СценарийПланирования;
			Запись.ПериодНачала = Стр.ПериодНачала;
			Запись.ПериодОкончания = Стр.ПериодОкончания;
			Запись.ВидРаботы = Стр.ВидРаботы;
			Запись.МодельТехники = Стр.МодельТехники;
			Запись.ВидТехники = Стр.ВидТехники;
			Запись.ПотребностьСмен = Стр.ПотребностьСмен;
			Запись.ДоступноСмен = Окр(РезультатСопоставления.Доступно, 2);
			Запись.НехватаетСмен = Дефицит;
			Запись.ДнейПериода = Дней;
			Запись.СменВДень = СменВДень;
			Запись.КоэффициентНеЗадан = РезультатСопоставления.КоэффициентНеЗадан;
			Запись.ПланТехресурсовОтсутствует =
				ИндексДоступности.Получить(Стр.Подразделение) = Неопределено;

			Записано = Записано + 1;

		КонецЦикла;

		Если Записано > 0 Тогда
			НаборЗаписей.Записать(Ложь);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Записано;

КонецФункции

// Возвращает индекс доступности по подразделениям (design §4.7, шаг 2):
// один проход по таблице доступности (NFR-002).
//
// Параметры:
//   ТЗДоступность - ТаблицаЗначений - колонки: СценарийПланирования,
//                   Подразделение, МодельТехники, ВидТехники, ЕдиницДоступно.
//
// Возвращаемое значение:
//   Соответствие - подразделение -> Массив строк таблицы доступности.
//
Функция ИндексДоступностиПоПодразделениям(ТЗДоступность)

	Индекс = Новый Соответствие;
	Для Каждого Строка Из ТЗДоступность Цикл
		СтрокиПодразделения = Индекс.Получить(Строка.Подразделение);
		Если СтрокиПодразделения = Неопределено Тогда
			СтрокиПодразделения = Новый Массив;
			Индекс.Вставить(Строка.Подразделение, СтрокиПодразделения);
		КонецЕсли;
		СтрокиПодразделения.Добавить(Строка);
	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Устанавливает отборы набора записей регистра Тх_ДефицитТехники по отборам
// запуска: сценарий - всегда, организация и подразделение - если заполнены
// (design §4.7, шаг 3, NFR-005).
//
// Параметры:
//   Отбор     - ОтборНабораЗаписейСведений - отбор набора записей регистра;
//   Параметры - Структура - параметры запуска расчёта.
//
Процедура УстановитьОтборыЗапуска(Отбор, Параметры)

	Отбор.СценарийПланирования.Установить(Параметры.СценарийПланирования);
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Отбор.Организация.Установить(Параметры.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда
		Отбор.Подразделение.Установить(Параметры.Подразделение);
	КонецЕсли;

КонецПроцедуры

// Возвращает строковый ключ записи дефицита по 8 измерениям (защита
// от дублей ключа при записи набора).
//
// Параметры:
//   Стр - СтрокаТаблицыЗначений - строка потребности (запрос ЗапросПотребности).
//
// Возвращаемое значение:
//   Строка - ключ по значениям всех измерений.
//
Функция КлючЗаписиДефицита(Стр)

	Возврат Строка(Стр.Организация) + "|" + Строка(Стр.Подразделение) + "|"
		+ Строка(Стр.СценарийПланирования) + "|" + Строка(Стр.ПериодНачала) + "|"
		+ Строка(Стр.ПериодОкончания) + "|" + Строка(Стр.ВидРаботы) + "|"
		+ Строка(Стр.МодельТехники) + "|" + Строка(Стр.ВидТехники);

КонецФункции

// Возвращает доступные смены по строке потребности (design §4.7, шаги 4-5;
// TD-004, FR-011, D-007):
//   Автотранспорт - модель в модель, без коэффициентов (FAQ Q4);
//   СХТехника - своя модель напрямую + замены: смены_замены / К
//   (К из КоэффициентЗамещения по реквизитам моделей; Неопределено -
//   реквизитов нет, КоэффициентНеЗадан = Истина, НЕ молчаливый 1,00).
// Сопоставляются только строки доступности того же вида техники, что у
// строки потребности (Оборудование в потребность не входит - D-007).
//
// Параметры:
//   Стр               - СтрокаТаблицыЗначений - строка потребности;
//   СтрокиДоступности - Массив - строки таблицы доступности подразделения;
//   Дней              - Число - календарных дней интервала строки;
//   СменВДень         - Число - смен в день (FAQ Q1).
//
// Возвращаемое значение:
//   Структура - свойства: Доступно (Число), КоэффициентНеЗадан (Булево).
//
Функция ДоступноСменСтроки(Стр, СтрокиДоступности, Дней, СменВДень)

	Доступно = 0;
	КоэффициентНеЗадан = Ложь;

	Если Стр.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		// Модель в модель, без пересчёта через K (D-007/FAQ Q4).
		Для Каждого СтрДост Из СтрокиДоступности Цикл
			Если СтрДост.ВидТехники = Стр.ВидТехники
				И СтрДост.МодельТехники = Стр.МодельТехники Тогда
				Доступно = Доступно + СтрДост.ЕдиницДоступно * Дней * СменВДень;
			КонецЕсли;
		КонецЦикла;
	Иначе
		// СХТехника: суммирование эквивалента в сменах базовой модели (TD-004).
		Для Каждого СтрДост Из СтрокиДоступности Цикл
			Если СтрДост.ВидТехники <> Стр.ВидТехники Тогда
				// Строки доступности других видов техники (например, Оборудование)
				// с потребностью не сопоставляются (D-007).
				Продолжить;
			КонецЕсли;

			СменМодели = СтрДост.ЕдиницДоступно * Дней * СменВДень;

			Если СтрДост.МодельТехники = Стр.МодельТехники Тогда
				Доступно = Доступно + СменМодели;
			Иначе
				// T6: модельный коэффициент замещения (FR-004, design 6.4):
				// К = Реквизит(замены)/Реквизит(оригинала), эквивалент замены
				// в сменах оригинала = смены_замены / К.
				К = КоэффициентЗамещения(Стр.МодельТехники, СтрДост.МодельТехники);
				Если К = Неопределено Тогда
					// У модели нет реквизитов замещения (или разные базовые) -
					// пометка вместо молчаливого 1,00 (FR-011).
					КоэффициентНеЗадан = Истина;
				Иначе
					Доступно = Доступно + СменМодели / К;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Доступно, КоэффициентНеЗадан", Доступно, КоэффициентНеЗадан);

КонецФункции

#КонецОбласти

#Область СлужебныеТестированиеБ6

// Возвращает ссылку элемента справочника по наименованию (служебная функция
// для Vanessa-сценариев B6: поля формы записи с конкретными типами
// заполняются из кода клиента тестирования).
//
// Параметры:
//	 ИмяСправочника - Строка - имя справочника конфигурации;

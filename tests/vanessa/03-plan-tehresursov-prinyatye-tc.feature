# language: ru
# Сценарий 3 из 8 (design §11 «Сценарные Vanessa»), SRV-02 §9.4.
# Дедупликация физических ТС в доступности (Q-003) по решению владельца
# 10.11.2026 (docs/review/decision-dostupnost-2026-11-10.md):
# доступность = срез последних РегистрСведений.АпкИсторияТранспортныхСредств
# с Исправно = Истина (данные Документ.АпкПланТехническихРесурсов
# как источник не читаются); дубль ЗАПИСЕЙ ИСТОРИИ одного ТС срез
# схлопывает в одну машину - единиц техники дубль НЕ добавляет
# (одна строка доступности = один физический объект).
# Фикстура: ТС создаётся с моделью из фактической строки спроса техкарт
# (демо-данные годового плана: НИВА / Отделение №2 / «Основной» / 2014-2015)
# и АпкТипТС = СХТехника (вид строки пула - из реквизита ТС), приписка -
# ДВЕ записи регистра (обе Исправно = Истина, периоды 01.01.1999/01.07.1999).
# Расчёт - серверный вызов Тх_ТехникаСервер.РассчитатьДефицит с
# ДатаНачала = 31.12.1999 (дата среза): срез раньше всех демо-записей
# регистра (2000-01-01) - пул изолирован тестовой припиской, окно спроса
# 2014-2015 целиком правее границы.
# Инвариант по регистру Тх_ДефицитТехники: ДоступноСмен = 1 машина x
# ДнейПериода x СменВДень (дубль записей не удваивает),
# ПланТехресурсовОтсутствует = Ложь (машина приписана к организации/
# подразделению строки спроса).

Функционал: Дедупликация ТС при расчёте дефицита

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	# Очистка прошлого прогона (идемпотентность) и изоляция доступности:
	# записи истории тестовых ТС (Тх_VA% ТС% - свои и чужие (04) приписки
	# ломят изоляцию среза 31.12.1999), сами тестовые ТС; остатки планов
	# прошлых прогонов (маркер «Тх_VA_03%») источником больше не являются,
	# но удаляются для чистоты базы (Q-006/К4а).
	Дано я выполняю код встроенного языка на сервере
	|ЗапросУд = Новый Запрос("ВЫБРАТЬ С.Ссылка ИЗ Документ.АпкПланТехническихРесурсов КАК С ГДЕ С.Комментарий ПОДОБНО ""Тх_VA_03%""");|
	|ВыбУд = ЗапросУд.Выполнить().Выбрать();|
	|Пока ВыбУд.Следующий() Цикл ВыбУд.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|
	|Запрос2 = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Д.Ссылка ИЗ Документ.АпкПланТехническихРесурсов КАК Д ГДЕ Д.Проведен И Д.СценарийПланирования = &Сцен2");|
	|Запрос2.УстановитьПараметр("Сцен2", Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной"));|
	|Выб2 = Запрос2.Выполнить().Выбрать();|
	|Пока Выб2.Следующий() Цикл Выб2.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|
	|ЗапросТС = Новый Запрос("ВЫБРАТЬ Спр.Ссылка ИЗ Справочник.ТранспортныеСредства КАК Спр ГДЕ Спр.Наименование ПОДОБНО ""Тх_VA% ТС%""");|
	|ВыбТС = ЗапросТС.Выполнить().Выбрать();|
	|Пока ВыбТС.Следующий() Цикл|
	|	НаборИст = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|	НаборИст.Отбор.ТранспортноеСредство.Установить(ВыбТС.Ссылка);|
	|	НаборИст.Записать(Истина);|
	|	ВыбТС.Ссылка.ПолучитьОбъект().Удалить();|
	|КонецЦикла;|
	|ЗапросТХТС = Новый Запрос("ВЫБРАТЬ Спр.Ссылка ИЗ Справочник.ТранспортныеСредства КАК Спр ГДЕ Спр.Код ПОДОБНО ""ТХТС%"" И НЕ Спр.ПометкаУдаления");|
	|ВыбТХТС = ЗапросТХТС.Выполнить().Выбрать();|
	|Пока ВыбТХТС.Следующий() Цикл|
	|	НаборТХТС = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|	НаборТХТС.Отбор.ТранспортноеСредство.Установить(ВыбТХТС.Ссылка);|
	|	НаборТХТС.Записать(Истина);|
	|КонецЦикла;|

Сценарий: Дубль строки ТС в плане не удваивает доступность
	# 1. Подготовка: ТС модели из строки спроса техкарт (АпкТипТС =
	#    СХТехника), приписка к НИВА/Отделение №2 - ДВЕ записи истории ТС
	#    (дубль, обе Исправно = Истина; срез последних оставляет одну
	#    машину); расчёт дефицита с датой среза 31.12.1999 (серверный
	#    вызов, параметры - как у формы «Расчет дефицита» в 05).
	Когда я выполняю код встроенного языка на сервере
	|Сценарий = Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной");|
	|Орг = Справочники.Организации.НайтиПоНаименованию("НИВА");|
	|Подр = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отделение №2");|
	|ЗапросМодели = Новый Запрос("ВЫБРАТЬ Т.Техника КАК МодельТехники ИЗ РегистрНакопления.АпкМеханизированныеРаботыПоГодовомуПлану.Обороты() КАК Т ГДЕ Т.СценарийПланирования = &Сценарий И Т.Организация = &Орг И Т.Подразделение = &Подр И Т.ПериодОкончания >= ДАТАВРЕМЯ(2014, 1, 1) И Т.ПериодНачала <= ДАТАВРЕМЯ(2015, 12, 31, 23, 59, 59) И Т.Техника <> ЗНАЧЕНИЕ(Справочник.АпкМоделиСХТехники.ПустаяСсылка) СГРУППИРОВАТЬ ПО Т.Техника УПОРЯДОЧИТЬ ПО Т.Техника");|
	|ЗапросМодели.УстановитьПараметр("Сценарий", Сценарий);|
	|ЗапросМодели.УстановитьПараметр("Орг", Орг);|
	|ЗапросМодели.УстановитьПараметр("Подр", Подр);|
	|ВыбМодели = ЗапросМодели.Выполнить().Выбрать();|
	|Если НЕ ВыбМодели.Следующий() Тогда ВызватьИсключение "нет строк спроса СХ-техники (НИВА/Отделение №2/Основной, 2014-2015)"; КонецЕсли;|
	|Модель = ВыбМодели.МодельТехники;|
	|ТС = Справочники.ТранспортныеСредства.СоздатьЭлемент();|
	|ТС.Код = "ТХВА0301";|
	|ТС.Наименование = "Тх_VA_03 ТС 1";|
	|ТС.АпкМодель = Модель;|
	|ТС.АпкТипТС = Перечисления.АпкТипыТС.СХТехника;|
	|ТС.Записать();|
	|НаборИст = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|НаборИст.Отбор.ТранспортноеСредство.Установить(ТС.Ссылка);|
	|ЗаписьИст1 = НаборИст.Добавить();|
	|ЗаписьИст1.Период = Дата(1999, 1, 1);|
	|ЗаписьИст1.ТранспортноеСредство = ТС.Ссылка;|
	|ЗаписьИст1.Организация = Орг;|
	|ЗаписьИст1.ЭксплуатирующееПодразделение = Подр;|
	|ЗаписьИст1.Исправно = Истина;|
	|ЗаписьИст2 = НаборИст.Добавить();|
	|ЗаписьИст2.Период = Дата(1999, 7, 1);|
	|ЗаписьИст2.ТранспортноеСредство = ТС.Ссылка;|
	|ЗаписьИст2.Организация = Орг;|
	|ЗаписьИст2.ЭксплуатирующееПодразделение = Подр;|
	|ЗаписьИст2.Исправно = Истина;|
	|НаборИст.Записать(Истина);|
	|ПараметрыРасчета = Новый Структура("СценарийПланирования, Организация, Подразделение, ДатаНачала, ДатаОкончания, СменВДень", Сценарий, Орг, Подр, Дата(1999, 12, 31), Дата(2015, 12, 31, 23, 59, 59), 1);|
	|Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);|
	# 2. Инвариант Q-003: строки регистра дефицита модели тестового ТС
	#    (строки дефицита - источники перемещений пустые) видят ровно ОДНУ
	#    машину: ДоступноСмен = ДнейПериода x СменВДень (дубль записей
	#    истории срезом не удваивается); приписка есть ->
	#    ПланТехресурсовОтсутствует = Ложь.
	И я выполняю код встроенного языка на сервере
	|Орг = Справочники.Организации.НайтиПоНаименованию("НИВА");|
	|Подр = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отделение №2");|
	|Сценарий = Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной");|
	|ТС = Справочники.ТранспортныеСредства.НайтиПоНаименованию("Тх_VA_03 ТС 1");|
	|Если НЕ ЗначениеЗаполнено(ТС) Тогда ВызватьИсключение "тестовое ТС не найдено"; КонецЕсли;|
	|Запр = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н, СУММА(ВЫБОР КОГДА Р.ДоступноСмен = Р.ДнейПериода * Р.СменВДень И НЕ Р.ПланТехресурсовОтсутствует ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК Ошибки ИЗ РегистрСведений.Тх_ДефицитТехники КАК Р ГДЕ Р.Организация = &Орг И Р.Подразделение = &Подр И Р.СценарийПланирования = &Сценарий И Р.МодельТехники = &Модель И Р.ИсточникОрганизации = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) И Р.ИсточникПодразделения = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) И Р.ДнейПериода > 0");|
	|Запр.УстановитьПараметр("Орг", Орг);|
	|Запр.УстановитьПараметр("Подр", Подр);|
	|Запр.УстановитьПараметр("Сценарий", Сценарий);|
	|Запр.УстановитьПараметр("Модель", ТС.АпкМодель);|
	|ТЗ = Запр.Выполнить().Выгрузить();|
	|Если ТЗ.Количество() = 0 ИЛИ ТЗ[0].Н = 0 Тогда ВызватьИсключение "нет строк дефицита по модели тестового ТС (строка спроса не попала в расчёт)"; КонецЕсли;|
	|Если ТЗ[0].Ошибки > 0 Тогда ВызватьИсключение "ДоступноСмен <> 1 машина x дней x смен (дубль ТС удваивает доступность) или нет приписки к подразделению строки"; КонецЕсли;|
	|Сообщить("ТХ_03 строк по модели тестового ТС: " + Строка(ТЗ[0].Н));|

	# 3. Teardown (Q-006/К4а): приписка тестового ТС убирается набором пустых
	#    записей, само ТС удаляется - срез 31.12.1999 остаётся чистым для
	#    следующих сценариев (утечка 03 -> 04 ломила изоляцию уровня 1).
	И я выполняю код встроенного языка на сервере
	|ЗапросТС = Новый Запрос("ВЫБРАТЬ Спр.Ссылка ИЗ Справочник.ТранспортныеСредства КАК Спр ГДЕ Спр.Наименование ПОДОБНО ""Тх_VA% ТС%""");|
	|ВыбТС = ЗапросТС.Выполнить().Выбрать();|
	|Пока ВыбТС.Следующий() Цикл|
	|	НаборИст = РегистрыСведений.АпкИсторияТранспортныхСредств.СоздатьНаборЗаписей();|
	|	НаборИст.Отбор.ТранспортноеСредство.Установить(ВыбТС.Ссылка);|
	|	НаборИст.Записать(Истина);|
	|	ВыбТС.Ссылка.ПолучитьОбъект().Удалить();|
	|КонецЦикла;|

# language: ru
# Сценарий 7 из 8 (design §11 «Сценарные Vanessa»).
# Пометка строк с незаданным коэффициентом.
# Покрывает: FR-011 (нет коэффициента для модели → модель исключена из
# пересчёта доступности, строка отчёта помечена «коэффициент не задан» —
# вычисляемое поле ПометкаКоэффициента + условное оформление СКД).
# T6: регистр коэффициентов удалён (FR-005); пометка выставляется, когда
# КоэффициентЗамещения по реквизитам моделей = Неопределено (FR-011).
#
# T11-переформулировка (согласована с задачей T11): исходный шаг
# «выбор работы „Вспашка“ в форме выбора» нестабилен — АпкФормаВыбора
# справочника ВидыРаботСотрудников (кастомная форма АПК: двухпанельный
# режим «дерево», поиск и переход по строке VA-шагами не срабатывают,
# клик «Выбрать» по строке-группе — no-op). Суть FR-011 сохранена:
# серверная подготовка доступности «чужой» модели (принятая ТС ТХТС001,
# модель «Тх_Тест Базовая») -> при расчёте дефицита требуемые техкартами
# модели (без реквизитов замещения) получают КоэффициентНеЗадан=Истина
# -> в отчёте формируется пометка «коэффициент не задан» (СКД-поле
# ПометкаКоэффициента), проверяемая в табличном документе отчёта
# + серверным инвариантом по регистру Тх_ДефицитТехники.

Функционал: Пометка строк с незаданным коэффициентом

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	# Очистка прошлого прогона (идемпотентность) и подготовка доступности:
	# проведённый план техресурсов (НИВА / Основной / Отделение №2) с ПРИНЯТОЙ
	# ТС ТХТС* (модель «Тх_Тест Базовая») - единственная доступность по отборам
	# расчёта => требуемые техкартами модели (без реквизитов замещения)
	# помечаются «коэффициент не задан» (FR-011, design §6.4).
	Дано я выполняю код встроенного языка на сервере
	|ЗапросУд = Новый Запрос("ВЫБРАТЬ С.Ссылка ИЗ Документ.Тх_ПланТехническихРесурсов КАК С ГДЕ С.Комментарий ПОДОБНО ""Тх_VA%""");|
	|ВыбУд = ЗапросУд.Выполнить().Выбрать();|
	|Пока ВыбУд.Следующий() Цикл ВыбУд.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;|
	|Док = Документы.Тх_ПланТехническихРесурсов.СоздатьДокумент();|
	|Док.Дата = ТекущаяДатаСеанса();|
	|Док.Организация = Справочники.Организации.НайтиПоНаименованию("НИВА");|
	|Док.Подразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отделение №2");|
	|Док.СценарийПланирования = Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной");|
	|Док.Комментарий = "Тх_VA_07Доступность";|
	|ЗапросТС = Новый Запрос("ВЫБРАТЬ Спр.Ссылка ИЗ Справочник.ТранспортныеСредства КАК Спр ГДЕ Спр.Код ПОДОБНО ""ТХТС%"" И НЕ Спр.ПометкаУдаления");|
	|ВыбТС = ЗапросТС.Выполнить().Выбрать();|
	|КолТСТ = 0;|
	|Пока ВыбТС.Следующий() Цикл|
	|	Стр = Док.ОсновнаяТехника.Добавить();|
	|	Стр.ТранспортноеСредство = ВыбТС.Ссылка;|
	|	Стр.МодельТехники = ВыбТС.Ссылка.АпкМодель;|
	|	Стр.Количество = 1;|
	|	Стр.Принят = Истина;|
	|	КолТСТ = КолТСТ + 1;|
	|КонецЦикла;|
	|Если КолТСТ = 0 Тогда ВызватьИсключение "нет тестовых ТС (ТХТС*)"; КонецЕсли;|
	|Док.Записать(РежимЗаписиДокумента.Проведение);|

Сценарий: Пометка строк с незаданным коэффициентом
	Когда я закрываю все окна клиентского приложения
	# 1. Расчёт дефицита по данным, где есть модель без коэффициента
	И В командном интерфейсе я выбираю 'Планирование техники' 'Расчет дефицита'
	Тогда открылось окно 'Расчет дефицита'
	И я нажимаю кнопку выбора у поля с именем 'Организация'
	И я жду открытия окна 'Организации' в течение 15 секунд
	И в таблице 'Список' в дополнение формы с именем 'СписокСтрокаПоиска' я ввожу текст 'НИВА'
	И пауза 4
	И в таблице 'Список' я перехожу к первой строке
	И я нажимаю на кнопку с именем 'ФормаВыбрать'
	И я нажимаю кнопку выбора у поля с именем 'Подразделение'
	И я жду открытия окна 'Структура предприятия' в течение 15 секунд
	И в таблице 'Список' в дополнение формы с именем 'СписокСтрокаПоиска' я ввожу текст 'Отделение №2'
	И пауза 4
	И в таблице 'Список' я перехожу к первой строке
	И я нажимаю на кнопку с именем 'ФормаВыбрать'
	И я нажимаю кнопку выбора у поля с именем 'СценарийПланирования'
	И я жду открытия окна 'Сценарии планирования растениеводства' в течение 15 секунд
	И я нажимаю на кнопку с именем 'ФормаСписок'
	И в таблице 'Список' я перехожу к строке:
		| 'Наименование' |
		| 'Основной' |
	И я нажимаю на кнопку с именем 'ФормаВыбрать'
	И в поле с именем 'ДатаНачала' я ввожу текст '01.01.2014'
	И в поле с именем 'ДатаОкончания' я ввожу текст '31.12.2015'
	И из выпадающего списка с именем 'ВидТехники' я выбираю точное значение 'Схтехника'
	И в поле с именем 'СменВДень' я ввожу текст '1'
	И я нажимаю на кнопку с именем 'РассчитатьИОткрытьОтчет'
	И пауза 3
	Тогда открылось окно 'Анализ дефицита техники'
	# 2. В отчёте строка по модели без коэффициента присутствует и помечена
	#    «коэффициент не задан» (условное оформление, FR-011); модель исключена
	#    из доступности (ДоступноСмен по ней не пересчитан через коэффициент).
	И я нажимаю на кнопку с именем 'СформироватьОтчет'
	И пауза 3
	Тогда открылось окно 'Анализ дефицита техники'
	# 3. FR-011: пометка «коэффициент не задан» в результате отчёта
	#    (вычисляемое поле ПометкаКоэффициента выводится в табличный документ)
	И табличный документ 'ОтчетТабличныйДокумент' содержит значения:
		| 'коэффициент не задан' |
	# 4. Серверный инвариант FR-011: в регистре дефицита есть помеченные строки
	#    (требуемая техкартой модель ≠ доступной «Тх_Тест Базовая», К не задан,
	#    доступность замещения исключена из пересчёта -> дефицит сохраняется).
	И я выполняю код встроенного языка на сервере
	|Запр = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.Тх_ДефицитТехники КАК Р ГДЕ Р.Организация = &Орг И Р.Подразделение = &Подр И Р.СценарийПланирования = &Сцен И Р.КоэффициентНеЗадан");|
	|Запр.УстановитьПараметр("Орг", Справочники.Организации.НайтиПоНаименованию("НИВА"));|
	|Запр.УстановитьПараметр("Подр", Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отделение №2"));|
	|Запр.УстановитьПараметр("Сцен", Справочники.АпкСценарииПланирования.НайтиПоНаименованию("Основной"));|
	|Н = Запр.Выполнить().Выгрузить()[0].Н;|
	|Если Н = 0 Тогда ВызватьИсключение "нет строк с пометкой «коэффициент не задан» (FR-011 нарушен)"; КонецЕсли;|
	|Сообщить("ТХ_07 помеченных строк: " + Строка(Н));|

// Финальная проверка чистоты раннера (Q-006, TEST-02): строки реестра
// + повторный sweep по маскам; пустой результат = чисто.
//
// Возвращаемое значение:
//   Массив - описания остатков (пустой массив = чистота доказана).
//
Функция ОстаткиПослеПрогона() Экспорт

	ПроверитьТестовуюБазу();

	Остатки = Новый Массив;

	Для Каждого Ссылка Из ОстаткиРеестра() Цикл
		Остатки.Добавить("Реестр: " + Строка(Ссылка));
	КонецЦикла;

	Для Каждого Описание Из УбратьОстаткиПоМаскам() Цикл
		Остатки.Добавить("Маска: " + Описание);
	КонецЦикла;

	Возврат Остатки;


// Форма обработки «Тх_ФормированиеПланаРаботТехники» (design 5.4/6.1,
// T7-T9): параметры потребности по техкартам годового плана АПК и кнопка
// «Сформировать» (Form.Command.Сформировать).
//
// T9: «Сформировать» создаёт НОВЫЙ документ «План технических ресурсов»
// (АпкПланТехническихРесурсов, Тх_ТехникаСервер.ЗаполнитьПланРабот),
// записывает и открывает его;
// если указан «текущий документ» - перезаполнение его табличных частей
// с подтверждением (FAQ Q8). Без техкарт документ не создаётся (design 9).
//
// Без модальности и фоновых заданий (NFR-001): ПоказатьВопрос /
// ПоказатьПредупреждение / ПоказатьЗначение - асинхронные. Форма выбора
// типового справочника сценариев - стандартный (поле типизировано
// с T7; легаси-обработчик НачалоВыбора удалён, FAQ Q8, TD-001).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Умолчание (design 5.4): при пустом значении - одна смена в день.
	Если НЕ ЗначениеЗаполнено(СменВдень) Тогда
		СменВдень = 1;
	КонецЕсли;

	// Открытие из существующего документа: параметр «Документ»
	// (design 5.4 - опция «Перезаполнить текущий документ»).
	ВходящийДокумент = Неопределено;
	Параметры.Свойство("Документ", ВходящийДокумент);
	Если ВходящийДокумент <> Неопределено Тогда
		Документ = ВходящийДокумент;
	КонецЕсли;

КонецПроцедуры

// BSLLS:Typo-off

&НаКлиенте
Процедура ПерезаполнениеЗавершение(РезультатВопроса, ДопПараметры) Экспорт
// BSLLS:Typo-on

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Результат = ПерезаполнитьНаСервере();
		Если ЗначениеЗаполнено(Результат.ОшибкаЗаписи) Тогда
			// P2-2: сбой записи/доступа - НЕ «нет данных» (подробности в ЖР).
			ПоказатьПредупреждение(,
				НСтр("ru = 'Не удалось записать документ плана. Подробности записаны в журнал регистрации.'"));
		ИначеЕсли Результат.КоличествоСтрок = 0 Тогда
			// Крайний случай design 9: документ не перезаполняется.
			ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
				// BSLLS:Typo-off
				НСтр("ru = 'Техкарты за период не найдены.'"));
				// BSLLS:Typo-on
		Иначе
			ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
				ТекстСводки(Результат));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)

	// Сценарий планирования обязателен (design 5.4).
	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите сценарий планирования.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ПараметрыВводаКорректны() Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Документ) Тогда
		// FAQ Q8: перезаполнение текущего документа - с подтверждением.
		// BSLLS:Typo-off
		Оповещение = Новый ОписаниеОповещения("ПерезаполнениеЗавершение", ЭтотОбъект);
		// BSLLS:Typo-on
		// BSLLS:Typo-off (слово «перезаполнить» в вопросе - ложное срабатывание Typo)
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Перезаполнить документ %1? Табличные части будут очищены.'"),
			Строка(Документ));
		// BSLLS:Typo-on
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СоздатьИОткрытьДокумент();
	КонецЕсли;

КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПараметрыВводаКорректны()

	Если НЕ ЗначениеЗаполнено(ПериодС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПериодПо) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите окончание периода.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ПериодС > ПериодПо Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Начало периода не может быть позже его окончания.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СменВдень) Или СменВдень <= 0 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Смен в день должно быть больше нуля.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура СоздатьИОткрытьДокумент()

	Результат = СоздатьНаСервере();
	Если ЗначениеЗаполнено(Результат.ОшибкаЗаписи) Тогда
		// P2-2: сбой записи/доступа - НЕ «нет данных» (подробности в ЖР).
		ПоказатьПредупреждение(,
			НСтр("ru = 'Не удалось записать документ плана. Подробности записаны в журнал регистрации.'"));
	ИначеЕсли Результат.КоличествоСтрок = 0 Тогда
		// Крайний случай design 9: документ не создаётся.
		ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
			// BSLLS:Typo-off
			НСтр("ru = 'Техкарты за период не найдены.'"));
			// BSLLS:Typo-on
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Формирование плана работ'"), ,
			ТекстСводки(Результат));
		ПоказатьЗначение(, Результат.Документ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ТекстСводки(Результат)

	Возврат СтрШаблон(
		НСтр("ru = 'Строк: %1, смен всего: %2 (часов: %3), замещено: %4, дефицитных: %5'"),
		Результат.КоличествоСтрок, Результат.ВсегоСмен, Результат.ВсегоЧасов,
		Результат.ЗамещенныхСтрок, Результат.ДефицитныхСтрок);

КонецФункции

&НаСервере
Функция СоздатьНаСервере()

	// P2-2 (UI-01): «нет данных» и «не удалось записать» - РАЗНЫЕ ветки.
	// Сбой записи/доступа не должен выглядеть как «техкарт нет»: исходный
	// текст уходит в журнал регистрации, клиенту - понятное сообщение.
	Попытка
		ДокументОбъект = Документы.АпкПланТехническихРесурсов.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		Результат = Тх_ТехникаСервер.ЗаполнитьПланРабот(ДокументОбъект, ПараметрыЗаполнения());

		Если Результат.КоличествоСтрок > 0 Тогда
			ДокументОбъект.Записать();
			Возврат СводкаКлиенту(Результат, ДокументОбъект.Ссылка);
		КонецЕсли;

		Возврат СводкаКлиенту(Результат);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Тх_ФормированиеПланаРаботТехники: не удалось создать или записать документ плана'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		Возврат СводкаКлиенту(Новый Структура("КоличествоСтрок", 0), , ТекстОшибки);
	КонецПопытки;

КонецФункции

// BSLLS:Typo-off

&НаСервере
Функция ПерезаполнитьНаСервере()
// BSLLS:Typo-on

	// P2-2 (UI-01): тот же контракт, что и у создания - сбой записи
	// отделён от «нет данных» и зажурналирован с исходным текстом.
	Попытка
		ДокументОбъект = Документ.ПолучитьОбъект();
		Результат = Неопределено;
		Если ДокументОбъект <> Неопределено Тогда
			Результат = Тх_ТехникаСервер.ЗаполнитьПланРабот(ДокументОбъект, ПараметрыЗаполнения());
			Если Результат.КоличествоСтрок > 0 Тогда
				ДокументОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		Если Результат = Неопределено Тогда
			Результат = Новый Структура("КоличествоСтрок", 0);
		КонецЕсли;

		Возврат СводкаКлиенту(Результат);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			// Ложное срабатывание Typo: "перезаполнить" - обычное слово в тексте сообщения.
			// BSLLS:Typo-off
			НСтр("ru = 'Тх_ФормированиеПланаРаботТехники: не удалось перезаполнить или записать документ плана'"),
			// BSLLS:Typo-on
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		Возврат СводкаКлиенту(Новый Структура("КоличествоСтрок", 0), , ТекстОшибки);
	КонецПопытки;

КонецФункции

&НаСервере
Функция СводкаКлиенту(Сводка, ДокументСсылка = Неопределено, ОшибкаЗаписи = "")

	// Сводка серверного модуля содержит СтрокиПлана
	// (ТаблицаЗначений) - она не сериализуется
	// между клиентом и сервером (XDTO); клиенту передаются
	// только скалярные итоги и ссылка документа.
	Результат = Новый Структура;
	Результат.Вставить("КоличествоСтрок", Сводка.КоличествоСтрок);
	Результат.Вставить("ВсегоСмен", Сводка.ВсегоСмен);
	Результат.Вставить("ВсегоЧасов", Сводка.ВсегоЧасов);
	Результат.Вставить("ЗамещенныхСтрок", Сводка.ЗамещенныхСтрок);
	Результат.Вставить("ДефицитныхСтрок", Сводка.ДефицитныхСтрок);
	Результат.Вставить("ПланОтсутствует", Сводка.ПланОтсутствует);
	Если ДокументСсылка <> Неопределено Тогда
		Результат.Вставить("Документ", ДокументСсылка);
	КонецЕсли;
	Результат.Вставить("ОшибкаЗаписи", ОшибкаЗаписи);

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПараметрыЗаполнения()

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СценарийПланирования", СценарийПланирования);
	СтруктураПараметров.Вставить("Организация", Организация);
	СтруктураПараметров.Вставить("Подразделение", Подразделение);
	СтруктураПараметров.Вставить("ДатаНачала", ПериодС);
	СтруктураПараметров.Вставить("ДатаОкончания", ПериодПо);
	СтруктураПараметров.Вставить("ДнейПериода", ДнейПериода);
	СтруктураПараметров.Вставить("СменВдень", СменВдень);

	Возврат СтруктураПараметров;

КонецФункции
#КонецОбласти

// Общий модуль «Тх_Тесты» - серверные модульные тесты расширения
// «ПланированиеТехникиАПК» (design §11, задача A11).
//
// Упрощённый xUnit-паттерн: 20 экспортных функций Тест*(), вызываемых
// обработкой-раннером Тх_РаннерТестов (кнопка формы, COM или /Execute).
// Каждый тест:
//  - создаёт собственные данные (уникальные имена через Новый
//    УникальныйИдентификатор - конфликты повторных прогонов исключены);
//  - выполняет проверки через Проверить (провал - Сообщить с префиксом
//    имени теста и фиксация в контексте теста);
//  - очищает данные за собой в finally-стиле: очистка выполняется и при
//    успешном завершении, и при исключении;
//  - возвращает Булево: Истина - все проверки пройдены (или SKIP).
//
// Синтетика потребности (тесты пересчёта дефицита). Записи в регистры
// накопления годового плана АПК (Апк*РаботыПоГодовомуПлану) расширением
// невозможны, поэтому:
//  - тесты формул пересчёта доступности через замещение моделей
//    (ТестДоступноСменЧерезЗамещение, ТестДоступноСменЗамещениеНеЗадан,
//    ТестДефицитМаксНуля) проверяют контракт TD-004 на уровне
//    сценария замещения: реальные КоэффициентЗамещения/ЧислоДнейПериода
//    + таблицы значений,
//    моделирующие строки потребности и доступности; формула сопоставления
//    продублирована зеркалом ДоступноСменКонтракт (проверка контракта
//    TD-004 - приватная Тх_ТехникаСервер.ДоступноСменСтроки не
//    экспортируется);
//  - сквозные тесты (ТестНеПринятыеТСИсключены,
//    ТестПланТехресурсовОтсутствует_..., ТестДетерминированность...)
//    идут по реальным экспортным функциям Тх_ТехникаСервер
//    (ЗапросДоступности / РассчитатьДефицит); тесты, которым нужна
//    потребность годового плана, помечены «зависит от данных ИБ» и при
//    пустой потребности возвращают Истина с сообщением SKIP.
//
// Модуль серверный, НЕ привилегированный: тесты выполняются под правами
// запустившего и работают только с собственными данными расширения.

#Область Инфраструктура

// Создаёт контекст теста: имя + массив провалов.
//
// Параметры:
//   ИмяТеста - Строка - имя тестовой функции (префикс сообщений).
//
// Возвращаемое значение:
//   Структура - свойства: Имя (Строка), Провалы (Массив).
//
Функция НовыйКонтекстТеста(ИмяТеста)

	Возврат Новый Структура("Имя, Провалы", ИмяТеста, Новый Массив);

КонецФункции

// Фиксирует проверку теста: провал заносится в контекст, выводится
// сообщение с префиксом имени теста.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста (НовыйКонтекстТеста);
//   ИмяПроверки    - Строка - краткое имя проверки;
//   Условие        - Булево - условие успешности проверки;
//   Детали         - Строка - детали провала (фактические значения).
//
Процедура Проверить(СтруктураТеста, ИмяПроверки, Условие, Детали = "")

	Если НЕ Условие Тогда
		СтруктураТеста.Провалы.Добавить(ИмяПроверки);
		Текст = СтрШаблон(НСтр("ru = '[%1] ПРОВАЛ: %2'"),
			СтруктураТеста.Имя, ИмяПроверки);
		Если Детали <> "" Тогда
			Текст = Текст + " (" + Детали + ")";
		КонецЕсли;
		СообщитьТекстом(Текст);
	КонецЕсли;

КонецПроцедуры

// Возвращает итог теста: Истина - провалов нет.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста.
//
// Возвращаемое значение:
//   Булево - результат теста.
//
Функция РезультатТеста(СтруктураТеста)

	Возврат СтруктураТеста.Провалы.Количество() = 0;

КонецФункции

// Выводит сообщение SKIP: тест пропущен (нет данных ИБ), считается пройденным.
//
// Параметры:
//   СтруктураТеста - Структура - контекст теста;
//   Причина        - Строка - причина пропуска.
//
Процедура СообщитьПропуск(СтруктураТеста, Причина)

	СообщитьТекстом(СтрШаблон(НСтр("ru = '[%1] SKIP: %2'"),
		СтруктураТеста.Имя, Причина));

КонецПроцедуры

// Выводит немодальное сообщение пользователю.
//
// Параметры:
//   Текст - Строка - текст сообщения.
//
Процедура СообщитьТекстом(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

// Возвращает псевдослучайное уникальное имя (генератор, устойчивый
// к повторным прогонам тестов).
//
// Возвращаемое значение:
//   Строка - строковое представление нового уникального идентификатора.
//
Функция УникальноеИмя()

	Возврат Строка(Новый УникальныйИдентификатор());

КонецФункции

// Ищет первый существующий элемент справочника АПК (тесты сначала ищут
// готовые ссылки, новые создают только при необходимости).
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника (например, "АпкМоделиСХТехники").
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка первого элемента;
//   Неопределено - элементов нет или каталог недоступен.
//
Функция НайтиПервыйЭлемент(ИмяСправочника)

	Результат = Неопределено;


	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ НЕ Спр.ПометкаУдаления";

	Попытка
		Выборка = Тх_ТехникаСервер.ВыполнитьЗапросАПК(ТекстЗапроса).Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Создаёт новый элемент справочника с уникальным наименованием
// (созданное тесты удаляют за собой).
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника;
//   Поля - Структура, Неопределено - значения реквизитов
//          (например, МощностьДвигателя).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка созданного элемента;
//   Неопределено - создать не удалось (обязательные реквизиты, отсутствие каталога).
//
Функция СоздатьЭлемент(ИмяСправочника, Поля = Неопределено)

	Результат = Неопределено;

	Попытка
		Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
		Объект.Наименование = УникальноеИмя();
		Если Поля <> Неопределено Тогда
			Для Каждого КлючЗначение Из Поля Цикл
				Объект[КлючЗначение.Ключ] = КлючЗначение.Значение;
			КонецЦикла;
		КонецЕсли;
		Объект.Записать();
		Результат = Объект.Ссылка;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Создаёт новую модель техники каталога вида техники (уникальное имя,
// опционально - мощность двигателя).
//
// Параметры:
//   ВидТехники - ПеречислениеСсылка.Тх_ВидыТехники - вид техники;
//   Мощность   - Число, Неопределено - мощность двигателя (Неопределено/0 -
//                модель «без мощности»).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - ссылка созданной модели.
//
Функция СоздатьМодель(ВидТехники, Мощность = Неопределено)

	ИмяСправочника = Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники);
	Если ИмяСправочника = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = Неопределено;
	Если Мощность <> Неопределено Тогда
		Поля = Новый Структура("МощностьДвигателя", Мощность);
	КонецЕсли;

	Возврат СоздатьЭлемент(ИмяСправочника, Поля);

КонецФункции

// Удаляет созданный тестом элемент справочника (существующие данные
// тесты не трогают, поэтому удаляются только созданные ссылки).
//
// Параметры:
//   Ссылка - СправочникСсылка, ДокументСсылка, Неопределено -
//            ссылка на удаление (владельцем данных не является).
//
Процедура УдалитьСсылку(Ссылка)

	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.Удалить();
		КонецЕсли;
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры


#КонецОбласти

#Область Тесты_ДатыИФункции

// Тест ЧислоДнейПериода: календарные дни периода, границы включены
// (FAQ Q1, FR-001): 01.03..10.03 = 10, один день = 1, пустые даты = 0.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены.
//
Функция ТестЧислоДнейПериода() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЧислоДнейПериода");

	Попытка
		Проверить(Контекст, НСтр("ru = '01.03..10.03 = 10 дней (границы включены)'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10)) = 10);

		Проверить(Контекст, НСтр("ru = 'один день = 1'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 5), Дата(2025, 3, 5)) = 1);

		Проверить(Контекст, НСтр("ru = 'пустые даты = 0'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(1, 1, 1), Дата(1, 1, 1)) = 0);

		Проверить(Контекст, НСтр("ru = 'интервал после окончания = 0 (не отрицательный)'"),
			Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 10), Дата(2025, 3, 1)) = 0);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции





#КонецОбласти


#Область Тесты_ПересчетДефицита

// Возвращает таблицу значений, моделирующую строки потребности (формат
// колонок запроса Тх_ТехникаСервер.ЗапросПотребности).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: СценарийПланирования, Организация, Подразделение,
//     ПериодНачала, ПериодОкончания, ВидРаботы, МодельТехники, ВидТехники,
//     ПотребностьСмен.
//
Функция НоваяТаблицаПотребности()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СценарийПланирования");
	Таблица.Колонки.Добавить("Организация");
	Таблица.Колонки.Добавить("Подразделение");
	Таблица.Колонки.Добавить("ПериодНачала", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ПериодОкончания", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ВидРаботы");
	Таблица.Колонки.Добавить("МодельТехники");
	Таблица.Колонки.Добавить("ВидТехники");
	Таблица.Колонки.Добавить("ПотребностьСмен", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

// Возвращает таблицу значений, моделирующую строки доступности (формат
// колонок запроса Тх_ТехникаСервер.ЗапросДоступности).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: СценарийПланирования, Подразделение,
//     МодельТехники, ВидТехники, ЕдиницДоступно.
//
Функция НоваяТаблицаДоступности()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СценарийПланирования");
	Таблица.Колонки.Добавить("Подразделение");
	Таблица.Колонки.Добавить("МодельТехники");
	Таблица.Колонки.Добавить("ВидТехники");
	Таблица.Колонки.Добавить("ЕдиницДоступно", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

// ПРОВЕРКА КОНТРАКТА TD-004: зеркало приватной функции
// Тх_ТехникаСервер.ДоступноСменСтроки (не экспортируется намеренно).
// Повторяет её формулу сопоставления (design §4.7, шаги 4-5; D-007, FR-011),
// реальный коэффициент замещения берёт через
// Тх_ТехникаСервер.КоэффициентЗамещения (T6).
// При изменении формулы в Тх_ТехникаСервер зеркало должно быть актуализировано.
//
// Параметры:
//   СтрПотребности    - СтрокаТаблицыЗначений - строка потребности;
//   СтрокиДоступности - ТаблицаЗначений - строки доступности подразделения;
//   Дней              - Число - календарных дней интервала строки;
//   СменВДень         - Число - смен в день (FAQ Q1).
//
// Возвращаемое значение:
//   Структура - свойства: Доступно (Число), КоэффициентНеЗадан (Булево).
//
Функция ДоступноСменКонтракт(СтрПотребности, СтрокиДоступности, Дней, СменВДень)

	Доступно = 0;
	КоэффициентНеЗадан = Ложь;

	Если СтрПотребности.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт Тогда
		// Модель в модель, без пересчёта через K (D-007, FAQ Q4).
		Для Каждого СтрДост Из СтрокиДоступности Цикл
			Если СтрДост.ВидТехники = СтрПотребности.ВидТехники
				И СтрДост.МодельТехники = СтрПотребности.МодельТехники Тогда
				Доступно = Доступно + СтрДост.ЕдиницДоступно * Дней * СменВДень;
			КонецЕсли;
		КонецЦикла;
	Иначе
		// СХТехника: эквивалент аналога в сменах базовой модели (TD-004).
		Для Каждого СтрДост Из СтрокиДоступности Цикл
			Если СтрДост.ВидТехники <> СтрПотребности.ВидТехники Тогда
				Продолжить;
			КонецЕсли;

			СменМодели = СтрДост.ЕдиницДоступно * Дней * СменВДень;

			Если СтрДост.МодельТехники = СтрПотребности.МодельТехники Тогда
				Доступно = Доступно + СменМодели;
			Иначе
				// T6: модельный коэффициент замещения (FR-004, design 6.4).
				К = Тх_ТехникаСервер.КоэффициентЗамещения(
					СтрПотребности.МодельТехники, СтрДост.МодельТехники);
				Если К = Неопределено Тогда
					// Реквизитов замещения нет - пометка вместо молчаливого 1,00 (FR-011).
					КоэффициентНеЗадан = Истина;
				Иначе
					// TD-004: эквивалент замены в сменах оригинала = смены_замены / К.
					Доступно = Доступно + СменМодели / К;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Доступно, КоэффициентНеЗадан", Доступно, КоэффициентНеЗадан);

КонецФункции

// ПРОВЕРКА КОНТРАКТА FR-012: дефицит неотрицателен (зеркало формулы
// функции Тх_ТехникаСервер.РассчитатьДефицит, округление 2 знака).
//
// Параметры:
//   ПотребностьСмен - Число - потребность в сменах;
//   ДоступноСмен    - Число - доступно смен.
//
// Возвращаемое значение:
//   Число - дефицит (не меньше нуля).
//
Функция ДефицитКонтракт(ПотребностьСмен, ДоступноСмен)

	Возврат Макс(0, Окр(ПотребностьСмен - ДоступноСмен, 2));

КонецФункции



// Тест НеПринятыеТСИсключены (FR-007): реальный путь через
// Тх_ТехникаСервер.ЗапросДоступности - документ плана техресурсов с двумя
// строками одной модели (принятая и не принятая): в доступность попадает
// только принятая (ЕдиницДоступно = 2, а не 7).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестНеПринятыеТСИсключены() Экспорт

	Контекст = НовыйКонтекстТеста("ТестНеПринятыеТСИсключены");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Сценарий = Неопределено;
	Модель = Неопределено;
	Организация = Неопределено;
	Подразделение = Неопределено;
	ТС1 = Неопределено;
	ТС2 = Неопределено;
	ДокументСсылка = Неопределено;
	СценарийСоздан = Ложь;
	МодельСоздана = Ложь;
	ТССозданы = Ложь;
	Пропуск = "";

	Попытка
		Сценарий = НайтиПервыйЭлемент("АпкСценарииПланирования");
		Если Сценарий = Неопределено Тогда
			Сценарий = СоздатьЭлемент("АпкСценарииПланирования");
			СценарийСоздан = Сценарий <> Неопределено;
		КонецЕсли;
		Модель = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники));
		Если Модель = Неопределено Тогда
			Модель = СоздатьМодель(ВидТехники);
			МодельСоздана = Модель <> Неопределено;
		КонецЕсли;

		Если Сценарий = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось подготовить тестовые данные (справочники АПК)'");
		Иначе
			// Шапка документа: организация/подразделение обязательны
			// (ОбработкаПроведения отклоняет пустую шапку), дата документа
			// не может быть пустой - заполняем текущей датой сеанса.
			Организация = НайтиПервыйЭлемент("Организации");
			Подразделение = НайтиПервыйЭлемент("СтруктураПредприятия");

			// Уникальные ТС: контроль дублей ТС в документе; у справочника
			// ТранспортныеСредства Код (= «госномер») уникален и не
			// автонумеруется - задаём GUID вручную.
			ТС1 = СоздатьЭлемент("ТранспортныеСредства",
				Новый Структура("Код", УникальноеИмя()));
			ТС2 = СоздатьЭлемент("ТранспортныеСредства",
				Новый Структура("Код", УникальноеИмя()));
			ТССозданы = ТС1 <> Неопределено И ТС2 <> Неопределено;

			Если Организация = Неопределено ИЛИ Подразделение = Неопределено
				ИЛИ НЕ ТССозданы Тогда
				Пропуск = НСтр("ru = 'не удалось подготовить шапку документа (организация/подразделение/ТС)'");
			Иначе
				// Синтетический план: 2 принятые + 5 НЕ принятых единиц одной модели.
				Документ = Документы.Тх_ПланТехническихРесурсов.СоздатьДокумент();
				Документ.Дата = ТекущаяДатаСеанса();
				Документ.Организация = Организация;
				Документ.Подразделение = Подразделение;
				Документ.СценарийПланирования = Сценарий;

				СтрокаПринятая = Документ.ОсновнаяТехника.Добавить();
				СтрокаПринятая.ТранспортноеСредство = ТС1;
				СтрокаПринятая.МодельТехники = Модель;
				СтрокаПринятая.Принят = Истина;
				СтрокаПринятая.Количество = 2;

				СтрокаНеПринятая = Документ.ОсновнаяТехника.Добавить();
				СтрокаНеПринятая.ТранспортноеСредство = ТС2;
				СтрокаНеПринятая.МодельТехники = Модель;
				СтрокаНеПринятая.Принят = Ложь;
				СтрокаНеПринятая.Количество = 5;

				Документ.Записать(РежимЗаписиДокумента.Проведение);
				ДокументСсылка = Документ.Ссылка;

				ПараметрыЗапроса = Новый Структура(
					"СценарийПланирования, Организация, Подразделение",
					Сценарий, Неопределено, Неопределено);
				РезультатЗапроса = Тх_ТехникаСервер.ЗапросДоступности(ПараметрыЗапроса);

				ЕдиницДоступно = 0;
				СтрокаНайдена = Ложь;
				Выборка = РезультатЗапроса.Выбрать();
				Пока Выборка.Следующий() Цикл
					Если Выборка.МодельТехники = Модель
						И Выборка.ВидТехники = ВидТехники Тогда
						СтрокаНайдена = Истина;
						ЕдиницДоступно = Выборка.ЕдиницДоступно;
					КонецЕсли;
				КонецЦикла;

				Проверить(Контекст, НСтр("ru = 'строка доступности по модели найдена'"),
					СтрокаНайдена);
				Проверить(Контекст, НСтр("ru = 'в доступности только принятые ТС (2, а не 7)'"),
					ЕдиницДоступно = 2,
					Строка(ЕдиницДоступно));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьДокумент(ДокументСсылка);
	Если СценарийСоздан Тогда
		УдалитьСсылку(Сценарий);
	КонецЕсли;
	Если МодельСоздана Тогда
		УдалитьСсылку(Модель);
	КонецЕсли;
	Если ТССозданы Тогда
		УдалитьСсылку(ТС1);
		УдалитьСсылку(ТС2);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Удаляет созданный тестом документ плана техресурсов (с отменой проведения).
//
// Параметры:
//   ДокументСсылка - ДокументСсылка.Тх_ПланТехническихРесурсов, Неопределено -
//                    ссылка на документ теста.
//
Процедура УдалитьДокумент(ДокументСсылка)

	Если ДокументСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Объект = ДокументСсылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Объект.Удалить();
		КонецЕсли;
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Тест ДефицитМаксНуля (FR-012): доступность больше потребности -
// НехватаетСмен = 0, не отрицательное (контракт формулы РассчитатьДефицит).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестДефицитМаксНуля() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДефицитМаксНуля");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	Пропуск = "";

	Попытка
		Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Модель = СоздатьМодель(ВидТехники);

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось создать тестовые данные (справочники АПК)'");
		Иначе
			// Потребность 10 смен, доступность своей модели 2 ед. x 10 дней = 20 смен.
			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.ВидРаботы = Работа;
			СтрПотребности.МодельТехники = Модель;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрДоступности = Доступность.Добавить();
			СтрДоступности.МодельТехники = Модель;
			СтрДоступности.ВидТехники = ВидТехники;
			СтрДоступности.ЕдиницДоступно = 2;

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			РезультатСопоставления = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);

			Проверить(Контекст, НСтр("ru = 'доступность своей модели = 2 x 10 x 1 = 20 смен'"),
				РезультатСопоставления.Доступно = 20,
				Строка(РезультатСопоставления.Доступно));

			Дефицит = ДефицитКонтракт(СтрПотребности.ПотребностьСмен,
				РезультатСопоставления.Доступно);
			Проверить(Контекст, НСтр("ru = 'дефицит = 0 при доступности больше потребности'"),
				Дефицит = 0,
				Строка(Дефицит));
			Проверить(Контекст, НСтр("ru = 'дефицит неотрицательный (FR-012)'"),
				Дефицит >= 0);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(Работа);
	УдалитьСсылку(Модель);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции


// Тест ПланТехресурсовОтсутствует_ПометкаНеНоль (NFR-005, рек. B).
// ЗАВИСИТ ОТ ДАННЫХ ИБ: сквозной расчёт по реальному сценарию годового
// плана; строки подразделений без плана техресурсов получают
// ПланТехресурсовОтсутствует = Истина и НехватаетСмен = ПотребностьСмен
// (вся потребность), НЕ 0. При пустой потребности или отсутствии
// подразделений без плана - SKIP.
//
// Возвращаемое значение:
//   Булево - Истина, если проверки пройдены (или SKIP).
//
Функция ТестПланТехресурсовОтсутствует_ПометкаНеНоль() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПланТехресурсовОтсутствует_ПометкаНеНоль");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			// Снимок строк сценария - восстановить после теста (чужие расчёты не портим).
			СнимокРегистра = СнимокДефицита(Сценарий);

			ПараметрыРасчета = Новый Структура(
				"СценарийПланирования, Организация, Подразделение, СуффиксОбъема",
				Сценарий, Неопределено, Неопределено, "_Вер");
			ЗаписаноСтрок = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);

			Проверить(Контекст, НСтр("ru = 'расчёт по сценарию записал строки'"),
				ЗаписаноСтрок > 0);

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	Д.ПотребностьСмен КАК ПотребностьСмен,
			|	Д.НехватаетСмен КАК НехватаетСмен
			|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
			|ГДЕ Д.СценарийПланирования = &Сценарий
			|	И Д.ПланТехресурсовОтсутствует";
			Запрос.УстановитьПараметр("Сценарий", Сценарий);

			ПомеченныеСтроки = 0;
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ПомеченныеСтроки = ПомеченныеСтроки + 1;
				Проверить(Контекст, НСтр("ru = 'помеченная строка: дефицит = вся потребность, не 0'"),
					Выборка.НехватаетСмен = Выборка.ПотребностьСмен
						И Выборка.ПотребностьСмен > 0,
					СтрШаблон(НСтр("ru = 'НехватаетСмен = %1, ПотребностьСмен = %2'"),
						Выборка.НехватаетСмен, Выборка.ПотребностьСмен));
			КонецЦикла;

			Если ПомеченныеСтроки = 0 Тогда
				Пропуск = НСтр("ru = 'у всех подразделений сценария есть план техресурсов - помеченных строк нет'");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ДетерминированностьПовторногоРасчета (NFR-005).
// ЗАВИСИТ ОТ ДАННЫХ ИБ: два расчёта с теми же параметрами - число строк
// и значения ресурсов идентичны (сравнение выгрузок регистра).
// При пустой потребности - SKIP.
//
// Возвращаемое значение:
//   Булево - Истина, если проверки пройдены (или SKIP).
//
Функция ТестДетерминированностьПовторногоРасчета() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДетерминированностьПовторногоРасчета");
	Сценарий = Неопределено;
	СнимокРегистра = Неопределено;
	Пропуск = "";

	Попытка
		Сценарий = СценарийСПотребностью();
		Если Сценарий = Неопределено Тогда
			Пропуск = НСтр("ru = 'в ИБ нет данных годового плана АПК (потребность пуста)'");
		Иначе
			СнимокРегистра = СнимокДефицита(Сценарий);

			ПараметрыРасчета = Новый Структура(
				"СценарийПланирования, Организация, Подразделение, СуффиксОбъема",
				Сценарий, Неопределено, Неопределено, "_Вер");

			ЗаписаноПервый = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);
			ТаблицаПервая = ВыгрузкаДефицита(Сценарий);

			ЗаписаноВторой = Тх_ТехникаСервер.РассчитатьДефицит(ПараметрыРасчета);
			ТаблицаВторая = ВыгрузкаДефицита(Сценарий);

			Проверить(Контекст, НСтр("ru = 'число записанных строк одинаково'"),
				ЗаписаноПервый = ЗаписаноВторой,
				СтрШаблон(НСтр("ru = '%1 и %2'"), ЗаписаноПервый, ЗаписаноВторой));
			Проверить(Контекст, НСтр("ru = 'число строк регистра одинаково'"),
				ТаблицаПервая.Количество() = ТаблицаВторая.Количество());
			Проверить(Контекст, НСтр("ru = 'значения всех строк идентичны'"),
				ТаблицыИдентичны(ТаблицаПервая, ТаблицаВторая));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если Сценарий <> Неопределено И СнимокРегистра <> Неопределено Тогда
		ВосстановитьДефицит(Сценарий, СнимокРегистра);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест ВалидацииGenericТипов (design §4.1, п. 2, TD-001): ссылка
// «правильного» справочника проходит ВалидироватьТипАПК, другого - нет,
// пустая ссылка - Ложь.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестВалидацииGenericТипов() Экспорт

	Контекст = НовыйКонтекстТеста("ТестВалидацииGenericТипов");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	Работа = Неопределено;
	Модель = Неопределено;
	РаботаСоздана = Ложь;
	МодельСоздана = Ложь;
	Пропуск = "";

	Попытка
		Работа = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
		Если Работа = Неопределено Тогда
			Работа = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаРабот());
			РаботаСоздана = Работа <> Неопределено;
		КонецЕсли;
		Модель = НайтиПервыйЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники));
		Если Модель = Неопределено Тогда
			Модель = СоздатьМодель(ВидТехники);
			МодельСоздана = Модель <> Неопределено;
		КонецЕсли;

		Если Работа = Неопределено ИЛИ Модель = Неопределено Тогда
			Пропуск = НСтр("ru = 'не удалось подготовить тестовые данные (справочники АПК)'");
		Иначе
			Проверить(Контекст, НСтр("ru = 'ссылка правильного справочника = Истина'"),
				Тх_ТехникаСервер.ВалидироватьТипАПК(Работа,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));

			Проверить(Контекст, НСтр("ru = 'ссылка другого справочника = Ложь (модель как работа)'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Модель,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));

			Проверить(Контекст, НСтр("ru = 'ссылка другого справочника = Ложь (работа как модель)'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(Работа,
					Тх_ТехникаСервер.ИмяСправочникаМоделей(ВидТехники)));

			ПустаяРабота = Справочники[Тх_ТехникаСервер.ИмяСправочникаРабот()].ПустаяСсылка();
			Проверить(Контекст, НСтр("ru = 'пустая ссылка = Ложь'"),
				НЕ Тх_ТехникаСервер.ВалидироватьТипАПК(ПустаяРабота,
					Тх_ТехникаСервер.ИмяСправочникаРабот()));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Если РаботаСоздана Тогда
		УдалитьСсылку(Работа);
	КонецЕсли;
	Если МодельСоздана Тогда
		УдалитьСсылку(Модель);
	КонецЕсли;

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Возвращает первый сценарий планирования, по которому в регистрах
// годового плана АПК есть потребность (рантайм-запрос, design §4.1).
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - сценарий с потребностью;
//   Неопределено - потребности нет или модуль АПК недоступен.
//
Функция СценарийСПотребностью()

	Результат = Неопределено;

	// Имена таблиц годового плана - динамические (runtime, design 4.1/TD-001).
	// 8.5: таблицы записей (виртуальная таблица оборотов требует измерения
	// в выборке, для проверки существования потребности она не нужна).
	ИмяРегистраМехРабот = "АпкМеханизированныеРаботыПоГодовомуПлану";
	ИмяРегистраТранРабот = "АпкТранспортныеРаботыПоГодовомуПлану";

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.СценарийПланирования КАК СценарийПланирования
	|ИЗ
	|	(
	|		ВЫБРАТЬ
	|			М.СценарийПланирования КАК СценарийПланирования
	|		ИЗ РегистрНакопления." + ИмяРегистраМехРабот + " КАК М
	|		ГДЕ М.СценарийПланирования <> ЗНАЧЕНИЕ(Справочник.АпкСценарииПланирования.ПустаяСсылка)
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Тран.СценарийПланирования
	|		ИЗ РегистрНакопления." + ИмяРегистраТранРабот + " КАК Тран
	|		ГДЕ Тран.СценарийПланирования <> ЗНАЧЕНИЕ(Справочник.АпкСценарииПланирования.ПустаяСсылка)
	|	) КАК Т";

	Попытка
		Выборка = Тх_ТехникаСервер.ВыполнитьЗапросАПК(ТекстЗапроса).Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.СценарийПланирования;
		КонецЕсли;
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает снимок строк регистра Тх_ДефицитТехники по сценарию
// (для восстановления после сквозных тестов).
//
// Параметры:
//   Сценарий - СправочникСсылка - сценарий планирования.
//
// Возвращаемое значение:
//   ТаблицаЗначений - выгрузка набора записей сценария.
//
Функция СнимокДефицита(Сценарий)

	НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СценарийПланирования.Установить(Сценарий);
	НаборЗаписей.Прочитать();

	Возврат НаборЗаписей.Выгрузить();

КонецФункции

// Восстанавливает строки регистра Тх_ДефицитТехники по сценарию из снимка.
//
// Параметры:
//   Сценарий  - СправочникСсылка - сценарий планирования;
//   Снимок    - ТаблицаЗначений - выгрузка СнимокДефицита.
//
Процедура ВосстановитьДефицит(Сценарий, Снимок)

	Попытка
		НаборЗаписей = РегистрыСведений.Тх_ДефицитТехники.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СценарийПланирования.Установить(Сценарий);
		НаборЗаписей.Загрузить(Снимок);
		НаборЗаписей.Записать(Истина);
	Исключение
		// Очистка без прерывания теста: остаток уберёт следующий прогон
		// (имена тестовых объектов содержат GUID).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Тх_Тесты: очистка тестовых данных'"),
			УровеньЖурналаРегистрации.Информация,,, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Возвращает выгрузку строк регистра Тх_ДефицитТехники по сценарию,
// упорядоченную по измерениям (для сравнения повторных расчётов).
//
// Параметры:
//   Сценарий - СправочникСсылка - сценарий планирования.
//
// Возвращаемое значение:
//   ТаблицаЗначений - все измерения и ресурсы регистра.
//
Функция ВыгрузкаДефицита(Сценарий)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Д.Организация КАК Организация,
	|	Д.Подразделение КАК Подразделение,
	|	Д.ПериодНачала КАК ПериодНачала,
	|	Д.ПериодОкончания КАК ПериодОкончания,
	|	Д.ВидРаботы КАК ВидРаботы,
	|	Д.МодельТехники КАК МодельТехники,
	|	Д.ВидТехники КАК ВидТехники,
	|	Д.ПотребностьСмен КАК ПотребностьСмен,
	|	Д.ДоступноСмен КАК ДоступноСмен,
	|	Д.НехватаетСмен КАК НехватаетСмен,
	|	Д.ДнейПериода КАК ДнейПериода,
	|	Д.СменВДень КАК СменВДень,
	|	Д.КоэффициентНеЗадан КАК КоэффициентНеЗадан,
	|	Д.ПланТехресурсовОтсутствует КАК ПланТехресурсовОтсутствует
	|ИЗ РегистрСведений.Тх_ДефицитТехники КАК Д
	|ГДЕ Д.СценарийПланирования = &Сценарий
	|УПОРЯДОЧИТЬ ПО
	|	Д.Организация,
	|	Д.Подразделение,
	|	Д.ПериодНачала,
	|	Д.ПериодОкончания,
	|	Д.ВидРаботы,
	|	Д.МодельТехники,
	|	Д.ВидТехники";
	Запрос.УстановитьПараметр("Сценарий", Сценарий);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сравнивает две выгрузки регистра построчно и по колонкам.
//
// Параметры:
//   ТаблицаПервая  - ТаблицаЗначений - первая выгрузка;
//   ТаблицаВторая  - ТаблицаЗначений - вторая выгрузка.
//
// Возвращаемое значение:
//   Булево - Истина, если количество строк и все значения совпадают.
//
Функция ТаблицыИдентичны(ТаблицаПервая, ТаблицаВторая)

	Если ТаблицаПервая.Количество() <> ТаблицаВторая.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСтроки = 0 По ТаблицаПервая.Количество() - 1 Цикл
		Для Каждого Колонка Из ТаблицаПервая.Колонки Цикл
			Если ТаблицаПервая[НомерСтроки][Колонка.Имя]
				<> ТаблицаВторая[НомерСтроки][Колонка.Имя] Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти


// Тест доступности через замещение моделей (T6, FR-004/TD-004): потребность
// в оригинале (ширина 2), доступность - замена (ширина 3, К = 1.5):
// 1 единица на 10 дней по 1 смене = 10 смен замены -> эквивалент = 10 / 1.5.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестДоступноСменЧерезЗамещение() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступноСменЧерезЗамещение");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	МодельОригинал = Неопределено;
	МодельЗамены = Неопределено;
	Пропуск = "";

	Попытка
		МодельОригинал = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 2));
		МодельЗамены = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 3));

		Если МодельОригинал = Неопределено ИЛИ МодельЗамены = Неопределено Тогда
			Пропуск = НСтр("ru = 'нет каталогов моделей АПК'");
		Иначе
			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.ВидРаботы = Неопределено;
			СтрПотребности.МодельТехники = МодельОригинал;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрДоступности = Доступность.Добавить();
			СтрДоступности.МодельТехники = МодельЗамены;
			СтрДоступности.ВидТехники = ВидТехники;
			СтрДоступности.ЕдиницДоступно = 1;

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			РезультатСопоставления = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);

			Ожидаемо = 10 / 1.5;
			Отклонение = Макс(РезультатСопоставления.Доступно - Ожидаемо,
				Ожидаемо - РезультатСопоставления.Доступно);
			Проверить(Контекст, НСтр("ru = 'доступность = смены_замены / К = 10 / 1,5'"),
				Отклонение < 0.0001, Строка(РезультатСопоставления.Доступно));
			Проверить(Контекст, НСтр("ru = 'коэффициент задан - пометки нет'"),
				НЕ РезультатСопоставления.КоэффициентНеЗадан);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельОригинал);
	УдалитьСсылку(МодельЗамены);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест пометки при незаданном замещении (T6, FR-011): у модели замены нет
// реквизитов замещения - модель исключается из пересчёта доступности,
// выставляется КоэффициентНеЗадан (НЕ молчаливый 1,00).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестДоступноСменЗамещениеНеЗадан() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступноСменЗамещениеНеЗадан");
	ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
	МодельОригинал = Неопределено;
	МодельПустая = Неопределено;
	Пропуск = "";

	Попытка
		МодельОригинал = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 2));
		МодельПустая = СоздатьЭлемент("АпкМоделиСХТехники");

		Если МодельОригинал = Неопределено ИЛИ МодельПустая = Неопределено Тогда
			Пропуск = НСтр("ru = 'нет каталогов моделей АПК'");
		Иначе
			Потребность = НоваяТаблицаПотребности();
			СтрПотребности = Потребность.Добавить();
			СтрПотребности.ПериодНачала = Дата(2025, 3, 1);
			СтрПотребности.ПериодОкончания = Дата(2025, 3, 10);
			СтрПотребности.ВидРаботы = Неопределено;
			СтрПотребности.МодельТехники = МодельОригинал;
			СтрПотребности.ВидТехники = ВидТехники;
			СтрПотребности.ПотребностьСмен = 10;

			Доступность = НоваяТаблицаДоступности();
			СтрДоступности = Доступность.Добавить();
			СтрДоступности.МодельТехники = МодельПустая;
			СтрДоступности.ВидТехники = ВидТехники;
			СтрДоступности.ЕдиницДоступно = 1;

			Дней = Тх_ТехникаСервер.ЧислоДнейПериода(Дата(2025, 3, 1), Дата(2025, 3, 10));
			РезультатСопоставления = ДоступноСменКонтракт(СтрПотребности, Доступность, Дней, 1);

			Проверить(Контекст, НСтр("ru = 'доступность = 0 (модель исключена)'"),
				РезультатСопоставления.Доступно = 0);
			Проверить(Контекст, НСтр("ru = 'пометка КоэффициентНеЗадан выставлена'"),
				РезультатСопоставления.КоэффициентНеЗадан);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельОригинал);
	УдалитьСсылку(МодельПустая);

	Если Пропуск <> "" Тогда
		СообщитьПропуск(Контекст, Пропуск);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

#Область Тесты_ПотребностьПоТехкартам

// Тест запроса потребности по техкартам (T7, FR-003.1-2, TD-005/TD-006)
// на данных годового плана АПК («зависит от данных ИБ», SKIP при их
// отсутствии). Кросс-чек: сумма смен ПотребностьПоТехкартам должна
// совпадать с суммой релиза-001 ЗапросПотребности по тем же отборам.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестПотребностьПоТехкартам_ДемоДанные() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПотребностьПоТехкартам_ДемоДанные");
	Сценарий = СценарийСПотребностью();

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Попытка
		Параметры = Новый Структура;
		Параметры.Вставить("СценарийПланирования", Сценарий);

		Потребность = Тх_ТехникаСервер.ПотребностьПоТехкартам(Параметры).Выгрузить();

		Проверить(Контекст, НСтр("ru = 'строки потребности найдены'"),
			Потребность.Количество() > 0, Строка(Потребность.Количество()));

		ВсегоСмен = 0;
		СтрокБезСмен = 0;
		Для Каждого Стр Из Потребность Цикл
			ВсегоСмен = ВсегоСмен + Стр.ПотребностьСмен;
			Если Стр.ПотребностьСмен <= 0 Тогда
				СтрокБезСмен = СтрокБезСмен + 1;
			КонецЕсли;
		КонецЦикла;
		Проверить(Контекст, НСтр("ru = 'все строки с положительными сменами'"),
			СтрокБезСмен = 0, Строка(СтрокБезСмен));

		// Кросс-чек с релизом-001: те же регистры, тот же сценарий, те же
		// окна (по умолчанию), тот же суффикс _Вер - суммы обязаны совпасть.
		Эталон = Тх_ТехникаСервер.ЗапросПотребности(Параметры).Выгрузить();
		ВсегоСменЭталон = 0;
		Для Каждого Стр Из Эталон Цикл
			ВсегоСменЭталон = ВсегоСменЭталон + Стр.ПотребностьСмен;
		КонецЦикла;
		Отклонение = Макс(ВсегоСмен - ВсегоСменЭталон, ВсегоСменЭталон - ВсегоСмен);
		Проверить(Контекст, НСтр("ru = 'сумма смен = сумма ЗапросПотребности (кросс-чек)'"),
			Отклонение < 0.0001,
			Строка(ВсегоСмен) + " / " + Строка(ВсегоСменЭталон));
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест фильтра потребности по «чужому» подразделению (T7, design 6.1):
// отбор В ИЕРАРХИИ по подразделению без данных должен возвращать пустой
// результат.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестПотребностьПоТехкартам_ЧужоеПодразделение() Экспорт

	Контекст = НовыйКонтекстТеста("ТестПотребностьПоТехкартам_ЧужоеПодразделение");
	Сценарий = СценарийСПотребностью();
	ЧужоеПодразделение = Неопределено;

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Попытка
		ЧужоеПодразделение = СоздатьЭлемент("СтруктураПредприятия");
		Если ЧужоеПодразделение = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'не удалось создать тестовое подразделение'"));
		Иначе
			Параметры = Новый Структура;
			Параметры.Вставить("СценарийПланирования", Сценарий);
			Параметры.Вставить("Подразделение", ЧужоеПодразделение);

			Потребность = Тх_ТехникаСервер.ПотребностьПоТехкартам(Параметры).Выгрузить();
			Проверить(Контекст, НСтр("ru = 'по чужому подразделению - пусто'"),
				Потребность.Количество() = 0, Строка(Потребность.Количество()));
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(ЧужоеПодразделение);

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_ДоступностьМоделей

// Тест карты доступных моделей по документу АпкПланТехническихРесурсов
// (T8, design 6.2): создаёт проведённый план распределения с тестовыми
// ТС (va_prep_data, модель «Тх_Тест Базовая») и проверяет карту моделей
// подразделения; по «чужому» подразделению - флаг отсутствия плана.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестДоступныеМодели_ПланРаспределения() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступныеМодели_ПланРаспределения");
	Сценарий = СценарийСПотребностью();

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст,
			НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Подразделение = Неопределено;
	ЧужоеПодразделение = Неопределено;
	ДокСсылка = Неопределено;

	Попытка
		// Тестовые ТС(va_prep_data): коды ТХТС*, модель «Тх_Тест Базовая».
		ТС = Новый Массив;
		ВыборкаТС = Тх_ТехникаСервер.ВыполнитьЗапросАПК(
			"ВЫБРАТЬ Спр.Ссылка КАК Ссылка
			|ИЗ Справочник.ТранспортныеСредства КАК Спр
			|ГДЕ Спр.Код ПОДОБНО &Шаблон И НЕ Спр.ПометкаУдаления",
			Новый Структура("Шаблон", "ТХТС%")).Выбрать();
		Пока ВыборкаТС.Следующий() Цикл
			ТС.Добавить(ВыборкаТС.Ссылка);
		КонецЦикла;

		Если ТС.Количество() = 0 Тогда
			СообщитьПропуск(Контекст,
				НСтр("ru = 'нет тестовых ТС (va_prep_data)'"));
		Иначе
			Организация = Неопределено;
			ВыборкаОрг = Тх_ТехникаСервер.ВыполнитьЗапросАПК(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Спр.Ссылка КАК Ссылка
				|ИЗ Справочник.Организации КАК Спр
				|ГДЕ НЕ Спр.ПометкаУдаления").Выбрать();
			Если ВыборкаОрг.Следующий() Тогда
				Организация = ВыборкаОрг.Ссылка;
			КонецЕсли;

			Подразделение = СоздатьЭлемент("СтруктураПредприятия");
			ЧужоеПодразделение = СоздатьЭлемент("СтруктураПредприятия");

			Если Подразделение = Неопределено Или ЧужоеПодразделение = Неопределено Тогда
				СообщитьПропуск(Контекст,
					НСтр("ru = 'не удалось создать тестовые подразделения'"));
			Иначе
				// План распределения: достаточно ТЧ Подразделения и Техника.
				ДокОбъект = Документы.АпкПланТехническихРесурсов.СоздатьДокумент();
				ДокОбъект.Дата = ТекущаяДатаСеанса();
				ДокОбъект.Организация = Организация;
				ДокОбъект.СценарийПланирования = Сценарий;
				СтрПодр = ДокОбъект.Подразделения.Добавить();
				СтрПодр.Подразделение = Подразделение;
				Для Каждого ТССылка Из ТС Цикл
					СтрТС = ДокОбъект.Техника.Добавить();
					СтрТС.ТранспортноеСредство = ТССылка;
				КонецЦикла;
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				ДокСсылка = ДокОбъект.Ссылка;

				// Карта по своему подразделению.
				Параметры = Новый Структура;
				Параметры.Вставить("СценарийПланирования", Сценарий);
				Если Организация <> Неопределено Тогда
					Параметры.Вставить("Организация", Организация);
				КонецЕсли;
				Параметры.Вставить("Подразделение", Подразделение);

				Результат = Тх_ТехникаСервер.ДоступныеМоделиПодразделения(Параметры);
				Проверить(Контекст, НСтр("ru = 'план найден (флаг сброшен)'"),
					НЕ Результат.ПланОтсутствует);
				Проверить(Контекст, НСтр("ru = 'карта: одна модель (Тх_Тест Базовая)'"),
					Результат.Модели.Количество() = 1,
					Строка(Результат.Модели.Количество()));
				Если Результат.Модели.Количество() = 1 Тогда
					Стр = Результат.Модели[0];
					Проверить(Контекст, НСтр("ru = 'единиц = число тестовых ТС'"),
						Стр.ЕдиницДоступно = ТС.Количество(),
						Строка(Стр.ЕдиницДоступно) + " / " + Строка(ТС.Количество()));
					Проверить(Контекст, НСтр("ru = 'тип ТС = СХТехника (ТЧ Техника)'"),
						Стр.ТипТС = Перечисления.АпкТипыТС.СХТехника);
					МодельБазовая = Неопределено;
					ВыборкаМод = Тх_ТехникаСервер.ВыполнитьЗапросАПК(
						"ВЫБРАТЬ ПЕРВЫЕ 1 Спр.Ссылка КАК Ссылка
						|ИЗ Справочник.АпкМоделиСХТехники КАК Спр
						|ГДЕ Спр.Наименование = &Наименование И НЕ Спр.ПометкаУдаления",
						Новый Структура("Наименование", "Тх_Тест Базовая")).Выбрать();
					Если ВыборкаМод.Следующий() Тогда
						МодельБазовая = ВыборкаМод.Ссылка;
					КонецЕсли;
					Проверить(Контекст, НСтр("ru = 'модель = Тх_Тест Базовая'"),
						Стр.МодельТехники = МодельБазовая);
				КонецЕсли;

				// Чужое подразделение: план не найден, карта пуста.
				ПараметрыЧужие = Новый Структура;
				ПараметрыЧужие.Вставить("СценарийПланирования", Сценарий);
				ПараметрыЧужие.Вставить("Подразделение", ЧужоеПодразделение);
				РезультатЧужой = Тх_ТехникаСервер
					.ДоступныеМоделиПодразделения(ПараметрыЧужие);
				Проверить(Контекст, НСтр("ru = 'чужое подразделение: флаг плана'"),
					РезультатЧужой.ПланОтсутствует);
				Проверить(Контекст, НСтр("ru = 'чужое подразделение: карта пуста'"),
					РезультатЧужой.Модели.Количество() = 0,
					Строка(РезультатЧужой.Модели.Количество()));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	// Очистка: документ плана распределения и тестовые подразделения.
	УдалитьСсылку(ДокСсылка);
	УдалитьСсылку(Подразделение);
	УдалитьСсылку(ЧужоеПодразделение);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест флага «план распределения отсутствует» (T8, design 6.2):
// по свежесозданному сценарию нет ни одного документа плана - карта пуста,
// флаг установлен; контракт карты - три колонки.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестДоступныеМодели_БезПлана() Экспорт

	Контекст = НовыйКонтекстТеста("ТестДоступныеМодели_БезПлана");
	Сценарий = СоздатьЭлемент("АпкСценарииПланирования");

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст,
			НСтр("ru = 'не удалось создать тестовый сценарий'"));
	Иначе
		Попытка
			Параметры = Новый Структура("СценарийПланирования", Сценарий);
			Результат = Тх_ТехникаСервер.ДоступныеМоделиПодразделения(Параметры);
			Проверить(Контекст, НСтр("ru = 'флаг: план распределения отсутствует'"),
				Результат.ПланОтсутствует);
			Проверить(Контекст, НСтр("ru = 'карта моделей пуста'"),
				Результат.Модели.Количество() = 0,
				Строка(Результат.Модели.Количество()));
			Проверить(Контекст,
				НСтр("ru = 'колонки карты: МодельТехники/ТипТС/ЕдиницДоступно'"),
				Результат.Модели.Колонки.Количество() = 3,
				Строка(Результат.Модели.Колонки.Количество()));
		Исключение
			Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
				ОписаниеОшибки());
		КонецПопытки;

		УдалитьСсылку(Сценарий);
	КонецЕсли;

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_ЗаполнитьПланаРабот

// Тест заполнения документа плана работ на демо-данных годового плана АПК
// (T9, design 6.3): полный прогон ЗаполнитьПланРабот по сценарию с
// потребностью; инварианты строк не зависят от наличия планов распределения.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестЗаполнитьПланРабот_ДемоДанные() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЗаполнитьПланРабот_ДемоДанные");
	Сценарий = СценарийСПотребностью();

	Если Сценарий = Неопределено Тогда
		СообщитьПропуск(Контекст,
			НСтр("ru = 'нет данных годового плана АПК (техкарты)'"));
		Возврат РезультатТеста(Контекст);
	КонецЕсли;

	Попытка
		Параметры = Новый Структура;
		Параметры.Вставить("СценарийПланирования", Сценарий);
		Параметры.Вставить("ДнейПериода", 10);
		Параметры.Вставить("СменВдень", 1);

		// Документ только в памяти: запись в БД не выполняется.
		ДокументОбъект = Документы.Тх_ПланТехническихРесурсов.СоздатьДокумент();
		Результат = Тх_ТехникаСервер.ЗаполнитьПланРабот(ДокументОбъект, Параметры);

		Проверить(Контекст, НСтр("ru = 'строки потребности перенесены'"),
			Результат.КоличествоСтрок > 0, Строка(Результат.КоличествоСтрок));
		Проверить(Контекст, НСтр("ru = 'шапка: сценарий'"),
			ДокументОбъект.СценарийПланирования = Сценарий);
		Проверить(Контекст, НСтр("ru = 'строк в ТЧ = сводке'"),
			ДокументОбъект.ОсновнаяТехника.Количество()
				+ ДокументОбъект.Автотранспорт.Количество()
				= Результат.КоличествоСтрок,
			Строка(ДокументОбъект.ОсновнаяТехника.Количество())
				+ "+" + Строка(ДокументОбъект.Автотранспорт.Количество()));

		ИмяКаталогаСХ = Тх_ТехникаСервер.ИмяСправочникаМоделей(
			Перечисления.Тх_ВидыТехники.СХТехника);
		Для Каждого Стр Из ДокументОбъект.ОсновнаяТехника Цикл
			Проверить(Контекст, НСтр("ru = 'модель строки - каталог СХ-техники'"),
				Тх_ТехникаСервер.ВалидироватьТипАПК(Стр.МодельТехники, ИмяКаталогаСХ));
			Проверить(Контекст, НСтр("ru = 'сцепка строки валидна'"),
				Тх_ТехникаСервер.ВалидироватьСцепку(Стр.МодельТехники, Стр.Оборудование));
			Проверить(Контекст, НСтр("ru = 'Количество = округление вверх (смен/10)'"),
				Стр.Количество = Тх_ТехникаСервер.ОкруглитьВверх(Стр.ПотребностьСмен / 10),
				Строка(Стр.Количество) + " / " + Строка(Стр.ПотребностьСмен));
		КонецЦикла;

		ИмяКаталогаАвто = Тх_ТехникаСервер.ИмяСправочникаМоделей(
			Перечисления.Тх_ВидыТехники.Автотранспорт);
		Для Каждого Стр Из ДокументОбъект.Автотранспорт Цикл
			Проверить(Контекст, НСтр("ru = 'модель строки - каталог автотранспорта'"),
				Тх_ТехникаСервер.ВалидироватьТипАПК(Стр.МодельТехники, ИмяКаталогаАвто));
			Проверить(Контекст, НСтр("ru = 'сцепка строки валидна'"),
				Тх_ТехникаСервер.ВалидироватьСцепку(Стр.МодельТехники, Стр.Оборудование));
			Проверить(Контекст, НСтр("ru = 'Количество = округление вверх (смен/10)'"),
				Стр.Количество = Тх_ТехникаСервер.ОкруглитьВверх(Стр.ПотребностьСмен / 10),
				Строка(Стр.Количество) + " / " + Строка(Стр.ПотребностьСмен));
		КонецЦикла;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест сценария пользователя «замещение по ширине 1,5x» (T9, design 6.4,
// Acceptance): потребность 10 смен по модели шириной 2, доступна только
// модель шириной 3 -> замещение с К=1,5, смены 10/1,5; вторая строка
// (кандидат есть, но все реквизиты пусты -> К не задан) -> дефицит
// с пометкой «коэффициент замещения не задан» (design 9); третья
// строка (автотранспорт - кандидатов нет вовсе) -> дефицит без пометки.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестЗаполнитьТЧ_ЗамещениеПоШирине() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЗаполнитьТЧ_ЗамещениеПоШирине");

	Оригинал = СоздатьЭлемент("АпкМоделиСХТехники", Новый Структура("ШиринаОбработки", 2));
	Замена = СоздатьЭлемент("АпкМоделиСХТехники", Новый Структура("ШиринаОбработки", 3));
	БезКоэффициента = СоздатьЭлемент("АпкМоделиСХТехники");
	АвтоМодель = СоздатьЭлемент("АпкМоделиАвтотранспорта");

	Если Оригинал = Неопределено Или Замена = Неопределено Или БезКоэффициента = Неопределено
			Или АвтоМодель = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'не удалось создать тестовые модели'"));
	Иначе
		Попытка
			Потребность = НоваяПотребностьТ7();
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
			Стр.МодельТехники = Оригинал;
			Стр.ПотребностьСмен = 10;
			Стр.ПотребностьЧасов = 80;
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
			Стр.МодельТехники = БезКоэффициента;
			Стр.ПотребностьСмен = 5;
			Стр.ПотребностьЧасов = 40;
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.Автотранспорт;
			Стр.МодельТехники = АвтоМодель;
			Стр.ПотребностьСмен = 3;
			Стр.ПотребностьЧасов = 24;

			Модели = НоваяКартаДоступностиТ8();
			СтрК = Модели.Добавить();
			СтрК.МодельТехники = Замена;
			СтрК.ТипТС = Перечисления.АпкТипыТС.СХТехника;
			СтрК.ЕдиницДоступно = 4;
			Доступность = Новый Структура("Модели, ПланОтсутствует", Модели, Ложь);

			ДокументОбъект = Документы.Тх_ПланТехническихРесурсов.СоздатьДокумент();
			Результат = Тх_ТехникаСервер.ЗаполнитьТЧПланаРабот(
				ДокументОбъект, Потребность, Доступность, 10, 1);

			Проверить(Контекст, НСтр("ru = 'строк: 3'"),
				Результат.КоличествоСтрок = 3, Строка(Результат.КоличествоСтрок));
			Проверить(Контекст, НСтр("ru = 'замещённых: 1'"),
				Результат.ЗамещенныхСтрок = 1, Строка(Результат.ЗамещенныхСтрок));
			Проверить(Контекст, НСтр("ru = 'дефицитных: 2'"),
				Результат.ДефицитныхСтрок = 2, Строка(Результат.ДефицитныхСтрок));
			Проверить(Контекст, НСтр("ru = 'ТЧ ОсновнаяТехника: 2 строки'"),
				ДокументОбъект.ОсновнаяТехника.Количество() = 2,
				Строка(ДокументОбъект.ОсновнаяТехника.Количество()));
			Проверить(Контекст, НСтр("ru = 'ТЧ Автотранспорт: 1 строка'"),
				ДокументОбъект.Автотранспорт.Количество() = 1,
				Строка(ДокументОбъект.Автотранспорт.Количество()));

			// Замещённая строка: модель = замена, смены 10/1,5.
			СтрокаЗамены = Неопределено;
			СтрокаДефицита = Неопределено;
			СтрокаАвто = Неопределено;
			Для Каждого СтрДок Из ДокументОбъект.ОсновнаяТехника Цикл
				Если СтрДок.МодельТехники = Замена Тогда
					СтрокаЗамены = СтрДок;
				КонецЕсли;
				Если СтрДок.МодельТехники = БезКоэффициента Тогда
					СтрокаДефицита = СтрДок;
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрДок Из ДокументОбъект.Автотранспорт Цикл
				Если СтрДок.МодельТехники = АвтоМодель Тогда
					СтрокаАвто = СтрДок;
				КонецЕсли;
			КонецЦикла;

			Если СтрокаЗамены = Неопределено Или СтрокаДефицита = Неопределено
					Или СтрокаАвто = Неопределено Тогда
				Проверить(Контекст, НСтр("ru = 'строки найдены по моделям'"), Ложь);
			Иначе
				Проверить(Контекст, НСтр("ru = 'замещённая: 4 единицы'"),
					СтрокаЗамены.ДоступноЕдиниц = 4,
					Строка(СтрокаЗамены.ДоступноЕдиниц));
				// 10 / 1,5 = 6,(6): границы без глобальных функций.
				Проверить(Контекст, НСтр("ru = 'замещённая: смены 10/1,5'"),
					СтрокаЗамены.ПотребностьСмен < 6.67
						И СтрокаЗамены.ПотребностьСмен > 6.66,
					Строка(СтрокаЗамены.ПотребностьСмен));
				Проверить(Контекст, НСтр("ru = 'замещённая: Количество = 1'"),
					СтрокаЗамены.Количество = 1, Строка(СтрокаЗамены.Количество));
				Проверить(Контекст, НСтр("ru = 'комментарий: замещение с К'"),
					СтрНайти(СтрокаЗамены.Комментарий, "замещение:") > 0
						И СтрНайти(СтрокаЗамены.Комментарий, "К=1,5") > 0,
					СтрокаЗамены.Комментарий);
				Проверить(Контекст, НСтр("ru = 'дефицитная: 0 единиц'"),
					СтрокаДефицита.ДоступноЕдиниц = 0,
					Строка(СтрокаДефицита.ДоступноЕдиниц));
				Проверить(Контекст, НСтр("ru = 'дефицитная: Количество = 1'"),
					СтрокаДефицита.Количество = 1, Строка(СтрокаДефицита.Количество));
				// design 9: кандидат есть, но К не задан -> пометка.
				Проверить(Контекст, НСтр("ru = 'дефицитная: пометка К не задан'"),
					СтрокаДефицита.Комментарий
						= НСтр("ru = 'коэффициент замещения не задан'"),
					СтрокаДефицита.Комментарий);
				// Кандидатов нет вовсе -> дефицит без пометки.
				Проверить(Контекст, НСтр("ru = 'авто: 0 единиц'"),
					СтрокаАвто.ДоступноЕдиниц = 0, Строка(СтрокаАвто.ДоступноЕдиниц));
				Проверить(Контекст, НСтр("ru = 'авто: без комментария'"),
					СтрокаАвто.Комментарий = "", СтрокаАвто.Комментарий);
			КонецЕсли;
		Исключение
			Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	УдалитьСсылку(Оригинал);
	УдалитьСсылку(Замена);
	УдалитьСсылку(БезКоэффициента);
	УдалитьСсылку(АвтоМодель);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест движка без замещения (T9, design 6.3): своя модель доступна -
// строка не меняется, Количество = округление вверх(смен/(дней x смен в день)).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестЗаполнитьТЧ_СвояМодельДоступна() Экспорт

	Контекст = НовыйКонтекстТеста("ТестЗаполнитьТЧ_СвояМодельДоступна");

	Модель = СоздатьЭлемент("АпкМоделиСХТехники", Новый Структура("ШиринаОбработки", 2));

	Если Модель = Неопределено Тогда
		СообщитьПропуск(Контекст, НСтр("ru = 'не удалось создать тестовую модель'"));
	Иначе
		Попытка
			Потребность = НоваяПотребностьТ7();
			Стр = Потребность.Добавить();
			Стр.ВидТехники = Перечисления.Тх_ВидыТехники.СХТехника;
			Стр.МодельТехники = Модель;
			Стр.ПотребностьСмен = 25;
			Стр.ПотребностьЧасов = 200;

			Модели = НоваяКартаДоступностиТ8();
			СтрК = Модели.Добавить();
			СтрК.МодельТехники = Модель;
			СтрК.ТипТС = Перечисления.АпкТипыТС.СХТехника;
			СтрК.ЕдиницДоступно = 3;
			Доступность = Новый Структура("Модели, ПланОтсутствует", Модели, Ложь);

			ДокументОбъект = Документы.Тх_ПланТехническихРесурсов.СоздатьДокумент();
			Результат = Тх_ТехникаСервер.ЗаполнитьТЧПланаРабот(
				ДокументОбъект, Потребность, Доступность, 10, 2);

			Проверить(Контекст, НСтр("ru = 'строк: 1'"),
				Результат.КоличествоСтрок = 1, Строка(Результат.КоличествоСтрок));
			Проверить(Контекст, НСтр("ru = 'замещений нет'"),
				Результат.ЗамещенныхСтрок = 0 И Результат.ДефицитныхСтрок = 0);

			СтрокаДока = ДокументОбъект.ОсновнаяТехника[0];
			Проверить(Контекст, НСтр("ru = 'модель не менялась'"),
				СтрокаДока.МодельТехники = Модель);
			Проверить(Контекст, НСтр("ru = 'доступно 3 единицы'"),
				СтрокаДока.ДоступноЕдиниц = 3, Строка(СтрокаДока.ДоступноЕдиниц));
			// округление вверх(25 / (10 x 2)): 1,25 -> 2.
			Проверить(Контекст, НСтр("ru = 'Количество = 2'"),
				СтрокаДока.Количество = 2, Строка(СтрокаДока.Количество));
			Проверить(Контекст, НСтр("ru = 'комментарий пуст'"),
				СтрокаДока.Комментарий = "", СтрокаДока.Комментарий);
		Исключение
			Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	УдалитьСсылку(Модель);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Строит пустую таблицу потребности в формате ПотребностьПоТехкартам (T7).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: ВидТехники, ВидРаботы, МодельТехники,
//     Оборудование, ПотребностьСмен, ПотребностьЧасов.
//
Функция НоваяПотребностьТ7()

	Потребность = Новый ТаблицаЗначений;
	Потребность.Колонки.Добавить("ВидТехники");
	Потребность.Колонки.Добавить("ВидРаботы");
	Потребность.Колонки.Добавить("МодельТехники");
	Потребность.Колонки.Добавить("Оборудование");
	Потребность.Колонки.Добавить("ПотребностьСмен");
	Потребность.Колонки.Добавить("ПотребностьЧасов");

	Возврат Потребность;

КонецФункции

// Строит пустую карту доступности в формате ДоступныеМоделиПодразделения
// (T8).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: МодельТехники, ТипТС, ЕдиницДоступно.
//
Функция НоваяКартаДоступностиТ8()

	Модели = Новый ТаблицаЗначений;
	Модели.Колонки.Добавить("МодельТехники");
	Модели.Колонки.Добавить("ТипТС");
	Модели.Колонки.Добавить("ЕдиницДоступно");

	Возврат Модели;

КонецФункции

#КонецОбласти





#Область Тесты_Сцепка

// Тест ВалидироватьСцепку (FR-002, design 5.3): совместимые пары
// (СХ-техника + СХ-оборудование, автотранспорт + прицеп) проходят,
// несовместимые отклоняются, незаполненная половина сцепкой не считается.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестВалидацииСцепки() Экспорт

	Контекст = НовыйКонтекстТеста("ТестВалидацииСцепки");

	МодельСХ = Неопределено;
	МодельАвто = Неопределено;
	ОборудованиеСХ = Неопределено;
	Прицеп = Неопределено;

	Попытка
		МодельСХ = СоздатьМодель(Перечисления.Тх_ВидыТехники.СХТехника);
		МодельАвто = СоздатьМодель(Перечисления.Тх_ВидыТехники.Автотранспорт);
		ОборудованиеСХ = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделейСХОборудования());
		Прицеп = СоздатьЭлемент(Тх_ТехникаСервер.ИмяСправочникаМоделейПрицепов());

		Если МодельСХ = Неопределено ИЛИ МодельАвто = Неопределено
			ИЛИ ОборудованиеСХ = Неопределено ИЛИ Прицеп = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Проверить(Контекст, НСтр("ru = 'СХ-техника + СХ-оборудование = совместимо'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, ОборудованиеСХ));

		Проверить(Контекст, НСтр("ru = 'автотранспорт + прицеп = совместимо'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельАвто, Прицеп));

		Проверить(Контекст, НСтр("ru = 'СХ-техника + прицеп = несовместимо'"),
			НЕ Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, Прицеп));

		Проверить(Контекст, НСтр("ru = 'автотранспорт + СХ-оборудование = несовместимо'"),
			НЕ Тх_ТехникаСервер.ВалидироватьСцепку(МодельАвто, ОборудованиеСХ));

		Проверить(Контекст, НСтр("ru = 'пустое оборудование - сцепка не проверяется'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(МодельСХ, Неопределено));

		Проверить(Контекст, НСтр("ru = 'пустая модель - сцепка не проверяется'"),
			Тх_ТехникаСервер.ВалидироватьСцепку(Неопределено, ОборудованиеСХ));

	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельСХ);
	УдалитьСсылку(МодельАвто);
	УдалитьСсылку(ОборудованиеСХ);
	УдалитьСсылку(Прицеп);

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти

#Область Тесты_КоэффициентЗамещения

// Тест приоритета ручных реквизитов замещения (FR-004, design 6.4):
// у моделей СХ-техники заполнены ручной коэффициент, ширина и мощность -
// базовым должен стать ручной КоэффициентПереводаВУЭГА; К = 6/4 = 1.5.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияПриоритетРучного() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияПриоритетРучного");

	МодельА = Неопределено;
	МодельБ = Неопределено;

	Попытка
		МодельА = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 4));
		МодельБ = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 6));

		Если МодельА = Неопределено ИЛИ МодельБ = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(МодельА);

		Проверить(Контекст, НСтр("ru = 'базовый реквизит возвращается'"),
			Реквизит <> Неопределено);

		Если Реквизит <> Неопределено Тогда
			Проверить(Контекст, НСтр("ru = 'приоритет ручного КоэффициентПереводаВУЭГА'"),
				Реквизит.Реквизит = "КоэффициентПереводаВУЭГА");

			К = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ);
			Проверить(Контекст, НСтр("ru = 'К = 6/4 = 1.5'"),
				К <> Неопределено И К > 1.499 И К < 1.501);
		КонецЕсли;
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельА);
	УдалитьСсылку(МодельБ);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест замещения по ширине обработки (FR-004, acceptance: ширина 1.5x):
// модели СХ-техники без ручных реквизитов, ширина 2 и 3 - К = 1.5.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияПоШирине() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияПоШирине");

	МодельА = Неопределено;
	МодельБ = Неопределено;

	Попытка
		МодельА = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 2));
		МодельБ = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("ШиринаОбработки", 3));

		Если МодельА = Неопределено ИЛИ МодельБ = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(МодельА);
		Проверить(Контекст, НСтр("ru = 'базовый реквизит - ШиринаОбработки'"),
			Реквизит <> Неопределено И Реквизит.Реквизит = "ШиринаОбработки");

		К = Тх_ТехникаСервер.КоэффициентЗамещения(МодельА, МодельБ);
		Проверить(Контекст, НСтр("ru = 'К = 3/2 = 1.5 (ширина 1.5x)'"),
			К <> Неопределено И К > 1.499 И К < 1.501);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	УдалитьСсылку(МодельА);
	УдалитьСсылку(МодельБ);

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест стартового расчёта по мощности двигателя и прочих каталогов:
// СХ-техника без ручных реквизитов - старт по МощностьДвигателя (К = 1.5);
// автотранспорт по Грузоподъемность (К = 2); прицепы по Вместимость (К = 2).
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияСтартИПрочиеКаталоги() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияСтартИПрочиеКаталоги");

	Модели = Новый Массив;

	Попытка
		Трактор100 = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 100));
		Трактор150 = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 150));
		Грузовик5 = СоздатьЭлемент("АпкМоделиАвтотранспорта",
			Новый Структура("Грузоподъемность", 5));
		Грузовик10 = СоздатьЭлемент("АпкМоделиАвтотранспорта",
			Новый Структура("Грузоподъемность", 10));
		Прицеп10 = СоздатьЭлемент("АпкМоделиПрицепов",
			Новый Структура("Вместимость", 10));
		Прицеп20 = СоздатьЭлемент("АпкМоделиПрицепов",
			Новый Структура("Вместимость", 20));
		Модели.Добавить(Трактор100);
		Модели.Добавить(Трактор150);
		Модели.Добавить(Грузовик5);
		Модели.Добавить(Грузовик10);
		Модели.Добавить(Прицеп10);
		Модели.Добавить(Прицеп20);

		Если Трактор100 = Неопределено ИЛИ Грузовик5 = Неопределено ИЛИ Прицеп10 = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Реквизит = Тх_ТехникаСервер.РеквизитЗамещения(Трактор100);
		Проверить(Контекст, НСтр("ru = 'старт по МощностьДвигателя'"),
			Реквизит <> Неопределено И Реквизит.Реквизит = "МощностьДвигателя");

		КМощь = Тх_ТехникаСервер.КоэффициентЗамещения(Трактор100, Трактор150);
		Проверить(Контекст, НСтр("ru = 'К по мощности = 150/100 = 1.5'"),
			КМощь <> Неопределено И КМощь > 1.499 И КМощь < 1.501);

		КГруз = Тх_ТехникаСервер.КоэффициентЗамещения(Грузовик5, Грузовик10);
		Проверить(Контекст, НСтр("ru = 'К по грузоподъемности = 10/5 = 2'"),
			КГруз <> Неопределено И КГруз > 1.999 И КГруз < 2.001);

		КПрицеп = Тх_ТехникаСервер.КоэффициентЗамещения(Прицеп10, Прицеп20);
		Проверить(Контекст, НСтр("ru = 'К по вместимости прицепов = 20/10 = 2'"),
			КПрицеп <> Неопределено И КПрицеп > 1.999 И КПрицеп < 2.001);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Для Каждого Модель Из Модели Цикл
		УдалитьСсылку(Модель);
	КонецЦикла;

	Возврат РезультатТеста(Контекст);

КонецФункции

// Тест КоэффициентНеЗадан (FR-004): пустые реквизиты, разные базовые
// реквизиты, разные каталоги - везде Неопределено.
//
// Возвращаемое значение:
//   Булево - Истина, если все проверки пройдены (или SKIP).
//
Функция ТестКоэффициентЗамещенияНеЗадан() Экспорт

	Контекст = НовыйКонтекстТеста("ТестКоэффициентЗамещенияНеЗадан");

	Модели = Новый Массив;

	Попытка
		ОборудованиеПустое = СоздатьЭлемент("АпкМоделиСХОборудования");
		ОборудованиеШирокое = СоздатьЭлемент("АпкМоделиСХОборудования",
			Новый Структура("ШиринаОбработки", 4));
		МодельРучная = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("КоэффициентПереводаВУЭГА", 4));
		МодельМощная = СоздатьЭлемент("АпкМоделиСХТехники",
			Новый Структура("МощностьДвигателя", 100));
		Модели.Добавить(ОборудованиеПустое);
		Модели.Добавить(ОборудованиеШирокое);
		Модели.Добавить(МодельРучная);
		Модели.Добавить(МодельМощная);

		Если ОборудованиеПустое = Неопределено ИЛИ МодельРучная = Неопределено Тогда
			СообщитьПропуск(Контекст, НСтр("ru = 'нет каталогов моделей АПК'"));
			Возврат Истина;
		КонецЕсли;

		Проверить(Контекст, НСтр("ru = 'СХ-оборудование без ширины - Неопределено'"),
			Тх_ТехникаСервер.РеквизитЗамещения(ОборудованиеПустое) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'у замены не заполнен реквизит - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(ОборудованиеШирокое, ОборудованиеПустое) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'разные базовые реквизиты - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(МодельРучная, МодельМощная) = Неопределено);

		Проверить(Контекст, НСтр("ru = 'разные каталоги - Неопределено'"),
			Тх_ТехникаСервер.КоэффициентЗамещения(МодельМощная, ОборудованиеШирокое) = Неопределено);
	Исключение
		Проверить(Контекст, НСтр("ru = 'выполнение без исключений'"), Ложь,
			ОписаниеОшибки());
	КонецПопытки;

	Для Каждого Модель Из Модели Цикл
		УдалитьСсылку(Модель);
	КонецЦикла;

	Возврат РезультатТеста(Контекст);

КонецФункции

#КонецОбласти
